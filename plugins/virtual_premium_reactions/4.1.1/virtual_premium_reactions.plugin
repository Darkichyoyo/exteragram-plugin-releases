SETTING_SYNC = "sync_enabled"
SETTING_SCOPE = "sync_scope"
SETTING_SCOPE_CHATS = "sync_chats"
SCOPE_ALL = 0
SCOPE_SELECTED = 1


def _vpr_argb(value):
    value = int(value) & 0xFFFFFFFF
    return value - (1 << 32) if value >= (1 << 31) else value


from android.view import View as _VPRView


class _VPRClick(dynamic_proxy(_VPRView.OnClickListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onClick(self, view):
        try:
            self.fn(view)
        except Exception:
            pass


# --- Manual, user-confirmed updater (same module as MultiTools 3.2) ---


def on_ui_thread():
    try:
        from android.os import Looper
        from java.lang import Thread as JavaThread
        return Looper.getMainLooper().getThread() == JavaThread.currentThread()
    except Exception:
        return False


def ui(fn):
    if on_ui_thread():
        fn()
    else:
        run_on_ui_thread(fn)


def _bulletin(kind, text):
    def _show():
        try:
            getattr(BulletinHelper, "show_" + kind)(text, get_last_fragment())
        except Exception:
            pass
    try:
        ui(_show)
    except Exception:
        pass


def toast_err(text):
    _bulletin("error", text)


def toast_info(text):
    _bulletin("info", text)


RELEASES_BASE = "https://raw.githubusercontent.com/Darkichyoyo/exteragram-plugin-releases/main/"
MANIFEST_URL = RELEASES_BASE + "releases.json"
API_CONTENTS_BASE = "https://api.github.com/repos/Darkichyoyo/exteragram-plugin-releases/contents/"
API_REF = "main"
MAX_MANIFEST_BYTES = 64 * 1024
MAX_PLUGIN_BYTES = 2 * 1024 * 1024
BUSY_TIMEOUT_SECONDS = 180
INSTALL_RESPONSE_TIMEOUT_SECONDS = 90
STALE_TEMP_SECONDS = 600
TEMP_PREFIX = "eg_update_"


def _default_schedule(delay, fn):
    timer = threading.Timer(delay, fn)
    timer.daemon = True
    timer.start()
    return timer
_VERSION = re.compile(r"[0-9]{1,6}(\.[0-9]{1,6}){0,3}")
_SHA = re.compile(r"[0-9a-f]{64}")


class UpdateError(Exception):
    pass


def parse_version(text):
    if not isinstance(text, str) or not _VERSION.fullmatch(text):
        raise UpdateError("Некорректный формат версии")
    parts = tuple(int(p) for p in text.split("."))
    return parts + (0,) * (4 - len(parts))


class ReleaseInfo:
    def __init__(self, plugin_id, version, url, sha256, size):
        self.plugin_id, self.version, self.url, self.sha256, self.size = plugin_id, version, url, sha256, size


def parse_manifest(raw, plugin_id):
    try:
        data = json.loads(raw.decode("utf-8") if isinstance(raw, (bytes, bytearray)) else raw)
    except (ValueError, UnicodeDecodeError):
        raise UpdateError("Манифест обновлений повреждён")
    if not isinstance(data, dict) or data.get("schema") != 1 or not isinstance(data.get("plugins"), dict):
        raise UpdateError("Неподдерживаемый формат манифеста")
    entry = data["plugins"].get(plugin_id)
    if entry is None:
        return None
    if not isinstance(entry, dict):
        raise UpdateError("Некорректная запись манифеста")
    version, url, digest, size = (entry.get(k) for k in ("version", "url", "sha256", "size"))
    parse_version(version)
    if not (isinstance(url, str) and url.startswith(RELEASES_BASE) and url.endswith(".plugin")
            and ".." not in url and len(url) < 300):
        raise UpdateError("Адрес файла обновления не из доверенного репозитория")
    if not (isinstance(digest, str) and _SHA.fullmatch(digest)):
        raise UpdateError("Некорректная контрольная сумма в манифесте")
    if not (isinstance(size, int) and not isinstance(size, bool) and 0 < size <= MAX_PLUGIN_BYTES):
        raise UpdateError("Некорректный размер файла в манифесте")
    return ReleaseInfo(plugin_id, version, url, digest, size)


def read_plugin_metadata(source):
    try:
        tree = ast.parse(source)
    except (SyntaxError, ValueError):
        raise UpdateError("Файл обновления не является корректным Python")
    found = {}
    for node in tree.body:
        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
            name = node.targets[0].id
            if name in ("__id__", "__version__") and isinstance(node.value, ast.Constant) \
                    and isinstance(node.value.value, str):
                found[name] = node.value.value
    return found.get("__id__"), found.get("__version__")


def verify_payload(payload, info, current_id, current_version, stage=None):
    stage = stage or (lambda *_args, **_kwargs: None)
    if len(payload) != info.size:
        raise UpdateError("Размер файла не совпал с манифестом")
    stage("verify.size", "OK", bytes=len(payload))
    digest = hashlib.sha256(payload).hexdigest()
    if digest != info.sha256:
        raise UpdateError("Контрольная сумма SHA-256 не совпала")
    stage("verify.sha256", "OK", sha256=digest[:12])
    try:
        source = payload.decode("utf-8")
    except UnicodeDecodeError:
        raise UpdateError("Файл обновления не в UTF-8")
    file_id, file_version = read_plugin_metadata(source)
    if file_id != current_id or info.plugin_id != current_id:
        raise UpdateError("Идентификатор плагина в файле не совпал")
    if file_version != info.version:
        raise UpdateError("Версия в файле не совпала с манифестом")
    stage("verify.metadata", "OK", id=file_id, version=file_version)
    return source


class UpdateController:
    def __init__(self, plugin_id, version, http_get, install, notify, confirm, background, log=None,
                 clock=time.monotonic, tmp_root=None, source=None, schedule=None, wall_clock=time.time):
        parse_version(version)
        self.plugin_id, self.version = plugin_id, version
        self._http_get, self._install, self._notify = http_get, install, notify
        self._confirm, self._background = confirm, background
        self._log = log or (lambda *_args, **_kwargs: None)
        self._clock, self._tmp_root = clock, tmp_root
        self._lock = threading.Lock()
        self._operation = None
        self._phase = None
        self._busy_since = None
        self._source = source
        self._schedule = schedule or _default_schedule
        self._wall = wall_clock

    def _enter(self):
        with self._lock:
            now = self._clock()
            if self._phase == "handoff" or (self._busy_since is not None and
                    now - self._busy_since < BUSY_TIMEOUT_SECONDS):
                return None
            operation = object()
            self._operation, self._phase = operation, "check"
            self._busy_since = now
            return operation

    def _current(self, operation):
        with self._lock:
            return self._operation is operation

    def _transition(self, operation, before, after):
        with self._lock:
            if self._operation is not operation or self._phase != before:
                return False
            self._phase = after
            self._busy_since = self._clock()
            return True

    def _leave(self, operation):
        with self._lock:
            if self._operation is not operation:
                return False
            self._operation, self._phase = None, None
            self._busy_since = None
            return True

    def _stage(self, stage, result, level="INFO", **details):
        try:
            self._log(stage, result, level, details)
        except Exception:
            pass

    def _fetch(self, stage, url, max_bytes):
        started = self._clock()
        try:
            raw = self._http_get(url, max_bytes)
        except Exception as exc:
            reason = str(exc) if isinstance(exc, UpdateError) else type(exc).__name__
            self._stage(stage, "FAILED", "ERROR", reason=reason, ms=int((self._clock() - started) * 1000))
            raise
        try:
            host = str(self._source()) if self._source is not None else "injected"
        except Exception:
            host = "unknown"
        self._stage(stage, "OK", bytes=len(raw), limit=max_bytes, ms=int((self._clock() - started) * 1000),
                    host=host)
        return raw

    def check(self, *_args):
        operation = self._enter()
        if operation is None:
            self._stage("check", "IGNORED_BUSY", "WARN")
            self._notify("Проверка или установка уже выполняется")
            return
        self._stage("check", "STARTED", installed=self.version)
        try:
            self._background(lambda: self._check_work(operation))
        except Exception as exc:
            self._leave(operation)
            self._stage("check", "NOT_STARTED", "ERROR", reason=type(exc).__name__)
            self._notify("Проверка не запущена: " + type(exc).__name__, True)

    def find_update(self):
        try:
            raw = self._fetch("manifest.fetch", MANIFEST_URL, MAX_MANIFEST_BYTES)
        except UpdateError:
            raise
        except Exception as exc:
            raise UpdateError("Не удалось получить манифест: " + type(exc).__name__)
        if len(raw) > MAX_MANIFEST_BYTES:
            self._stage("manifest.parse", "FAILED", "ERROR", reason="too large", bytes=len(raw))
            raise UpdateError("Манифест слишком большой")
        try:
            info = parse_manifest(raw, self.plugin_id)
        except UpdateError as exc:
            self._stage("manifest.parse", "FAILED", "ERROR", reason=str(exc))
            raise
        if info is None:
            self._stage("manifest.parse", "NO_ENTRY", "WARN", plugin=self.plugin_id)
            return None
        self._stage("manifest.parse", "OK", remote=info.version, size=info.size, sha256=info.sha256[:12])
        newer = parse_version(info.version) > parse_version(self.version)
        self._stage("version.compare", "NEWER" if newer else "NOT_NEWER", installed=self.version,
                    remote=info.version)
        return info if newer else None

    def _check_work(self, operation):
        if not self._current(operation):
            return
        try:
            info = self.find_update()
        except UpdateError as exc:
            if not self._leave(operation):
                return
            self._notify(str(exc), True)
            return
        except Exception as exc:
            if not self._leave(operation):
                return
            self._stage("check", "CRASHED", "ERROR", reason=type(exc).__name__)
            self._notify("Проверка не выполнена: " + type(exc).__name__, True)
            return
        if info is None:
            if not self._leave(operation):
                return
            self._stage("check", "UP_TO_DATE", installed=self.version)
            self._notify(f"Установлена последняя версия ({self.version})")
            return
        if not self._transition(operation, "check", "confirm"):
            return
        self._stage("confirm", "SHOWN", remote=info.version)

        def declined():
            if not self._transition(operation, "confirm", "declined"):
                return
            self._stage("confirm", "DECLINED")
            self._leave(operation)
        try:
            self._confirm(info, lambda: self.start_install(info, operation), declined)
        except Exception as exc:
            self._leave(operation)
            self._stage("confirm", "FAILED", "ERROR", reason=type(exc).__name__)
            self._notify("Диалог обновления не открыт: " + type(exc).__name__, True)

    def start_install(self, info, operation):
        if not self._transition(operation, "confirm", "install"):
            return
        self._stage("confirm", "ACCEPTED", remote=info.version)
        try:
            self._background(lambda: self._install_work(info, operation))
        except Exception as exc:
            self._leave(operation)
            self._notify("Установка не запущена: " + type(exc).__name__, True)

    def _sweep_stale(self):
        root = self._tmp_root or tempfile.gettempdir()
        removed = 0
        try:
            names = os.listdir(root)
        except OSError:
            return
        now = self._wall()
        for name in names:
            path = os.path.join(root, name)
            try:
                if (name.startswith(TEMP_PREFIX) and os.path.isdir(path)
                        and now - os.path.getmtime(path) > STALE_TEMP_SECONDS):
                    shutil.rmtree(path, ignore_errors=True)
                    removed += 1
            except OSError:
                continue
        if removed:
            self._stage("install.cleanup", "STALE_REMOVED", count=removed)

    def _install_work(self, info, operation):
        if not self._current(operation):
            return
        directory = None
        try:
            self._sweep_stale()
            payload = self._fetch("download", info.url, min(info.size, MAX_PLUGIN_BYTES))
            try:
                verify_payload(payload, info, self.plugin_id, self.version, self._stage)
            except UpdateError as exc:
                self._stage("verify", "FAILED", "ERROR", reason=str(exc))
                raise
            if parse_version(info.version) <= parse_version(self.version):
                raise UpdateError("Версия не новее установленной")
            directory = tempfile.mkdtemp(prefix=TEMP_PREFIX, dir=self._tmp_root)
            path = os.path.join(directory, self.plugin_id + ".plugin")
            with open(path, "xb") as output:
                output.write(payload)
            self._stage("install.handoff", "STARTED", note="file verified; passing to plugin engine")
        except UpdateError as exc:
            self._finish(directory, False, str(exc), operation)
            return
        except Exception as exc:
            self._finish(directory, False, "Скачивание не выполнено: " + type(exc).__name__, operation)
            return
        if not self._transition(operation, "install", "handoff"):
            shutil.rmtree(directory, ignore_errors=True)
            return
        state = {"done": False, "timed_out": False}
        guard = threading.Lock()

        def outcome(result):
            if result is None:
                return True, f"Движок подтвердил установку версии {info.version}"
            first = str(result).strip().splitlines()[0][:120] if str(result).strip() else "без описания"
            return False, "Установка не выполнена движком: " + first

        def callback(result):
            with guard:
                if state["done"]:
                    return
                state["done"] = True
                late = state["timed_out"]
            ok, message = outcome(result)
            if not late:
                self._finish(directory, ok, message, operation)
                return
            shutil.rmtree(directory, ignore_errors=True)
            self._stage("install.result", "LATE_OK" if ok else "LATE_FAILED", "INFO" if ok else "ERROR",
                        message=message[:160])
            self._notify(message, not ok)

        def no_response():
            with guard:
                if state["done"] or state["timed_out"]:
                    return
                state["timed_out"] = True
            self._leave(operation)
            self._stage("install.result", "NO_RESPONSE", "WARN", waited_s=INSTALL_RESPONSE_TIMEOUT_SECONDS,
                        note="request sent, installation NOT confirmed; temp file kept for the engine")
            self._notify(f"Установщик не ответил за {INSTALL_RESPONSE_TIMEOUT_SECONDS} с — установка не "
                         "подтверждена. Проверьте версию в списке плагинов.", True)

        try:
            route = self._install(path, callback)
            self._stage("install.handoff", "RETURNED", route=str(route), callback_received=state["done"],
                        note="request handed over; this is not an installation result")
        except Exception as exc:
            with guard:
                if state["done"]:
                    return
                state["done"] = True
            self._finish(directory, False, "Установщик недоступен: " + type(exc).__name__, operation)
            return
        self._transition(operation, "handoff", "waiting")
        with guard:
            waiting = not state["done"]
        if waiting:
            try:
                self._schedule(INSTALL_RESPONSE_TIMEOUT_SECONDS, no_response)
            except Exception as exc:
                self._stage("install.watchdog", "NOT_STARTED", "ERROR", reason=type(exc).__name__)

    def _finish(self, directory, ok, message, operation):
        if directory:
            shutil.rmtree(directory, ignore_errors=True)
        self._leave(operation)
        self._stage("install.result", "OK" if ok else "FAILED", "INFO" if ok else "ERROR", message=message[:160])
        self._notify(message, not ok)


def no_cache_url(url, now=None):
    if url != MANIFEST_URL:
        return url
    stamp = int((time.time() if now is None else now) * 1000)
    return f"{url}?nocache={stamp}"


def api_url(url):
    if not url.startswith(RELEASES_BASE):
        return None
    path = url[len(RELEASES_BASE):]
    if not path or ".." in path or "?" in path or "#" in path:
        return None
    return API_CONTENTS_BASE + path + "?ref=" + API_REF


class UpdaterBindings:
    def __init__(self):
        self.last_source = "none"

    def http_get(self, url, max_bytes):
        if not url.startswith("https://"):
            raise UpdateError("Допускается только HTTPS")
        primary = api_url(url)
        if primary is not None:
            try:
                data = self._get(primary, max_bytes, api=True)
                self.last_source = "api.github.com"
                return data
            except Exception as exc:
                reason = str(exc) if isinstance(exc, UpdateError) else type(exc).__name__
                data = self._get(url, max_bytes)
                self.last_source = "raw.githubusercontent.com (api: " + reason[:60] + ")"
                return data
        data = self._get(url, max_bytes)
        self.last_source = "raw.githubusercontent.com"
        return data

    def _get(self, url, max_bytes, api=False):
        from java.net import URL
        conn = URL(url if api else no_cache_url(url)).openConnection()
        if api:
            conn.setRequestProperty("Accept", "application/vnd.github.raw")
            conn.setRequestProperty("X-GitHub-Api-Version", "2022-11-28")
        conn.setUseCaches(False)
        conn.setRequestProperty("Cache-Control", "no-cache")
        conn.setRequestProperty("Pragma", "no-cache")
        conn.setInstanceFollowRedirects(False)
        conn.setConnectTimeout(10000)
        conn.setReadTimeout(20000)
        conn.setRequestProperty("User-Agent", "exteragram-plugin-updater/1")
        stream, chunks, total = None, [], 0
        try:
            code = conn.getResponseCode()
            if code != 200:
                raise UpdateError(f"Сервер ответил HTTP {code}")
            stream = conn.getInputStream()
            from java import jarray, jbyte
            buffer = jarray(jbyte)(8192)
            while True:
                count = stream.read(buffer)
                if count < 0:
                    break
                total += count
                if total > max_bytes:
                    raise UpdateError("Ответ сервера больше допустимого размера")
                chunks.append(bytes(bytearray(b & 0xFF for b in buffer[:count])))
        finally:
            if stream is not None:
                try:
                    stream.close()
                except Exception:
                    pass
            conn.disconnect()
        return b"".join(chunks)

    def install(self, path, callback):
        from java import dynamic_proxy, jclass
        Utilities = jclass("org.telegram.messenger.Utilities")
        PluginsController = jclass("com.exteragram.messenger.plugins.PluginsController")

        class Result(dynamic_proxy(Utilities.Callback)):
            def run(self, arg):
                callback(None if arg is None else str(arg))

        proxy = Result()
        controller = PluginsController.getInstance()
        engine = None
        try:
            engine = controller.engines.get("python")
        except Exception:
            engine = None
        if engine is not None:
            try:
                engine.loadPluginFromFile(path, None, proxy)
                return "engine"
            except TypeError:
                pass
        controller.loadPluginFromFile(path, proxy)
        return "controller"


def _upd_background(fn):
    thread = threading.Thread(target=fn, name="virtual_premium_reactions-updater")
    thread.daemon = True
    thread.start()


def _upd_notify(text, error=False):
    (toast_err if error else toast_info)(text)


def show_update_sheet(context, title, versions, note, button, decision):
    from java import dynamic_proxy
    from android.content import DialogInterface
    from android.graphics.drawable import GradientDrawable
    from android.view import Gravity, View
    from android.widget import LinearLayout, TextView
    from org.telegram.ui.ActionBar import BottomSheet, Theme
    density = context.getResources().getDisplayMetrics().density
    dp = lambda v: int(density * v + 0.5)

    def color(name, default):
        try:
            return Theme.getColor(getattr(Theme, name))
        except Exception:
            return default

    def signed(argb):
        argb &= 0xFFFFFFFF
        return argb - (1 << 32) if argb >= (1 << 31) else argb

    def with_alpha(value, alpha):
        return signed((alpha << 24) | (value & 0xFFFFFF))

    def readable_on(value):
        red, green, blue = (value >> 16) & 255, (value >> 8) & 255, value & 255
        return signed(0xFF1B1B1B) if (0.299 * red + 0.587 * green + 0.114 * blue) > 150 else -1

    def rounded(fill, radius):
        shape = GradientDrawable()
        shape.setColor(fill)
        shape.setCornerRadius(float(dp(radius)))
        return shape

    sheet = BottomSheet(context, False)

    class Click(dynamic_proxy(View.OnClickListener)):
        def __init__(self, action):
            super().__init__()
            self.action = action

        def onClick(self, view):
            self.action(view)

    class Dismissed(dynamic_proxy(DialogInterface.OnDismissListener)):
        def onDismiss(self, dialog):
            decision.close()

    def text_view(text, size, text_color):
        view = TextView(context)
        view.setText(text)
        view.setTextSize(size)
        view.setTextColor(text_color)
        return view

    main_color = color("key_windowBackgroundWhiteBlackText", -1)
    gray_color = color("key_windowBackgroundWhiteGrayText2", -5592406)
    accent = color("key_featuredStickers_addButton", -14443544)

    root = LinearLayout(context)
    root.setOrientation(LinearLayout.VERTICAL)
    root.setPadding(dp(20), dp(10), dp(20), dp(20))
    info = LinearLayout(context)
    info.setOrientation(LinearLayout.VERTICAL)
    info.setClickable(True)
    handle = View(context)
    handle.setBackground(rounded(with_alpha(gray_color, 0x80), 2))
    handle_params = LinearLayout.LayoutParams(dp(36), dp(4))
    handle_params.gravity = Gravity.CENTER_HORIZONTAL
    info.addView(handle, handle_params)

    heading = text_view(title, 22, main_color)
    try:
        from org.telegram.messenger import AndroidUtilities
        heading.setTypeface(AndroidUtilities.bold())
    except Exception:
        pass
    heading_params = LinearLayout.LayoutParams(-2, -2)
    heading_params.topMargin = dp(18)
    info.addView(heading, heading_params)

    chip = text_view(versions, 14, accent)
    chip.setPadding(dp(10), dp(4), dp(10), dp(4))
    chip.setBackground(rounded(with_alpha(accent, 0x2E), 10))
    chip_params = LinearLayout.LayoutParams(-2, -2)
    chip_params.topMargin = dp(10)
    info.addView(chip, chip_params)

    note_view = text_view(note, 14, gray_color)
    note_params = LinearLayout.LayoutParams(-1, -2)
    note_params.topMargin = dp(10)
    note_params.bottomMargin = dp(18)
    info.addView(note_view, note_params)
    root.addView(info, LinearLayout.LayoutParams(-1, -2))

    action = text_view(button, 16, readable_on(accent))
    action.setGravity(Gravity.CENTER)
    action.setBackground(rounded(accent, 14))
    action.setClickable(True)
    try:
        from org.telegram.messenger import AndroidUtilities
        action.setTypeface(AndroidUtilities.bold())
    except Exception:
        pass
    root.addView(action, LinearLayout.LayoutParams(-1, dp(52)))

    def on_download(view):
        if decision.download():
            view.setEnabled(False)
            sheet.dismiss()

    def on_info(view):
        decision.close()
        sheet.dismiss()

    action.setOnClickListener(Click(on_download))
    info.setOnClickListener(Click(on_info))
    sheet.setCustomView(root)
    sheet.setOnDismissListener(Dismissed())
    sheet.show()


class UpdateSheetDecision:
    def __init__(self, accepted, declined):
        self._accepted, self._declined = accepted, declined
        self._lock, self._decided = threading.Lock(), False

    def _take(self):
        with self._lock:
            if self._decided:
                return False
            self._decided = True
            return True

    def download(self):
        if not self._take():
            return False
        self._accepted()
        return True

    def close(self):
        if not self._take():
            return False
        self._declined()
        return True


def _upd_confirm(current):
    def confirm(info, accepted, declined):
        def show():
            decision = UpdateSheetDecision(accepted, declined)
            try:
                fragment = get_last_fragment()
                activity = fragment.getParentActivity() if fragment is not None else None
                if activity is None:
                    raise RuntimeError("no activity")
            except Exception as exc:
                decision.close()
                _upd_notify("Диалог обновления не открыт: " + type(exc).__name__, True)
                return
            try:
                show_update_sheet(activity, "Доступно обновление", "%s → %s" % (current, info.version),
                                  "Перед установкой файл будет проверен.", "Скачать", decision)
                return
            except Exception:
                pass
            try:
                def close(dialog):
                    try:
                        dialog.dismiss()
                    except Exception:
                        pass

                def yes(dialog, _which):
                    close(dialog)
                    decision.download()

                def no(dialog, _which):
                    close(dialog)
                    decision.close()

                builder = AlertDialogBuilder(activity)
                builder.set_title("Доступно обновление")
                builder.set_message("Версия %s → %s. Файл будет скачан, проверен (SHA-256, ID, версия) "
                                    "и передан движку плагинов для установки." % (current, info.version))
                builder.set_positive_button("Установить", yes)
                builder.set_negative_button("Отмена", no)
                builder.set_cancelable(False)
                builder.show()
            except Exception as exc:
                decision.close()
                _upd_notify("Диалог обновления не открыт: " + type(exc).__name__, True)
        ui(show)
    return confirm


def build_updater(plugin_id, version, log=None):
    android = UpdaterBindings()
    return UpdateController(plugin_id, version, android.http_get, android.install, _upd_notify,
                            _upd_confirm(version), _upd_background, log=log, source=lambda: android.last_source)


class VirtualPremiumReactionsPlugin(BasePlugin):
    _cfg: Dict[str, Any] = {"enabled": False, "all": "", "local": "", "ttl_days": 7,
                            "animate": True, "capture": "", "double_tap": True}
    _pending: Optional[Dict[str, Any]] = None
    _programmatic_until: float = 0.0

    def _reset_state(self) -> None:
        self._pending = None
        self._vpr_merged = set()
        self._programmatic_until = 0.0
        self._live: Dict[Tuple[int, int, int], Any] = {}

        self._lock = threading.RLock()

        self._inflight: Dict[int, List[Dict[str, Any]]] = {}

        self._expect: List[Dict[str, Any]] = []
        self._op_seq = 0
        self._records: Dict[str, Dict[str, Any]] = {}
        self._index: Dict[Tuple[int, int, int], List[str]] = {}

        self._updates: Dict[Tuple[int, int, int], Dict[str, Any]] = {}

        self._removals: Dict[Tuple[int, int, int], Dict[str, Any]] = {}
        self._field_cache: Dict[Tuple[str, str], Any] = {}
        self._panel_types = REACTION_PANEL_TYPES
        self._dirty = False
        self._flush_scheduled = False

        self._store_lock = threading.Lock()
        self._tmp_seq = 0
        self._unloaded = False
        self._last_cleanup = 0.0
        self._store_file: Optional[str] = None
        self._direct_picker = None
        self._direct_window = None
        self._direct_kind = None
        self._direct_listener = None
        self._direct_peer = None
        self._direct_window_peer = None
        self._picker_proxy_type = None
        self._picker_window_proxy_type = None
        self._picker_hooks = set()
        self._sync = None
        self._sync_latest = {}
        self._preview_vr = None
        self._preview_swap = None
        self._updater = None

        self._sync_seq = 0
        self._vpr_background = False
        self._vpr_peers = {}
        self._vpr_peer_lock = threading.Lock()
        self._vpr_peer_file_lock = threading.Lock()
        self._vpr_peers_dirty = False
        self._vpr_peers_save_pending = False
        self._vpr_seen = {}
        self._vpr_predicted = {}
        self._vpr_recheck = {}
        self._vpr_warmed = set()

    def on_plugin_load(self) -> None:
        self._reset_state()
        self._refresh_config()

        if self._cfg.get("capture"):
            self.set_setting(SETTING_CAPTURE, "")
            self._refresh_config()
        self._load_store()
        self._vpr_load_peers()
        self._cleanup(force=True)
        self._install_hooks()
        self._sync_configure()
        self._vpr_after_load()

    def on_plugin_unload(self) -> None:
        if self._sync is not None:
            self._sync.stop()
            self._sync = None
        self._close_direct_picker()
        try:
            self._revert_all_live()
        except Exception:
            pass
        self._flush_now()
        self._vpr_flush_peers()

        self._unloaded = True
        self._live = {}
        self._cancel_taps()

    def on_app_event(self, event_type) -> None:
        try:
            if event_type == AppEvent.RESUME:
                self._vpr_background = False
                self._refresh_config()
                self._cleanup()
            elif event_type in (AppEvent.PAUSE, AppEvent.STOP):
                self._vpr_background = True
                self._cleanup(force=True)
                self._flush_now()
                self._vpr_flush_peers()
                if self._sync is not None: self._sync.leave()
        except Exception:
            pass

    def _install_hooks(self) -> None:
        for name, method, hook in (
            ("org.telegram.ui.ChatActivity", "selectReaction", _SelectReactionHook(self)),
            ("org.telegram.ui.Components.Reactions.ReactionsLayoutInBubble", "setMessage", _ReactionsRenderHook(self)),
            ("org.telegram.ui.Components.Reactions.ReactionsLayoutInBubble$ReactionButton", "attachPreview", _ReactionPreviewHook(self)),
            ("org.telegram.ui.Components.Reactions.ReactionsEffectOverlay", "show", _VPREffectHook(self)),
            ("org.telegram.ui.Components.Reactions.ReactionsLayoutInBubble", "getReactionButton", _VPRButtonLookupHook(self)),
        ):
            try:
                clazz = find_class(name)
                if clazz is not None:
                    self.hook_all_methods(clazz, method, hook)
            except Exception:
                pass

        try:
            from java.lang import Class
            from org.telegram.messenger import ApplicationLoader
            reflected = Class.forName('org.telegram.ui.ChatActivity', False, ApplicationLoader.applicationContext.getClassLoader())
            names = {str(m.getName()) for m in reflected.getDeclaredMethods()}
            chat = find_class('org.telegram.ui.ChatActivity')
            for name, leaving in (('onResume', False), ('onPause', True), ('onFragmentDestroy', True)):
                if name in names:
                    self.hook_all_methods(chat, name, _ChatLifecycleHook(self, leaving))
        except Exception:
            pass

        types = set(REACTION_PANEL_TYPES)
        for name in ("TYPE_REACTIONS", "TYPE_TAGS"):
            try:
                types.add(int(getattr(SelectAnimatedEmojiDialog, name)))
            except Exception:
                pass
        self._panel_types = tuple(types)

        picker_hook = _PickerHook(self)
        picker = find_class("org.telegram.ui.SelectAnimatedEmojiDialog")
        abstract_only = set()
        try:
            from java.lang import Class
            from java.lang.reflect import Modifier
            from org.telegram.messenger import ApplicationLoader
            loader = ApplicationLoader.applicationContext.getClassLoader()
            reflected = Class.forName("org.telegram.ui.SelectAnimatedEmojiDialog", False, loader)
            candidates = {}
            for member in reflected.getDeclaredMethods():
                name = str(member.getName())
                candidates.setdefault(name, []).append(bool(Modifier.isAbstract(member.getModifiers())))
            abstract_only = {name for name, flags in candidates.items() if flags and all(flags)}
        except Exception:
            pass
        if picker is not None:
            for method in ("onReactionClick", "onEmojiSelected", "onEmojiClick"):
                if method in abstract_only:
                    continue
                try:
                    unhooks = self.hook_all_methods(picker, method, picker_hook)
                    if unhooks:
                        self._picker_hooks.add(method)
                except Exception:
                    pass

        window = "org.telegram.ui.Components.Reactions." + WINDOW_HINT
        for name in [window]:
            try:
                from java.lang import Class
                from org.telegram.messenger import ApplicationLoader
                reflected_window = Class.forName(name, False, ApplicationLoader.applicationContext.getClassLoader())
                from java.lang.reflect import Modifier
                if not any(str(m.getName()) == 'onEmojiSelected' and not Modifier.isAbstract(m.getModifiers())
                           for m in reflected_window.getDeclaredMethods()):
                    continue
            except Exception:
                continue
            clazz = self._find_class_safe(name)
            if clazz is None:
                continue
            try:
                self.hook_all_methods(clazz, "onEmojiSelected", picker_hook)
            except Exception:
                pass

        for name in ("TL_messages_sendReaction", "TL_updateMessageReactions",
                     "TL_updateEditMessage", "TL_updateEditChannelMessage"):
            try:
                self.add_hook(name)
            except Exception:
                pass

    def _refresh_config(self) -> None:
        try:
            ttl_index = int(self.get_setting(SETTING_TTL, DEFAULT_TTL_INDEX) or 0)
        except Exception:
            ttl_index = DEFAULT_TTL_INDEX
        ttl_index = max(0, min(len(TTL_VARIANTS) - 1, ttl_index))
        self._cfg = {
            "enabled": bool(self.get_setting(SETTING_ENABLED, True)),
            "all": self.get_setting(SETTING_ALL, "") or "",
            "local": self.get_setting(SETTING_LOCAL, "") or "",
            "ttl_days": TTL_VARIANTS[ttl_index],
            "animate": bool(self.get_setting(SETTING_ANIMATION, True)),
            "capture": self.get_setting(SETTING_CAPTURE, "") or "",
            "double_tap": True,
        }

    def _sync_configure(self, enabled=None) -> None:
        old = getattr(self, '_sync', None)
        if old is not None:
            with old.lock:
                targets = list(old.visible)
            old.stop()
        else:
            targets = []
        self._sync = None
        for target in targets:
            obj = self._live.get(target)
            if obj is not None:
                self._refresh_message(*target, obj)
        self._sync_latest = {}
        if enabled is None:
            enabled = bool(self.get_setting('sync_enabled', True))
        if self._unloaded or not self._cfg.get('enabled') or not enabled:
            return
        try:
            name = 'org.telegram.ui.Components.Reactions.ReactionsLayoutInBubble$ReactionLayoutButton'
            try:
                from java.lang import Class
                from org.telegram.messenger import ApplicationLoader
                Class.forName(name, False, ApplicationLoader.applicationContext.getClassLoader())
            except Exception:
                return
            if find_class(name) is None:
                return
            from java import jclass
            cls = jclass(name)

            url, api = _VPR_DEFAULT_DB, _VPR_DEFAULT_API_KEY
            sync = _VPRSync(self, url, api, cls)
            self._sync = sync
        except Exception:
            self._sync = None

    def _on_sync_change(self, value=None, *_args) -> None:
        self._refresh_config()
        self._sync_configure(bool(value) if self._vpr_is_boolean(value) else None)
        self._schedule_settings_reload()

    def _sync_descriptor(self, message_object):
        try:
            account = int(message_object.currentAccount); dialog = int(message_object.getDialogId())
            mid = int(message_object.getId()); me = self._uid(account)
            if not self._scope_allows(dialog): return None
            owner = message_object.messageOwner
            if owner is None or mid <= 0 or me <= 0: return None
            peer = getattr(owner,'peer_id',None)
            if isinstance(peer,TLRPC.TL_peerUser):
                other = dialog
                if other == me or other <= 0: return None
                sender = int(message_object.getFromChatId()); date = int(owner.date)
                if sender not in (me,other) or date <= 0: return None

                text = getattr(owner, 'message', None)
                text = str(text).strip() if text is not None else ''
                tag = hashlib.sha256(text.encode('utf-8', 'surrogatepass')).hexdigest()[:2]
                raw = 'p2:{}:{}:{}:{}:{}'.format(min(me,other),max(me,other),date,sender,tag)
            elif isinstance(peer,TLRPC.TL_peerChat):
                chat_id=int(peer.chat_id)
                if dialog >= 0 or chat_id <= 0: return None
                raw = '{}:{}'.format(chat_id,mid)
            elif isinstance(peer,TLRPC.TL_peerChannel):
                chat_id=int(peer.channel_id)
                if dialog >= 0 or chat_id <= 0: return None
                raw = '{}:{}'.format(chat_id,mid)
            else: return None
            key=hashlib.sha256(raw.encode('utf-8')).hexdigest()[:32]
            return account,dialog,mid,me,key
        except Exception:
            return None

    def _sync_refresh(self, target, sync) -> None:
        def refresh():
            if self._unloaded or self._sync is not sync or not sync.active: return
            obj=self._live.get(target)
            if obj is not None: self._refresh_message(*target,obj)
        try: run_on_ui_thread(refresh)
        except Exception: pass

    @staticmethod
    def _vpr_is_boolean(value) -> bool:
        return isinstance(value, (bool, Boolean))

    @classmethod
    def _select_variant(cls, args):
        if args is None or len(args) not in (10, 11, 12):
            return None
        if not isinstance(args[1], MessageObject):
            return None
        if args[6] is None or not isinstance(args[6], ReactionsLayoutInBubble.VisibleReaction):
            return None
        if not all(cls._vpr_is_boolean(args[i]) for i in range(7, len(args))):
            return None
        return str(len(args)) + " арг."

    @classmethod
    def _set_message_variant(cls, args):
        if args is None or len(args) not in (3, 4):
            return None
        if args[0] is None or not isinstance(args[0], MessageObject):
            return None
        if not cls._vpr_is_boolean(args[1]):
            return None
        if len(args) == 4 and not cls._vpr_is_boolean(args[2]):
            return None
        provider = args[-1]
        if provider is not None and not isinstance(provider, Theme.ResourcesProvider):
            return None
        return len(args)

    def _sync_render(self, param) -> None:
        sync = self._sync
        if sync is None or not sync.active or not self._cfg.get('enabled'):
            return
        try:
            args = param.args
            variant = self._set_message_variant(args)
            if variant is None:
                return
            obj = args[0]
            is_small = bool(args[1])
            is_tags = bool(args[2]) if variant == 4 else False
            if is_small or is_tags:
                return
            desc = self._sync_descriptor(obj)
            if desc is None:
                return
            account, dialog, mid, me, key = desc
            target = (account, dialog, mid)

            reactions, results = self._results_of(obj)
            if reactions is None or results is None or self._is_min(reactions) or int(results.size()) == 0:
                return
            self._remember_live(account, dialog, mid, obj)
            sync.observe(*desc)
            with sync.lock:
                clash = any(k != target and k[:2] == target[:2] and v[0][4] == key
                            for k, v in sync.visible.items())
            entries = sync.last(me, key) if clash else sync.get(me, key)
            if not entries and (dialog <= 0 or clash):
                return
            layout = param.thisObject
            buttons = layout.reactionButtons
            if buttons is None:
                return
            button_list = [buttons.get(i) for i in range(int(buttons.size()))]
            if entries:
                self._vpr_forget(target)
            else:
                entries = self._vpr_predict(sync, desc, button_list, obj)
                if not entries:
                    return
            if dialog <= 0:
                self._sync_render_group(button_list, entries, account, mid)
                return
            docs = sorted({d for d, _f in entries})
            if len(docs) != 1:
                remembered = sync.last(me, key)
                if len({d for d, _f in remembered}) == 1:
                    entries = remembered
                    docs = [remembered[0][0]]
            if len(docs) != 1:
                return
            doc = docs[0]

            fallbacks = {f for _d, f in entries if f}
            candidates = []
            for button in button_list:
                real_key = self._key_of_tl(button.reaction)
                if not real_key or real_key == _KEY_STAR:
                    continue
                if fallbacks and real_key not in fallbacks:
                    continue
                if bool(button.choosen) or int(button.realCount) != 1:
                    continue
                candidates.append(button)
            if len(candidates) != 1:
                combined = []
                for b in button_list:
                    rk = self._key_of_tl(b.reaction)
                    if (rk and rk.startswith('e:') and (not fallbacks or rk in fallbacks)
                            and bool(b.choosen) and int(b.realCount) == 2):
                        combined.append(b)
                if not candidates and len(combined) == 1 and (fallbacks or len(button_list) == 1):
                    self._sync_swap_image(combined[0], account, doc)
                return
            button = candidates[0]
            if self._key_of_tl(button.reaction) == 'd:' + str(doc):
                return
            if self._sync_swap_image(button, account, doc) is False:
                return
        except Exception:
            errors = getattr(self, '_vpr_render_errors', 0) + 1
            self._vpr_render_errors = errors
            if errors >= 20:
                sync.stop(); self._sync = None

    def _sync_swap_image(self, button, account, doc):
        from java import jlong
        from org.telegram.ui.Components import AnimatedEmojiDrawable

        try:
            current = button.animatedEmojiDrawable
            if current is not None and int(current.getDocumentId()) == int(doc):
                return False
        except Exception:
            pass
        try:
            drawable = AnimatedEmojiDrawable.make(jint(account), jint(button.getCacheType()), jlong(doc))
        except Exception:
            drawable = AnimatedEmojiDrawable(jint(button.getCacheType()), jint(account), jlong(doc))
        old_drawable = button.animatedEmojiDrawable
        was_attached = bool(button.attached)
        try:
            if was_attached:
                button.detach()
            button.animatedEmojiDrawable = drawable
            if was_attached:
                button.attach()
        except Exception:
            try:
                if bool(button.attached):
                    button.detach()
                button.animatedEmojiDrawable = old_drawable
                if was_attached:
                    button.attach()
            except Exception:
                pass
            raise
        return True

    def _preview_before(self, param):
        self._preview_after()
        button = param.thisObject
        if button is None or button.previewImageReceiver is not None or button.previewAnimatedEmojiDrawable is not None:
            return
        drawable = button.animatedEmojiDrawable
        if drawable is None:
            return
        doc = int(drawable.getDocumentId())
        if not doc:
            return
        field = self._preview_vr
        if field is None:
            clazz = button.getClass()
            while clazz is not None and field is None:
                try:
                    field = clazz.getDeclaredField('visibleReaction')
                except Exception:
                    clazz = clazz.getSuperclass()
            if field is None:
                return
            field.setAccessible(True)
            self._preview_vr = field
        visible = field.get(button)
        if visible is None or visible.emojicon is None:
            return
        field.set(button, ReactionsLayoutInBubble.VisibleReaction.fromCustomEmoji(Long(doc)))
        self._preview_swap = (button, visible)

    def _preview_after(self):
        swap = self._preview_swap
        if swap is None:
            return
        self._preview_swap = None
        self._preview_vr.set(swap[0], swap[1])

    def _sync_render_group(self, button_list, entries, account, mid):
        by_fallback = {}
        for d, f in entries:
            if f:
                by_fallback.setdefault(f, []).append(d)
        if not by_fallback:
            return
        for button in button_list:
            real_key = self._key_of_tl(button.reaction)
            if not real_key or real_key == _KEY_STAR or bool(button.choosen):
                continue
            docs = by_fallback.get(real_key)
            if not docs or len(set(docs)) != 1 or int(button.realCount) != len(docs):
                continue
            if real_key == 'd:' + str(docs[0]):
                continue
            self._sync_swap_image(button, account, docs[0])

    @staticmethod
    def _sync_button_field(button, name):
        clazz = button.getClass()
        while clazz is not None:
            try:
                field = clazz.getDeclaredField(name)
                field.setAccessible(True)
                return field.get(button)
            except Exception:
                clazz = clazz.getSuperclass()
        return None

    def _sync_after_choice(self, param, pending) -> None:
        if pending is None or self._sync is None:
            return
        args = param.args
        if not self._select_variant(args):
            return
        obj = args[1]
        if (int(obj.currentAccount) != pending.get("account") or
                int(obj.getDialogId()) != pending.get("dialog_id") or
                int(obj.getId()) != pending.get("message_id")):
            return
        kind = pending.get("kind")
        if kind == PENDING_ADD:
            _key, record = self._record_of(pending["account"], pending["dialog_id"], pending["message_id"])
            _reactions, results = self._results_of(obj)
            _i, chosen = self._find_entry(results, pending.get("local"), chosen=True)
            if record is None or record.get("local") != pending.get("local") or chosen is None:
                return
            self._sync_publish_choice(obj, pending.get("local"), pending.get("real"))
        elif kind in (PENDING_REMOVE, PENDING_PLAIN):
            self._sync_publish_choice(obj, None)

    def _sync_join_key(self, args, message_object, clicked_key):
        sync = self._sync
        if sync is None or not sync.active or not self._cfg.get("enabled"):
            return None
        if (not isinstance(clicked_key, str) or not clicked_key or clicked_key == _KEY_STAR
                or clicked_key.startswith("d:")):
            return None
        try:
            if args is None or len(args) != 11 or args[2] is not None:
                return None
        except Exception:
            return None
        desc = self._sync_descriptor(message_object)
        if desc is None:
            return None
        _account, dialog, _mid, me, key = desc
        entries = sync.get(me, key)
        if not entries and dialog > 0:
            entries = self._vpr_predicted_entries(desc)
        if not entries:
            return None
        _reactions, results = self._results_of(message_object)
        if results is None:
            return None
        entry = None
        for i in range(int(results.size())):
            item = results.get(i)
            if item is not None and self._key_of_tl(item.reaction) == clicked_key:
                entry = item
                break

        if entry is None or bool(entry.chosen):
            return None
        owners = [d for d, f in entries if f == clicked_key]
        docs = set(owners)
        if len(docs) != 1:
            return None
        if dialog > 0:
            if len({d for d, _f in entries}) != 1 or int(entry.count) != 1:
                return None
        elif int(entry.count) != len(owners):
            return None
        try:
            doc = int(next(iter(docs)))
        except (TypeError, ValueError):
            return None
        if not 0 < doc < 2**63:
            return None
        return "d:" + str(doc)

    def _sync_publish_choice(self, message_object, local_key, fallback=None) -> None:
        sync = self._sync
        if sync is None or not sync.active:
            return
        doc = None
        if local_key is not None:
            if not isinstance(local_key, str) or not local_key.startswith("d:"):
                return
            try:
                doc = int(local_key[2:])
            except (TypeError, ValueError):
                return
            if not 0 < doc < 2**63:
                return
        desc = self._sync_descriptor(message_object)
        if desc is None:
            return
        account, dialog, mid, me, key = desc
        target = (account, dialog, mid)
        with sync.lock:
            if any(k != target and k[:2] == target[:2] and v[0][4] == key
                   for k, v in sync.visible.items()):
                return
        with self._lock:
            self._sync_seq += 1
            revision = self._sync_seq
            self._sync_latest[target] = revision
        self._remember_live(account, dialog, mid, message_object)
        sync.observe(*desc)
        sync.publish(me, key, doc, revision, target, fallback if doc is not None else None)

    def _ui_later(self, fn, delay_ms: int, where: str = "ui task") -> None:
        def runner():
            if self._unloaded:
                return
            try:
                fn()
            except Exception:
                pass
        try:
            run_on_ui_thread(runner, int(delay_ms))
        except Exception:
            pass

    def _vpr_after_load(self) -> None:
        self._ui_later(self._vpr_warm_all, 300, "warm emoji")
        for delay in RESYNC_DELAYS_MS:
            self._ui_later(self._resync_visible, delay, "resync visible")

    def _resync_visible(self) -> None:
        if self._unloaded or not self._cfg.get("enabled"):
            return
        sync = self._sync
        if not self._index and (sync is None or not sync.active):
            return
        fragment = get_last_fragment()
        root = fragment.getFragmentView() if fragment is not None else None
        if root is None:
            return
        from android.view import ViewGroup
        from org.telegram.ui.Cells import ChatMessageCell
        stack, visited, done = [root], 0, set()
        while stack and visited < RESYNC_MAX_VIEWS:
            view = stack.pop()
            visited += 1
            if isinstance(view, ChatMessageCell):
                message_object = view.getMessageObject()
                if message_object is None:
                    continue
                _reactions, results = self._results_of(message_object)
                if results is None or int(results.size()) == 0:
                    continue
                target = (int(message_object.currentAccount), int(message_object.getDialogId()),
                          int(message_object.getId()))
                if target not in done:
                    done.add(target)
                    self._refresh_message(target[0], target[1], target[2], message_object)
                continue
            if isinstance(view, ViewGroup):
                for index in range(int(view.getChildCount())):
                    child = view.getChildAt(jint(index))
                    if child is not None:
                        stack.append(child)

    def _vpr_peers_path(self) -> str:
        folder = os.path.join(get_plugins_dir(), "virtual_premium_reactions")
        ensure_dir_exists(folder)
        return os.path.join(folder, PEER_FILE)

    def _vpr_load_peers(self) -> None:
        peers = {}
        try:
            path = self._vpr_peers_path()
            if os.path.exists(path) and os.path.getsize(path) <= 1048576:
                with open(path, "r", encoding="utf-8") as handle:
                    data = json.load(handle)
                items = data.get("peers") if isinstance(data, dict) and data.get("v") == 1 else None
                if isinstance(items, dict):
                    for name, value in list(items.items())[:MAX_PEERS * 2]:
                        try:
                            me_part, dialog_part = str(name).split("|", 1)
                            me, dialog = int(me_part), int(dialog_part)
                            doc, fallback, ts, account = value
                            doc, ts, account = int(doc), float(ts), int(account)
                        except Exception:
                            continue
                        if (me <= 0 or dialog <= 0 or account < 0 or not 0 < doc < 2**63
                                or not isinstance(fallback, str) or not 0 < len(fallback) <= 64):
                            continue
                        peers[(me, dialog)] = [doc, fallback, ts, account]
        except Exception:
            peers = {}
        with self._vpr_peer_lock:
            self._vpr_peers = peers
            self._vpr_peers_dirty = False

    def _vpr_flush_peers(self) -> None:
        with self._vpr_peer_lock:
            if not self._vpr_peers_dirty:
                return
            self._vpr_peers_dirty = False
            items = sorted(self._vpr_peers.items(), key=lambda item: item[1][2], reverse=True)[:MAX_PEERS]
        payload = {"v": 1, "peers": {"{}|{}".format(me, dialog): [str(v[0]), v[1], v[2], v[3]]
                                     for (me, dialog), v in items}}
        with self._vpr_peer_file_lock:
            tmp = None
            try:
                path = self._vpr_peers_path()
                tmp = path + ".tmp"
                with open(tmp, "w", encoding="utf-8") as handle:
                    json.dump(payload, handle, ensure_ascii=False, separators=(",", ":"))
                    handle.flush()
                    os.fsync(handle.fileno())
                os.replace(tmp, path)
                tmp = None
            except Exception:
                with self._vpr_peer_lock:
                    self._vpr_peers_dirty = True
            finally:
                if tmp is not None:
                    try:
                        os.remove(tmp)
                    except Exception:
                        pass

    def _vpr_schedule_peer_save(self) -> None:
        with self._vpr_peer_lock:
            if self._vpr_peers_save_pending:
                return
            self._vpr_peers_save_pending = True

        def task():
            with self._vpr_peer_lock:
                self._vpr_peers_save_pending = False
            if not self._unloaded:
                self._vpr_flush_peers()
        try:
            run_on_queue(task, PLUGINS_QUEUE, 3000)
        except Exception:
            with self._vpr_peer_lock:
                self._vpr_peers_save_pending = False

    def _vpr_learn_peer(self, current, latest, bootstrap: bool = False) -> None:
        try:
            account, dialog, me = int(current[0]), int(current[1]), int(current[2])
            ts, doc, fallback = latest
            ts, doc = float(ts), int(doc)
        except Exception:
            return
        if (self._unloaded or dialog <= 0 or me <= 0 or not 0 < doc < 2**63
                or not isinstance(fallback, str) or not 0 < len(fallback) <= 64):
            return
        with self._vpr_peer_lock:
            old = self._vpr_peers.get((me, dialog))
            if old is not None and (bootstrap or old[2] > ts):
                return
            fresh = [doc, fallback, ts, account]
            if old == fresh:
                return
            self._vpr_peers[(me, dialog)] = fresh
            if len(self._vpr_peers) > MAX_PEERS + 100:
                keep = sorted(self._vpr_peers.items(), key=lambda item: item[1][2], reverse=True)[:MAX_PEERS]
                self._vpr_peers = dict(keep)
            self._vpr_peers_dirty = True
        self._vpr_schedule_peer_save()
        if old is None or old[0] != doc:
            self._vpr_warm_doc(account, doc)

    def _vpr_bootstrap_peer(self, current, loaded) -> None:
        counts = {}
        for docs in loaded.values():
            for doc, fallback in docs:
                if fallback:
                    counts[(doc, fallback)] = counts.get((doc, fallback), 0) + 1
        if counts:
            (doc, fallback), _count = max(counts.items(), key=lambda item: item[1])
            self._vpr_learn_peer(current, (0.0, doc, fallback), bootstrap=True)

    def _vpr_warm_doc(self, account, doc) -> None:
        try:
            account, doc = int(account), int(doc)
        except Exception:
            return
        if account < 0 or not 0 < doc < 2**63 or (account, doc) in self._vpr_warmed:
            return

        def run():
            if self._unloaded or (account, doc) in self._vpr_warmed:
                return
            self._vpr_warmed.add((account, doc))
            if _find_animated_document(account, doc) is not None:
                return
            from java import jlong
            from org.telegram.ui.Components import AnimatedEmojiDrawable
            AnimatedEmojiDrawable.make(jint(account), jint(int(AnimatedEmojiDrawable.CACHE_TYPE_ALERT_PREVIEW)),
                                       jlong(doc))
        self._ui(run, "warm emoji")

    def _vpr_warm_all(self) -> None:
        if self._unloaded or not self._cfg.get("enabled"):
            return
        with self._vpr_peer_lock:
            items = sorted(self._vpr_peers.items(), key=lambda item: item[1][2], reverse=True)[:WARM_DOCS_MAX]
        for (me, _dialog), value in items:
            if self._uid(value[3]) == me:
                self._vpr_warm_doc(value[3], value[0])
        local_key = self._key_of_value(self._cfg.get("local"))
        if local_key and local_key.startswith(_PREFIX_DOC):
            try:
                self._vpr_warm_doc(self._sel_account(), int(local_key[len(_PREFIX_DOC):]))
            except Exception:
                pass

    @staticmethod
    def _vpr_trim(store) -> None:
        overflow = len(store) - MAX_PREDICT_TRACK
        if overflow > 0:
            for extra in list(islice(store, overflow)):
                store.pop(extra, None)

    def _vpr_forget(self, target) -> None:
        self._vpr_predicted.pop(target, None)
        self._vpr_seen.pop(target, None)
        self._vpr_recheck.pop(target, None)

    def _vpr_reaction_age(self, message_object, account, dialog, fallback):
        try:
            reactions = message_object.messageOwner.reactions
            recent = reactions.recent_reactions if reactions is not None else None
            if recent is None:
                return None
            newest = None
            for index in range(int(recent.size())):
                item = recent.get(index)
                if item is None or self._key_of_tl(item.reaction) != fallback:
                    continue
                if int(MessageObject.getPeerId(item.peer_id)) != dialog:
                    continue
                date = int(item.date)
                if date > 0 and (newest is None or date > newest):
                    newest = date
            if newest is None:
                return None
            try:
                from org.telegram.tgnet import ConnectionsManager
                now = int(ConnectionsManager.getInstance(int(account)).getCurrentTime())
            except Exception:
                now = int(time.time())
            return max(0.0, float(now - newest))
        except Exception:
            return None

    def _vpr_predict(self, sync, desc, button_list, message_object):
        try:
            account, dialog, mid, me, key = desc
            if dialog <= 0:
                return []
            target = (account, dialog, mid)
            with self._vpr_peer_lock:
                memory = self._vpr_peers.get((me, dialog))
            if not memory:
                return []
            doc, fallback = memory[0], memory[1]
            present = False
            for button in button_list:
                try:
                    if self._key_of_tl(button.reaction) != fallback:
                        continue
                    real = int(button.realCount)
                    chosen = bool(button.choosen)
                except Exception:
                    continue
                if (not chosen and real == 1) or (chosen and real == 2):
                    present = True
                    break
            if not present:
                self._vpr_forget(target)
                return []
            now = time.monotonic()
            since = self._vpr_seen.get(target)
            if since is None:
                age = self._vpr_reaction_age(message_object, account, dialog, fallback)
                since = now - age if age is not None else now
                self._vpr_seen[target] = since
                self._vpr_trim(self._vpr_seen)
            wait = sync.predict_wait(account, dialog, me, key, since)
            if wait is not None and wait <= 0:
                self._vpr_predicted.pop(target, None)
                self._vpr_recheck.pop(target, None)
                return []
            self._vpr_predicted[target] = doc
            self._vpr_trim(self._vpr_predicted)
            if wait is not None and self._vpr_recheck.get(target, 0.0) <= now:
                self._vpr_recheck[target] = now + wait + 0.15
                self._vpr_trim(self._vpr_recheck)
                self._vpr_schedule_refresh([target], sync, wait + 0.15)
            return [(doc, fallback)]
        except Exception:
            return []

    def _vpr_schedule_refresh(self, targets, sync, delay_s) -> None:
        targets = list(targets)
        if not targets:
            return

        def run():
            if self._unloaded or self._sync is not sync or not sync.active:
                return
            for target in targets:
                if target not in self._vpr_predicted:
                    continue
                message_object = self._live.get(target)
                if message_object is not None:
                    self._refresh_message(target[0], target[1], target[2], message_object)
        try:
            run_on_ui_thread(run, max(0, int(float(delay_s) * 1000)))
        except Exception:
            pass

    def _vpr_stream_ready(self, current, sync) -> None:
        key = (current[0], current[1])
        targets = [target for target in list(self._vpr_predicted) if target[:2] == key]
        if targets:
            self._vpr_schedule_refresh(targets, sync, PREDICT_READY_GRACE + 0.15)

    def _vpr_predicted_entries(self, desc):
        try:
            account, dialog, mid, me, _key = desc
            doc = self._vpr_predicted.get((account, dialog, mid))
            if doc is None:
                return []
            with self._vpr_peer_lock:
                memory = self._vpr_peers.get((me, dialog))
            if not memory or memory[0] != doc:
                return []
            return [(doc, memory[1])]
        except Exception:
            return []

    def _vpr_request_swaps(self, account, pending, dialog_id, message_id):
        swaps = {}
        local_key = self._key_of_value(self._cfg.get("local"))
        if local_key:
            swaps[local_key] = self._key_of_value(self._cfg.get("all"))
        try:
            if dialog_id and message_id:
                for record_key in self._records_for(account, dialog_id, message_id):
                    record = self._records.get(record_key) or {}
                    real_key, record_local = record.get("real"), record.get("local")
                    if real_key and record_local and real_key != record_local:
                        swaps[record_local] = real_key
        except Exception:
            pass
        if pending is not None and pending.get("kind") == PENDING_ADD:
            pending_local, pending_real = pending.get("local"), pending.get("real")
            if pending_local and pending_real and pending_local != pending_real:
                swaps[pending_local] = pending_real
        return swaps

    def _sel_account(self) -> int:
        try:
            return int(UserConfig.selectedAccount)
        except Exception:
            return 0

    def _ui(self, fn, where: str = "ui task") -> None:
        def runner():
            try:
                fn()
            except Exception:
                pass
        try:
            run_on_ui_thread(runner)
        except Exception:
            runner()

    def _cancel_taps(self) -> None:
        self._pending = None
        with self._lock:
            self._expect = []

    def _on_enabled_change(self, value: bool) -> None:
        self._refresh_config()
        if self._vpr_is_boolean(value):
            self._cfg["enabled"] = bool(value)
        if not value:
            self._cancel_taps()
            self._revert_all_live()
            self._flush_now()
        self._sync_configure()
        self._schedule_settings_reload()

    def _on_simple_change(self, *_args) -> None:
        self._refresh_config()

    def _on_ttl_change(self, index: int) -> None:
        self._refresh_config()
        self._cleanup(force=True)

    def _reload_settings_page(self) -> None:
        try:
            self.set_setting(SETTING_TTL, self.get_setting(SETTING_TTL, DEFAULT_TTL_INDEX),
                             reload_settings=True)
        except Exception:
            pass

    def create_settings(self) -> List[Any]:
        try:
            return self._build_settings()
        except Exception:
            return [Header(text="Virtual Premium Reactions"),
                    Text(text="Не удалось построить настройки",
                         subtext="Подробности — в логе плагина", icon="msg_error", red=True)]

    def _ui_activity(self):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            raise RuntimeError("settings activity unavailable")
        return activity

    @staticmethod
    def _ui_color(name, fallback):
        try:
            return int(Theme.getColor(getattr(Theme, name)))
        except Exception:
            return fallback

    @staticmethod
    def _ui_alpha(color, alpha):
        value = (int(color) & 0x00FFFFFF) | ((int(alpha) & 0xFF) << 24)
        return value - (1 << 32) if value >= (1 << 31) else value

    @staticmethod
    def _ui_round(color, radius, stroke_color=None, stroke=0):
        background = GradientDrawable()
        background.setColor(int(color))
        background.setCornerRadius(float(radius))
        if stroke_color is not None and stroke:
            background.setStroke(int(stroke), int(stroke_color))
        return background

    @staticmethod
    def _ui_text(activity, text, size, color, bold=False):
        view = TextView(activity)
        view.setText(text)
        view.setTextSize(size)
        view.setTextColor(int(color))
        if bold:
            view.setTypeface(Typeface.DEFAULT, Typeface.BOLD)
        return view

    def _ui_pill(self, activity, text, color, background):
        dp = AndroidUtilities.dp
        pill = self._ui_text(activity, text, 12, color, bold=True)
        pill.setSingleLine(True)
        pill.setPadding(dp(10), dp(4), dp(10), dp(5))
        pill.setBackground(self._ui_round(background, dp(100)))
        return pill

    def _ui_card(self, activity):
        dp = AndroidUtilities.dp
        outer = LinearLayout(activity)
        outer.setOrientation(LinearLayout.VERTICAL)
        outer.setPadding(dp(14), dp(12), dp(14), dp(4))
        card = LinearLayout(activity)
        card.setOrientation(LinearLayout.VERTICAL)
        card.setPadding(dp(20), dp(18), dp(20), dp(18))
        card.setBackground(self._ui_round(
            self._ui_color("key_windowBackgroundWhite", _vpr_argb(0xFFFFFFFF)), dp(20),
            self._ui_color("key_divider", _vpr_argb(0x1F000000)), dp(1)))
        outer.addView(card, LinearLayout.LayoutParams(-1, -2))
        return outer, card

    @staticmethod
    def _ru_plural(n, one, few, many):
        n = abs(int(n)) % 100
        if 11 <= n <= 14:
            return many
        n %= 10
        if n == 1:
            return one
        if 2 <= n <= 4:
            return few
        return many

    def _schedule_settings_reload(self, delay_ms: int = 400) -> None:
        def run():
            if not getattr(self, "_unloaded", False):
                self._reload_settings_page()
        try:
            run_on_ui_thread(run, delay_ms)
        except Exception:
            pass

    def _hero_card(self, cfg, ready, sync_on, scope_only, scope_ids):
        if not cfg["enabled"]:
            mode, pill = "off", "Выключено"
            title = "Плагин выключен"
            summary = "Реакции работают как обычно. Выбор можно настроить заранее."
        elif ready:
            mode, pill = "on", "Работает"
            title = "Всё готово"
            summary = "В чат уходит обычная реакция, а у вас на экране — премиум."
        else:
            mode, pill = "setup", "Нужна настройка"
            title = "Выберите две реакции"
            summary = "Одну увидят все, другую — только вы. Это ниже, в «Ваших реакциях»."
        try:
            activity = self._ui_activity()
            dp = AndroidUtilities.dp
            black = self._ui_color("key_windowBackgroundWhiteBlackText", _vpr_argb(0xFF222222))
            gray = self._ui_color("key_windowBackgroundWhiteGrayText2", _vpr_argb(0xFF8A8A8A))
            accent = self._ui_color("key_windowBackgroundWhiteBlueText", _vpr_argb(0xFF3A8EE6))
            orange = _vpr_argb(0xFFE38A00)
            if mode == "on":
                status_color = self._ui_color("key_windowBackgroundWhiteGreenText", _vpr_argb(0xFF2E9E4F))
            elif mode == "setup":
                status_color = orange
            else:
                status_color = gray
            outer, card = self._ui_card(activity)

            top = LinearLayout(activity)
            top.setOrientation(LinearLayout.HORIZONTAL)
            top.setGravity(Gravity.CENTER_VERTICAL)
            card.addView(top, LinearLayout.LayoutParams(-1, -2))
            top.addView(self._ui_pill(activity, "●  " + pill, status_color, self._ui_alpha(status_color, 0x24)),
                        LinearLayout.LayoutParams(-2, -2))
            top.addView(TextView(activity), LinearLayout.LayoutParams(0, 1, 1.0))
            top.addView(self._ui_text(activity, "VPR " + str(__version__), 11, gray, bold=True),
                        LinearLayout.LayoutParams(-2, -2))

            heading = self._ui_text(activity, title, 21, black, bold=True)
            heading.setPadding(0, dp(12), 0, 0)
            card.addView(heading)
            detail = self._ui_text(activity, summary, 14, gray)
            detail.setPadding(0, dp(4), 0, 0)
            card.addView(detail)

            if cfg["enabled"]:
                if not sync_on:
                    sync_text, sync_color = "Обмен выключен", gray
                elif scope_only and not scope_ids:
                    sync_text, sync_color = "Обмен: чаты не выбраны", orange
                elif scope_only:
                    count = len(scope_ids)
                    sync_text = "Обмен: " + str(count) + " " + self._ru_plural(count, "чат", "чата", "чатов")
                    sync_color = accent
                else:
                    sync_text, sync_color = "Обмен: все чаты", accent
                chips = LinearLayout(activity)
                chips.setOrientation(LinearLayout.HORIZONTAL)
                chips.setPadding(0, dp(14), 0, 0)
                card.addView(chips, LinearLayout.LayoutParams(-1, -2))
                chips.addView(self._ui_pill(activity, sync_text, sync_color, self._ui_alpha(sync_color, 0x1A)),
                              LinearLayout.LayoutParams(-2, -2))
                spaced = LinearLayout.LayoutParams(-2, -2)
                spaced.leftMargin = dp(8)
                chips.addView(self._ui_pill(activity, "Записей: " + str(len(self._records)), gray,
                                            self._ui_alpha(gray, 0x1A)), spaced)
            try:
                card.setContentDescription(pill + ". " + title + ". " + summary)
            except Exception:
                pass
            return Custom(view=outer)
        except Exception:
            return Text(text=title, subtext=summary, icon="msg_reactions")

    def _ui_emoji_view(self, activity, value, kind, caption, labels):
        from android.widget import ImageView
        if value.startswith(_PREFIX_ANIMATED):
            from java import jlong
            from org.telegram.ui.Components import AnimatedEmojiDrawable, BackupImageView
            document_id = int(value[len(_PREFIX_ANIMATED):])
            if document_id <= 0:
                raise ValueError("invalid custom emoji")
            try:
                cache_type = int(AnimatedEmojiDrawable.CACHE_TYPE_ALERT_PREVIEW)
            except AttributeError:
                cache_type = 3
            account = self._sel_account()
            drawable = AnimatedEmojiDrawable.make(jint(account), jint(cache_type), jlong(document_id))
            image = BackupImageView(activity)
            image.setAnimatedEmojiDrawable(drawable)
            self._load_inline_custom(image, caption, "", kind, value, account, document_id, labels)
            return image
        from org.telegram.messenger import Emoji
        drawable = Emoji.getEmojiDrawable(str(value))
        if drawable is None:
            raise ValueError("telegram emoji drawable unavailable")
        image = ImageView(activity)
        image.setImageDrawable(drawable)
        for delay in (250, 1000, 3000):
            run_on_ui_thread(lambda v=image: v.invalidate(), delay)
        return image

    def _reaction_setting_row(self, kind, value):
        title = "Для всех" if kind == KIND_ALL else "Только для меня"
        hint = ("Её увидят все · без Premium" if kind == KIND_ALL
                else "Видите только вы · можно премиум")
        handler = self._set_capture_all if kind == KIND_ALL else self._set_capture_local
        icon_name = "msg_contacts" if kind == KIND_ALL else "msg_secret"
        fallback = ("Не выбрана" if not value else
                    "Премиум-эмодзи" if value.startswith(_PREFIX_ANIMATED) else str(value))
        try:
            activity = self._ui_activity()
            from android.widget import FrameLayout, ImageView
            dp = AndroidUtilities.dp
            black = self._ui_color("key_windowBackgroundWhiteBlackText", _vpr_argb(0xFF222222))
            gray = self._ui_color("key_windowBackgroundWhiteGrayText2", _vpr_argb(0xFF8A8A8A))
            accent = self._ui_color("key_windowBackgroundWhiteBlueText", _vpr_argb(0xFF3A8EE6))
            row = LinearLayout(activity)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setGravity(Gravity.CENTER_VERTICAL)
            row.setPadding(dp(20), dp(10), dp(18), dp(10))
            row.setMinimumHeight(dp(70))

            badge = FrameLayout(activity)
            badge.setBackground(self._ui_round(self._ui_alpha(accent, 0x1F), dp(18)))
            icon = ImageView(activity)
            resources = activity.getResources()
            icon_id = resources.getIdentifier(icon_name, "drawable", activity.getPackageName())
            if not icon_id:
                icon_id = resources.getIdentifier("msg_reactions", "drawable", activity.getPackageName())
            if icon_id:
                icon.setImageResource(icon_id)
                icon.setColorFilter(accent)
            badge.addView(icon, FrameLayout.LayoutParams(dp(20), dp(20), Gravity.CENTER))
            row.addView(badge, LinearLayout.LayoutParams(dp(36), dp(36)))

            column = LinearLayout(activity)
            column.setOrientation(LinearLayout.VERTICAL)
            lp = LinearLayout.LayoutParams(0, -2, 1.0)
            lp.leftMargin = dp(16)
            lp.rightMargin = dp(12)
            row.addView(column, lp)
            column.addView(self._ui_text(activity, title, 16, black))
            caption_text = hint if value else "Нажмите, чтобы выбрать"
            caption = self._ui_text(activity, caption_text, 13, gray if value else accent)
            caption.setPadding(0, dp(3), 0, 0)
            column.addView(caption)

            chip = FrameLayout(activity)
            chip.setBackground(self._ui_round(self._ui_alpha(accent, 0x14), dp(14)))
            row.addView(chip, LinearLayout.LayoutParams(dp(48), dp(48)))
            preview = None
            if value:
                try:
                    preview = self._ui_emoji_view(activity, value, kind, caption,
                                                  (caption_text, caption_text, caption_text))
                except Exception:
                    preview = None
                    caption.setText(hint + " · " + fallback)
            if preview is not None:
                chip.addView(preview, FrameLayout.LayoutParams(dp(28), dp(28), Gravity.CENTER))
            else:
                mark = self._ui_text(activity, "?" if value else "+", 22, accent, bold=True)
                mark.setGravity(Gravity.CENTER)
                chip.addView(mark, FrameLayout.LayoutParams(-1, -1))
            try:
                row.setContentDescription(title + ". " + fallback)
            except Exception:
                pass
            return Custom(view=row, on_click=handler)
        except Exception:
            return Text(text=title, subtext=(hint + " · " + fallback if value else "Нажмите, чтобы выбрать"),
                        icon=icon_name, on_click=handler)

    def _build_settings(self) -> List[Any]:
        self._refresh_config()
        cfg = self._cfg
        if cfg.get("capture"):
            return self._waiting_page(cfg["capture"])

        ready = bool(cfg["all"]) and bool(cfg["local"]) and cfg["all"] != cfg["local"]
        try:
            sync_on = bool(self.get_setting(SETTING_SYNC, True))
        except Exception:
            sync_on = True
        scope_only, scope_ids = self._scope_reload()
        items = [
            self._hero_card(cfg, ready, sync_on, scope_only, scope_ids),
            Header(text="Основное"),
            Switch(key=SETTING_ENABLED, text="Виртуальные реакции", default=True,
                   subtext="В чат — обычная, вам — премиум",
                   icon="msg_reactions", on_change=self._on_enabled_change),
            Switch(key=SETTING_SYNC, text="Обмен с друзьями", default=True,
                   subtext="Видеть премиум друзей с этим плагином",
                   icon="msg_contacts", on_change=self._on_sync_change),
        ]
        if sync_on:
            items.append(Selector(key=SETTING_SCOPE, text="Где работает обмен", default=SCOPE_ALL,
                                  items=["Во всех чатах", "Только в выбранных"],
                                  icon="msg_secret", on_change=self._on_scope_change))
            if scope_only:
                items.append(Text(text="Выбранные чаты", subtext=self._scope_summary(),
                                  icon="msg_edit", on_click=self._open_scope_picker))
        if not sync_on:
            note = "Обмен выключен: ваши премиум-реакции видны только вам, а реакции друзей — обычные."
        elif scope_only and not scope_ids:
            note = "Выберите хотя бы один чат — пока обмен нигде не работает."
        elif scope_only:
            note = "Обмен работает только в выбранных личных чатах. В остальных премиум видите только вы."
        else:
            note = "Обмен работает с теми, у кого тоже стоит этот плагин. Остальные видят обычные реакции."
        items += [
            Divider(text=note),
            Header(text="Ваши реакции"),
            self._reaction_setting_row(KIND_ALL, cfg["all"]),
            self._reaction_setting_row(KIND_LOCAL, cfg["local"]),
            Divider(text="Нажмите на строку, чтобы сменить реакцию. Реакции со звёздами не поддерживаются."),
            Header(text="Ещё"),
            self._sub_page_row("Дополнительно", "Анимация, хранение и сброс", "msg_settings", self._advanced_page),
            Text(text="Проверить обновления", subtext="Установлена версия " + str(__version__),
                 icon="msg_download", on_click=self._on_check_updates),
            Divider(text="Virtual Premium Reactions " + str(__version__) + " · " + str(__author__)),
        ]
        return items

    def _on_check_updates(self, *_args):
        try:
            if getattr(self, "_updater", None) is None:
                self._updater = build_updater(__id__, __version__)
            self._updater.check()
        except Exception as exc:
            toast_err("Проверка не запущена: " + type(exc).__name__)

    def _sub_page_row(self, text, subtext, icon, builder):
        try:
            return Text(text=text, subtext=subtext, icon=icon, create_sub_fragment=builder)
        except TypeError:
            return Text(text=text, subtext=subtext, icon=icon,
                        on_click=lambda *_: self._toast("Раздел недоступен в этой версии exteraGram", "error"))

    def _advanced_page(self) -> List[Any]:
        try:
            return [
                Header(text="Отображение"),
                Switch(key=SETTING_ANIMATION, text="Анимированные эмодзи", default=True,
                       subtext="Загружать премиум-эмодзи заранее",
                       icon="msg_photos", on_change=self._on_simple_change),
                Header(text="Хранение"),
                Selector(key=SETTING_TTL, text="Срок хранения", default=DEFAULT_TTL_INDEX,
                         items=[str(days) + " дн." for days in TTL_VARIANTS],
                         icon="msg_autodelete", on_change=self._on_ttl_change),
                Divider(text="Плагин помнит, где вы поставили премиум, чтобы показывать его после перезапуска. Старые записи удаляются сами."),
                Header(text="Сброс"),
                Text(text="Очистить записи", subtext="Сохранено: " + str(len(self._records)),
                     icon="msg_delete", red=True, on_click=self._clear_records),
                Text(text="Сбросить выбор реакций", subtext="Остальные настройки сохранятся",
                     icon="msg_delete", red=True, on_click=self._reset_reactions),
                Divider(text="Реакции на сервере не удаляются — меняется только то, что видно у вас."),
            ]
        except Exception:
            return [Text(text="Не удалось открыть раздел", subtext="Подробности — в логе плагина",
                         icon="msg_error", red=True)]

    def _scope_reload(self):
        try:
            only = int(self.get_setting(SETTING_SCOPE, SCOPE_ALL) or 0) == SCOPE_SELECTED
        except Exception:
            only = False
        ids = frozenset()
        try:
            raw = json.loads(str(self.get_setting(SETTING_SCOPE_CHATS, "[]") or "[]"))
            if isinstance(raw, list):
                ids = frozenset(int(x) for x in raw if int(x) > 0)
        except Exception:
            ids = frozenset()
        state = (only, ids)
        self._vpr_scope = state
        return state

    def _scope_state(self):
        state = getattr(self, "_vpr_scope", None)
        return state if state is not None else self._scope_reload()

    def _scope_allows(self, dialog) -> bool:
        only, ids = self._scope_state()
        if not only:
            return True
        try:
            return int(dialog) in ids
        except Exception:
            return False

    @staticmethod
    def _scope_name(user) -> str:
        try:
            from org.telegram.messenger import UserObject
            name = str(UserObject.getUserName(user) or "").strip()
            if name:
                return name
        except Exception:
            pass
        first = str(getattr(user, "first_name", "") or "").strip()
        last = str(getattr(user, "last_name", "") or "").strip()
        return (first + " " + last).strip() or "Без имени"

    def _scope_summary(self) -> str:
        ids = self._scope_state()[1]
        if not ids:
            return "Никто не выбран — нажмите, чтобы добавить"
        names = []
        try:
            controller = MessagesController.getInstance(self._sel_account())
            for uid in ids:
                user = controller.getUser(Long(uid))
                if user is not None:
                    names.append(self._scope_name(user))
        except Exception:
            names = []
        count = len(ids)
        if not names:
            return "Выбрано: " + str(count) + " " + self._ru_plural(count, "чат", "чата", "чатов")
        names.sort(key=lambda s: s.lower())
        shown = names[:2]
        text = ", ".join(shown)
        if count > len(shown):
            text += " и ещё " + str(count - len(shown))
        return text

    def _scope_candidates(self, account):
        controller = MessagesController.getInstance(account)
        me = self._uid(account)
        selected = set(self._scope_state()[1])
        seen, ordered = set(), []
        dialogs = None
        try:
            dialogs = controller.getAllDialogs()
        except Exception:
            try:
                dialogs = controller.allDialogs
            except Exception:
                dialogs = None
        if dialogs is not None:
            for i in range(int(dialogs.size())):
                if len(ordered) >= 80:
                    break
                try:
                    uid = int(dialogs.get(i).id)
                except Exception:
                    continue
                if uid <= 0 or uid == me or uid == 777000 or uid in seen:
                    continue
                user = controller.getUser(Long(uid))
                if user is None or bool(getattr(user, "bot", False)) or bool(getattr(user, "deleted", False)):
                    continue
                seen.add(uid)
                ordered.append((uid, user))

        for uid in sorted(selected - seen):
            seen.add(uid)
            ordered.append((uid, controller.getUser(Long(uid))))
        return ([p for p in ordered if p[0] in selected] +
                [p for p in ordered if p[0] not in selected])

    def _scope_avatar(self, activity, account, user):
        try:
            from org.telegram.ui.Components import AvatarDrawable, BackupImageView
            image = BackupImageView(activity)
            image.setRoundRadius(AndroidUtilities.dp(20))
            drawable = AvatarDrawable()
            if user is None:
                image.setImageDrawable(drawable)
                return image
            try:
                drawable.setInfo(jint(account), user)
            except Exception:
                try:
                    drawable.setInfo(user)
                except Exception:
                    pass
            image.setForUserOrChat(user, drawable)
            return image
        except Exception:
            return None

    def _scope_person_row(self, activity, account, uid, user, staged, changed):
        dp = AndroidUtilities.dp
        black = self._ui_color("key_windowBackgroundWhiteBlackText", _vpr_argb(0xFF222222))
        gray = self._ui_color("key_windowBackgroundWhiteGrayText2", _vpr_argb(0xFF8A8A8A))
        accent = self._ui_color("key_windowBackgroundWhiteBlueText", _vpr_argb(0xFF3A8EE6))
        row = LinearLayout(activity)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        row.setPadding(dp(22), dp(7), dp(22), dp(7))
        row.setMinimumHeight(dp(56))
        try:
            row.setBackground(Theme.getSelectorDrawable(False))
        except Exception:
            pass
        avatar = self._scope_avatar(activity, account, user)
        if avatar is not None:
            row.addView(avatar, LinearLayout.LayoutParams(dp(40), dp(40)))
        name = self._scope_name(user) if user is not None else "Пользователь " + str(uid)
        label = self._ui_text(activity, name, 16, black)
        label.setSingleLine(True)
        try:
            from android.text import TextUtils
            label.setEllipsize(TextUtils.TruncateAt.END)
        except Exception:
            pass
        lp = LinearLayout.LayoutParams(0, -2, 1.0)
        lp.leftMargin = dp(14)
        lp.rightMargin = dp(12)
        row.addView(label, lp)
        check = self._ui_text(activity, "", 14, _vpr_argb(0xFFFFFFFF), bold=True)
        check.setGravity(Gravity.CENTER)
        row.addView(check, LinearLayout.LayoutParams(dp(24), dp(24)))

        def paint():
            chosen = uid in staged
            check.setText("✓" if chosen else "")
            if chosen:
                check.setBackground(self._ui_round(accent, dp(12)))
            else:
                check.setBackground(self._ui_round(0, dp(12), gray, dp(2)))
            try:
                row.setContentDescription(name + (", выбран" if chosen else ""))
            except Exception:
                pass

        def toggle(_view):
            if uid in staged:
                staged.discard(uid)
            else:
                staged.add(uid)
            paint()
            changed()

        paint()
        row.setOnClickListener(_VPRClick(toggle))
        return row

    def _open_scope_picker(self, *_args) -> None:
        try:
            activity = self._ui_activity()
            from android.widget import ScrollView
            dp = AndroidUtilities.dp
            gray = self._ui_color("key_windowBackgroundWhiteGrayText2", _vpr_argb(0xFF8A8A8A))
            accent = self._ui_color("key_windowBackgroundWhiteBlueText", _vpr_argb(0xFF3A8EE6))
            account = self._sel_account()
            people = self._scope_candidates(account)
            staged = set(self._scope_state()[1])

            scroll = ScrollView(activity)
            body = LinearLayout(activity)
            body.setOrientation(LinearLayout.VERTICAL)
            body.setPadding(0, dp(2), 0, dp(6))
            scroll.addView(body)
            intro = self._ui_text(activity, "Отметьте людей — можно сразу нескольких. Обмен будет работать только в личных чатах с ними.", 14, gray)
            intro.setPadding(dp(24), 0, dp(24), dp(8))
            body.addView(intro)
            counter = self._ui_text(activity, "", 13, accent, bold=True)
            counter.setPadding(dp(24), 0, dp(24), dp(6))
            body.addView(counter)

            def changed():
                count = len(staged)
                counter.setText(("Выбрано: " + str(count)) if count else "Пока никто не выбран")

            changed()
            if not people:
                empty = self._ui_text(activity, "Личные чаты не найдены. Откройте список чатов и попробуйте ещё раз.", 14, gray)
                empty.setPadding(dp(24), dp(12), dp(24), dp(12))
                body.addView(empty)
            for uid, user in people:
                body.addView(self._scope_person_row(activity, account, uid, user, staged, changed))

            builder = AlertDialogBuilder(activity)
            builder.set_title("Чаты для обмена")
            builder.set_view(scroll)

            def done(bld, _which):
                bld.dismiss()
                self._scope_save(staged)

            builder.set_positive_button("Готово", done)
            builder.set_negative_button("Отмена", lambda bld, _which: bld.dismiss())
            builder.show()
        except Exception:
            self._toast("Не удалось открыть выбор чатов", "error")

    def _scope_save(self, ids) -> None:
        try:
            clean = sorted({int(x) for x in ids if int(x) > 0})
            self.set_setting(SETTING_SCOPE_CHATS, json.dumps(clean))
            self._vpr_scope = (self._scope_state()[0], frozenset(clean))
            if clean:
                self._toast("Обмен работает в " + str(len(clean)) + " " +
                            self._ru_plural(len(clean), "чате", "чатах", "чатах"), "success")
            else:
                self._toast("Чаты не выбраны — обмен пока нигде не работает")
        except Exception:
            self._toast("Не удалось сохранить выбор чатов", "error")
        self._schedule_settings_reload()

    def _on_scope_change(self, index=None, *_args) -> None:
        _stored, ids = self._scope_reload()
        try:
            self._vpr_scope = (int(index) == SCOPE_SELECTED, ids)
        except (TypeError, ValueError):
            pass
        only = self._scope_state()[0]
        if only:
            run_on_ui_thread(self._open_scope_picker, 350)
        self._schedule_settings_reload()

    def _load_inline_custom(self, image, caption, prefix, kind, value, account, document_id, labels=None):
        import weakref
        from java import jlong
        from java.lang.ref import WeakReference
        from org.telegram.ui.Components import AnimatedEmojiDrawable
        image_ref, caption_ref = WeakReference(image), WeakReference(caption)
        plugin_ref = weakref.ref(self)
        state = {"document_bound": False, "fetch_sent": False}
        delays = (0, 250, 500, 1000, 2000, 4000, 8000, 15000, 30000)
        loading, done, failed = labels if labels else (prefix + " Загрузка…", prefix, prefix + " Премиум-эмодзи")
        caption.setText(loading)

        def tick(index):
            plugin = plugin_ref()
            view, label = image_ref.get(), caption_ref.get()
            if plugin is None or view is None or label is None or getattr(plugin, "_unloaded", False):
                return
            setting = SETTING_ALL if kind == KIND_ALL else SETTING_LOCAL
            try:
                if plugin._sel_account() != account or (plugin.get_setting(setting, "") or "") != value:
                    return
                drawable = view.getAnimatedEmojiDrawable()
                if drawable is None:
                    raise RuntimeError("drawable unavailable")
                if not state["fetch_sent"]:
                    state["fetch_sent"] = True

                    try:
                        AnimatedEmojiDrawable.getDocumentFetcher(jint(account)).fetchDocument(jlong(document_id), None)
                    except Exception:
                        pass
                document = _find_animated_document(account, document_id)
                if document is not None and not state["document_bound"]:
                    drawable.setupDocument(document)
                    state["document_bound"] = True
                view.invalidate()
                receiver = drawable.getImageReceiver()
                if receiver is not None and receiver.hasBitmapImage():
                    label.setText(done)
                    return
            except Exception:
                label.setText(failed)
                return
            if index + 1 >= len(delays):
                label.setText(failed)
                return
            run_on_ui_thread(lambda: tick(index + 1), delays[index + 1] - delays[index])

        run_on_ui_thread(lambda: tick(0))

    def _waiting_page(self, kind: str) -> List[Any]:
        where = "«Реакция для всех»" if kind == KIND_ALL else "«Реакция только для меня»"
        hint = ("Подойдёт обычный эмодзи, доступный без Premium"
                if kind == KIND_ALL else "Можно любой, в том числе премиум-эмодзи")
        return [
            Header(text="Выбор реакции"),
            Text(text="Ждём выбор: " + where,
                 subtext="Откройте тестовый чат и выберите эмодзи в панели реакций. "
                         "Сначала убедитесь, что реакция не отправляется.",
                 icon="msg_reactions", accent=True),
            Divider(text=hint),
            Text(text="Отменить", icon="msg_delete", red=True, on_click=self._cancel_capture),
        ]

    def _set_capture_all(self, view=None, *_args) -> None:
        self._open_reaction_picker(KIND_ALL, view)

    def _set_capture_local(self, view=None, *_args) -> None:
        self._open_reaction_picker(KIND_LOCAL, view)

    def _on_picker_dismiss(self, window) -> None:
        try:
            current = self._direct_window
            if current is not None and (current is window or bool(current.equals(window))):
                self._direct_picker = None
                self._direct_window = None
                self._direct_kind = None
                self._direct_listener = None
                self._direct_peer = None
                self._direct_window_peer = None
        except Exception:
            pass

    def _close_direct_picker(self) -> None:
        window = self._direct_window
        self._direct_picker = None
        self._direct_window = None
        self._direct_kind = None
        self._direct_listener = None
        self._direct_peer = None
        self._direct_window_peer = None
        if window is not None:
            try:
                window.dismiss()
            except Exception:
                pass

    def _picker_proxy_class(self):
        if self._picker_proxy_type is not None:
            return self._picker_proxy_type
        from extera_utils.classes import Base, java_subclass, joverride
        from java.lang import Class
        from java.lang.reflect import Modifier
        from org.telegram.messenger import ApplicationLoader
        loader = ApplicationLoader.applicationContext.getClassLoader()
        clazz = Class.forName("org.telegram.ui.SelectAnimatedEmojiDialog", False, loader)
        by_signature = {}
        for method in list(clazz.getDeclaredMethods()) + list(clazz.getMethods()):
            name = str(method.getName())
            signature = tuple(str(t.getName()) for t in method.getParameterTypes())
            key = (name, signature)
            if key not in by_signature:
                by_signature[key] = method
        supported = {"onReactionClick", "onEmojiClick", "onEmojiSelected"}
        missing_abstract = []
        selected = []
        for (name, signature), method in by_signature.items():
            flags = method.getModifiers()
            result = str(method.getReturnType().getName())
            if Modifier.isAbstract(flags):
                if name not in supported or result != "void" or Modifier.isPrivate(flags):
                    missing_abstract.append(name + "(" + ",".join(signature) + "):" + result)
            if (name in supported and result == "void" and not Modifier.isStatic(flags)
                    and not Modifier.isFinal(flags) and not Modifier.isPrivate(flags)):
                selected.append((name, signature))
        if missing_abstract:
            raise RuntimeError("unsupported abstract picker methods")
        available = {name for name, _sig in selected}
        if "onReactionClick" not in available or "onEmojiClick" not in available:
            raise RuntimeError("required picker callbacks not found by reflection")
        owner = self
        def handler_for(name):
            def handle(peer, *args):
                try:
                    owner._direct_capture_values(list(args))
                except Exception:
                    pass

            return handle
        attrs = {"__init__": lambda peer: None}
        for index, (name, signature) in enumerate(selected):
            attr = "_callback_" + str(index)
            handler = handler_for(name)

            handler.__name__ = attr
            attrs[attr] = joverride(name, list(signature))(handler)
        proxy = type("VirtualReactionPicker", (Base,), attrs)
        self._picker_proxy_type = java_subclass(SelectAnimatedEmojiDialog)(proxy)
        return self._picker_proxy_type

    def _picker_window_class(self):
        if self._picker_window_proxy_type is not None:
            return self._picker_window_proxy_type
        from extera_utils.classes import Base, java_subclass
        from java.lang import Class
        from java.lang.reflect import Modifier
        from org.telegram.messenger import ApplicationLoader
        loader = ApplicationLoader.applicationContext.getClassLoader()
        clazz = Class.forName("org.telegram.ui.SelectAnimatedEmojiDialog$SelectAnimatedEmojiDialogWindow", False, loader)
        abstract = []
        for member in list(clazz.getDeclaredMethods()) + list(clazz.getMethods()):
            if Modifier.isAbstract(member.getModifiers()):
                name = str(member.getName())
                signature = ", ".join(str(t.getName()) for t in member.getParameterTypes())
                abstract.append(name + "(" + signature + ")")
        if abstract:
            raise RuntimeError("native popup needs unsupported abstract methods")
        @java_subclass(SelectAnimatedEmojiDialog.SelectAnimatedEmojiDialogWindow)
        class PickerWindow(Base):
            def __init__(peer):
                pass
        self._picker_window_proxy_type = PickerWindow
        return PickerWindow

    def _create_picker_window(self, picker):
        try:
            proxy_type = self._picker_window_class()
            peer = proxy_type.new_instance(picker, Integer(-2), Integer(-2), init_args=[])
            self._direct_window_peer = peer
            return peer.java
        except Exception:
            self._direct_window_peer = None

            window = PopupWindow(picker, jint(-2), jint(-2), True)
            try:
                from android.graphics.drawable import ColorDrawable
                window.setBackgroundDrawable(ColorDrawable(0))
                window.setOutsideTouchable(True)
                window.setClippingEnabled(True)
            except Exception:
                pass
            return window

    def _open_reaction_picker(self, kind: str, view) -> None:
        self._close_direct_picker()
        try:
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment else None
            if activity is None or view is None:
                raise RuntimeError("picker anchor unavailable")

            try:
                picker_type = int(SelectAnimatedEmojiDialog.TYPE_SET_DEFAULT_REACTION)
            except AttributeError:
                picker_type = 2
            proxy_type = self._picker_proxy_class()

            peer = proxy_type.new_instance(fragment, activity, False, None,
                                           Integer(picker_type), None, init_args=[])
            picker = peer.java
            self._direct_peer = peer
            try:
                reactions = ArrayList()
                available = MediaDataController.getInstance(self._sel_account()).getReactionsList()
                for index in range(int(available.size())):
                    reaction = available.get(index)
                    if reaction is None or not getattr(reaction, "reaction", None):
                        continue
                    visible = ReactionsLayoutInBubble.VisibleReaction.fromEmojicon(str(reaction.reaction))
                    if visible is not None:
                        reactions.add(visible)
                picker.setRecentReactions(reactions)
            except Exception:
                pass
            window = self._create_picker_window(picker)
            listener = _PickerDismissListener(self, window)
            window.setOnDismissListener(listener)
            self._direct_picker, self._direct_window = picker, window
            self._direct_kind, self._direct_listener = kind, listener
            window.showAsDropDown(view, 0, 0, Gravity.TOP | Gravity.RIGHT)
            try:
                window.dimBehind()
            except Exception:
                pass
        except Exception:
            self._close_direct_picker()
            self._toast("Не удалось открыть панель реакций", "error")

    def _direct_capture_from_panel(self, param) -> bool:
        picker = self._direct_picker
        if picker is None or not self._direct_kind:
            return False
        owner = param.thisObject
        try:
            same = owner is picker or bool(owner.equals(picker))
        except Exception:
            same = owner is picker
        if not same:
            return False

        try:
            param.setResult(None)
        except Exception:
            pass
        return self._direct_capture_values(list(param.args or []))

    def _direct_capture_values(self, args) -> bool:
        if self._direct_picker is None or not self._direct_kind:
            return False
        kind = self._direct_kind
        value = self._picker_value(args)
        if not value:
            self._toast("Не удалось выбрать эту реакцию. Попробуйте другую", "error")
            return True
        account, kind = self._sel_account(), self._direct_kind

        candidates = []
        if len(args) > 2:
            candidates.append(args[2])
        if len(args) > 1:
            candidates.append(getattr(args[1], "document", None))
        for document in candidates:
            if document is not None and getattr(document, "id", None):
                self._cache_document(account, document)
                break

        if self._save_capture(value, account, kind_override=kind):
            self._close_direct_picker()
        return True

    def _cancel_capture(self, *_args) -> None:
        self.set_setting(SETTING_CAPTURE, "", reload_settings=True)
        self._refresh_config()
        self._toast("Выбор реакции отменён")

    def _confirm_action(self, title: str, message: str, action) -> None:
        try:
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment else None
            if activity is None:
                raise RuntimeError("no activity for confirmation")
            dialog = AlertDialogBuilder(activity)
            dialog.set_title(title)
            dialog.set_message(message)
            def confirm(builder, _which):
                builder.dismiss()
                action()
            dialog.set_positive_button("Да, продолжить", confirm)
            dialog.set_negative_button("Отмена", lambda builder, _which: builder.dismiss())
            dialog.show()
        except Exception:
            self._toast("Не удалось открыть подтверждение — действие не выполнено", "error")

    def _clear_records(self, *_args) -> None:
        self._confirm_action("Очистить записи?", "Локальное отображение сохранённых виртуальных реакций будет удалено. Реакции на сервере не удаляются.", self._do_clear_records)

    def _do_clear_records(self) -> None:
        self._revert_all_live()
        count = len(self._records)
        self._records = {}
        self._index = {}
        self._updates = {}
        self._removals = {}
        self._dirty = True
        self._flush_now()
        self._toast("Удалено записей: " + str(count), "success")
        self._reload_settings_page()

    def _reset_reactions(self, *_args) -> None:
        self._confirm_action("Сбросить выбор?", "Обе выбранные реакции будут очищены. Остальные настройки останутся прежними.", self._do_reset_reactions)

    def _do_reset_reactions(self) -> None:
        self.set_setting(SETTING_ALL, "")
        self.set_setting(SETTING_LOCAL, "")
        self.set_setting(SETTING_CAPTURE, "", reload_settings=True)
        self._refresh_config()
        self._toast("Реакции сброшены", "success")

    def _store_path(self) -> str:
        if self._store_file is None:
            path = os.path.join(get_plugins_dir(), "virtual_premium_reactions")
            ensure_dir_exists(path)
            self._store_file = os.path.join(path, "store.json")
        return self._store_file

    def _load_store(self) -> None:
        self._records = {}
        self._index = {}
        try:
            path = self._store_path()

            try:
                folder, base = os.path.split(path)
                for name in os.listdir(folder):
                    if name.startswith(base + ".") and name.endswith(".tmp"):
                        os.remove(os.path.join(folder, name))
            except Exception:
                pass
            if not os.path.exists(path):
                return
            raw = read_file(path)
            if not raw:
                return
            data = json.loads(raw)
            records = data.get("records") if isinstance(data, dict) else None
            if not isinstance(records, dict):
                return

            best: Dict[Tuple[int, int, int], Tuple[str, Dict[str, Any]]] = {}
            for key, record in records.items():
                try:
                    if not isinstance(key, str) or not isinstance(record, dict):
                        raise ValueError("invalid record")
                    parts = key.split("|")
                    if len(parts) != 4:
                        raise ValueError("invalid key")
                    msg = (int(parts[0]), int(parts[1]), int(parts[2]))
                    real_key, local_key = record.get("real"), record.get("local")
                    if not isinstance(real_key, str) or not isinstance(local_key, str) or not real_key or not local_key or real_key == local_key:
                        raise ValueError("invalid reaction pair")
                    ts = float(record.get("ts") or 0)
                    ct = float(record.get("ct") or ts)
                    if not math.isfinite(ts) or not math.isfinite(ct):
                        raise ValueError("invalid timestamp")
                    clean = {
                        "real": real_key,
                        "local": local_key,
                        "order": int(record.get("order") or 0),
                        "ts": ts,
                        "ct": ct,
                        "seq": None,
                    }

                    uid = int(record.get("uid") or 0)
                    if uid < 0:
                        raise ValueError("invalid owner")
                    if uid:
                        clean["uid"] = uid
                    if msg in best and best[msg][1]["ts"] >= ts:
                        continue
                    best[msg] = (self._record_key(msg[0], msg[1], msg[2], real_key), clean)
                except (TypeError, ValueError, OverflowError):
                    continue
            for msg, (key, record) in best.items():
                self._records[key] = record
                self._index[msg] = [key]
        except Exception:
            pass

    def _mark_dirty(self) -> None:
        self._dirty = True
        if self._unloaded or self._flush_scheduled:
            return
        self._flush_scheduled = True
        try:
            run_on_queue(self._flush_task, PLUGINS_QUEUE, FLUSH_DELAY_MS)
        except Exception:
            self._flush_scheduled = False
            self._flush_now()

    def _flush_task(self) -> None:
        self._flush_scheduled = False
        if self._unloaded:
            return
        self._flush_now()

    def _flush_now(self) -> None:
        with self._store_lock:
            if not self._dirty:
                return
            self._dirty = False
            tmp = None
            try:
                snapshot = {key: dict(value) for key, value in list(self._records.items())}
                payload = json.dumps({"v": 2, "records": snapshot}, ensure_ascii=False,
                                     separators=(",", ":"))
                path = self._store_path()
                self._tmp_seq += 1
                tmp = "{}.{}.{}.tmp".format(path, os.getpid(), self._tmp_seq)
                with open(tmp, "w", encoding="utf-8") as handle:
                    handle.write(payload)
                    handle.flush()
                    os.fsync(handle.fileno())
                os.replace(tmp, path)
                tmp = None
            except Exception:
                self._dirty = True
            finally:
                if tmp is not None:
                    try:
                        os.remove(tmp)
                    except Exception:
                        pass

    @staticmethod
    def _record_key(account: int, dialog_id: int, message_id: int, real_key: str) -> str:
        return "{}|{}|{}|{}".format(account, dialog_id, message_id, real_key)

    def _uid(self, account: int) -> int:
        try:
            return int(UserConfig.getInstance(int(account)).getClientUserId())
        except Exception:
            return 0

    def _records_for(self, account: int, dialog_id: int, message_id: int) -> List[str]:
        keys = self._index.get((account, dialog_id, message_id))
        if not keys:
            return []
        uid = None
        result = []
        for key in keys:
            record = self._records.get(key)
            if record is None:
                continue
            owner = record.get("uid")
            if owner:
                if uid is None:
                    uid = self._uid(account)
                if not uid or int(owner) != uid:
                    continue
            result.append(key)
        return result

    def _record_of(self, account: int, dialog_id: int, message_id: int):
        keys = self._records_for(account, dialog_id, message_id)
        if not keys:
            return None, None
        return keys[-1], self._records.get(keys[-1])

    def _add_record(self, account: int, dialog_id: int, message_id: int, real_key: str,
                    local_key: str, order: int = 0, op_seq: Optional[int] = None) -> str:
        msg = (account, dialog_id, message_id)

        for old in list(self._index.get(msg) or []):
            self._records.pop(old, None)
        key = self._record_key(account, dialog_id, message_id, real_key)
        now = time.time()
        self._records[key] = {
            "real": real_key,
            "local": local_key,
            "order": int(order or 0),
            "ts": now,
            "ct": now,
            "seq": (int(op_seq) if op_seq is not None else None),
        }
        uid = self._uid(account)
        if uid:
            self._records[key]["uid"] = uid
        self._index[msg] = [key]

        self._updates.pop(msg, None)
        self._removals.pop(msg, None)
        self._mark_dirty()
        return key

    def _drop_record(self, key: str, persist: bool = True) -> None:
        if self._records.pop(key, None) is None:
            return
        parts = key.split("|")
        if len(parts) == 4:
            try:
                msg = (int(parts[0]), int(parts[1]), int(parts[2]))
                bucket = self._index.get(msg)
                if bucket and key in bucket:
                    bucket.remove(key)
                if not bucket:
                    self._index.pop(msg, None)
                    self._updates.pop(msg, None)
            except Exception:
                pass
        if persist:
            self._mark_dirty()

    def _drop_message_records(self, account: int, dialog_id: int, message_id: int) -> None:
        for key in self._records_for(account, dialog_id, message_id):
            self._drop_record(key)

    def _touch_records(self, account: int, dialog_id: int, message_id: int) -> None:
        now = time.time()
        touched = False
        for key in self._records_for(account, dialog_id, message_id):
            record = self._records.get(key)
            if record is not None and now - float(record.get("ts") or 0) > TOUCH_INTERVAL:
                record["ts"] = now
                touched = True
        if touched:
            self._mark_dirty()

    def _cleanup(self, force: bool = False) -> None:
        now = time.time()
        if not force and now - self._last_cleanup < CLEANUP_INTERVAL:
            return
        self._last_cleanup = now
        self._prune_removals(now)
        ttl = max(1, int(self._cfg.get("ttl_days", 7))) * 86400
        dropped = 0
        for key, record in list(self._records.items()):
            if now - float(record.get("ts") or 0) > ttl:
                self._drop_record(key, persist=False)
                dropped += 1
        overflow = len(self._records) - MAX_RECORDS
        if overflow > 0:
            ordered = nsmallest(overflow, self._records.items(), key=lambda item: float(item[1].get("ts") or 0))
            for key, _record in ordered:
                self._drop_record(key, persist=False)
                dropped += 1
        if dropped:
            self._mark_dirty()

    def _remember_live(self, account: int, dialog_id: int, message_id: int, message_object) -> None:
        if message_object is None:
            return
        key = (account, dialog_id, message_id)
        self._live.pop(key, None)
        self._live[key] = message_object
        overflow = len(self._live) - MAX_LIVE
        if overflow > 0:
            for extra in list(islice(self._live, overflow)):
                self._live.pop(extra, None)

    def _revert_all_live(self) -> None:
        for (account, dialog_id, message_id), message_object in list(self._live.items()):
            try:
                if self._revert_model(message_object, self._records_for(account, dialog_id, message_id)):
                    self._refresh_message(account, dialog_id, message_id, message_object)
            except Exception:
                pass
        self._live.clear()

    def _cache_document(self, account: int, document) -> None:
        if document is None or not self._cfg.get("animate", True):
            return
        try:
            from org.telegram.ui.Components import AnimatedEmojiDrawable
            fetcher = AnimatedEmojiDrawable.getDocumentFetcher(int(account))
            if fetcher is not None:
                fetcher.putDocument(document)
        except Exception:
            pass

    @staticmethod
    def _key_of_value(value: Optional[str]) -> Optional[str]:
        if not value:
            return None
        if value.startswith(_PREFIX_ANIMATED):
            try:
                return _PREFIX_DOC + str(int(value[len(_PREFIX_ANIMATED):]))
            except Exception:
                return None
        return _PREFIX_EMOJI + value

    @staticmethod
    def _value_from_key(key: Optional[str]) -> Optional[str]:
        if not key:
            return None
        if key.startswith(_PREFIX_EMOJI):
            return key[len(_PREFIX_EMOJI):]
        if key.startswith(_PREFIX_DOC):
            return _PREFIX_ANIMATED + key[len(_PREFIX_DOC):]
        return None

    @staticmethod
    def _key_of_visible(reaction) -> Optional[str]:
        if reaction is None:
            return None
        try:
            if bool(reaction.isStar):
                return _KEY_STAR
            if reaction.emojicon is not None:
                return _PREFIX_EMOJI + str(reaction.emojicon)
            if reaction.documentId:
                return _PREFIX_DOC + str(int(reaction.documentId))
        except Exception:
            return None
        return None

    @staticmethod
    def _key_of_tl(reaction) -> Optional[str]:
        if reaction is None:
            return None
        try:
            if isinstance(reaction, TLRPC.TL_reactionEmoji):
                return _PREFIX_EMOJI + str(reaction.emoticon)
            if isinstance(reaction, TLRPC.TL_reactionCustomEmoji):
                return _PREFIX_DOC + str(int(reaction.document_id))
            if isinstance(reaction, TLRPC.TL_reactionPaid):
                return _KEY_STAR
        except Exception:
            return None
        return None

    @staticmethod
    def _tl_from_key(key: Optional[str]):
        if not key:
            return None
        try:
            if key.startswith(_PREFIX_EMOJI):
                reaction = TLRPC.TL_reactionEmoji()
                reaction.emoticon = key[len(_PREFIX_EMOJI):]
                return reaction
            if key.startswith(_PREFIX_DOC):
                reaction = TLRPC.TL_reactionCustomEmoji()
                reaction.document_id = int(key[len(_PREFIX_DOC):])
                return reaction
            if key == _KEY_STAR:
                return TLRPC.TL_reactionPaid()
        except Exception:
            return None
        return None

    @staticmethod
    def _visible_from_key(key: Optional[str]):
        if not key:
            return None
        try:
            if key.startswith(_PREFIX_EMOJI):
                return ReactionsLayoutInBubble.VisibleReaction.fromEmojicon(key[len(_PREFIX_EMOJI):])
            if key.startswith(_PREFIX_DOC):
                return ReactionsLayoutInBubble.VisibleReaction.fromCustomEmoji(
                    Long(int(key[len(_PREFIX_DOC):])))
        except Exception:
            return None
        return None

    def _label(self, value_or_key: Optional[str], account: int) -> str:
        value = value_or_key
        if value and (value.startswith(_PREFIX_EMOJI) or value.startswith(_PREFIX_DOC)):
            value = self._value_from_key(value)
        if not value:
            return "не выбрана"
        if value.startswith(_PREFIX_ANIMATED):
            try:
                document = _find_animated_document(account, int(value[len(_PREFIX_ANIMATED):]))
                if document is not None:
                    emoji = MessageObject.findAnimatedEmojiEmoticon(document, "\U0001F642")
                    if emoji:
                        return str(emoji) + " (премиум)"
            except Exception:
                pass
            return "премиум-эмодзи"
        return value

    @staticmethod
    def _results_of(message_object):
        try:
            owner = message_object.messageOwner
            if owner is None or owner.reactions is None:
                return None, None
            return owner.reactions, owner.reactions.results
        except Exception:
            return None, None

    def _find_entry(self, results, key: Optional[str], chosen: Optional[bool] = None):
        if results is None or not key:
            return -1, None
        try:
            size = int(results.size())
        except Exception:
            return -1, None
        for index in range(size):
            try:
                entry = results.get(index)
                if self._key_of_tl(entry.reaction) != key:
                    continue
                if chosen is None or bool(entry.chosen) == chosen:
                    return index, entry
            except Exception:
                continue
        return -1, None

    @staticmethod
    def _is_min(reactions) -> bool:
        try:
            return bool(reactions.min)
        except Exception:
            return False

    @staticmethod
    def _max_order(results) -> int:
        maximum = 0
        try:
            for index in range(int(results.size())):
                entry = results.get(index)
                if bool(entry.chosen) and int(entry.chosen_order) > maximum:
                    maximum = int(entry.chosen_order)
        except Exception:
            pass
        return maximum

    @staticmethod
    def _unchoose(results, entry) -> None:
        entry.chosen = False
        entry.count = int(entry.count) - 1
        if int(entry.count) <= 0:
            results.remove(entry)

    def _ensure_chosen(self, results, key: str) -> Tuple[Any, bool]:
        _index, entry = self._find_entry(results, key)
        if entry is None:
            entry = TLRPC.TL_reactionCount()
            entry.reaction = self._tl_from_key(key)
            entry.count = 0
            entry.chosen = False
            results.add(entry)
        if bool(entry.chosen):
            if not int(entry.chosen_order or 0):
                entry.chosen_order = self._max_order(results) or 1
            return entry, False
        entry.chosen = True
        entry.count = int(entry.count) + 1
        entry.chosen_order = self._max_order(results) + 1
        return entry, True

    def _is_renderable(self, key: Optional[str], account: int, assume_ok: bool = False) -> bool:
        if not key:
            return False
        try:
            if key.startswith(_PREFIX_DOC):
                int(key[len(_PREFIX_DOC):])
                return True
            if key.startswith(_PREFIX_EMOJI):
                emoji = key[len(_PREFIX_EMOJI):]
                reactions_map = MediaDataController.getInstance(account).getReactionsMap()
                if reactions_map.containsKey(emoji):
                    return True
                if bool(reactions_map.isEmpty()):
                    return bool(assume_ok)
                return False
        except Exception:
            return bool(assume_ok)
        return False

    def _patch_recent(self, reactions, from_key: str, to_key: str, account: int) -> None:
        try:
            recent = reactions.recent_reactions
            if recent is None or int(recent.size()) == 0:
                return
            me = int(UserConfig.getInstance(account).getClientUserId())
            for index in range(int(recent.size())):
                peer_reaction = recent.get(index)
                if self._key_of_tl(peer_reaction.reaction) != from_key:
                    continue
                try:
                    peer = int(MessageObject.getPeerId(peer_reaction.peer_id))
                except Exception:
                    continue
                if peer == me:
                    peer_reaction.reaction = self._tl_from_key(to_key)
        except Exception:
            pass

    def _echo_confirms(self, account: int, dialog_id: int, message_id: int, key: str) -> bool:
        updates = self._updates.get((account, dialog_id, message_id))
        return bool(updates and key in updates.get("chosen_keys", ()))

    def _vpr_merged_set(self):
        merged = getattr(self, '_vpr_merged', None)
        if merged is None:
            merged = set()
            self._vpr_merged = merged
        return merged

    def _vpr_patch_recent_all(self, reactions, from_key, to_key) -> None:
        try:
            recent = reactions.recent_reactions if reactions is not None else None
            if recent is None:
                return
            for index in range(int(recent.size())):
                peer_reaction = recent.get(index)
                if self._key_of_tl(peer_reaction.reaction) == from_key:
                    peer_reaction.reaction = self._tl_from_key(to_key)
        except Exception:
            pass

    def _vpr_try_merge(self, reactions, results, real_key, local_key, account, dialog_id, message_id):
        # Private chat: both sides reacted with the same real emoji -> one pill (mine), both avatars.
        if results is None or int(dialog_id) <= 0 or not real_key or not local_key or real_key == local_key:
            return None
        target = (int(account), int(dialog_id), int(message_id))
        merged = self._vpr_merged_set()
        _ri, real_entry = self._find_entry(results, real_key)
        _li, local_entry = self._find_entry(results, local_key)
        if (real_entry is not None and bool(real_entry.chosen) and int(real_entry.count) >= 2
                and local_entry is None):
            real_entry.reaction = self._tl_from_key(local_key)
            self._vpr_patch_recent_all(reactions, real_key, local_key)
            if len(merged) > 4096:
                merged.clear()
            merged.add(target)
            return True
        if (target in merged and real_entry is None and local_entry is not None
                and bool(local_entry.chosen) and int(local_entry.count) >= 2):
            self._vpr_patch_recent_all(reactions, real_key, local_key)
            return False
        if target in merged:
            merged.discard(target)
        return None

    def _vpr_merge_after_add(self, message_object, real_key, local_key, target) -> None:
        if int(target[1]) <= 0 or not real_key or not local_key or real_key == local_key:
            return
        reactions, results = self._results_of(message_object)
        if results is None:
            return
        _li, local_entry = self._find_entry(results, local_key, chosen=True)
        _ri, real_entry = self._find_entry(results, real_key, chosen=False)
        if local_entry is None or real_entry is None or int(real_entry.count) < 1:
            return
        local_entry.count = int(local_entry.count) + int(real_entry.count)
        results.remove(real_entry)
        self._vpr_patch_recent_all(reactions, real_key, local_key)
        merged = self._vpr_merged_set()
        if len(merged) > 4096:
            merged.clear()
        merged.add((int(target[0]), int(target[1]), int(target[2])))

    def _vpr_unmerge(self, message_object, real_key, local_key, target) -> bool:
        merged = self._vpr_merged_set()
        key = (int(target[0]), int(target[1]), int(target[2]))
        if key not in merged:
            return False
        merged.discard(key)
        if not real_key or not local_key:
            return False
        reactions, results = self._results_of(message_object)
        if results is None:
            return False
        _li, local_entry = self._find_entry(results, local_key, chosen=False)
        if local_entry is None:
            return False
        _ri, real_entry = self._find_entry(results, real_key)
        if real_entry is None:
            local_entry.reaction = self._tl_from_key(real_key)
        else:
            real_entry.count = int(real_entry.count) + int(local_entry.count)
            results.remove(local_entry)
        self._vpr_patch_recent_all(reactions, local_key, real_key)
        return True

    def _vpr_effect_before(self, param) -> None:
        # The fly/burst animation must use the emoji the pill actually shows.
        if not self._cfg.get('enabled'):
            return
        args = param.args
        if args is None or len(args) != 9:
            return
        cell, visible = args[2], args[6]
        if cell is None or visible is None:
            return
        try:
            if bool(visible.isStar) or visible.emojicon is None:
                return
            emoji = str(visible.emojicon)
        except Exception:
            return
        from org.telegram.ui.Cells import ChatMessageCell
        if not isinstance(cell, ChatMessageCell):
            return
        message_object = cell.getMessageObject()
        if message_object is None:
            return
        layout = self._sync_button_field(cell, 'reactionsLayoutInBubble')
        button = layout.getReactionButton(emoji) if layout is not None else None
        replacement = None
        if button is not None:
            drawable = button.animatedEmojiDrawable
            if drawable is not None:
                doc = int(drawable.getDocumentId())
                if doc and self._key_of_tl(button.reaction) != _PREFIX_DOC + str(doc):
                    replacement = _PREFIX_DOC + str(doc)
        else:
            account = int(message_object.currentAccount)
            _k, record = self._record_of(account, int(message_object.getDialogId()), int(message_object.getId()))
            key = _PREFIX_EMOJI + emoji
            if record is not None and record.get('real') == key and record.get('local') and record.get('local') != key:
                replacement = record.get('local')
        if not replacement:
            return
        new_visible = self._visible_from_key(replacement)
        if new_visible is not None:
            args[6] = new_visible

    def _vpr_lookup_after(self, param) -> None:
        # Lets the animation find a pill whose picture was swapped to a custom emoji.
        try:
            if param.getResult() is not None:
                return
        except Exception:
            return
        args = param.args
        if args is None or len(args) != 1 or not isinstance(args[0], str):
            return
        text = args[0]
        if not text.isdigit():
            return
        doc = int(text)
        buttons = param.thisObject.reactionButtons
        if buttons is None:
            return
        for index in range(int(buttons.size())):
            button = buttons.get(index)
            drawable = button.animatedEmojiDrawable
            if drawable is not None and int(drawable.getDocumentId()) == doc:
                param.setResult(button)
                return

    def _sync_display(self, message_object) -> bool:
        if not self._cfg["enabled"] or message_object is None or not self._index:
            return False
        reactions, results = self._results_of(message_object)
        if results is None:
            self._vpr_missing_reactions(message_object)
            return False
        account = int(message_object.currentAccount)
        dialog_id = int(message_object.getDialogId())
        message_id = int(message_object.getId())
        pending = self._pending
        if (pending is not None and pending.get("message_id") == message_id
                and pending.get("account") == account
                and pending.get("dialog_id") == dialog_id):
            return False
        key, record = self._record_of(account, dialog_id, message_id)
        if record is None:
            return False
        real_key, local_key = record.get("real"), record.get("local")
        if not real_key or not local_key or real_key == local_key:
            return False
        if not self._is_renderable(local_key, account):
            return False

        _ri, real_entry = self._find_entry(results, real_key)
        real_chosen = real_entry is not None and bool(real_entry.chosen)
        _li, local_entry = self._find_entry(results, local_key)
        local_chosen = local_entry is not None and bool(local_entry.chosen)

        changed = False
        msg = (account, dialog_id, message_id)
        edited = False
        lost = False
        if not real_chosen and not local_chosen:
            edited = self._vpr_edit_suspect(msg, message_object)
            lost = edited or self._is_min(reactions)
        merged_now = self._vpr_try_merge(reactions, results, real_key, local_key, account, dialog_id, message_id)
        if merged_now is not None:
            changed = merged_now
        elif lost:
            restored = self._vpr_restore_after_loss(message_object, results, key, record, real_entry, msg, edited)
            if restored is None:
                return False
            changed = restored
        elif self._echo_confirms(account, dialog_id, message_id, real_key):
            changed = self._apply_virtual_choice(results, real_key, local_key)
        elif real_chosen:
            self._unchoose(results, real_entry)
            self._ensure_chosen(results, local_key)
            changed = True
        elif not local_chosen:
            minimized = self._is_min(reactions)
            age = time.time() - float(record.get("ct") or record.get("ts") or 0)
            if (not minimized and age > STALE_GRACE
                    and not self._message_has_inflight(account, dialog_id, message_id)):
                self._drop_record(key)
                return False
            _entry, changed = self._ensure_chosen(results, local_key)

        self._patch_recent(reactions, real_key, local_key, account)
        if changed:
            self._touch_records(account, dialog_id, message_id)
            self._remember_live(account, dialog_id, message_id, message_object)
        return changed

    # --- 4.1.1: keep the virtual reaction when a message is edited ---------------------
    # After an edit the client rebuilds the message from server data in which the user's
    # own reaction can arrive without the "chosen" flag. 4.1 read that as "removed on another
    # device" and dropped the record after STALE_GRACE, so the standard reaction replaced the
    # virtual one. Now such a state drops the record only when a fresh full (non-min) server
    # answer, received after we asked for it, confirms that the reaction is really gone.

    def _vpr_log(self, text: str, *args) -> None:
        try:
            logger = getattr(self, "logger", None)
            if logger is not None:
                logger.info(text, *args)
        except Exception:
            pass

    def _vpr_edits_map(self) -> Dict[Tuple[int, int, int], float]:
        edits = getattr(self, "_vpr_edits", None)
        if edits is None:
            edits = {}
            self._vpr_edits = edits
        return edits

    def _vpr_asked_map(self) -> Dict[Tuple[int, int, int], float]:
        asked = getattr(self, "_vpr_full_asked", None)
        if asked is None:
            asked = {}
            self._vpr_full_asked = asked
        return asked

    def _vpr_edit_suspect(self, msg, message_object) -> bool:
        seen = self._vpr_edits_map().get(msg)
        if seen is not None and time.time() - seen < EDIT_GRACE:
            return True
        try:
            owner = message_object.messageOwner if message_object is not None else None
            edit_date = int(owner.edit_date or 0) if owner is not None else 0
            if edit_date <= 0:
                return False
            from org.telegram.tgnet import ConnectionsManager
            now = int(ConnectionsManager.getInstance(int(msg[0])).getCurrentTime())
            return -60 <= now - edit_date < EDIT_GRACE
        except Exception:
            return False

    def _vpr_server_dropped(self, msg, real_key, local_key) -> bool:
        asked = self._vpr_asked_map().get(msg)
        info = self._updates.get(msg)
        if asked is None or not info:
            return False
        if float(info.get("ts") or 0) <= float(asked):
            return False
        keys = info.get("chosen_keys") or ()
        return real_key not in keys and local_key not in keys

    def _vpr_restore_after_loss(self, message_object, results, key, record, real_entry, msg, edited):
        account, dialog_id, message_id = msg
        real_key, local_key = record.get("real"), record.get("local")
        inflight = self._message_has_inflight(account, dialog_id, message_id)
        if edited:
            if not inflight and self._vpr_server_dropped(msg, real_key, local_key):
                self._drop_record(key)
                self._vpr_log("edit: server confirmed the reaction is gone, record dropped")
                return None
            self._vpr_request_full(msg)
        changed = False
        if real_entry is not None and not inflight and int(real_entry.count) > 0:
            # the user's own real reaction is still counted here, it only lost the chosen flag
            self._unchoose(results, real_entry)
            changed = True
        _entry, added = self._ensure_chosen(results, local_key)
        changed = bool(changed or added)
        if changed and int(dialog_id) > 0 and not inflight:
            try:
                self._vpr_merge_after_add(message_object, real_key, local_key, msg)
            except Exception:
                pass
        return changed

    def _vpr_missing_reactions(self, message_object) -> None:
        try:
            owner = message_object.messageOwner
            if owner is None or int(owner.edit_date or 0) <= 0:
                return
            msg = (int(message_object.currentAccount), int(message_object.getDialogId()),
                   int(message_object.getId()))
            if self._records_for(*msg) and self._vpr_edit_suspect(msg, message_object):
                self._vpr_request_full(msg)
        except Exception:
            pass

    def _vpr_on_edit(self, account, update) -> None:
        try:
            if not self._cfg["enabled"] or update is None or not self._index:
                return
            message = update.message
            if message is None:
                return
            msg = (int(account), int(MessageObject.getDialogId(message)), int(message.id))
            if not self._records_for(*msg):
                return
            edits = self._vpr_edits_map()
            if len(edits) > 256:
                edits.clear()
            edits[msg] = time.time()
            self._vpr_log("edit of a message with a virtual reaction: refresh scheduled")
            try:
                run_on_ui_thread(lambda: self._vpr_request_full(msg), delay=EDIT_REFRESH_DELAY_MS)
            except Exception:
                self._vpr_request_full(msg)
        except Exception:
            pass

    def _vpr_request_full(self, msg) -> bool:
        asked = self._vpr_asked_map()
        now = time.time()
        last = asked.get(msg)
        if last is not None and now - last < FULL_RETRY:
            return False
        if len(asked) > 256:
            asked.clear()
        asked[msg] = now
        account, dialog_id, message_id = msg
        try:
            controller = MessagesController.getInstance(int(account))
            request = TLRPC.TL_messages_getMessagesReactions()
            request.peer = controller.getInputPeer(int(dialog_id))
            if request.peer is None:
                return False
            request.id.add(Integer(int(message_id)))
        except Exception:
            self._vpr_log("edit: reactions refresh request could not be built")
            return False

        def done(response, error):
            if error is not None or response is None:
                self._vpr_log("edit: reactions refresh failed")
                return
            updates = response
            try:
                from java import cast
                updates = cast(TLRPC.Updates, response)
            except Exception:
                pass
            try:
                items = updates.updates
                for index in range(int(items.size())):
                    try:
                        items.get(index).updateUnreadState = False
                    except Exception:
                        pass
            except Exception:
                pass
            try:
                controller.processUpdates(updates, False)
                self._vpr_log("edit: reactions refreshed from server")
            except Exception:
                self._vpr_log("edit: reactions refresh could not be applied")

        try:
            from client_utils import send_request
            try:
                send_request(request, done, account=account)
            except TypeError:
                if account != self._sel_account():
                    return False
                send_request(request, done)
            return True
        except Exception:
            return False

    def _apply_virtual_choice(self, results, real_key: str, local_key: str) -> bool:
        try:
            _ri, real_entry = self._find_entry(results, real_key)
            _li, local_entry = self._find_entry(results, local_key)
            if real_entry is not None and bool(real_entry.chosen):
                if local_entry is None and int(real_entry.count) <= 1:
                    real_entry.reaction = self._tl_from_key(local_key)
                    return True
                self._unchoose(results, real_entry)
                self._ensure_chosen(results, local_key)
                return True
            if local_entry is not None and bool(local_entry.chosen):
                return False
            return self._ensure_chosen(results, local_key)[1]
        except Exception:
            return False

    def _finalize_local_choice(self, message_object, real_key: str, local_key: str) -> bool:
        try:
            _reactions, results = self._results_of(message_object)
            if results is None:
                return False
            _entry, changed = self._ensure_chosen(results, local_key)
            _i, entry_real = self._find_entry(results, real_key, chosen=True)
            if entry_real is not None:
                self._unchoose(results, entry_real)
                changed = True
            return changed
        except Exception:
            return False

    def _revert_model(self, message_object, keys: Optional[List[str]] = None) -> bool:
        if message_object is None:
            return False
        reactions, results = self._results_of(message_object)
        if results is None:
            return False
        account = int(message_object.currentAccount)
        if keys is None:
            keys = self._records_for(account, int(message_object.getDialogId()),
                                     int(message_object.getId()))
        changed = False
        for key in keys or []:
            record = self._records.get(key)
            if record is None:
                continue
            real_key, local_key = record.get("real"), record.get("local")
            if not real_key or not local_key or real_key == local_key:
                continue
            _li, local_entry = self._find_entry(results, local_key)
            _ri, real_entry = self._find_entry(results, real_key)
            if local_entry is None or not bool(local_entry.chosen):
                continue
            if real_entry is not None and bool(real_entry.chosen):
                continue
            target_m = (account, int(message_object.getDialogId()), int(message_object.getId()))
            if real_entry is None and int(local_entry.count) > 1 and target_m in self._vpr_merged_set():
                local_entry.reaction = self._tl_from_key(real_key)
                self._vpr_patch_recent_all(reactions, local_key, real_key)
                self._vpr_merged_set().discard(target_m)
                changed = True
                continue
            if real_entry is not None:
                real_entry.chosen = True
                real_entry.count = int(real_entry.count) + 1
                real_entry.chosen_order = int(record.get("order") or 0) or int(local_entry.chosen_order or 1)
                if int(local_entry.count) > 1:
                    local_entry.count = int(local_entry.count) - 1
                    local_entry.chosen = False
                else:
                    results.remove(local_entry)
            elif int(local_entry.count) > 1:
                local_entry.chosen = False
                local_entry.count = int(local_entry.count) - 1
                restored = TLRPC.TL_reactionCount()
                restored.reaction = self._tl_from_key(real_key)
                restored.count = 1
                restored.chosen = True
                restored.chosen_order = int(record.get("order") or 0) or int(local_entry.chosen_order or 1)
                results.add(restored)
            else:
                local_entry.reaction = self._tl_from_key(real_key)
            self._patch_recent(reactions, local_key, real_key, account)
            changed = True
        return changed

    def _remove_display(self, message_object, records: List[Dict[str, Any]]) -> bool:
        reactions, results = self._results_of(message_object)
        if results is None:
            return False
        account = int(message_object.currentAccount)
        changed = False
        for record in records:
            _li, local_entry = self._find_entry(results, record.get("local"), chosen=True)
            if local_entry is None:
                continue
            target_m = (account, int(message_object.getDialogId()), int(message_object.getId()))
            if target_m in self._vpr_merged_set() and int(local_entry.count) > 1:
                local_entry.reaction = self._tl_from_key(record.get("real"))
                self._vpr_patch_recent_all(reactions, record.get("local"), record.get("real"))
                self._vpr_merged_set().discard(target_m)
                self._unchoose(results, local_entry)
                changed = True
                continue
            self._unchoose(results, local_entry)
            self._patch_recent(reactions, record.get("local"), record.get("real"), account)
            changed = True
        return changed

    def _force_unchoose(self, message_object, key: Optional[str], refresh: bool = True) -> bool:
        if not key or message_object is None:
            return False
        try:
            _reactions, results = self._results_of(message_object)
            _i, entry = self._find_entry(results, key, chosen=True)
            if entry is None:
                return False
            self._unchoose(results, entry)
            if refresh:
                self._refresh_message(int(message_object.currentAccount),
                                      int(message_object.getDialogId()),
                                      int(message_object.getId()), message_object)
            return True
        except Exception:
            return False

    def _refresh_message(self, account: int, dialog_id: int, message_id: int, message_object) -> None:
        try:
            reactions = message_object.messageOwner.reactions
            if reactions is None:
                return
            NotificationCenter.getInstance(int(account)).postNotificationName(
                NotificationCenter.didUpdateReactions,
                Long(int(dialog_id)), Integer(int(message_id)), reactions)
        except Exception:
            pass

    def _render_hook(self, param) -> None:
        if not self._cfg["enabled"]:
            return
        args = param.args
        if not self._set_message_variant(args):
            return
        message_object = args[0]
        self._sync_display(message_object)
        self._render_guard_removed(message_object)

    def _vpr_adopt_real(self, message_object, local_key, all_key):
        # Use the same "for all" emoji as the friend, so both reactions are one pill.
        try:
            if not local_key or not all_key:
                return all_key
            sync = self._sync
            if sync is None or not sync.active:
                return all_key
            desc = self._sync_descriptor(message_object)
            if desc is None:
                return all_key
            _account, dialog, _mid, me, key = desc
            entries = sync.get(me, key)
            if not entries and dialog > 0:
                entries = self._vpr_predicted_entries(desc)
            if not entries:
                return all_key
            _reactions, results = self._results_of(message_object)
            if results is None:
                return all_key
            want = local_key[len(_PREFIX_DOC):] if local_key.startswith(_PREFIX_DOC) else None
            same_doc, any_peer = None, None
            for item in entries:
                try:
                    doc, fallback = item[0], item[1]
                except Exception:
                    continue
                if not isinstance(fallback, str) or not fallback or fallback == all_key or fallback == local_key:
                    continue
                _index, entry = self._find_entry(results, fallback, chosen=False)
                if entry is None or int(entry.count) < 1 or self._visible_from_key(fallback) is None:
                    continue
                if want is not None and str(doc) == want and same_doc is None:
                    same_doc = fallback
                if any_peer is None:
                    any_peer = fallback
            if same_doc is not None:
                return same_doc
            if int(dialog) > 0 and any_peer is not None:
                return any_peer
        except Exception:
            pass
        return all_key

    def _select_reaction_before(self, param) -> None:
        self._pending = None
        programmatic = self._programmatic_until > time.monotonic()
        self._programmatic_until = 0.0

        if not self._cfg["enabled"] and not self._cfg.get("capture"):
            return
        args = param.args
        if not self._select_variant(args):
            return
        message_object = args[1]
        visible_reaction = args[6]
        if message_object is None or visible_reaction is None:
            return

        chat_activity = param.thisObject
        try:
            account = int(chat_activity.getCurrentAccount())
        except Exception:
            account = int(message_object.currentAccount)
        dialog_id = int(message_object.getDialogId())
        if dialog_id == 0:
            try:
                dialog_id = int(chat_activity.getDialogId())
            except Exception:
                pass
        message_id = int(message_object.getId())

        if self._cfg.get("capture"):
            self._handle_capture(visible_reaction, account, dialog_id, param, chat_activity)
            return
        try:
            if bool(visible_reaction.isStar):
                return
        except Exception:
            return

        clicked_key = self._key_of_visible(visible_reaction)
        if not clicked_key:
            return
        local_key = self._key_of_value(self._cfg["local"])
        all_key = self._key_of_value(self._cfg["all"])

        try:
            from_double_tap = bool(args[7])
        except Exception:
            from_double_tap = False
        if (from_double_tap and self._cfg.get("double_tap", True)
                and local_key and all_key and local_key != all_key):
            local_visible_dt = self._visible_from_key(local_key)
            if local_visible_dt is not None:
                args[6] = local_visible_dt
                visible_reaction = local_visible_dt
                clicked_key = local_key

        if not from_double_tap and not programmatic:
            join_key = self._sync_join_key(args, message_object, clicked_key)
            if join_key is not None:
                _join_rk, join_record = self._record_of(account, dialog_id, message_id)
                if join_record is None or join_record.get("local") != join_key:
                    local_key = join_key
                clicked_key = join_key

        record_key, record = self._record_of(account, dialog_id, message_id)
        base = {"account": account, "dialog_id": dialog_id, "message_id": message_id}

        if record is not None and not programmatic:
            rec_real, rec_local = record.get("real"), record.get("local")
            if rec_real and rec_local and rec_real != rec_local:
                rec_reactions, rec_results = self._results_of(message_object)
                _ri, stale_real = self._find_entry(rec_results, rec_real, chosen=True)
                _li, shown_local = self._find_entry(rec_results, rec_local, chosen=True)
                if stale_real is not None and shown_local is None:
                    if clicked_key == rec_real and not from_double_tap:
                        clicked_key = rec_local
                    merged_now = self._vpr_try_merge(rec_reactions, rec_results, rec_real, rec_local,
                                                     account, dialog_id, message_id)
                    if merged_now is None and self._apply_virtual_choice(rec_results, rec_real, rec_local):
                        self._patch_recent(rec_reactions, rec_real, rec_local, account)

        if record is not None and not programmatic and record.get("local") == clicked_key:
            local_visible = self._visible_from_key(record.get("local"))
            if local_visible is None:
                return
            args[6] = local_visible
            self._pending = self._expect_send(dict(base, kind=PENDING_REMOVE, real=record.get("real"),
                                                   local=record.get("local")))
            return

        if record is not None:
            self._revert_model(message_object, [record_key])
            if clicked_key != local_key:
                self._pending = dict(base, kind=PENDING_PLAIN, real=record.get("real"),
                                     local=record.get("local"))
                return

        if not local_key or clicked_key != local_key:
            return

        self._drop_message_records(account, dialog_id, message_id)

        def reject(text: str) -> None:
            param.setResult(None)
            self._toast(text, "error", chat_activity)

        if not all_key:
            reject("Сначала выберите «реакцию для всех» в настройках плагина")
            return
        if all_key == local_key:
            return
        all_key = self._vpr_adopt_real(message_object, local_key, all_key)

        _reactions, results = self._results_of(message_object)
        _index, already_entry = self._find_entry(results, all_key, chosen=True)
        if already_entry is not None and not self._message_busy(account, dialog_id, message_id):
            param.setResult(None)
            self._add_record(account, dialog_id, message_id, all_key, local_key)
            self._sync_display(message_object)
            self._remember_live(account, dialog_id, message_id, message_object)
            self._refresh_message(account, dialog_id, message_id, message_object)
            try:
                self._sync_publish_choice(message_object, local_key, all_key)
            except Exception:
                pass
            return

        real_visible = self._visible_from_key(all_key)
        if real_visible is None:
            reject("Не удалось разобрать «реакцию для всех»")
            return
        if not self._is_renderable(local_key, account, assume_ok=True):
            reject("Клиент не умеет показывать " + self._label(local_key, account)
                   + " как реакцию — выберите другую в настройках")
            return
        allowed, error_text = self._check_sendable(account, dialog_id, real_visible)
        if not allowed:
            reject(error_text)
            return
        local_visible = self._visible_from_key(local_key)
        if local_visible is None:
            reject("Не удалось разобрать «реакцию только для меня»")
            return
        args[6] = local_visible
        self._pending = self._expect_send(dict(base, kind=PENDING_ADD, real=all_key, local=local_key))

    def _select_reaction_after(self, param) -> None:
        pending = self._pending
        self._pending = None
        if pending is None:
            return
        args = param.args
        if not self._select_variant(args):
            return
        message_object = args[1]
        if (message_object is None
                or int(message_object.getId()) != pending["message_id"]
                or int(message_object.currentAccount) != pending["account"]):
            return

        account = pending["account"]
        dialog_id = pending["dialog_id"]
        message_id = pending["message_id"]
        kind = pending.get("kind")
        _reactions, results = self._results_of(message_object)

        if kind == PENDING_ADD:
            _i, entry = self._find_entry(results, pending["local"], chosen=True)
            if entry is None:
                self._drop_expect(pending)
                return
            self._add_record(account, dialog_id, message_id, pending["real"], pending["local"],
                             order=int(entry.chosen_order or 0), op_seq=pending.get("seq"))
            self._finalize_local_choice(message_object, pending["real"], pending["local"])
            self._vpr_merge_after_add(message_object, pending["real"], pending["local"],
                                      (account, dialog_id, message_id))
        elif kind == PENDING_REMOVE:
            self._drop_message_records(account, dialog_id, message_id)
            self._force_unchoose(message_object, pending.get("local"), refresh=False)
            self._vpr_unmerge(message_object, pending.get("real"), pending.get("local"),
                              (account, dialog_id, message_id))
        elif kind == PENDING_PLAIN:
            _i, real_entry = self._find_entry(results, pending.get("real"), chosen=True)
            if real_entry is None:
                self._drop_message_records(account, dialog_id, message_id)
                self._refresh_message(account, dialog_id, message_id, message_object)
                return

        else:
            return

        self._sync_display(message_object)
        self._remember_live(account, dialog_id, message_id, message_object)
        self._refresh_message(account, dialog_id, message_id, message_object)

    def _handle_capture(self, visible_reaction, account: int, dialog_id: int, param, fragment) -> None:
        param.setResult(None)
        key = self._key_of_visible(visible_reaction)
        if key == _KEY_STAR:
            self._toast("Платные (звёздные) реакции выбрать нельзя", "error", fragment)
            return
        value = self._value_from_key(key)
        if not value:
            self._toast("Не удалось разобрать выбранную реакцию", "error", fragment)
            return
        self._save_capture(value, account, dialog_id, fragment, " (не отправлена)")

    def _save_capture(self, value: str, account: int, dialog_id: int = 0, fragment=None,
                      suffix: str = "", kind_override: Optional[str] = None) -> bool:
        kind = kind_override or self._cfg.get("capture")
        if kind not in (KIND_ALL, KIND_LOCAL):
            self._toast("Выбор реакции больше не активен", "error", fragment)
            return False
        key = self._key_of_value(value)
        if not key:
            self._toast("Не удалось разобрать выбранную реакцию", "error", fragment)
            return False
        value_type = "custom" if key.startswith(_PREFIX_DOC) else "standard"
        other = self._cfg.get("all" if kind == KIND_LOCAL else "local")
        if other and self._key_of_value(other) == key:
            self._toast("Выберите разные реакции для двух режимов", "error", fragment)
            return False
        if kind == KIND_LOCAL:
            if not self._is_renderable(key, account, assume_ok=True):
                self._toast("Этот эмодзи клиент не покажет как реакцию — выберите другой",
                            "error", fragment)
                return False
            self.set_setting(SETTING_LOCAL, value)
            label = "«Только для меня»"
        else:
            allowed, error_text = self._check_sendable(account, dialog_id, self._visible_from_key(key))
            if not allowed:
                if (kind_override == KIND_ALL and self._direct_kind == KIND_ALL
                        and value_type == "custom"
                        and error_text == "Кастомная реакция требует Telegram Premium"):
                    self._close_direct_picker()
                    def save_local():
                        if self._sel_account() != account:
                            self._toast("Аккаунт изменился. Выберите эмодзи ещё раз", "error")
                            return
                        self._save_capture(value, account, kind_override=KIND_LOCAL)
                    self._confirm_action(
                        "Выбрать эмодзи только для себя?",
                        "Эту реакцию нельзя отправить другим без Telegram Premium. "
                        "Сохранить её для отображения только у вас? "
                        "Реакцию для всех выберите отдельно из обычных.", save_local)
                    return False
                self._toast(error_text + ". Премиум-эмодзи выбирайте как «только для меня»",
                            "error", fragment)
                return False
            self.set_setting(SETTING_ALL, value)
            label = "«Для всех»"
        self.set_setting(SETTING_CAPTURE, "", reload_settings=True)
        self._refresh_config()
        self._toast(label + ": " + self._label(value, account) + suffix, "success", fragment)
        return True

    def _check_sendable(self, account: int, dialog_id: int, visible_reaction):
        try:
            if visible_reaction is None:
                return False, "Реакция не выбрана"
            if bool(visible_reaction.isStar):
                return False, "Платные реакции плагин не поддерживает"

            user_config = UserConfig.getInstance(account)
            controller = MessagesController.getInstance(account)
            is_premium = bool(user_config.isPremium())
            premium_blocked = bool(controller.premiumFeaturesBlocked())

            if visible_reaction.documentId:
                if not is_premium and not premium_blocked:
                    return False, "Кастомная реакция требует Telegram Premium"
            else:
                emoji = visible_reaction.emojicon
                if emoji is None:
                    return False, "Реакция не выбрана"
                try:
                    available = MediaDataController.getInstance(account).getReactionsMap().get(emoji)
                except Exception:
                    available = None
                if available is not None and bool(available.premium) \
                        and not is_premium and not premium_blocked:
                    return False, "«{}» доступна только с Telegram Premium".format(emoji)

            if dialog_id < 0:
                try:
                    chat_full = controller.getChatFull(-dialog_id)
                except Exception:
                    chat_full = None
                available_reactions = getattr(chat_full, "available_reactions", None) if chat_full else None
                if available_reactions is not None:
                    if isinstance(available_reactions, TLRPC.TL_chatReactionsNone):
                        return False, "В этом чате реакции отключены"
                    if isinstance(available_reactions, TLRPC.TL_chatReactionsSome):
                        allowed_list = available_reactions.reactions
                        allowed = any(bool(visible_reaction.isSame(allowed_list.get(i)))
                                      for i in range(int(allowed_list.size())))
                        if not allowed:
                            return False, "Эта реакция не разрешена в этом чате"
            return True, ""
        except Exception:
            return False, "Не удалось проверить доступность реакции"

    def _expect_send(self, pending: Dict[str, Any]) -> Dict[str, Any]:
        with self._lock:
            self._op_seq += 1
            pending["seq"] = self._op_seq
            pending["ts"] = time.time()
            self._prune_expect(pending["ts"])
            self._expect.append(pending)
        return pending

    def _prune_expect(self, now: float) -> None:
        self._expect = [item for item in self._expect if now - item.get("ts", now) <= EXPECT_TTL]

    def _drop_expect(self, pending: Dict[str, Any]) -> None:
        with self._lock:
            self._expect = [item for item in self._expect if item is not pending]

    def _take_expect(self, account: int, dialog_id: int, message_id: int,
                     request_keys: set) -> Optional[Dict[str, Any]]:
        now = time.time()
        with self._lock:
            self._prune_expect(now)
            for item in self._expect:
                if item.get("account") != account or item.get("message_id") != message_id:
                    continue
                if dialog_id and item.get("dialog_id") != dialog_id:
                    continue
                has_local = item.get("local") in request_keys
                if item.get("kind") == PENDING_ADD and not has_local:
                    continue
                if item.get("kind") == PENDING_REMOVE and has_local:
                    continue
                self._expect.remove(item)
                return item
        return None

    def _input_peer_dialog(self, account: int, peer) -> int:
        if peer is None:
            return 0
        try:
            if isinstance(peer, TLRPC.TL_inputPeerSelf):
                return int(UserConfig.getInstance(account).getClientUserId())
        except Exception:
            pass
        for attr, sign in (("user_id", 1), ("chat_id", -1), ("channel_id", -1)):
            try:
                value = int(getattr(peer, attr, 0) or 0)
            except Exception:
                value = 0
            if value:
                return sign * value
        return 0

    def _track_send(self, account: int, dialog_id: int, message_id: int, is_plugin: bool,
                    is_new: bool = False, op_seq: Optional[int] = None) -> Dict[str, Any]:
        entry = {
            "dialog_id": int(dialog_id),
            "message_id": int(message_id),
            "plugin": bool(is_plugin),
            "new": bool(is_new),
            "seq": (int(op_seq) if op_seq is not None else None),
            "ts": time.time(),
        }
        with self._lock:
            queue = self._inflight.setdefault(account, [])
            queue.append(entry)
            if len(queue) > MAX_INFLIGHT:
                del queue[:len(queue) - MAX_INFLIGHT]
        return entry

    def _untrack(self, account: int, entry: Optional[Dict[str, Any]]) -> None:
        if entry is None:
            return
        with self._lock:
            queue = self._inflight.get(account)
            if queue:
                self._inflight[account] = [item for item in queue if item is not entry]
                if not self._inflight[account]:
                    self._inflight.pop(account, None)

    def _response_targets(self, response) -> List[Tuple[int, int]]:
        targets: List[Tuple[int, int]] = []
        if response is None:
            return targets
        updates = []
        try:
            single = getattr(response, "update", None)
            if single is not None:
                updates.append(single)
        except Exception:
            pass
        try:
            many = getattr(response, "updates", None)
            if many is not None:
                for index in range(int(many.size())):
                    updates.append(many.get(index))
        except Exception:
            pass
        for update in updates:
            try:
                if isinstance(update, TLRPC.TL_updateMessageReactions):
                    targets.append((int(MessageObject.getPeerId(update.peer)), int(update.msg_id)))
            except Exception:
                continue
        return targets

    def _pop_send(self, account: int, response: Any = None) -> Optional[Dict[str, Any]]:
        now = time.time()
        targets = self._response_targets(response)
        with self._lock:
            queue = self._inflight.get(account)
            if not queue:
                return None
            queue[:] = [item for item in queue if now - item.get("ts", now) <= INFLIGHT_TTL]
            entry = None
            if targets:
                for item in queue:
                    for dialog_id, message_id in targets:
                        if item.get("message_id") == message_id and (
                                not item.get("dialog_id") or item.get("dialog_id") == dialog_id):
                            entry = item
                            break
                    if entry is not None:
                        break
            elif queue:
                distinct = {(item.get("dialog_id"), item.get("message_id")) for item in queue}
                if len(distinct) == 1:
                    entry = queue[0]
            if entry is not None:
                queue.remove(entry)
            if not queue:
                self._inflight.pop(account, None)
            return entry

    def _message_has_inflight(self, account: int, dialog_id: int, message_id: int) -> bool:
        now = time.time()
        with self._lock:
            queue = self._inflight.get(account)
            if not queue:
                return False
            return any(entry.get("message_id") == message_id
                       and (not entry.get("dialog_id") or entry.get("dialog_id") == dialog_id)
                       and now - entry.get("ts", now) <= INFLIGHT_TTL
                       for entry in queue)

    def _message_busy(self, account: int, dialog_id: int, message_id: int) -> bool:
        if self._message_has_inflight(account, dialog_id, message_id):
            return True
        now = time.time()
        with self._lock:
            return any(item.get("account") == account and item.get("message_id") == message_id
                       and item.get("dialog_id") == dialog_id
                       and now - item.get("ts", now) <= EXPECT_TTL
                       for item in self._expect)

    def pre_request_hook(self, request_name: str, account: int, request: Any) -> HookResult:
        if request_name != "TL_messages_sendReaction":
            return HookResult()
        reactions = getattr(request, "reaction", None)
        try:
            has_reactions = reactions is not None and int(reactions.size()) > 0
        except Exception:
            has_reactions = False
        tracked = None
        pending = None
        req_dialog, req_msg = 0, 0
        try:
            request_keys = set()
            if has_reactions:
                for index in range(int(reactions.size())):
                    key = self._key_of_tl(reactions.get(index))
                    if key:
                        request_keys.add(key)
            req_dialog = self._input_peer_dialog(account, getattr(request, "peer", None))
            try:
                req_msg = int(request.msg_id)
            except Exception:
                req_msg = 0
            pending = self._take_expect(account, req_dialog, req_msg, request_keys)
            if pending is not None:
                dialog_id = int(pending["dialog_id"])
                tracked = self._track_send(account, dialog_id, req_msg, True,
                                           pending["kind"] == PENDING_ADD, pending.get("seq"))
                if pending["kind"] == PENDING_REMOVE:
                    self._remember_removal(account, dialog_id, req_msg,
                                           str(pending.get("real")), pending.get("seq"),
                                           peer=getattr(request, "peer", None))
            else:
                tracked = self._track_send(account, req_dialog, req_msg, False)
                if has_reactions:
                    self._removals.pop((account, req_dialog, req_msg), None)
        except Exception:
            pass

        try:
            if not self._cfg["enabled"] or not has_reactions:
                return HookResult()
            swaps = self._vpr_request_swaps(account, pending, req_dialog, req_msg)
            if not swaps or not any(self._key_of_tl(reactions.get(i)) in swaps
                                    for i in range(int(reactions.size()))):
                return HookResult()

            sanitized = ArrayList()
            seen = set()
            for index in range(int(reactions.size())):
                reaction = reactions.get(index)
                key = self._key_of_tl(reaction)
                if key in swaps:
                    real_key = swaps.get(key)
                    real_reaction = self._tl_from_key(real_key) if real_key else None
                    if real_reaction is None:
                        self._untrack(account, tracked)
                        return HookResult(strategy=HookStrategy.CANCEL)
                    key, reaction = real_key, real_reaction
                if key in seen:
                    continue
                seen.add(key)
                sanitized.add(reaction)
            request.reaction = sanitized
            request.flags = int(request.flags) | 1
            return HookResult(strategy=HookStrategy.MODIFY, request=request)
        except Exception:
            return HookResult()

    def post_request_hook(self, request_name: str, account: int, response: Any, error: Any) -> HookResult:
        if request_name != "TL_messages_sendReaction":
            return HookResult()
        try:
            entry = self._pop_send(account, response if error is None else None)
            if entry is None:
                return HookResult()
            dialog_id = int(entry["dialog_id"])
            message_id = int(entry["message_id"])
            if (account, dialog_id, message_id) in self._removals:
                self._ui(lambda: self._reevaluate_deferred_removal(account, dialog_id, message_id),
                         "re-evaluate deferred removal")
            if error is None or not entry.get("plugin"):
                return HookResult()
            text = getattr(error, "text", None) or str(error)
            if not entry.get("new"):
                return HookResult()
            seq = entry.get("seq")
            self._ui(lambda: self._rollback_failed_add(account, dialog_id, message_id, seq, text),
                     "rollback failed add")
        except Exception:
            pass
        return HookResult()

    def _rollback_failed_add(self, account: int, dialog_id: int, message_id: int,
                             seq: Optional[int], text: str) -> None:
        if seq is None:
            return
        keys = [key for key in self._records_for(account, dialog_id, message_id)
                if self._records.get(key, {}).get("seq") == seq]
        if not keys:
            return
        records = [dict(self._records[key]) for key in keys]
        message_object = self._live.get((account, dialog_id, message_id))
        for key in keys:
            self._drop_record(key)
        if message_object is not None:
            self._remove_display(message_object, records)
            self._refresh_message(account, dialog_id, message_id, message_object)
        self._toast("Реакция не отправлена: " + text, "error")

    def on_update_hook(self, update_name: str, account: int, update: Any) -> HookResult:
        if update_name in ("TL_updateEditMessage", "TL_updateEditChannelMessage"):
            self._vpr_on_edit(account, update)
            return HookResult()
        if update_name != "TL_updateMessageReactions":
            return HookResult()
        try:
            if not self._cfg["enabled"] or update is None:
                return HookResult()
            dialog_id = int(MessageObject.getPeerId(update.peer))
            message_id = int(update.msg_id)
            msg = (account, dialog_id, message_id)
            sync = self._sync
            if sync is not None and sync.active:
                try:
                    sync.reaction_changed(msg)
                except Exception:
                    pass
            if not self._records_for(*msg):
                if msg in self._removals:
                    self._guard_removed_intent(account, dialog_id, message_id, update)
                return HookResult()
            reactions = update.reactions
            results = reactions.results if reactions is not None else None
            minimized = self._is_min(reactions)

            if not minimized:
                chosen_keys = set()
                if results is not None:
                    for index in range(int(results.size())):
                        entry = results.get(index)
                        if bool(entry.chosen):
                            key = self._key_of_tl(entry.reaction)
                            if key:
                                chosen_keys.add(key)
                self._updates[msg] = {"chosen_keys": chosen_keys, "ts": time.time()}
            self._touch_records(account, dialog_id, message_id)
        except Exception:
            pass
        return HookResult()

    def _remember_removal(self, account: int, dialog_id: int, message_id: int,
                          real_key: str, seq: Optional[int], peer=None) -> None:
        self._prune_removals()
        self._removals[(account, dialog_id, message_id)] = {
            "real": real_key,
            "seq": seq,
            "ts": time.time(),
            "asserted": False,
            "deferred": False,
            "peer": peer,
        }

    def _prune_removals(self, now: Optional[float] = None) -> None:
        now = time.time() if now is None else now
        for key, value in list(self._removals.items()):
            if now - float(value.get("ts") or 0) > REMOVAL_TTL:
                self._removals.pop(key, None)

    def _guard_removed_intent(self, account: int, dialog_id: int, message_id: int, update) -> None:
        try:
            self._prune_removals()
            recorded = self._removals.get((account, dialog_id, message_id))
            if recorded is None or recorded.get("asserted"):
                return
            real_key = recorded.get("real")
            reactions = update.reactions
            results = reactions.results if reactions is not None else None
            if not real_key or results is None:
                return
            _i, entry = self._find_entry(results, real_key, chosen=True)
            if entry is None:
                if not self._is_min(reactions):
                    recorded["deferred"] = False
                return
            if self._message_has_inflight(account, dialog_id, message_id):
                recorded["deferred"] = True
                return
            self._fire_corrective(account, dialog_id, message_id, recorded)
        except Exception:
            pass

    def _reevaluate_deferred_removal(self, account: int, dialog_id: int, message_id: int) -> None:
        recorded = self._removals.get((account, dialog_id, message_id))
        if not recorded or not recorded.get("deferred") or recorded.get("asserted"):
            return
        if self._message_has_inflight(account, dialog_id, message_id):
            return
        self._fire_corrective(account, dialog_id, message_id, recorded)

    def _fire_corrective(self, account: int, dialog_id: int, message_id: int, recorded) -> None:
        if not self._reassert_removal(account, message_id, recorded.get("peer")):
            return
        recorded["asserted"] = True
        recorded["deferred"] = False
        real_key = recorded.get("real")

        def retract():
            message_object = self._live.get((account, dialog_id, message_id))
            if message_object is not None:
                self._force_unchoose(message_object, real_key)
        self._ui(retract, "retract revived reaction")

    def _reassert_removal(self, account: int, message_id: int, peer) -> bool:
        if peer is None:
            return False
        try:
            from client_utils import send_request
            request = TLRPC.TL_messages_sendReaction()
            request.peer = peer
            request.msg_id = int(message_id)
            request.reaction = ArrayList()
            request.flags = 0

            def done(_response, error):
                pass

            try:
                send_request(request, done, account=account)
            except TypeError:
                if account != self._sel_account():
                    return False
                send_request(request, done)
            return True
        except Exception:
            return False

    def _render_guard_removed(self, message_object) -> None:
        if not self._removals:
            return
        try:
            key = (int(message_object.currentAccount), int(message_object.getDialogId()),
                   int(message_object.getId()))
            recorded = self._removals.get(key)
            if recorded is None or not recorded.get("asserted"):
                return

            self._force_unchoose(message_object, recorded.get("real"), refresh=False)
        except Exception:
            pass

    @staticmethod
    def _class_name(obj) -> str:
        try:
            return str(obj.getClass().getName())
        except Exception:
            return ""

    def _field_of_type(self, obj, needle: str):
        if obj is None:
            return None
        try:
            clazz = obj.getClass()
            cache_key = (str(clazz.getName()), needle)
        except Exception:
            return None
        cached = self._field_cache.get(cache_key, _MISSING)
        if cached is not _MISSING:
            if cached is None:
                return None
            try:
                return cached.get(obj)
            except Exception:
                return None
        found = None
        current, depth = clazz, 0
        while current is not None and depth < 8 and found is None:
            depth += 1
            try:
                fields = current.getDeclaredFields()
                count = int(fields.length) if hasattr(fields, "length") else len(fields)
            except Exception:
                fields, count = None, 0
            for index in range(count):
                try:
                    field = fields[index]
                    if needle in str(field.getType().getName()):
                        field.setAccessible(True)
                        found = field
                        break
                except Exception:
                    continue
            try:
                current = current.getSuperclass()
            except Exception:
                current = None
        self._field_cache[cache_key] = found
        if found is None:
            return None
        try:
            return found.get(obj)
        except Exception:
            return None

    @staticmethod
    def _outer_instance(obj):
        if obj is None:
            return None
        for name in ("this$0", "val$this$0"):
            try:
                value = get_private_field(obj, name)
                if value is not None:
                    return value
            except Exception:
                continue
        return None

    def _owner_chain(self, start, depth: int = 4) -> List[Any]:
        chain: List[Any] = []
        current = start
        for _ in range(depth):
            if current is None:
                break
            chain.append(current)
            nxt = self._field_of_type(current, WINDOW_HINT) or self._outer_instance(current)
            if nxt is None or any(nxt is item for item in chain):
                break
            current = nxt
        return chain

    def _client_window_object(self, dialog):
        if dialog is None:
            return None
        if WINDOW_HINT in self._class_name(dialog):
            return dialog
        window = self._field_of_type(dialog, WINDOW_HINT) or self._outer_instance(dialog)
        if window is not None and WINDOW_HINT in self._class_name(window):
            return window
        return None

    def _reactions_layout(self, owner):
        if owner is None:
            return None
        for candidate in self._owner_chain(owner):
            for field_name in ("reactionsContainerLayout", "reactionsLayout",
                               "containerLayout", "reactionsLayoutContainer"):
                try:
                    layout = get_private_field(candidate, field_name)
                except Exception:
                    layout = None
                if layout is not None:
                    return layout
            found = self._field_of_type(candidate, "ReactionsContainerLayout")
            if found is not None:
                return found
        return None

    def _picker_value(self, args, depth: int = 0) -> Optional[str]:
        for arg in list(args)[:3]:
            if arg is None:
                continue
            if depth < 2:
                for attribute in ("reaction", "span", "emoji"):
                    try:
                        nested = getattr(arg, attribute, None)
                    except Exception:
                        nested = None
                    if nested is not None and nested is not arg and not isinstance(nested, str):
                        value = self._picker_value([nested], depth + 1)
                        if value:
                            return value
            try:
                if bool(getattr(arg, "isStar", False)):
                    return None
                if getattr(arg, "emojicon", None):
                    return str(arg.emojicon)
                if isinstance(getattr(arg, "emoji", None), str) and arg.emoji:
                    return str(arg.emoji)
                document_id = int(getattr(arg, "documentId", 0) or 0)
            except Exception:
                document_id = 0
            if document_id:
                return _PREFIX_ANIMATED + str(document_id)
            try:
                number = int(arg)
            except Exception:
                number = 0
            if number > 100000:
                return _PREFIX_ANIMATED + str(number)
        return None

    def _reaction_panel(self, dialog) -> bool:
        try:
            if int(get_private_field(dialog, "type")) in self._panel_types:
                return True
        except Exception:
            pass
        layout = self._reactions_layout(self._client_window_object(dialog))
        if layout is None:
            return False
        try:
            return int(layout.getWindowType()) in self._panel_types
        except Exception:
            return False

    def _capture_from_panel(self, param) -> bool:
        if not self._cfg.get("capture"):
            return False
        if not self._reaction_panel(param.thisObject):
            return False

        try:
            param.setResult(None)
        except Exception:
            pass
        value = self._picker_value(list(param.args or []))
        if not value:
            self._toast("Эту реакцию выбрать нельзя. Попробуйте другую", "error")
            return True
        self._save_capture(value, self._sel_account())
        return True

    def _client_premium_emoji_before(self, param) -> bool:
        args = param.args
        if args is None or len(args) < 2:
            return False
        try:
            document_id = int(args[1]) if args[1] is not None else 0
        except Exception:
            document_id = 0
        if not document_id:
            return False
        window = self._client_window_object(param.thisObject)
        if window is None:
            return False
        account = self._sel_account()
        try:
            if bool(UserConfig.getInstance(account).isPremium()):
                return False
        except Exception:
            pass

        layout = self._reactions_layout(window)
        try:
            if layout is not None and bool(layout.channelReactions):
                return False
        except Exception:
            pass
        try:
            if layout is not None and int(layout.getWindowType()) == \
                    int(SelectAnimatedEmojiDialog.TYPE_STICKER_SET_EMOJI):
                return False
        except Exception:
            pass

        value = _PREFIX_ANIMATED + str(document_id)
        self._cache_document(account, args[2] if len(args) > 2 else None)
        if (self._cfg.get("local") or "") != value:
            try:
                self.set_setting(SETTING_LOCAL, value)
                self._refresh_config()
            except Exception:
                pass
        try:
            param.setResult(None)
        except Exception:
            pass

        label = self._label(value, account)
        if not self._cfg.get("all"):
            self._toast("Сохранено «только для меня»: " + label
                        + ". Осталось выбрать «для всех» в настройках плагина", "info")
            return True
        if self._apply_local_through_client(layout):
            self._toast("«Только для меня»: " + label + ", на сервер — "
                        + self._label(self._cfg.get("all"), account), "success")
        else:
            self._toast("Сохранено «только для меня»: " + label
                        + ". Поставьте реакцию ещё раз", "info")
        return True

    def _apply_local_through_client(self, layout) -> bool:
        local_visible = self._visible_from_key(self._key_of_value(self._cfg.get("local")))
        if local_visible is None or layout is None:
            return False
        if self._visible_from_key(self._key_of_value(self._cfg.get("all"))) is None:
            return False
        try:
            self._programmatic_until = time.monotonic() + 2.0
            layout.onReactionClicked(None, local_visible, False)
            return True
        except Exception:
            return False
        finally:
            self._programmatic_until = 0.0

    def _find_class_safe(self, name: str):
        try:
            return find_class(name)
        except Exception:
            return None

    def _toast(self, text: str, kind: str = "info", fragment=None) -> None:
        try:
            if kind == "error":
                BulletinHelper.show_error(text, fragment)
            elif kind == "success":
                BulletinHelper.show_success(text, fragment)
            else:
                BulletinHelper.show_info(text, fragment)
        except Exception:
            try:
                BulletinHelper.show_info(text)
            except Exception:
                pass

            pass

            pass
            pass
