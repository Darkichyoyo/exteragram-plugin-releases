_VPR_DEFAULT_DB = 'https://virtual-reactions-test-default-rtdb.europe-west1.firebasedatabase.app'
_VPR_DEFAULT_API_KEY = 'AIzaSyC469otv-RBz2VQTo6hmLfx3Z0vf-N8rio'
_VPR_SYNC_KEY = re.compile(r'^[0-9a-f]{32}$')
_VPR_SYNC_UID = re.compile(r'^[A-Za-z0-9_-]{1,128}$')

class _VPRSyncHTTPError(Exception):
    def __init__(self, code=None):
        super().__init__()
        self.code = code if isinstance(code, int) else None


class _VPRSyncNoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None

class _VPRSyncRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        parsed = urllib.parse.urlsplit(newurl)
        host = (parsed.hostname or '').lower()
        if (parsed.scheme != 'https' or parsed.username or parsed.password or parsed.port
                or not (host.endswith('.firebaseio.com') or host.endswith('.firebasedatabase.app'))):
            return None
        return super().redirect_request(req, fp, code, msg, headers, newurl)

class _VPRSync:
    def __init__(self, plugin, url, api_key, button_class):
        parsed = urllib.parse.urlsplit(url.strip().rstrip('/'))
        host = (parsed.hostname or '').lower()
        if (parsed.scheme != 'https' or not host or parsed.username or parsed.password or parsed.port
                or parsed.path or parsed.query or parsed.fragment
                or not (host.endswith('.firebaseio.com') or host.endswith('.firebasedatabase.app'))):
            raise ValueError('invalid Firebase database URL')
        if not isinstance(api_key,str) or not re.fullmatch(r'[A-Za-z0-9_-]{10,200}', api_key.strip()):
            raise ValueError('invalid Firebase API key')
        self.plugin, self.origin, self.api_key = plugin, 'https://' + host, api_key.strip()
        self.button_class = button_class
        self.opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), _VPRSyncNoRedirect())
        self.stream_opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), _VPRSyncRedirect())
        self.auth_lock = threading.RLock()
        self.stream_id = None
        self.stream_stop = None
        self.stream_response = None
        self.lock = threading.RLock()
        self.active = True
        self.cache, self.visible, self.pending, self.auth = {}, {}, set(), {}
        self.priority, self.retry_waiting = set(), set()
        self.batch_scheduled = False
        self.http_status = None

        self.mode = None
        self.tree = {}
        self.denied = 0
        self.project = hashlib.sha256((self.origin + '\0' + self.api_key).encode()).hexdigest()[:16]

        self.writes = _vpr_queue.Queue()
        self.write_conn = None
        self.dk_keys = {}
        self.own = {}
        self.shown = {}
        self.disk_loaded = set()
        self.file_lock = threading.Lock()
        self.ready = None
        self.leaving = None
        self.leave_seq = 0
        threading.Thread(target=self._writer_loop, daemon=True).start()
    def stop(self):
        with self.lock:
            current = self.stream_id
            snap = self._cache_snapshot_locked(current) if current else None
            self.active = False
            self.leaving = None
            self._stop_stream_locked()
            self.pending.clear(); self.priority.clear(); self.retry_waiting.clear()
            self.visible.clear(); self.cache.clear(); self.auth.clear(); self.tree = {}
            self.shown.clear()
            self.dk_keys = {}
        if current:
            self._save_cache_async(current, snap)
        self.writes.put(None)
    def _writer_loop(self):
        while True:
            task = self.writes.get()
            if task is None or not self.active:
                self._close_write_conn()
                if task is None:
                    return
                continue
            try:
                task()
            except Exception:
                pass
    def _close_write_conn(self):
        conn, self.write_conn = self.write_conn, None
        if conn is not None:
            try: conn.close()
            except Exception: pass
    def _new_write_conn(self):
        return http.client.HTTPSConnection(self.origin[8:], timeout=8, context=ssl.create_default_context())
    def _warm(self, me):
        def task():
            if not self.active:
                return
            try:
                self._session(me)
                if self.write_conn is None:
                    conn = self._new_write_conn()
                    conn.connect()
                    self.write_conn = conn
            except Exception:
                self._close_write_conn()
        self.writes.put(task)
    def _write_fast(self, me, path, method, value):
        _, token = self._session(me)
        raw = None if value is None else json.dumps(value, separators=(',', ':'), allow_nan=False).encode()
        target = path + '.json?' + urllib.parse.urlencode({'auth': token})
        headers = {'Accept': 'application/json', 'Content-Type': 'application/json', 'Connection': 'keep-alive'}
        for attempt in (0, 1):
            if self.write_conn is None:
                self.write_conn = self._new_write_conn()
            conn = self.write_conn
            try:
                conn.request(method, target, body=raw, headers=headers)
                response = conn.getresponse()
                content = response.read(131073)
                status = int(response.status)
                closing = bool(response.will_close)
            except Exception as error:
                self._close_write_conn()
                if attempt == 0:
                    continue
                raise _VPRSyncHTTPError() from None
            self.http_status = status
            if closing or len(content) > 131072:
                self._close_write_conn()
            if not 200 <= status < 300 or len(content) > 131072:
                raise _VPRSyncHTTPError(status)
            try:
                return json.loads(content.decode('utf-8')) if content else None
            except Exception:
                return None
        raise _VPRSyncHTTPError()
    def _cache_path(self, me):
        folder = os.path.join(get_plugins_dir(), 'virtual_premium_reactions')
        ensure_dir_exists(folder)
        return os.path.join(folder, 'sync-cache-{}-{}.json'.format(me, self.project))
    def _cache_snapshot_locked(self, current):
        if not current:
            return None
        me, dk = current[2], current[3]
        snap = {}
        for k in list(self.dk_keys.get(dk, ()))[:300]:
            entry = self.cache.get((me, k))
            if entry and entry[1]:
                snap[k] = [[str(d), f or ''] for d, f in entry[1][:16]]
        return snap
    def _save_cache_async(self, current, snap):
        if snap is None:
            return
        me, dk = current[2], current[3]
        def save():
            try:
                with self.file_lock:
                    path = self._cache_path(me)
                    data = {}
                    try:
                        if os.path.exists(path) and os.path.getsize(path) <= 4194304:
                            with open(path, 'r', encoding='utf-8') as f:
                                data = json.load(f)
                    except Exception:
                        data = {}
                    if not isinstance(data, dict):
                        data = {}
                    data.pop(dk, None)
                    if snap:
                        data[dk] = snap
                    while len(data) > 200:
                        data.pop(next(iter(data)))
                    tmp = path + '.tmp'
                    with open(tmp, 'w', encoding='utf-8') as f:
                        json.dump(data, f, separators=(',', ':'))
                    os.replace(tmp, path)
            except Exception:
                pass
        threading.Thread(target=save, daemon=True).start()
    def _load_cache(self, current):
        me, dk = current[2], current[3]
        if (me, dk) in self.disk_loaded:
            return
        self.disk_loaded.add((me, dk))
        try:
            with self.file_lock:
                path = self._cache_path(me)
                if not os.path.exists(path) or os.path.getsize(path) > 4194304:
                    return
                with open(path, 'r', encoding='utf-8') as f:
                    data = json.load(f)
            entries = data.get(dk) if isinstance(data, dict) else None
            if not isinstance(entries, dict):
                return
            loaded = {}
            for k, lst in list(entries.items())[:300]:
                if not isinstance(k, str) or not _VPR_SYNC_KEY.fullmatch(k) or not isinstance(lst, list):
                    continue
                docs = []
                for item in lst[:16]:
                    if not isinstance(item, list) or len(item) != 2:
                        continue
                    d, fb = item
                    if not isinstance(d, str) or not d.isascii() or not d.isdigit() or not 0 < len(d) <= 19:
                        continue
                    doc = int(d)
                    if not 0 < doc < 2**63:
                        continue
                    fb = fb if isinstance(fb, str) and 0 < len(fb) <= 64 else None
                    docs.append((doc, fb))
                if docs:
                    loaded[k] = sorted(docs, key=lambda x: (x[0], x[1] or ''))
            if loaded and current[1] > 0:
                try:
                    self.plugin._vpr_bootstrap_peer(current, loaded)
                except Exception:
                    pass
            changed = []
            with self.lock:
                if not self.active or self.stream_id != current:
                    return
                keys = self.dk_keys.setdefault(dk, set())
                for k, docs in loaded.items():
                    if (me, k) not in self.cache:
                        self.cache[(me, k)] = (time.monotonic(), docs)
                        self.shown.setdefault((me, k), docs)
                        keys.add(k)
                        changed.extend(t for t, (v, _) in self.visible.items() if t[:2] == current[:2] and v[4] == k)
            for target in set(changed):
                self.plugin._sync_refresh(target, self)
        except Exception:
            pass
    def _http(self, url, method='GET', data=None, ctype='application/json'):
        try:
            req = urllib.request.Request(url, data=data, method=method,
                headers={'Accept':'application/json','Content-Type':ctype})
            with self.opener.open(req, timeout=8) as response:
                self.http_status = int(response.status)
                content = response.read(131073)
                if len(content) > 131072: raise _VPRSyncHTTPError(self.http_status)
                return json.loads(content.decode('utf-8')) if content else None
        except urllib.error.HTTPError as error:
            raise _VPRSyncHTTPError(int(error.code)) from None
        except _VPRSyncHTTPError:
            raise
        except Exception as error:
            raise _VPRSyncHTTPError() from None
    def _auth_path(self, me):
        folder = os.path.join(get_plugins_dir(), 'virtual_premium_reactions')
        ensure_dir_exists(folder)
        return os.path.join(folder, 'firebase-auth-{}-{}.json'.format(me, self.project))
    def _save_auth(self, me, value):
        path = self._auth_path(me); tmp = path + '.tmp'
        raw = json.dumps(value, separators=(',', ':')).encode()
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        try:
            with os.fdopen(fd,'wb') as f: f.write(raw); f.flush(); os.fsync(f.fileno())
            os.replace(tmp,path)
        finally:
            try: os.unlink(tmp)
            except FileNotFoundError: pass
    def _session(self, me):
        with self.auth_lock:
            uid, access = self._session_locked(me)
            self.own[me] = uid
            return uid, access
    def _session_locked(self, me):
        if not self.active: raise _VPRSyncHTTPError()
        state = self.auth.get(me)
        if state and state.get('access') and time.monotonic() < state.get('deadline',0): return state['uid'], state['access']
        if state is None:
            path = self._auth_path(me)
            if os.path.exists(path):
                with open(path,'r',encoding='utf-8') as f: state = json.load(f)
                if not isinstance(state,dict) or set(state) != {'uid','refresh'}: raise _VPRSyncHTTPError()
            else: state = {}
        q = urllib.parse.urlencode({'key':self.api_key})
        if state:
            uid, refresh = state.get('uid'), state.get('refresh')
            if not isinstance(uid,str) or not _VPR_SYNC_UID.fullmatch(uid) or not isinstance(refresh,str) or not 1 <= len(refresh) <= 16384: raise _VPRSyncHTTPError()
            body = urllib.parse.urlencode({'grant_type':'refresh_token','refresh_token':refresh}).encode()
            data = self._http('https://securetoken.googleapis.com/v1/token?'+q,'POST',body,'application/x-www-form-urlencoded')
            if not isinstance(data,dict) or data.get('user_id') != uid: raise _VPRSyncHTTPError()
            access, new_refresh, ttl = data.get('id_token'), data.get('refresh_token'), data.get('expires_in')
        else:
            data = self._http('https://identitytoolkit.googleapis.com/v1/accounts:signUp?'+q,'POST',b'{"returnSecureToken":true}')
            if not isinstance(data,dict): raise _VPRSyncHTTPError()
            uid, access, new_refresh, ttl = data.get('localId'), data.get('idToken'), data.get('refreshToken'), data.get('expiresIn')
        if not isinstance(uid,str) or not _VPR_SYNC_UID.fullmatch(uid) or not isinstance(access,str) or not 1 <= len(access) <= 16384 or not isinstance(new_refresh,str) or not 1 <= len(new_refresh) <= 16384: raise _VPRSyncHTTPError()
        try: ttl = int(ttl)
        except Exception: raise _VPRSyncHTTPError() from None
        if not 1 <= ttl <= 86400: raise _VPRSyncHTTPError()
        self._save_auth(me, {'uid':uid,'refresh':new_refresh})
        self.auth[me] = {'uid':uid,'refresh':new_refresh,'access':access,'deadline':time.monotonic()+max(0,ttl-120)}
        return uid,access
    def _database(self, me, key, uid=None, method='GET', value=None):
        if not _VPR_SYNC_KEY.fullmatch(key): raise ValueError('invalid key')
        own,token = self._session(me)
        if uid is not None and (uid != own or not _VPR_SYNC_UID.fullmatch(uid)): raise ValueError('invalid uid')
        path = '/r/' + key + ('/' + uid if uid else '') + '.json?'+urllib.parse.urlencode({'auth':token})
        raw = None if value is None else json.dumps(value,separators=(',',':'),allow_nan=False).encode()
        result = self._http(self.origin+path, method, raw)
        return own,result
    def _enqueue(self, cachekey, priority=False):
        with self.lock:
            if not self.active or self.mode != 'legacy':
                return
            self.pending.add(cachekey)
            if priority:
                self.priority.add(cachekey)
            if not self.batch_scheduled:
                self.batch_scheduled = True
                run_on_queue(self._fetch_batch, PLUGINS_QUEUE, 100)

    @staticmethod
    def dialog_key(dialog, me):
        if me <= 0:
            return None
        if dialog > 0 and dialog != me:
            raw = 'p:{}:{}'.format(min(dialog, me), max(dialog, me))
        elif dialog < 0:
            raw = 'g:{}'.format(dialog)
        else:
            return None
        return hashlib.sha256(raw.encode('utf-8')).hexdigest()[:32]

    def _stop_stream_locked(self):
        self.ready = None
        ev, response = self.stream_stop, self.stream_response
        self.stream_id = self.stream_stop = self.stream_response = None
        if ev:
            ev.set()

        if response:
            def close():
                try:
                    import socket
                    response.fp.raw._sock.shutdown(socket.SHUT_RDWR)
                except Exception:
                    pass
                try:
                    response.close()
                except Exception:
                    pass
            threading.Thread(target=close, daemon=True).start()

    def leave(self, account=None, dialog=None, delay_ms=None):
        try:
            delay_ms = STREAM_LINGER_MS if delay_ms is None else int(delay_ms)
        except (TypeError, ValueError):
            delay_ms = 0
        with self.lock:
            current = self.stream_id
            if current is None or (account is not None and current[:2] != (account, dialog)):
                return
            ticket = None
            if delay_ms > 0 and self.active:
                self.leave_seq += 1
                ticket = (current, self.leave_seq)
                self.leaving = ticket
        if ticket is not None:
            try:
                run_on_queue(lambda: self._leave_now(current, ticket), PLUGINS_QUEUE, delay_ms)
                return
            except Exception:
                pass
        self._leave_now(current, ticket)

    def _leave_now(self, current, ticket=None):
        with self.lock:
            if self.stream_id != current or (ticket is not None and self.leaving != ticket):
                return
            self.leaving = None
            snap = self._cache_snapshot_locked(current)
            self._stop_stream_locked()
            self.pending.clear(); self.priority.clear()
            self.visible.clear()
            self.tree = {}
        self._save_cache_async(current, snap)

    def enter(self, account, dialog, me):
        dk = self.dialog_key(dialog, me)
        if not dk:
            return
        current = (account, dialog, me, dk)
        with self.lock:
            self.leaving = None
            if not self.active or self.stream_id == current:
                return
            old = self.stream_id
            old_snap = self._cache_snapshot_locked(old) if old else None
            self._stop_stream_locked()
            self.visible = {k:v for k,v in self.visible.items() if k[:2] == current[:2]}
            self.pending.clear(); self.priority.clear()
            self.tree = {}
            ev = threading.Event()
            self.stream_id, self.stream_stop = current, ev
        if old:
            self._save_cache_async(old, old_snap)
        threading.Thread(target=self._stream, args=(current, ev), daemon=True).start()
        self._load_cache(current)
        self._warm(me)

        with self.lock:
            keys = [(v[0][3],v[0][4]) for v in self.visible.values()]
        for cachekey in keys:
            self._enqueue(cachekey, True)

    def _stream(self, current, stop):
        _account, _dialog, me, dk = current
        delay = 1
        while self.active and not stop.is_set():
            response = None
            use_v2 = self.mode != 'legacy'
            try:
                _, token = self._session(me)
                url = self.origin + ('/c/' if use_v2 else '/events/') + dk + '.json?' + urllib.parse.urlencode({'auth': token})
                req = urllib.request.Request(url, headers={'Accept':'text/event-stream', 'Cache-Control':'no-cache'})
                try:
                    response = self.stream_opener.open(req, timeout=8)
                except urllib.error.HTTPError as error:
                    if use_v2 and int(error.code) in (401, 403):
                        self.denied += 1
                        if self.denied == 1:
                            with self.auth_lock:
                                state = self.auth.get(me)
                                if state: state['deadline'] = 0
                        else:
                            with self.lock:
                                self.mode = 'legacy'
                        delay = 1
                        continue
                    raise

                try:
                    response.fp.raw._sock.settimeout(65)
                except Exception:
                    pass
                if 'text/event-stream' not in str(response.headers.get('Content-Type','')):
                    raise ValueError('not an event stream')
                with self.lock:
                    if not self.active or stop.is_set() or self.stream_id != current:
                        break
                    self.stream_response = response
                    if use_v2:
                        self.mode = 'v2'
                        self.pending.clear(); self.priority.clear()
                    keys = [(v[0][3],v[0][4]) for k,v in self.visible.items() if k[:2] == current[:2]]
                for cachekey in keys:
                    self._enqueue(cachekey, True)
                self.denied = 0
                delay = 1
                kind, parts = '', []
                while self.active and not stop.is_set():
                    line = response.readline(4194305)
                    if not line or len(line) > 4194304:
                        break
                    line = line.decode('utf-8').rstrip('\r\n')
                    if not line:
                        if kind in ('put','patch') and parts:
                            payload = json.loads('\n'.join(parts))
                            if use_v2:
                                self._stream_tree(current, kind, payload)
                            else:
                                self._stream_event(current, payload)
                        elif kind in ('cancel','auth_revoked'):
                            with self.auth_lock:
                                state = self.auth.get(me)
                                if state: state['deadline'] = 0
                            break
                        kind, parts = '', []
                    elif line.startswith('event:'):
                        kind = line[6:].strip()
                    elif line.startswith('data:'):
                        parts.append(line[5:].lstrip())
                        if sum(len(x) for x in parts) > 4194304:
                            raise ValueError('event too large')
            except Exception as error:
                pass
            finally:
                with self.lock:
                    if self.stream_response is response:
                        self.stream_response = None
                if response:
                    try: response.close()
                    except Exception: pass
            if not stop.wait(delay):
                delay = min(delay * 2, 30)

    def _stream_event(self, current, payload):
        if not isinstance(payload,dict):
            return
        path, data = payload.get('path'), payload.get('data')
        found = set()
        def add(value):
            if isinstance(value,dict):
                key = value.get('m')
                if isinstance(key,str) and _VPR_SYNC_KEY.fullmatch(key):
                    found.add(key)
        if path == '/' and isinstance(data,dict):
            for value in data.values(): add(value)
        elif isinstance(path,str) and path.count('/') == 1:
            add(data)
        elif isinstance(path,str) and path.endswith('/m') and isinstance(data,str) and _VPR_SYNC_KEY.fullmatch(data):
            found.add(data)
        with self.lock:
            if not self.active or self.stream_id != current:
                return
            selected = [(v[0][3],v[0][4]) for k,v in self.visible.items()
                        if k[:2] == current[:2] and v[0][4] in found]
        for cachekey in selected:
            self._enqueue(cachekey, True)

    @staticmethod
    def _tree_put(tree, segs, value):
        if not segs:
            touched = set(tree)
            tree.clear()
            if isinstance(value, dict):
                for k, v in value.items():
                    if isinstance(k, str) and _VPR_SYNC_KEY.fullmatch(k) and isinstance(v, dict):
                        tree[k] = v
                touched |= set(tree)
            return touched
        key = segs[0]
        if not _VPR_SYNC_KEY.fullmatch(key):
            return set()
        if len(segs) == 1:
            if isinstance(value, dict): tree[key] = value
            else: tree.pop(key, None)
            return {key}
        node = tree.get(key)
        if not isinstance(node, dict):
            node = {}; tree[key] = node
        cur = node
        for s in segs[1:-1]:
            nxt = cur.get(s)
            if not isinstance(nxt, dict):
                nxt = {}; cur[s] = nxt
            cur = nxt
        if value is None: cur.pop(segs[-1], None)
        else: cur[segs[-1]] = value
        if not node: tree.pop(key, None)
        return {key}

    def _tree_docs(self, node, me):
        own = (self.auth.get(me) or {}).get('uid') or self.own.get(me)
        docs = []
        if isinstance(node, dict):
            for uid, value in node.items():
                if uid == own or not isinstance(uid, str) or not _VPR_SYNC_UID.fullmatch(uid) or not isinstance(value, dict):
                    continue
                if not set(value) <= {'d', 't', 'f'}:
                    continue
                d, t, f = value.get('d'), value.get('t'), value.get('f')

                if not isinstance(d, str) or not d.isascii() or not d.isdigit() or not 0 < len(d) <= 19:
                    continue
                doc = int(d)
                if not 0 < doc < 2**63 or type(t) not in (int, float):
                    continue
                if not isinstance(f, str) or not 0 < len(f) <= 64:
                    f = None
                docs.append((doc, f))
        return sorted(docs, key=lambda x: (x[0], x[1] or ''))[:64]

    def _tree_latest(self, keys, me):
        own = (self.auth.get(me) or {}).get('uid') or self.own.get(me)
        best = None
        for key in keys:
            node = self.tree.get(key)
            if not isinstance(node, dict):
                continue
            for uid, value in node.items():
                if uid == own or not isinstance(uid, str) or not _VPR_SYNC_UID.fullmatch(uid) or not isinstance(value, dict):
                    continue
                if not set(value) <= {'d', 't', 'f'}:
                    continue
                d, t, f = value.get('d'), value.get('t'), value.get('f')
                if not isinstance(d, str) or not d.isascii() or not d.isdigit() or not 0 < len(d) <= 19:
                    continue
                if type(t) not in (int, float) or not isinstance(f, str) or not 0 < len(f) <= 64:
                    continue
                doc = int(d)
                if not 0 < doc < 2**63:
                    continue
                if best is None or t > best[0]:
                    best = (t, doc, f)
        return best

    def predict_wait(self, account, dialog, me, key, since):
        with self.lock:
            if not self.active:
                return 0.0
            entry = self.cache.get((me, key))
            if entry is not None and (entry[1] or self.mode == 'legacy'):
                return 0.0
            ready = self.ready
            if ready is None or ready[0][:2] != (account, dialog):
                return None
            due = max(ready[1] + PREDICT_READY_GRACE, since + PREDICT_LIVE_GRACE)
        return max(0.0, due - time.monotonic())

    def _stream_tree(self, current, kind, payload):
        if not isinstance(payload, dict):
            return
        path, data = payload.get('path'), payload.get('data')
        if not isinstance(path, str):
            return
        segs = [p for p in path.split('/') if p]
        changed = []
        with self.lock:
            if not self.active or self.stream_id != current:
                return
            if kind == 'patch' and isinstance(data, dict):
                items = [(segs + [p for p in str(k).split('/') if p], v) for k, v in data.items()]
            else:
                items = [(segs, data)]
            touched = set()
            me = current[2]
            before = {}
            if kind == 'put' and not segs:
                dkeys = self.dk_keys.get(current[3], set())
                before = {(me, k): self.cache[(me, k)] for k in dkeys if (me, k) in self.cache}
                for ck in before:
                    self.cache.pop(ck, None)
                touched |= {ck[1] for ck in before}
            for parts, value in items:
                touched |= self._tree_put(self.tree, parts, value)
            if len(self.tree) > 50000:
                self.tree = {}
            by_key = {}
            for k, (v, _) in self.visible.items():
                if k[:2] == current[:2]:
                    by_key.setdefault(v[4], []).append(k)
            for key in touched:
                docs = self._tree_docs(self.tree.get(key), me)
                old = before.get((me, key)) or self.cache.get((me, key))
                if docs:
                    self.cache[(me, key)] = (time.monotonic(), docs)
                    self.shown[(me, key)] = docs
                    self.dk_keys.setdefault(current[3], set()).add(key)
                else:
                    self.cache.pop((me, key), None)
                    self.shown.pop((me, key), None)
                    self.dk_keys.get(current[3], set()).discard(key)
                if (old[1] if old else []) != docs:
                    changed.extend(by_key.get(key, ()))
            if len(self.shown) > 4000:
                self.shown = {ck: v for ck, v in self.shown.items() if ck[1] in self.dk_keys.get(current[3], ())}
            if len(self.cache) > 20000:
                keep = {(me, k) for k in self.dk_keys.get(current[3], ())}
                self.cache = {ck: v for ck, v in self.cache.items() if ck in keep}
                self.dk_keys = {current[3]: self.dk_keys.get(current[3], set())}
            latest = self._tree_latest(touched, me) if current[1] > 0 else None
            root = kind == 'put' and not segs
            if root:
                self.ready = (current, time.monotonic())
        if latest is not None:
            try:
                self.plugin._vpr_learn_peer(current, latest)
            except Exception:
                pass
        for target in set(changed):
            self.plugin._sync_refresh(target, self)
        if root:
            try:
                self.plugin._vpr_stream_ready(current, self)
            except Exception:
                pass

    def observe(self, account, dialog, message_id, me, key):
        if not _VPR_SYNC_KEY.fullmatch(key):
            return
        item = (account, dialog, message_id, me, key)
        target, cachekey = (account, dialog, message_id), (me, key)
        with self.lock:
            if not self.active:
                return
            first = target not in self.visible
            self.visible[target] = (item, time.monotonic())
            while len(self.visible) > 256:
                self.visible.pop(next(iter(self.visible)))
        if first:
            self._enqueue(cachekey, True)
        with self.lock:
            need_enter = self.stream_id is None or self.stream_id[:2] != (account, dialog)
        if not need_enter:
            return

        def check_chat():
            try:
                fragment = get_last_fragment()
                if (not self.plugin._vpr_background and fragment is not None and int(fragment.getDialogId()) == dialog
                        and int(fragment.getCurrentAccount()) == account):
                    self.enter(account, dialog, me)
            except Exception:
                pass
        run_on_ui_thread(check_chat)

    def reaction_changed(self, target):
        with self.lock:
            entry = self.visible.get(target) if self.active else None
        if entry:
            item, _ = entry
            self._enqueue((item[3],item[4]), True)

    def get(self, me, key):
        with self.lock:
            if not self.active:
                return []
            entry = self.cache.get((me, key))
            docs = entry[1] if entry and entry[1] else self.shown.get((me, key))
            return list(docs) if docs else []

    def last(self, me, key):
        with self.lock:
            docs = self.shown.get((me, key)) if self.active else None
            return list(docs) if docs else []
    def _fetch_batch(self):
        with self.lock:
            if not self.active:
                return
            if not self.pending:
                self.batch_scheduled = False
                return
            key = next(iter(self.priority)) if self.priority else next(iter(self.pending))
            self.priority.discard(key)
            self.pending.discard(key)
        me, key = key
        changed = []
        try:
            own, data = self._database(me, key)
            if data is None:
                data = {}
            if not isinstance(data, dict) or len(data) > 200:
                raise _VPRSyncHTTPError()
            docs = []
            for uid, value in data.items():
                if uid == own or not isinstance(uid, str) or not _VPR_SYNC_UID.fullmatch(uid) or not isinstance(value, dict) or set(value) != {'d', 't'}:
                    continue
                doc, ts = value.get('d'), value.get('t')
                if type(doc) is int and 0 < doc < 2**63 and type(ts) in (int, float) and 0 < ts < 2**53:
                    docs.append((doc, None))
            docs = sorted(docs)[:64]
            with self.lock:
                if self.mode == 'v2':
                    docs = self.cache.get((me, key), (0, []))[1]
                old = self.cache.get((me, key))
                self.cache[(me, key)] = (time.monotonic(), docs)
                if docs:
                    self.shown[(me, key)] = docs
                else:
                    self.shown.pop((me, key), None)
                if old is None or old[1] != docs:
                    changed.extend(k for k, (v, _) in self.visible.items() if v[3] == me and v[4] == key)
        except Exception as error:
            with self.lock:
                old = self.cache.get((me, key))
                self.cache[(me, key)] = (time.monotonic(), old[1] if old else [])
        for target in set(changed):
            self.plugin._sync_refresh(target, self)
        with self.lock:
            if not self.active:
                self.batch_scheduled = False
            elif self.pending:
                run_on_queue(self._fetch_batch, PLUGINS_QUEUE, 100)
            else:
                self.batch_scheduled = False

    def publish(self, me, key, doc, revision, target, fallback=None):
        if not _VPR_SYNC_KEY.fullmatch(key) or (doc is not None and (type(doc) is not int or not 0 < doc < 2**63)):
            return
        if not isinstance(fallback, str) or not 0 < len(fallback) <= 64:
            fallback = None
        def task():
            if not self.active or self.plugin._sync_latest.get(target) != revision:
                return
            try:
                uid,_ = self._session(me)
                if not self.active or self.plugin._sync_latest.get(target) != revision:
                    return
                dk = self.dialog_key(target[1], me)
                method = 'DELETE' if doc is None else 'PUT'
                if self.mode != 'legacy' and dk:
                    value = None
                    if doc is not None:
                        value = {'d': str(doc), 't': int(time.time())}
                        if fallback: value['f'] = fallback
                    try:
                        self._write_fast(me, '/c/' + dk + '/' + key + '/' + uid, method, value)
                        return
                    except _VPRSyncHTTPError as error:
                        if error.code not in (401, 403) or self.mode == 'v2':
                            raise
                        with self.lock:
                            self.mode = 'legacy'
                self._database(me,key,uid,'DELETE' if doc is None else 'PUT',None if doc is None else {'d':doc,'t':int(time.time())})
                dk = self.dialog_key(target[1], me)
                if dk:
                    _, token = self._session(me)
                    path = '/events/' + dk + '/' + uid + '.json?' + urllib.parse.urlencode({'auth':token})
                    value = {'m':key,'t':int(time.time()*1000)}
                    self._http(self.origin + path, 'PUT', json.dumps(value,separators=(',',':')).encode())
            except Exception as error:
                pass
        self.writes.put(task)

class _ChatLifecycleHook(MethodHook):
    def __init__(self, plugin, leaving=False):
        self.plugin, self.leaving = plugin, leaving
    def after_hooked_method(self, param):
        try:
            sync = self.plugin._sync
            if sync is None or not sync.active: return
            account = int(param.thisObject.getCurrentAccount())
            dialog = int(param.thisObject.getDialogId())
            if self.leaving:
                sync.leave(account, dialog)
            elif self.plugin._scope_allows(dialog):
                sync.enter(account, dialog, self.plugin._uid(account))
        except Exception:
            pass

class _SelectReactionHook(MethodHook):
    def __init__(self, plugin: "VirtualPremiumReactionsPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            variant = self.plugin._select_variant(param.args)
            if not variant:
                return
            self.plugin._select_reaction_before(param)
        except Exception:
            pending = self.plugin._pending
            self.plugin._pending = None
            if pending is not None:
                self.plugin._drop_expect(pending)

    def after_hooked_method(self, param):
        if not self.plugin._select_variant(param.args):
            return
        pending = self.plugin._pending
        try:
            self.plugin._select_reaction_after(param)
        except Exception:
            return
        try:
            self.plugin._sync_after_choice(param, pending)
        except Exception:
            pass

class _ReactionsRenderHook(MethodHook):
    def __init__(self, plugin: "VirtualPremiumReactionsPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            self.plugin._render_hook(param)
        except Exception:
            pass

    def after_hooked_method(self, param):
        self.plugin._sync_render(param)

class _ReactionPreviewHook(MethodHook):
