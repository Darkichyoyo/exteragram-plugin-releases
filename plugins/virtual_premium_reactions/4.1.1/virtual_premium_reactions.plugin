class _PickerHook(MethodHook):
    def __init__(self, plugin: "VirtualPremiumReactionsPlugin"):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            plugin = self.plugin
            if plugin._direct_capture_from_panel(param):
                return

            if plugin._cfg.get("capture") and plugin._capture_from_panel(param):
                return
            if plugin._cfg.get("enabled"):
                plugin._client_premium_emoji_before(param)
        except Exception:
            pass

