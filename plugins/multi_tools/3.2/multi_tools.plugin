_reflect_cache = {}


def num(value, default=0):
    if value is None:
        return default
    if isinstance(value, bool):
        return int(value)
    if isinstance(value, (int, float)):
        return value
    for name in ("longValue", "intValue", "doubleValue", "floatValue"):
        try:
            return getattr(value, name)()
        except Exception:
            continue
    try:
        return int(str(value))
    except Exception:
        return default


def java_class(name):
    cached = _reflect_cache.get(("class", name))
    if cached is not None:
        return cached
    clazz = None
    try:
        from java.lang import Class
        from org.telegram.messenger import ApplicationLoader
        loader = ApplicationLoader.applicationContext.getClassLoader()
        clazz = Class.forName(name, False, loader)
    except Exception:
        try:
            from java.lang import Class
            clazz = Class.forName(name)
        except Exception:
            clazz = None
    if clazz is not None:
        _reflect_cache[("class", name)] = clazz
    return clazz


def java_field(class_name, field_name):
    key = ("field", class_name, field_name)
    if key in _reflect_cache:
        return _reflect_cache[key]
    field = None
    try:
        clazz = java_class(class_name)
        while clazz is not None and field is None:
            try:
                field = clazz.getDeclaredField(field_name)
                field.setAccessible(True)
            except Exception:
                field = None
                clazz = clazz.getSuperclass()
    except Exception:
        field = None
    _reflect_cache[key] = field
    return field


def controller_account(obj):
    try:
        field = java_field("org.telegram.messenger.BaseController", "currentAccount")
        if field is not None:
            return int(field.getInt(obj))
    except Exception:
        pass
    try:
        return int(obj.getCurrentAccount())
    except Exception:
        return int(UserConfig.selectedAccount)


def ids_of(array):
    result = []
    if array is None:
        return result
    try:
        size = int(array.size())
        for i in range(size):
            item = array.get(i)
            if item is not None:
                result.append(int(num(item)))
    except Exception:
        try:
            for item in array:
                if item is not None:
                    result.append(int(num(item)))
        except Exception:
            pass
    return result


def int_list(values):
    array = ArrayList()
    for value in values:
        array.add(Integer(int(value)))
    return array


def range_active():
    return bool(getattr(_dm_tls, "range", 0))


class DeletedStore(object):
    def __init__(self):
        self._data = {}
        self._scope_revision = {}
        self._lock = threading.RLock()
        self._io_lock = threading.Lock()
        self._timer = None
        self._timer_generation = 0
        self._closed = False
        self._path = None
        self.loaded = False
        self.read_only = False
        self.last_error = None

    def path(self):
        if self._path is None:
            import os
            try:
                from org.telegram.messenger import ApplicationLoader
                base = str(ApplicationLoader.getFilesDirFixed().getAbsolutePath())
            except Exception:
                base = os.path.dirname(os.path.abspath(__file__))
            self._path = os.path.join(base, DM_FILE)
        return self._path

    def load(self):
        with self._io_lock, self._lock:
            self._invalidate_timer_locked()
            self._closed = False
            self._data = {}
            self._scope_revision = {}
            self.read_only = False
            self.last_error = None
            path = self.path()
            try:
                try:
                    fh = open(path, "r", encoding="utf-8")
                except FileNotFoundError:
                    fh = None
                if fh is not None:
                    with fh:
                        raw = json.load(fh)
                    if not isinstance(raw, dict):
                        raise ValueError("Invalid marker store root")
                    data = {}
                    for acc, dialogs in raw.items():
                        if not isinstance(dialogs, dict):
                            raise ValueError("Invalid marker store account")
                        for did, mids in dialogs.items():
                            if not isinstance(mids, list):
                                raise ValueError("Invalid marker store dialog")
                            bucket = data.setdefault(int(acc), {}).setdefault(int(did), set())
                            bucket.update(int(m) for m in mids)
                    self._data = data
            except Exception as exc:
                self._data = {}
                self.read_only = True
                self.last_error = type(exc).__name__
            self.loaded = True

    @staticmethod
    def _payload(data):
        return {str(a): {str(d): sorted(m) for d, m in dialogs.items() if m}
                for a, dialogs in data.items()}

    def _write_payload(self, payload):
        import os
        import tempfile
        path = self.path()
        tmp = None
        try:
            with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", delete=False,
                                             dir=os.path.dirname(path), prefix=".mt-deleted-", suffix=".tmp") as fh:
                tmp = fh.name
                json.dump(payload, fh, separators=(",", ":"))
                fh.flush()
                os.fsync(fh.fileno())
            os.replace(tmp, path)
            tmp = None
            self.last_error = None
        except Exception as exc:
            self.last_error = type(exc).__name__
            raise
        finally:
            if tmp is not None:
                try:
                    os.remove(tmp)
                except OSError:
                    pass

    def _invalidate_timer_locked(self):
        self._timer_generation += 1
        timer, self._timer = self._timer, None
        if timer is not None:
            try:
                timer.cancel()
            except Exception:
                pass

    def _write_current_locked(self):
        if self.read_only:
            self.last_error = "ReadOnly"
            return False
        try:
            self._write_payload(self._payload(self._data))
            return True
        except Exception:
            return False

    def close(self):
        with self._io_lock, self._lock:
            if self._closed:
                return False
            self._closed = True
            self._invalidate_timer_locked()
            return self._write_current_locked()

    def _flush(self, generation=None):
        with self._io_lock:
            with self._lock:
                if self._closed:
                    return False
                if generation is not None:
                    if generation != self._timer_generation or self._timer is None:
                        return False
                    self._timer = None
                return self._write_current_locked()

    def save_later(self):
        with self._lock:
            if self._closed or self._timer is not None:
                return
            self._timer_generation += 1
            generation = self._timer_generation
            timer = threading.Timer(2.0, lambda: self._flush(generation))
            timer.daemon = True
            self._timer = timer
            try:
                timer.start()
            except Exception:
                self._invalidate_timer_locked()
                raise

    def flush_now(self):
        with self._lock:
            if self._closed:
                return False
            self._invalidate_timer_locked()
        return self._flush()

    def add(self, account, dialog_id, mids):
        account, dialog_id = int(account), int(dialog_id)
        with self._io_lock:
            with self._lock:
                if self._closed:
                    raise OSError("Deleted marker store is closed")
                if self.read_only:
                    self.last_error = "ReadOnly"
                    raise OSError("Deleted marker store is read-only")
                bucket = set(self._data.get(account, {}).get(dialog_id, set()))
                added = []
                for value in mids:
                    mid = int(value)
                    if mid > 0 and mid not in bucket:
                        bucket.add(mid)
                        added.append(mid)
                if not added:
                    return []
                candidate = dict(self._data)
                dialogs = dict(candidate.get(account, {}))
                dialogs[dialog_id] = bucket
                candidate[account] = dialogs
                self._write_payload(self._payload(candidate))
                self._data = candidate
                scope = (account, dialog_id)
                self._scope_revision[scope] = self._scope_revision.get(scope, 0) + 1
                return added

    def _restore_pending(self, account, dialog_id, mids):
        account, dialog_id = int(account), int(dialog_id)
        restored = {int(mid) for mid in mids if int(mid) > 0}
        if not restored:
            return
        with self._lock:
            if self._closed:
                return False
            bucket = set(self._data.get(account, {}).get(dialog_id, ()))
            bucket.update(restored)
            candidate = dict(self._data)
            dialogs = dict(candidate.get(account, {}))
            dialogs[dialog_id] = bucket
            candidate[account] = dialogs
            self._data = candidate
            scope = (account, dialog_id)
            self._scope_revision[scope] = self._scope_revision.get(scope, 0) + 1

    def has(self, account, dialog_id, mid):
        dialogs = self._data.get(account)
        if not dialogs:
            return False
        bucket = dialogs.get(dialog_id)
        return bool(bucket) and mid in bucket

    def any_for(self, account):
        return bool(self._data.get(account))

    def remove(self, account, dialog_id, mids):
        changed = False
        with self._lock:
            if self._closed:
                return False
            bucket = self._data.get(int(account), {}).get(int(dialog_id))
            if bucket:
                for mid in mids:
                    if mid in bucket:
                        bucket.discard(mid)
                        changed = True
                if not bucket:
                    self._data[int(account)].pop(int(dialog_id), None)
            if changed:
                scope = (int(account), int(dialog_id))
                self._scope_revision[scope] = self._scope_revision.get(scope, 0) + 1
        if changed:
            self.save_later()

    def snapshot(self):
        with self._lock:
            return [(a, d, sorted(m)) for a, dialogs in self._data.items() for d, m in dialogs.items() if m]

    def clear(self):
        with self._lock:
            if self._closed:
                return False
            for account, dialogs in self._data.items():
                for dialog_id in dialogs:
                    scope = (account, dialog_id)
                    self._scope_revision[scope] = self._scope_revision.get(scope, 0) + 1
            self._data = {}
        self.save_later()

    def total(self):
        with self._lock:
            return sum(len(m) for dialogs in self._data.values() for m in dialogs.values())

    def page(self, account, dialog_id, edge=None, direction='older', limit=50):
        import heapq
        if direction not in ('older', 'newer') or not 1 <= int(limit) <= 500:
            raise ValueError('invalid page request')
        with self._lock:
            bucket = self._data.get(int(account), {}).get(int(dialog_id), ())
            if direction == 'older':
                choices = (m for m in bucket if edge is None or m < int(edge))
                picked = heapq.nlargest(int(limit) + 1, choices)
                more = len(picked) > limit
                return sorted(picked[:limit]), more
            if edge is None:
                raise ValueError('newer page requires an edge')
            choices = (m for m in bucket if m > int(edge))
            picked = heapq.nsmallest(int(limit) + 1, choices)
            return picked[:limit], len(picked) > limit


_IDENT = []


def ident(view):
    if not _IDENT:
        from java.lang import System
        _IDENT.append(System)
    return int(_IDENT[0].identityHashCode(view))


def make_hook(plugin, kind, returns_value=False):
    from base_plugin import MethodHook

    class _BeforeHook(MethodHook):
        def before_hooked_method(self, param):
            try:
                plugin._dm_before(kind, param, returns_value)
            except Exception:
                pass

    class _AfterHook(MethodHook):
        def after_hooked_method(self, param):
            try:
                plugin._dm_after(kind, param)
            except Exception:
                pass

    class _BothHook(_BeforeHook):
        def after_hooked_method(self, param):
            try:
                plugin._dm_after(kind, param)
            except Exception:
                pass

    if kind in DM_UI_KINDS or kind in ("journal_view", "own_range_ids"):
        return _AfterHook()
    if kind in DM_AFTER_KINDS:
        return _BothHook()
    return _BeforeHook()


RELEASES_BASE = "https://raw.githubusercontent.com/Darkichyoyo/exteragram-plugin-releases/main/"
MANIFEST_URL = RELEASES_BASE + "releases.json"
API_CONTENTS_BASE = "https://api.github.com/repos/Darkichyoyo/exteragram-plugin-releases/contents/"
API_REF = "main"
MAX_MANIFEST_BYTES = 64 * 1024
MAX_PLUGIN_BYTES = 2 * 1024 * 1024
BUSY_TIMEOUT_SECONDS = 180
INSTALL_RESPONSE_TIMEOUT_SECONDS = 90
STALE_TEMP_SECONDS = 600
TEMP_PREFIX = "eg_update_"


def _default_schedule(delay, fn):
    timer = threading.Timer(delay, fn)
    timer.daemon = True
    timer.start()
    return timer
_VERSION = re.compile(r"[0-9]{1,6}(\.[0-9]{1,6}){0,3}")
_SHA = re.compile(r"[0-9a-f]{64}")


class UpdateError(Exception):
    pass


def parse_version(text):
    if not isinstance(text, str) or not _VERSION.fullmatch(text):
        raise UpdateError("Некорректный формат версии")
    parts = tuple(int(p) for p in text.split("."))
    return parts + (0,) * (4 - len(parts))


class ReleaseInfo:
    def __init__(self, plugin_id, version, url, sha256, size):
        self.plugin_id, self.version, self.url, self.sha256, self.size = plugin_id, version, url, sha256, size


def parse_manifest(raw, plugin_id):
    try:
        data = json.loads(raw.decode("utf-8") if isinstance(raw, (bytes, bytearray)) else raw)
    except (ValueError, UnicodeDecodeError):
        raise UpdateError("Манифест обновлений повреждён")
    if not isinstance(data, dict) or data.get("schema") != 1 or not isinstance(data.get("plugins"), dict):
        raise UpdateError("Неподдерживаемый формат манифеста")
    entry = data["plugins"].get(plugin_id)
    if entry is None:
        return None
    if not isinstance(entry, dict):
        raise UpdateError("Некорректная запись манифеста")
    version, url, digest, size = (entry.get(k) for k in ("version", "url", "sha256", "size"))
    parse_version(version)
    if not (isinstance(url, str) and url.startswith(RELEASES_BASE) and url.endswith(".plugin")
            and ".." not in url and len(url) < 300):
        raise UpdateError("Адрес файла обновления не из доверенного репозитория")
    if not (isinstance(digest, str) and _SHA.fullmatch(digest)):
        raise UpdateError("Некорректная контрольная сумма в манифесте")
    if not (isinstance(size, int) and not isinstance(size, bool) and 0 < size <= MAX_PLUGIN_BYTES):
        raise UpdateError("Некорректный размер файла в манифесте")
    return ReleaseInfo(plugin_id, version, url, digest, size)


def read_plugin_metadata(source):
    try:
        tree = ast.parse(source)
    except (SyntaxError, ValueError):
        raise UpdateError("Файл обновления не является корректным Python")
    found = {}
    for node in tree.body:
        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
            name = node.targets[0].id
            if name in ("__id__", "__version__") and isinstance(node.value, ast.Constant) \
                    and isinstance(node.value.value, str):
                found[name] = node.value.value
    return found.get("__id__"), found.get("__version__")


def verify_payload(payload, info, current_id, current_version, stage=None):
    stage = stage or (lambda *_args, **_kwargs: None)
    if len(payload) != info.size:
        raise UpdateError("Размер файла не совпал с манифестом")
    stage("verify.size", "OK", bytes=len(payload))
    digest = hashlib.sha256(payload).hexdigest()
    if digest != info.sha256:
        raise UpdateError("Контрольная сумма SHA-256 не совпала")
    stage("verify.sha256", "OK", sha256=digest[:12])
    try:
        source = payload.decode("utf-8")
    except UnicodeDecodeError:
        raise UpdateError("Файл обновления не в UTF-8")
    file_id, file_version = read_plugin_metadata(source)
    if file_id != current_id or info.plugin_id != current_id:
        raise UpdateError("Идентификатор плагина в файле не совпал")
    if file_version != info.version:
        raise UpdateError("Версия в файле не совпала с манифестом")
    stage("verify.metadata", "OK", id=file_id, version=file_version)
    return source


class UpdateController:
    def __init__(self, plugin_id, version, http_get, install, notify, confirm, background, log=None,
                 clock=time.monotonic, tmp_root=None, source=None, schedule=None, wall_clock=time.time):
        parse_version(version)
        self.plugin_id, self.version = plugin_id, version
        self._http_get, self._install, self._notify = http_get, install, notify
        self._confirm, self._background = confirm, background
        self._log = log or (lambda *_args, **_kwargs: None)
        self._clock, self._tmp_root = clock, tmp_root
        self._lock = threading.Lock()
        self._operation = None
        self._phase = None
        self._busy_since = None
        self._source = source
        self._schedule = schedule or _default_schedule
        self._wall = wall_clock

    def _enter(self):
        with self._lock:
            now = self._clock()
            if self._phase == "handoff" or (self._busy_since is not None and
                    now - self._busy_since < BUSY_TIMEOUT_SECONDS):
                return None
            operation = object()
            self._operation, self._phase = operation, "check"
            self._busy_since = now
            return operation

    def _current(self, operation):
        with self._lock:
            return self._operation is operation

    def _transition(self, operation, before, after):
        with self._lock:
            if self._operation is not operation or self._phase != before:
                return False
            self._phase = after
            self._busy_since = self._clock()
            return True

    def _leave(self, operation):
        with self._lock:
            if self._operation is not operation:
                return False
            self._operation, self._phase = None, None
            self._busy_since = None
            return True

    def _stage(self, stage, result, level="INFO", **details):
        try:
            self._log(stage, result, level, details)
        except Exception:
            pass

    def _fetch(self, stage, url, max_bytes):
        started = self._clock()
        try:
            raw = self._http_get(url, max_bytes)
        except Exception as exc:
            reason = str(exc) if isinstance(exc, UpdateError) else type(exc).__name__
            self._stage(stage, "FAILED", "ERROR", reason=reason, ms=int((self._clock() - started) * 1000))
            raise
        try:
            host = str(self._source()) if self._source is not None else "injected"
        except Exception:
            host = "unknown"
        self._stage(stage, "OK", bytes=len(raw), limit=max_bytes, ms=int((self._clock() - started) * 1000),
                    host=host)
        return raw

    def check(self, *_args):
        operation = self._enter()
        if operation is None:
            self._stage("check", "IGNORED_BUSY", "WARN")
            self._notify("Проверка или установка уже выполняется")
            return
        self._stage("check", "STARTED", installed=self.version)
        try:
            self._background(lambda: self._check_work(operation))
        except Exception as exc:
            self._leave(operation)
            self._stage("check", "NOT_STARTED", "ERROR", reason=type(exc).__name__)
            self._notify("Проверка не запущена: " + type(exc).__name__, True)

    def find_update(self):
        try:
            raw = self._fetch("manifest.fetch", MANIFEST_URL, MAX_MANIFEST_BYTES)
        except UpdateError:
            raise
        except Exception as exc:
            raise UpdateError("Не удалось получить манифест: " + type(exc).__name__)
        if len(raw) > MAX_MANIFEST_BYTES:
            self._stage("manifest.parse", "FAILED", "ERROR", reason="too large", bytes=len(raw))
            raise UpdateError("Манифест слишком большой")
        try:
            info = parse_manifest(raw, self.plugin_id)
        except UpdateError as exc:
            self._stage("manifest.parse", "FAILED", "ERROR", reason=str(exc))
            raise
        if info is None:
            self._stage("manifest.parse", "NO_ENTRY", "WARN", plugin=self.plugin_id)
            return None
        self._stage("manifest.parse", "OK", remote=info.version, size=info.size, sha256=info.sha256[:12])
        newer = parse_version(info.version) > parse_version(self.version)
        self._stage("version.compare", "NEWER" if newer else "NOT_NEWER", installed=self.version,
                    remote=info.version)
        return info if newer else None

    def _check_work(self, operation):
        if not self._current(operation):
            return
        try:
            info = self.find_update()
        except UpdateError as exc:
            if not self._leave(operation):
                return
            self._notify(str(exc), True)
            return
        except Exception as exc:
            if not self._leave(operation):
                return
            self._stage("check", "CRASHED", "ERROR", reason=type(exc).__name__)
            self._notify("Проверка не выполнена: " + type(exc).__name__, True)
            return
        if info is None:
            if not self._leave(operation):
                return
            self._stage("check", "UP_TO_DATE", installed=self.version)
            self._notify(f"Установлена последняя версия ({self.version})")
            return
        if not self._transition(operation, "check", "confirm"):
            return
        self._stage("confirm", "SHOWN", remote=info.version)

        def declined():
            if not self._transition(operation, "confirm", "declined"):
                return
            self._stage("confirm", "DECLINED")
            self._leave(operation)
        try:
            self._confirm(info, lambda: self.start_install(info, operation), declined)
        except Exception as exc:
            self._leave(operation)
            self._stage("confirm", "FAILED", "ERROR", reason=type(exc).__name__)
            self._notify("Диалог обновления не открыт: " + type(exc).__name__, True)

    def start_install(self, info, operation):
        if not self._transition(operation, "confirm", "install"):
            return
        self._stage("confirm", "ACCEPTED", remote=info.version)
        try:
            self._background(lambda: self._install_work(info, operation))
        except Exception as exc:
            self._leave(operation)
            self._notify("Установка не запущена: " + type(exc).__name__, True)

    def _sweep_stale(self):
        root = self._tmp_root or tempfile.gettempdir()
        removed = 0
        try:
            names = os.listdir(root)
        except OSError:
            return
        now = self._wall()
        for name in names:
            path = os.path.join(root, name)
            try:
                if (name.startswith(TEMP_PREFIX) and os.path.isdir(path)
                        and now - os.path.getmtime(path) > STALE_TEMP_SECONDS):
                    shutil.rmtree(path, ignore_errors=True)
                    removed += 1
            except OSError:
                continue
        if removed:
            self._stage("install.cleanup", "STALE_REMOVED", count=removed)

    def _install_work(self, info, operation):
        if not self._current(operation):
            return
        directory = None
        try:
            self._sweep_stale()
            payload = self._fetch("download", info.url, min(info.size, MAX_PLUGIN_BYTES))
            try:
                verify_payload(payload, info, self.plugin_id, self.version, self._stage)
            except UpdateError as exc:
                self._stage("verify", "FAILED", "ERROR", reason=str(exc))
                raise
            if parse_version(info.version) <= parse_version(self.version):
                raise UpdateError("Версия не новее установленной")
            directory = tempfile.mkdtemp(prefix=TEMP_PREFIX, dir=self._tmp_root)
            path = os.path.join(directory, self.plugin_id + ".plugin")
            with open(path, "xb") as output:
                output.write(payload)
            self._stage("install.handoff", "STARTED", note="file verified; passing to plugin engine")
        except UpdateError as exc:
            self._finish(directory, False, str(exc), operation)
            return
        except Exception as exc:
            self._finish(directory, False, "Скачивание не выполнено: " + type(exc).__name__, operation)
            return
        if not self._transition(operation, "install", "handoff"):
            shutil.rmtree(directory, ignore_errors=True)
            return
        state = {"done": False, "timed_out": False}
        guard = threading.Lock()

        def outcome(result):
            if result is None:
                return True, f"Движок подтвердил установку версии {info.version}"
            first = str(result).strip().splitlines()[0][:120] if str(result).strip() else "без описания"
            return False, "Установка не выполнена движком: " + first

        def callback(result):
            with guard:
                if state["done"]:
                    return
                state["done"] = True
                late = state["timed_out"]
            ok, message = outcome(result)
            if not late:
                self._finish(directory, ok, message, operation)
                return
            shutil.rmtree(directory, ignore_errors=True)
            self._stage("install.result", "LATE_OK" if ok else "LATE_FAILED", "INFO" if ok else "ERROR",
                        message=message[:160])
            self._notify(message, not ok)

        def no_response():
            with guard:
                if state["done"] or state["timed_out"]:
                    return
                state["timed_out"] = True
            self._leave(operation)
            self._stage("install.result", "NO_RESPONSE", "WARN", waited_s=INSTALL_RESPONSE_TIMEOUT_SECONDS,
                        note="request sent, installation NOT confirmed; temp file kept for the engine")
            self._notify(f"Установщик не ответил за {INSTALL_RESPONSE_TIMEOUT_SECONDS} с — установка не "
                         "подтверждена. Проверьте версию в списке плагинов.", True)

        try:
            route = self._install(path, callback)
            self._stage("install.handoff", "RETURNED", route=str(route), callback_received=state["done"],
                        note="request handed over; this is not an installation result")
        except Exception as exc:
            with guard:
                if state["done"]:
                    return
                state["done"] = True
            self._finish(directory, False, "Установщик недоступен: " + type(exc).__name__, operation)
            return
        self._transition(operation, "handoff", "waiting")
        with guard:
            waiting = not state["done"]
        if waiting:
            try:
                self._schedule(INSTALL_RESPONSE_TIMEOUT_SECONDS, no_response)
            except Exception as exc:
                self._stage("install.watchdog", "NOT_STARTED", "ERROR", reason=type(exc).__name__)

    def _finish(self, directory, ok, message, operation):
        if directory:
            shutil.rmtree(directory, ignore_errors=True)
        self._leave(operation)
        self._stage("install.result", "OK" if ok else "FAILED", "INFO" if ok else "ERROR", message=message[:160])
        self._notify(message, not ok)


def no_cache_url(url, now=None):
    if url != MANIFEST_URL:
        return url
    stamp = int((time.time() if now is None else now) * 1000)
    return f"{url}?nocache={stamp}"


def api_url(url):
    if not url.startswith(RELEASES_BASE):
        return None
    path = url[len(RELEASES_BASE):]
    if not path or ".." in path or "?" in path or "#" in path:
        return None
    return API_CONTENTS_BASE + path + "?ref=" + API_REF


class UpdaterBindings:
    def __init__(self):
        self.last_source = "none"

    def http_get(self, url, max_bytes):
        if not url.startswith("https://"):
            raise UpdateError("Допускается только HTTPS")
        primary = api_url(url)
        if primary is not None:
            try:
                data = self._get(primary, max_bytes, api=True)
                self.last_source = "api.github.com"
                return data
            except Exception as exc:
                reason = str(exc) if isinstance(exc, UpdateError) else type(exc).__name__
                data = self._get(url, max_bytes)
                self.last_source = "raw.githubusercontent.com (api: " + reason[:60] + ")"
                return data
        data = self._get(url, max_bytes)
        self.last_source = "raw.githubusercontent.com"
        return data

    def _get(self, url, max_bytes, api=False):
        from java.net import URL
        conn = URL(url if api else no_cache_url(url)).openConnection()
        if api:
            conn.setRequestProperty("Accept", "application/vnd.github.raw")
            conn.setRequestProperty("X-GitHub-Api-Version", "2022-11-28")
        conn.setUseCaches(False)
        conn.setRequestProperty("Cache-Control", "no-cache")
        conn.setRequestProperty("Pragma", "no-cache")
        conn.setInstanceFollowRedirects(False)
        conn.setConnectTimeout(10000)
        conn.setReadTimeout(20000)
        conn.setRequestProperty("User-Agent", "exteragram-plugin-updater/1")
        stream, chunks, total = None, [], 0
        try:
            code = conn.getResponseCode()
            if code != 200:
                raise UpdateError(f"Сервер ответил HTTP {code}")
            stream = conn.getInputStream()
            from java import jarray, jbyte
            buffer = jarray(jbyte)(8192)
            while True:
                count = stream.read(buffer)
                if count < 0:
                    break
                total += count
                if total > max_bytes:
                    raise UpdateError("Ответ сервера больше допустимого размера")
                chunks.append(bytes(bytearray(b & 0xFF for b in buffer[:count])))
        finally:
            if stream is not None:
                try:
                    stream.close()
                except Exception:
                    pass
            conn.disconnect()
        return b"".join(chunks)

    def install(self, path, callback):
        from java import dynamic_proxy, jclass
        Utilities = jclass("org.telegram.messenger.Utilities")
        PluginsController = jclass("com.exteragram.messenger.plugins.PluginsController")

        class Result(dynamic_proxy(Utilities.Callback)):
            def run(self, arg):
                callback(None if arg is None else str(arg))

        proxy = Result()
        controller = PluginsController.getInstance()
        engine = None
        try:
            engine = controller.engines.get("python")
        except Exception:
            engine = None
        if engine is not None:
            try:
                engine.loadPluginFromFile(path, None, proxy)
                return "engine"
            except TypeError:
                pass
        controller.loadPluginFromFile(path, proxy)
        return "controller"


def _upd_background(fn):
    thread = threading.Thread(target=fn, name="multi_tools-updater")
    thread.daemon = True
    thread.start()


def _upd_notify(text, error=False):
    (toast_err if error else toast_info)(text)


def show_update_sheet(context, title, versions, note, button, decision):
    from java import dynamic_proxy
    from android.content import DialogInterface
    from android.graphics.drawable import GradientDrawable
    from android.view import Gravity, View
    from android.widget import LinearLayout, TextView
    from org.telegram.ui.ActionBar import BottomSheet, Theme
    density = context.getResources().getDisplayMetrics().density
    dp = lambda v: int(density * v + 0.5)

    def color(name, default):
        try:
            return Theme.getColor(getattr(Theme, name))
        except Exception:
            return default

    def signed(argb):
        argb &= 0xFFFFFFFF
        return argb - (1 << 32) if argb >= (1 << 31) else argb

    def with_alpha(value, alpha):
        return signed((alpha << 24) | (value & 0xFFFFFF))

    def readable_on(value):
        red, green, blue = (value >> 16) & 255, (value >> 8) & 255, value & 255
        return signed(0xFF1B1B1B) if (0.299 * red + 0.587 * green + 0.114 * blue) > 150 else -1

    def rounded(fill, radius):
        shape = GradientDrawable()
        shape.setColor(fill)
        shape.setCornerRadius(float(dp(radius)))
        return shape

    sheet = BottomSheet(context, False)

    class Click(dynamic_proxy(View.OnClickListener)):
        def __init__(self, action):
            super().__init__()
            self.action = action

        def onClick(self, view):
            self.action(view)

    class Dismissed(dynamic_proxy(DialogInterface.OnDismissListener)):
        def onDismiss(self, dialog):
            decision.close()

    def text_view(text, size, text_color):
        view = TextView(context)
        view.setText(text)
        view.setTextSize(size)
        view.setTextColor(text_color)
        return view

    main_color = color("key_windowBackgroundWhiteBlackText", -1)
    gray_color = color("key_windowBackgroundWhiteGrayText2", -5592406)
    accent = color("key_featuredStickers_addButton", -14443544)

    root = LinearLayout(context)
    root.setOrientation(LinearLayout.VERTICAL)
    root.setPadding(dp(20), dp(10), dp(20), dp(20))
    info = LinearLayout(context)
    info.setOrientation(LinearLayout.VERTICAL)
    info.setClickable(True)
    handle = View(context)
    handle.setBackground(rounded(with_alpha(gray_color, 0x80), 2))
    handle_params = LinearLayout.LayoutParams(dp(36), dp(4))
    handle_params.gravity = Gravity.CENTER_HORIZONTAL
    info.addView(handle, handle_params)

    heading = text_view(title, 22, main_color)
    try:
        from org.telegram.messenger import AndroidUtilities
        heading.setTypeface(AndroidUtilities.bold())
    except Exception:
        pass
    heading_params = LinearLayout.LayoutParams(-2, -2)
    heading_params.topMargin = dp(18)
    info.addView(heading, heading_params)

    chip = text_view(versions, 14, accent)
    chip.setPadding(dp(10), dp(4), dp(10), dp(4))
    chip.setBackground(rounded(with_alpha(accent, 0x2E), 10))
    chip_params = LinearLayout.LayoutParams(-2, -2)
    chip_params.topMargin = dp(10)
    info.addView(chip, chip_params)

    note_view = text_view(note, 14, gray_color)
    note_params = LinearLayout.LayoutParams(-1, -2)
    note_params.topMargin = dp(10)
    note_params.bottomMargin = dp(18)
    info.addView(note_view, note_params)
    root.addView(info, LinearLayout.LayoutParams(-1, -2))

    action = text_view(button, 16, readable_on(accent))
    action.setGravity(Gravity.CENTER)
    action.setBackground(rounded(accent, 14))
    action.setClickable(True)
    try:
        from org.telegram.messenger import AndroidUtilities
        action.setTypeface(AndroidUtilities.bold())
    except Exception:
        pass
    root.addView(action, LinearLayout.LayoutParams(-1, dp(52)))

    def on_download(view):
        if decision.download():
            view.setEnabled(False)
            sheet.dismiss()

    def on_info(view):
        decision.close()
        sheet.dismiss()

    action.setOnClickListener(Click(on_download))
    info.setOnClickListener(Click(on_info))
    sheet.setCustomView(root)
    sheet.setOnDismissListener(Dismissed())
    sheet.show()


class UpdateSheetDecision:
    def __init__(self, accepted, declined):
        self._accepted, self._declined = accepted, declined
        self._lock, self._decided = threading.Lock(), False

    def _take(self):
        with self._lock:
            if self._decided:
                return False
            self._decided = True
            return True

    def download(self):
        if not self._take():
            return False
        self._accepted()
        return True

    def close(self):
        if not self._take():
            return False
        self._declined()
        return True


def _upd_confirm(current):
    def confirm(info, accepted, declined):
        def show():
            decision = UpdateSheetDecision(accepted, declined)
            try:
                fragment = get_last_fragment()
                activity = fragment.getParentActivity() if fragment is not None else None
                if activity is None:
                    raise RuntimeError("no activity")
            except Exception as exc:
                decision.close()
                _upd_notify("Диалог обновления не открыт: " + type(exc).__name__, True)
                return
            try:
                show_update_sheet(activity, "Доступно обновление", "%s → %s" % (current, info.version),
                                  "Перед установкой файл будет проверен.", "Скачать", decision)
                return
            except Exception:
                pass
            try:
                def close(dialog):
                    try:
                        dialog.dismiss()
                    except Exception:
                        pass

                def yes(dialog, _which):
                    close(dialog)
                    decision.download()

                def no(dialog, _which):
                    close(dialog)
                    decision.close()

                builder = AlertDialogBuilder(activity)
                builder.set_title("Доступно обновление")
                builder.set_message("Версия %s → %s. Файл будет скачан, проверен (SHA-256, ID, версия) "
                                    "и передан движку плагинов для установки." % (current, info.version))
                builder.set_positive_button("Установить", yes)
                builder.set_negative_button("Отмена", no)
                builder.set_cancelable(False)
                builder.show()
            except Exception as exc:
                decision.close()
                _upd_notify("Диалог обновления не открыт: " + type(exc).__name__, True)
        ui(show)
    return confirm


def build_updater(plugin_id, version, log=None):
    android = UpdaterBindings()
    return UpdateController(plugin_id, version, android.http_get, android.install, _upd_notify,
                            _upd_confirm(version), _upd_background, log=log, source=lambda: android.last_source)


DM_MEDIA_SESSION_BYTES = 200 * 1024 * 1024
DM_MEDIA_PENDING = 32
DM_MEDIA_PARALLEL = 3
DM_MEDIA_RECENT = 512
DM_MEDIA_RECENT_TTL = 2 * 3600


ARCHIVE_KINDS = ("photo", "video", "round", "voice")


def clean_media_meta(meta):
    out = {}
    try:
        duration = meta.get("duration")
        if isinstance(duration, (int, float)) and not isinstance(duration, bool) and 0 < duration <= 86400:
            out["duration"] = float(duration)
        wave = meta.get("waveform")
        if isinstance(wave, str) and 0 < len(wave) <= 256 and len(wave) % 2 == 0 and re.fullmatch(r"[0-9a-f]+", wave):
            out["waveform"] = wave
    except Exception:
        pass
    return out


def dm_media_policy(kind, size, dialog_id, private_only, kinds, limit):
    return (kind in kinds and 0 < size <= limit and dialog_id != 0
            and (not private_only or dialog_id > 0) and not is_special_dialog(dialog_id))


class MediaDownloadQueue:
    def __init__(self, budget=DM_MEDIA_SESSION_BYTES):
        self.budget = budget
        self.used = 0
        self.pending = {}
        self.running = {}
        self.seen = {}

    def submit(self, key, task, reason):
        if task["size"] <= 0:
            return False
        if key in self.pending or key in self.running:
            return False
        previous = self.seen.get(key)
        if previous is not None and not (reason == "delete" and previous == ("receive", "failed")):
            return False
        if len(self.pending) >= DM_MEDIA_PENDING or self.used + task["size"] > self.budget:
            return False
        self.used += task["size"]
        self.pending[key] = (task, reason)
        self.seen[key] = (reason, "queued")
        while len(self.seen) > DM_MEDIA_RECENT:
            old = next((k for k in self.seen if k not in self.pending and k not in self.running), None)
            if old is None:
                break
            self.seen.pop(old)
        return True

    def take(self):
        if not self.pending or len(self.running) >= DM_MEDIA_PARALLEL:
            return None
        key = next(iter(self.pending))
        item = self.pending.pop(key)
        self.running[key] = item
        return key, item[0], item[1]

    def finish(self, key, success):
        item = self.running.pop(key, None)
        if item is not None:
            self.seen[key] = (item[1], "done" if success else "failed")
        return item

    def clear(self):
        self.pending.clear()
        self.running.clear()
        self.seen.clear()


class SingleMediaArchive:
    MAX_BYTES = 100 * 1024 * 1024
    MAX_ENTRIES = 100

    def __init__(self, root):
        self.root = os.path.abspath(root)
        self.lock = threading.RLock()
        self.closed = False
        if os.path.islink(self.root):
            raise OSError("Unsafe archive root")
        if os.path.isdir(self.root):
            for name in os.listdir(self.root):
                path = os.path.join(self.root, name)
                if name.startswith("pending-") and os.path.isdir(path) and not os.path.islink(path):
                    shutil.rmtree(path)
                elif name.startswith("view-") and name.endswith(".mp4") and os.path.isfile(path):
                    os.unlink(path)

    @staticmethod
    def key(owner, account, dialog_id, mid):
        if int(owner) <= 0 or not 0 <= int(account) < 32 or not int(dialog_id) or int(mid) <= 0:
            raise ValueError("Invalid archive scope")
        raw = "%d:%d:%d:%d" % (int(owner), int(account), int(dialog_id), int(mid))
        return hashlib.sha256(raw.encode("ascii")).hexdigest()

    def _folder(self, key):
        if not re.fullmatch(r"[0-9a-f]{64}", key):
            raise ValueError("Invalid archive key")
        if os.path.islink(self.root):
            raise OSError("Unsafe archive root")
        folder = os.path.join(self.root, key)
        if os.path.islink(folder):
            raise OSError("Unsafe archive entry")
        return folder

    def get(self, key):
        with self.lock:
            folder = self._folder(key)
            if not os.path.exists(folder):
                return None
            manifest = os.path.join(folder, "entry.json")
            if os.path.islink(manifest) or os.path.getsize(manifest) > 1024:
                raise OSError("Unsafe archive manifest")
            with open(manifest, "r", encoding="utf-8") as stream:
                meta = json.load(stream)
            if meta.get("kind") not in ARCHIVE_KINDS or type(meta.get("encrypted")) is not bool:
                raise ValueError("Invalid archive manifest")
            meta = dict(meta, **clean_media_meta(meta))
            for name in ("duration", "waveform"):
                if name in meta and name not in clean_media_meta(meta):
                    meta.pop(name)
            paths = [os.path.join(folder, "media.bin")]
            if meta["encrypted"]:
                paths.append(os.path.join(folder, "key.bin"))
            if any(os.path.islink(p) or not os.path.isfile(p) for p in paths):
                raise OSError("Archive file unavailable")
            size = os.path.getsize(paths[0])
            if not 0 < size <= self.MAX_BYTES or size != meta.get("size"):
                raise OSError("Archive size mismatch")
            if meta["encrypted"] and os.path.getsize(paths[1]) != 48:
                raise OSError("Archive key unavailable")
            return dict(meta, path=paths[0], key_path=paths[1] if meta["encrypted"] else None)

    def put(self, key, source, kind, key_source=None, limit=20 * 1024 * 1024, valid=lambda: True, meta=None):
        with self.lock:
            if self.closed or not valid():
                return False
            if self.get(key) is not None:
                return False
            if kind not in ARCHIVE_KINDS:
                raise ValueError("Unsupported media")
            size = os.path.getsize(source)
            if not 0 < size <= min(int(limit), self.MAX_BYTES):
                raise OverflowError("Archive media limit")
            if key_source is not None and os.path.getsize(key_source) != 48:
                raise OSError("Invalid local encryption key")
            os.makedirs(self.root, mode=0o700, exist_ok=True)
            os.chmod(self.root, 0o700)
            used, count = 0, 0
            for name in os.listdir(self.root):
                if re.fullmatch(r"[0-9a-f]{64}", name):
                    folder = self._folder(name)
                    if os.path.isdir(folder):
                        count += 1
            for directory, dirs, files in os.walk(self.root, followlinks=False):
                dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(directory, d))]
                for leaf in files:
                    path = os.path.join(directory, leaf)
                    if os.path.isfile(path) and not os.path.islink(path):
                        used += os.path.getsize(path)
            if count >= self.MAX_ENTRIES or used + size + 1024 > self.MAX_BYTES:
                raise OverflowError("Archive capacity reached")
            temp = tempfile.mkdtemp(prefix="pending-", dir=self.root)
            try:
                for src, leaf, expected in [(source, "media.bin", size)] + ([(key_source, "key.bin", 48)] if key_source else []):
                    target = os.path.join(temp, leaf)
                    with open(src, "rb") as inp, open(target, "xb") as out:
                        os.chmod(target, 0o600)
                        initial = os.fstat(inp.fileno())
                        copied = 0
                        while True:
                            chunk = inp.read(min(65536, expected - copied + 1))
                            if not chunk:
                                break
                            copied += len(chunk)
                            if copied > expected:
                                raise OSError("Source changed during capture")
                            out.write(chunk)
                        final = os.fstat(inp.fileno())
                        if copied != expected or (initial.st_size, initial.st_mtime_ns) != (final.st_size, final.st_mtime_ns):
                            raise OSError("Source incomplete during capture")
                        out.flush()
                        os.fsync(out.fileno())
                with open(os.path.join(temp, "entry.json"), "x", encoding="utf-8") as out:
                    os.chmod(out.name, 0o600)
                    json.dump(dict(clean_media_meta(meta or {}), kind=kind, encrypted=key_source is not None, size=size), out)
                    out.flush()
                    os.fsync(out.fileno())
                if self.closed or not valid():
                    return False
                os.rename(temp, self._folder(key))
                temp = None
                return True
            finally:
                if temp is not None:
                    shutil.rmtree(temp, ignore_errors=True)

    def remove(self, key):
        with self.lock:
            if self.closed:
                return
            folder = self._folder(key)
            if os.path.isdir(folder):
                shutil.rmtree(folder)

    def close(self):
        with self.lock:
            self.closed = True


def local_runnable(action):
    from java import dynamic_proxy
    from java.lang import Runnable
    class Task(dynamic_proxy(Runnable)):
        def run(self):
            action()
    return Task()


_NATIVE_CHAT_TYPES = None
_NATIVE_CHAT_ABI = {}


class NativeUIAPIError(RuntimeError):
    def __init__(self, stage):
        super().__init__('Unsupported native UI API')
        self.stage = stage


def native_signature(class_name, method, alternatives, constructor=False):
    clazz = java_class(class_name)
    if clazz is None:
        raise NativeUIAPIError('class_unavailable')
    members = clazz.getConstructors() if constructor else clazz.getMethods()
    available = set()
    for member in members:
        if constructor or str(member.getName()) == method:
            available.add(tuple(str(t.getName()) for t in member.getParameterTypes()))
    for signature in alternatives:
        if tuple(signature) in available:
            return list(signature)
    raise NativeUIAPIError(method if not constructor else 'cell_constructor')


def native_chat_types():
    global _NATIVE_CHAT_TYPES
    if _NATIVE_CHAT_TYPES is not None:
        return _NATIVE_CHAT_TYPES
    from extera_utils.classes import Base, java_subclass, joverride
    from java.lang import Object
    from org.telegram.ui.ActionBar import BaseFragment, ActionBar
    from org.telegram.ui.Cells import ChatMessageCell
    from org.telegram.ui.Components import RecyclerListView, SizeNotifierFrameLayout
    from androidx.recyclerview.widget import RecyclerView
    from org.telegram.ui import PhotoViewer
    cell_name = 'org.telegram.ui.Cells.ChatMessageCell'
    msg = 'org.telegram.messenger.MessageObject'
    group = msg + '$GroupedMessages'
    image_args = native_signature(cell_name + '$ChatMessageCellDelegate', 'didPressImage', [
        [cell_name, 'float', 'float', 'boolean'], [cell_name, 'float', 'float']])
    place_args = native_signature('org.telegram.ui.PhotoViewer$EmptyPhotoViewerProvider', 'getPlaceForPhoto', [
        [msg, 'org.telegram.tgnet.TLRPC$FileLocation', 'int', 'boolean', 'boolean'],
        [msg, 'org.telegram.tgnet.TLRPC$FileLocation', 'int', 'boolean']])
    _NATIVE_CHAT_ABI['cell_ctor'] = native_signature(cell_name, '', [
        ['android.content.Context', 'int'], ['android.content.Context']], True)
    _NATIVE_CHAT_ABI['bind'] = native_signature(cell_name, 'setMessageObject', [
        [msg, group, 'boolean', 'boolean', 'boolean'],
        [msg, group, 'boolean', 'boolean', 'boolean', 'boolean'],
        [msg, group, 'boolean', 'boolean']])
    _NATIVE_CHAT_ABI['open'] = native_signature('org.telegram.ui.PhotoViewer', 'openPhoto', [
        ['java.util.ArrayList', 'int', 'long', 'long', 'long', 'org.telegram.ui.PhotoViewer$PhotoViewerProvider'],
        ['java.util.ArrayList', 'int', 'long', 'long', 'int', 'org.telegram.ui.PhotoViewer$PhotoViewerProvider']])
    _NATIVE_CHAT_ABI['image_args'], _NATIVE_CHAT_ABI['place_args'] = len(image_args), len(place_args)
    try:
        play_args = native_signature(cell_name + '$ChatMessageCellDelegate', 'needPlayMessage', [
            [cell_name, msg, 'boolean'], [msg, 'boolean']])
    except NativeUIAPIError:
        play_args = None
    _NATIVE_CHAT_ABI['play'] = play_args

    @java_subclass(BaseFragment)
    class JournalFragment(Base):
        def __init__(self, state):
            self.state = state

        @joverride('createView', ['android.content.Context'])
        def createView(self, context):
            view = self.state.build(context)
            self.java.setFragmentView(view)
            return view

        @joverride('onResume', [])
        def onResume(self):
            super().onResume()
            self.state.resume()

        @joverride('onFragmentDestroy', [])
        def onFragmentDestroy(self):
            try:
                self.state.dispose()
            finally:
                super().onFragmentDestroy()

    @java_subclass(ActionBar.ActionBarMenuOnItemClick)
    class HeaderClick(Base):
        def __init__(self, state):
            self.state = state

        @joverride('onItemClick', ['int'])
        def onItemClick(self, item):
            self.state.action(int(item))

    @java_subclass(RecyclerListView.SelectionAdapter)
    class HistoryAdapter(Base):
        def __init__(self, state):
            self.state = state

        @joverride('getItemCount', [])
        def getItemCount(self):
            return len(self.state.items)

        @joverride('getItemViewType', ['int'])
        def getItemViewType(self, position):
            return 1 if self.state.items[int(position)]['type'] == 'message' else 2

        @joverride('isEnabled', ['androidx.recyclerview.widget.RecyclerView$ViewHolder'])
        def isEnabled(self, holder):
            return True

        @joverride('onCreateViewHolder', ['android.view.ViewGroup', 'int'])
        def onCreateViewHolder(self, parent, kind):
            return self.state.make_holder(parent, int(kind))

        @joverride('onBindViewHolder', ['androidx.recyclerview.widget.RecyclerView$ViewHolder', 'int'])
        def onBindViewHolder(self, holder, position):
            self.state.bind(holder, int(position))

        @joverride('onViewRecycled', ['androidx.recyclerview.widget.RecyclerView$ViewHolder'])
        def onViewRecycled(self, holder):
            self.state.recycle(holder)
            super().onViewRecycled(holder)

    @java_subclass(Object, ChatMessageCell.ChatMessageCellDelegate)
    class CellDelegate(Base):
        def __init__(self, state):
            self.state = state

        @joverride('canPerformActions', [])
        def canPerformActions(self):
            return self.state.live()

        @joverride('didPressImage', image_args)
        def didPressImage(self, cell, x, y, *extra):
            self.state.open_cell(cell)

        @joverride('didPressOther', ['org.telegram.ui.Cells.ChatMessageCell', 'float', 'float'])
        def didPressOther(self, cell, x, y):
            self.state.open_cell(cell)

        @joverride('didLongPress', ['org.telegram.ui.Cells.ChatMessageCell', 'float', 'float'])
        def didLongPress(self, cell, x, y):
            self.state.copy_cell(cell)

        if play_args is not None:
            @joverride('needPlayMessage', play_args)
            def needPlayMessage(self, *args):
                return bool(self.state.play_message(args[-2], args[0] if len(args) == 3 else None))

    @java_subclass(PhotoViewer.EmptyPhotoViewerProvider)
    class ViewerProvider(Base):
        def __init__(self, state, cell, entry):
            self.state, self.cell, self.entry = state, cell, entry

        @joverride('getPlaceForPhoto', place_args)
        def getPlaceForPhoto(self, message, location, index, preview, *extra):
            return self.state.photo_place(self.cell, self.entry, bool(preview))

        @joverride('willHidePhotoViewer', [])
        def willHidePhotoViewer(self):
            try:
                if self.cell is not None:
                    self.cell.getPhotoImage().setVisible(True, True)
            except Exception:
                pass

        @joverride('onClose', [])
        def onClose(self):
            self.state.viewer_closed(self)

        @joverride('loadMore', [])
        def loadMore(self):
            return True

        @joverride('onDeletePhoto', ['int'])
        def onDeletePhoto(self, index):
            return False

    try:
        @java_subclass(RecyclerView.OnScrollListener)
        class HistoryScroll(Base):
            def __init__(self, state):
                self.state = state

            @joverride('onScrolled', ['androidx.recyclerview.widget.RecyclerView', 'int', 'int'])
            def onScrolled(self, view, dx, dy):
                try:
                    self.state.on_scroll(int(dy))
                except Exception:
                    pass
    except Exception:
        HistoryScroll = None

    try:
        @java_subclass(SizeNotifierFrameLayout)
        class HistoryBackground(Base):
            @joverride('isActionBarVisible', [])
            def isActionBarVisible(self):
                return False
    except Exception:
        HistoryBackground = None

    _NATIVE_CHAT_TYPES = JournalFragment, HeaderClick, HistoryAdapter, CellDelegate, ViewerProvider, HistoryScroll, HistoryBackground
    return _NATIVE_CHAT_TYPES


class NativePageLeases:
    def __init__(self, first):
        self.leases = [first] if first is not None else []
    def add(self, lease):
        self.leases.append(lease)
    def close(self):
        leases, self.leases = self.leases, []
        for lease in leases:
            lease.close()


class NativeHistoryState:
    def __init__(self, plugin, token, rows, title, before=None, older=None, journal=False, lease=None):
        self.plugin, self.token, self.rows, self.title = plugin, token, rows, title
        self.before, self.older, self.journal = before, older, journal
        self.lease = NativePageLeases(lease)
        self.pages = [(rows, lease)]
        self.detached_pages = []
        self._reap_scheduled = False
        self.history_keys = set()
        self.page_loading = False
        self.manual_paging = False
        self.top_end = older is None
        self.bottom_end = before is None
        self.peer = self.header = self.list = self.adapter = self.delegate = self.root = None
        self.refs, self.items, self.bound = [], [], {}
        self._round_frozen = {}
        self.provider = self.viewer_object = None
        self.player_observer = None
        self.player_events = []
        self._player_tick_pending = False
        self._player_tick_generation = 0
        self._player_tick_last = None
        self.disposed = False
        self._compose()

    def _compose(self):
        self.items = []
        if self.manual_paging and self.older is not None:
            self.items.append({'type': 'older', 'text': 'Показать более ранние сообщения'})
        if self.manual_paging and self.before is not None:
            self.items.append({'type': 'newest', 'text': 'К последним сообщениям'})
        day = None
        for row in self.rows:
            stamp = int(row.get('date', 0))
            value = time.strftime('%d.%m.%Y', time.localtime(stamp)) if stamp > 0 else 'Дата недоступна'
            if value != day:
                self.items.append({'type': 'date', 'text': value})
                day = value
            if row.get('message') is None and row.get('local') is None:
                self.items.append({'type': 'unavailable', 'row': row, 'text': row.get('text') or 'Сообщение недоступно в локальной базе'})
            else:
                self.items.append({'type': 'message', 'row': row})
        if not self.rows:
            self.items.append({'type': 'date', 'text': 'Нет доступных сообщений'})

    def live(self):
        return not self.disposed and self.plugin._vj_live(self.token)

    def build(self, context):
        from android.view import Gravity
        from android.widget import FrameLayout
        from androidx.recyclerview.widget import LinearLayoutManager
        from org.telegram.messenger import R
        from org.telegram.ui.ActionBar import Theme
        from org.telegram.ui.Components import RecyclerListView, SizeNotifierFrameLayout, ChatAvatarContainer
        Fragment, Header, Adapter, Delegate, Provider, Scroll, Background = native_chat_types()
        fragment = self.peer.java
        bar = fragment.getActionBar()
        bar.setBackButtonImage(R.drawable.ic_ab_back)
        bar.setAllowOverlayTitle(True)
        bar.setBackgroundColor(self.plugin._dm_theme('key_actionBarDefault', -1))
        header_click = Header.new_instance(init_args=[self])
        bar.setActionBarMenuOnItemClick(header_click.java)
        self.header = ChatAvatarContainer(context, fragment, False)
        self.header.setTitle(self.title)
        if self.journal:
            self.header.setSubtitle('История · локальная копия')
        else:
            with self.plugin._dm_store._lock:
                total = len(self.plugin._dm_store._data.get(self.token[1], {}).get(self.token[2], ()))
            self.header.setSubtitle('Удалённые · %d меток' % total)
        self.header.setEnabled(False)
        account, did = self.token[1], self.token[2]
        if did > 0:
            user = self.plugin._get_user(account, did)
            if user is not None:
                self.header.setUserAvatar(user)
        else:
            chat = self.plugin._get_chat(account, -did)
            if chat is not None:
                self.header.setChatAvatar(chat)
        hp = FrameLayout.LayoutParams(-1, -1, Gravity.TOP | Gravity.LEFT)
        hp.leftMargin, hp.rightMargin = self.plugin._dm_dp(56), self.plugin._dm_dp(56)
        bar.addView(self.header, hp)
        if self.journal:
            bar.createMenu().addItem(1, R.drawable.msg_delete)
        try:
            if Background is None:
                raise RuntimeError('Background subclass unavailable')
            background_peer = Background.new_instance(context, init_args=[])
            self.refs.append(background_peer)
            root = background_peer.java
        except Exception:
            root = SizeNotifierFrameLayout(context)
        root.setOccupyStatusBar(False)
        root.setBackgroundColor(self.plugin._dm_theme('key_chat_wallpaper', -986896))
        wallpaper = Theme.getCachedWallpaperNonBlocking()
        if wallpaper is not None:
            root.setBackgroundImage(wallpaper, Theme.isWallpaperMotion())
        self.root = root
        self.list = RecyclerListView(context)
        self.list.setDrawSelection(False)
        self.list.setItemAnimator(None)
        self.list.setLayoutAnimation(None)
        layout = LinearLayoutManager(context, LinearLayoutManager.VERTICAL, False)
        layout.setStackFromEnd(True)
        self.list.setLayoutManager(layout)
        self.list.setClipToPadding(False)
        self.list.setPadding(0, self.plugin._dm_dp(8), 0, self.plugin._dm_dp(8))
        self.list.setVerticalScrollBarEnabled(False)
        self.adapter = Adapter.new_instance(init_args=[self])
        self.delegate = Delegate.new_instance(init_args=[self])
        self.refs.extend([header_click, self.adapter, self.delegate])
        self.list.setAdapter(self.adapter.java)
        self._install_player_observer()
        if not self.journal:
            try:
                if Scroll is None:
                    raise RuntimeError('Scroll listener unavailable')
                listener = Scroll.new_instance(init_args=[self])
                self.refs.append(listener)
                self.list.addOnScrollListener(listener.java)
            except Exception:
                self.manual_paging = True
                self._compose()
                self.adapter.java.notifyDataSetChanged()
        root.addView(self.list, FrameLayout.LayoutParams(-1, -1))
        if not self.journal and not self.manual_paging:
            self._check_short_page_later()
        return root

    def _install_player_observer(self):
        try:
            from java import dynamic_proxy
            state = self
            class Observer(dynamic_proxy(NotificationCenter.NotificationCenterDelegate)):
                def __init__(self):
                    super().__init__()
                def didReceivedNotification(self, event, account, args):
                    try:
                        eid, acc = int(event), int(account)
                        mid = num(args[0]) if args is not None and len(args) and eid == int(NotificationCenter.messagePlayingProgressDidChanged) else 0
                        ui(lambda: state._player_event(eid, acc, mid))
                    except Exception:
                        pass
            self.player_observer = observer = Observer()
            center = NotificationCenter.getInstance(self.token[1])
            for name in ('messagePlayingDidStart', 'messagePlayingProgressDidChanged',
                         'messagePlayingPlayStateChanged', 'messagePlayingDidReset'):
                try:
                    event = getattr(NotificationCenter, name)
                    center.addObserver(observer, event)
                    self.player_events.append(event)
                except Exception:
                    pass
        except Exception:
            pass

    def _remove_player_observer(self):
        observer, self.player_observer = self.player_observer, None
        events, self.player_events = self.player_events, []
        if observer is None:
            return
        try:
            center = NotificationCenter.getInstance(self.token[1])
            for event in events:
                try:
                    center.removeObserver(observer, event)
                except Exception:
                    pass
        except Exception:
            pass

    @staticmethod
    def _player_dragging(cell):
        try:
            if cell.isDraggingdAnyMusicSeekBar():
                return True
        except (AttributeError, TypeError):
            pass
        for name in ('getSeekBar', 'getSeekBarWaveform'):
            try:
                bar = getattr(cell, name)()
                if bar is not None and bar.isDragging():
                    return True
            except (AttributeError, TypeError):
                pass
        return False

    def _player_event(self, event, account, mid):
        if self.disposed or self.list is None or int(account) != self.token[1] or not self.live():
            return
        try:
            from org.telegram.ui.Cells import ChatMessageCell
            from org.telegram.messenger import MediaController
            progress = int(event) == int(NotificationCenter.messagePlayingProgressDidChanged)
            player = MediaController.getInstance().getPlayingMessageObject() if progress else None
            for index in range(int(self.list.getChildCount())):
                try:
                    cell = self.list.getChildAt(index)
                    if not isinstance(cell, ChatMessageCell):
                        continue
                    row = self.bound.get(int(cell.hashCode()))
                    if row is None or (row.get('local') or {}).get('kind') not in ('voice', 'round'):
                        continue
                    obj = cell.getMessageObject()
                    if obj is None or row.get('_object') is None or ident(obj) != ident(row['_object']):
                        continue
                    if progress:
                        if player is None or int(obj.getId()) != int(mid) or int(player.getId()) != int(mid):
                            continue
                        if self._player_dragging(cell):
                            continue
                        obj.audioProgress = player.audioProgress
                        obj.audioProgressSec = player.audioProgressSec
                        try:
                            obj.audioPlayerDuration = player.audioPlayerDuration
                        except Exception:
                            pass
                        cell.updatePlayingMessageProgress()
                    else:
                        cell.updateButtonState(False, True, False)
                        cell.updatePlayingMessageProgress()
                except Exception:
                    pass
        except Exception:
            pass

    def _check_short_page_later(self):
        try:
            self.list.post(local_runnable(lambda: self.on_scroll(0)))
        except Exception:
            pass

    def on_scroll(self, dy):
        if self.journal or self.manual_paging or self.page_loading or not self.rows or not self.live():
            return
        layout = self.list.getLayoutManager()
        first = int(layout.findFirstVisibleItemPosition())
        last = int(layout.findLastVisibleItemPosition())
        if first < 0 or last < 0:
            return
        short_page = (dy == 0 and not self.list.canScrollVertically(-1)
                      and not self.list.canScrollVertically(1))
        if (dy < 0 or short_page) and not self.top_end and first <= 8:
            self.page_loading = True
            self.plugin._vj_load_adjacent(self, 'older')
        elif dy > 0 and not self.bottom_end and last >= len(self.items) - 9:
            self.page_loading = True
            self.plugin._vj_load_adjacent(self, 'newer')

    def attach_page(self, rows, lease, direction):
        if not self.live():
            lease.close()
            self.page_loading = False
            return
        layout = self.list.getLayoutManager()
        start = max(0, int(layout.findFirstVisibleItemPosition()))
        anchor = next((item['row'] for item in self.items[start:] if item['type'] in ('message', 'unavailable')), None)
        anchor_pos = next((i for i in range(start, len(self.items))
                           if self.items[i]['type'] in ('message', 'unavailable') and self.items[i]['row'] is anchor), -1)
        anchor_view = layout.findViewByPosition(anchor_pos) if anchor_pos >= 0 else None
        top = int(anchor_view.getTop()) - int(self.list.getPaddingTop()) if anchor_view is not None else 0
        candidate = ([ (rows, lease) ] + self.pages) if direction == 'older' else (self.pages + [ (rows, lease) ])
        evicted = None
        if len(candidate) > 4:
            evicted = candidate[-1] if direction == 'older' else candidate[0]
            if (anchor is not None and any(row is anchor for row in evicted[0])) or self.provider is not None:
                lease.close()
                self.page_loading = False
                return
            candidate.remove(evicted)
        previous_items = self.items
        self.lease.add(lease)
        self.pages = candidate
        self.rows = [r for page, _ in candidate for r in page]
        if direction == 'older':
            self.bottom_end = False if evicted else self.bottom_end
        else:
            self.top_end = False if evicted else self.top_end
        self._compose()
        active = {id(r) for r in self.rows}
        self.bound = {k: r for k, r in self.bound.items() if id(r) in active}
        self.history_keys = {ident(r['_object']) for r in self.rows if r.get('_object') is not None}
        self._notify_diff(previous_items, self.items)
        if anchor is not None:
            new_pos = next((i for i, item in enumerate(self.items)
                            if item['type'] in ('message', 'unavailable') and item['row'] is anchor), -1)
            if new_pos >= 0:
                layout.scrollToPositionWithOffset(new_pos, top)
        if evicted is not None and evicted[1] is not None:
            self.detached_pages.append(evicted)
            self._schedule_detached_cleanup(500)
        self.page_loading = False
        if not self.manual_paging:
            self._check_short_page_later()

    @staticmethod
    def _item_keys(items):
        result = []
        for i, item in enumerate(items):
            if item.get('row') is not None:
                result.append(('row', id(item['row'])))
            elif item['type'] == 'date':
                following = next((id(x['row']) for x in items[i + 1:] if x.get('row') is not None), None)
                result.append(('date', item.get('text'), following))
            else:
                result.append((item['type'], item.get('text')))
        return result

    def _notify_diff(self, old, new):
        ops = difflib.SequenceMatcher(None, self._item_keys(old), self._item_keys(new), autojunk=False).get_opcodes()
        for tag, a, b, c, d in reversed(ops):
            if tag in ('delete', 'replace') and b > a:
                self.adapter.java.notifyItemRangeRemoved(a, b - a)
            if tag in ('insert', 'replace') and d > c:
                self.adapter.java.notifyItemRangeInserted(a, d - c)

    def _schedule_detached_cleanup(self, delay):
        if self._reap_scheduled or self.disposed:
            return
        self._reap_scheduled = True
        from android.os import Handler, Looper
        Handler(Looper.getMainLooper()).postDelayed(local_runnable(self._reap_detached), delay)

    def _reap_detached(self):
        self._reap_scheduled = False
        if self.disposed or not self.detached_pages:
            return
        try:
            from org.telegram.messenger import MediaController
            playing = MediaController.getInstance().getPlayingMessageObject()
            playing_key = ident(playing) if playing is not None else None
        except Exception:
            self._schedule_detached_cleanup(1500)
            return
        kept = []
        for rows, lease in self.detached_pages:
            if playing_key is not None and any(r.get('_object') is not None and ident(r['_object']) == playing_key for r in rows):
                kept.append((rows, lease))
                continue
            if self.lease is not None and lease in self.lease.leases:
                self.lease.leases.remove(lease)
                lease.close()
            for row in rows:
                row.pop('_object', None)
        self.detached_pages = kept
        if kept:
            self._schedule_detached_cleanup(1500)

    def resume(self):
        if not self.plugin._vj_live_storage(self.token):
            self.peer.java.finishFragment()
        elif self.list is not None:
            self._schedule_player_tick()

    def make_holder(self, parent, kind):
        from android.view import Gravity
        from android.widget import FrameLayout, TextView
        from org.telegram.ui.Cells import ChatMessageCell
        from org.telegram.ui.Components import RecyclerListView
        from androidx.recyclerview.widget import RecyclerView
        context = parent.getContext()
        if kind == 1:
            ctor = _NATIVE_CHAT_ABI['cell_ctor']
            view = ChatMessageCell(context, int(self.token[1])) if len(ctor) == 2 else ChatMessageCell(context)
            view.setFullyDraw(True)
            view.isChat = self.token[2] < 0
            view.setDelegate(self.delegate.java)
        else:
            view = FrameLayout(context)
            label = TextView(context)
            label.setGravity(Gravity.CENTER)
            label.setTextSize(13.0)
            label.setPadding(self.plugin._dm_dp(12), self.plugin._dm_dp(5), self.plugin._dm_dp(12), self.plugin._dm_dp(5))
            label.setTextColor(self.plugin._dm_theme('key_chat_serviceText', -1))
            from android.graphics.drawable import GradientDrawable
            background = GradientDrawable()
            background.setColor(self.plugin._dm_theme('key_chat_serviceBackground', -1711276033))
            background.setCornerRadius(float(self.plugin._dm_dp(14)))
            label.setBackground(background)
            lp = FrameLayout.LayoutParams(-2, -2, Gravity.CENTER)
            lp.topMargin, lp.bottomMargin = self.plugin._dm_dp(6), self.plugin._dm_dp(6)
            view.addView(label, lp)
        view.setLayoutParams(RecyclerView.LayoutParams(-1, -2))
        return RecyclerListView.Holder(view)

    def bind(self, holder, position):
        item, view = self.items[position], holder.itemView
        if item['type'] == 'message':
            self._round_restore(view)
            row = item['row']
            obj = row.get('_object')
            if obj is None:
                try:
                    obj = self.plugin._vj_message_object(self.token, row)
                    row['_object'] = obj
                except Exception:
                    fallback = dict(row, local=None, text='Не удалось отобразить сообщение', message=None)
                    obj = self.plugin._vj_message_object(self.token, fallback)
                    row['_object'] = obj
            self.history_keys.add(ident(obj))
            args = [obj, None, False, False] + [False] * (len(_NATIVE_CHAT_ABI['bind']) - 4)
            view.setMessageObject(*args)
            self.bound[int(view.hashCode())] = row
            return
        label = view.getChildAt(0)
        label.setText(item['text'])
        from android.view import View
        from java import dynamic_proxy
        state = self
        class Click(dynamic_proxy(View.OnClickListener)):
            def onClick(self, ignored):
                if state.live():
                    if item['type'] == 'older':
                        state.plugin._vj_deleted_page(state.token[1], state.token[2], state.older)
                    elif item['type'] == 'newest':
                        state.plugin._vj_deleted_page(state.token[1], state.token[2], None)
        listener = Click()
        old = getattr(self, '_status_clicks', None)
        if old is None:
            self._status_clicks = old = {}
        old[int(view.hashCode())] = listener
        label.setOnClickListener(listener)

    def recycle(self, holder):
        view = holder.itemView
        self._round_restore(view)
        self.bound.pop(int(view.hashCode()), None)
        clicks = getattr(self, '_status_clicks', {})
        clicks.pop(int(view.hashCode()), None)
        try:
            receiver = view.getPhotoImage()
            receiver.cancelLoadImage()
            receiver.setImageBitmap(None)
        except Exception:
            pass

    def _round_freeze(self, cell):
        key = ident(cell)
        receiver = cell.getPhotoImage()
        if receiver is None:
            return
        if key not in self._round_frozen:
            decode = java_field('org.telegram.messenger.ImageReceiver', 'allowDecodeSingleFrame')
            old_decode = bool(decode.getBoolean(receiver)) if decode is not None else None
            self._round_frozen[key] = (cell, receiver, bool(receiver.getAllowStartAnimation()), old_decode)
        _, receiver, _, old_decode = self._round_frozen[key]
        receiver.setAllowStartAnimation(False)
        if old_decode is not None:
            receiver.setAllowDecodeSingleFrame(True)
        receiver.stopAnimation()
        animation = receiver.getAnimation()
        if animation is not None and old_decode is not None:
            animation.setAllowDecodeSingleFrame(True)
        cell.invalidate()

    def _round_restore(self, cell):
        entry = self._round_frozen.pop(ident(cell), None)
        if entry is None:
            return
        _, receiver, old_start, old_decode = entry
        try:
            if old_decode is not None:
                receiver.setAllowDecodeSingleFrame(old_decode)
            receiver.setAllowStartAnimation(old_start)
        except Exception:
            pass

    def open_cell(self, cell):
        if not self.live():
            return
        row = self.bound.get(int(cell.hashCode()))
        if row is None:
            return
        if row.get('local') is not None and row['local']['kind'] == 'sticker':
            return
        if row.get('local') is not None and row['local']['kind'] in ('voice', 'round'):
            self.play_message(row.get('_object'), cell)
            return
        if row.get('local') is None:
            if row.get('source') is not None:
                self.plugin._vj_preview(self.token, message=row.get('message'))
            elif row.get('missing'):
                toast_info('Локальная копия этого медиа не найдена. С сервера ничего не загружается.')
            return
        try:
            self.plugin._vj_native_viewer(self, cell, row)
        except Exception:
            toast_err('Не удалось открыть просмотрщик медиа.')

    def play_message(self, obj, cell=None):
        if obj is None or not self.live():
            return False
        row = next((r for r in self.rows if r.get('_object') is not None and ident(r['_object']) == ident(obj)), None)
        local = row.get('local') if row is not None else None
        if local is None or local['kind'] not in ('voice', 'round'):
            return False
        try:
            from org.telegram.messenger import MediaController, UserConfig
            if int(UserConfig.selectedAccount) != self.token[1]:
                return False
            if not os.path.isfile(local['path']):
                raise FileNotFoundError('Native preview was removed')
            if local['kind'] == 'round':
                if not self.stop_player():
                    toast_err('Не удалось остановить прежний просмотр кружка')
                    return False
                self.plugin._vj_native_viewer(self, cell, row)
                return False
            controller = MediaController.getInstance()
            controller.setVoiceMessagesPlaylist(None, False)
            result = bool(controller.playMessage(row['_object']))
            if result:
                self._player_tick_last = ident(row['_object'])
                self._schedule_player_tick()
            return result
        except Exception:
            toast_err('Не удалось открыть локальный кружок' if local['kind'] == 'round'
                      else 'Не удалось воспроизвести локальную копию')
            return False

    def _schedule_player_tick(self):
        if self.disposed or self._player_tick_pending:
            return
        self._player_tick_pending = True
        generation = self._player_tick_generation
        try:
            from android.os import Handler, Looper
            Handler(Looper.getMainLooper()).postDelayed(local_runnable(lambda: self._player_tick(generation)), 250)
        except Exception:
            self._player_tick_pending = False

    def _player_tick(self, generation):
        if generation != self._player_tick_generation:
            return
        self._player_tick_pending = False
        if self.disposed or self.list is None or not self.live():
            return
        try:
            from org.telegram.messenger import MediaController
            from org.telegram.ui.Cells import ChatMessageCell
            player = MediaController.getInstance().getPlayingMessageObject()
            owned = self.rows + [r for page, _ in self.detached_pages for r in page]
            owned_player = player is not None and any(
                r.get('_object') is not None and ident(r['_object']) == ident(player)
                and (r.get('local') or {}).get('kind') in ('voice', 'round') for r in owned)
            current_key = ident(player) if owned_player else None
            changed = current_key != self._player_tick_last
            self._player_tick_last = current_key
            for index in range(int(self.list.getChildCount())):
                try:
                    cell = self.list.getChildAt(index)
                    if not isinstance(cell, ChatMessageCell): continue
                    row = self.bound.get(int(cell.hashCode()))
                    if row is None or (row.get('local') or {}).get('kind') not in ('voice', 'round'): continue
                    obj = cell.getMessageObject()
                    if obj is None or row.get('_object') is None or ident(obj) != ident(row['_object']): continue
                    if owned_player and ident(obj) == ident(player):
                        if self._player_dragging(cell):
                            continue
                        obj.audioProgress = player.audioProgress
                        obj.audioProgressSec = player.audioProgressSec
                        try: obj.audioPlayerDuration = player.audioPlayerDuration
                        except Exception: pass
                        try: obj.bufferedProgress = player.bufferedProgress
                        except Exception: pass
                        cell.updatePlayingMessageProgress()
                    elif changed:
                        cell.updateButtonState(False, True, False)
                        cell.updatePlayingMessageProgress()
                except Exception:
                    pass
            if owned_player:
                self._schedule_player_tick()
        except Exception:
            pass

    def stop_player(self):
        try:
            from org.telegram.messenger import MediaController
            controller = MediaController.getInstance()
            playing = controller.getPlayingMessageObject()
            if playing is None:
                return True
            owned = self.rows + [row for rows, _ in self.detached_pages for row in rows]
            playing_key = ident(playing)
            if any(r.get('_object') is not None and ident(r['_object']) == playing_key for r in owned):
                controller.cleanupPlayer(True, True)
                playing = controller.getPlayingMessageObject()
                if playing is not None and any(r.get('_object') is not None and ident(r['_object']) == ident(playing) for r in owned):
                    return False
            return True
        except Exception:
            return False

    def copy_cell(self, cell):
        if not self.live():
            return
        row = self.bound.get(int(cell.hashCode()))
        if row is not None and row.get('text'):
            from org.telegram.messenger import AndroidUtilities
            AndroidUtilities.addToClipboard(row['text'])
            toast_info('Текст скопирован')

    def photo_place(self, cell, entry, preview):
        if cell is None or self.disposed:
            return None
        row = self.bound.get(int(cell.hashCode()))
        if row is not entry:
            return None
        from java import jarray, jint
        from org.telegram.ui import PhotoViewer
        receiver = cell.getPhotoImage()
        if not receiver.hasBitmapImage():
            return None
        coords = jarray(jint)([0, 0])
        cell.getLocationInWindow(coords)
        place = PhotoViewer.PlaceProviderObject()
        place.viewX, place.viewY = int(coords[0]), int(coords[1])
        place.parentView, place.imageReceiver = self.list, receiver
        place.radius = receiver.getRoundRadius()
        if preview:
            place.thumb = receiver.getBitmapSafe()
        place.isEvent = True
        return place

    def action(self, item):
        if item == -1:
            self.peer.java.finishFragment()
        elif item == 1 and self.journal and self.live():
            self.plugin._vj_remove_copy(self)

    def restore_viewer_ui(self):
        for view, visibility in self.__dict__.pop('_viewer_restore', []):
            try:
                view.setVisibility(visibility)
            except Exception:
                pass

    def viewer_closed(self, provider):
        if self.provider is not provider:
            return
        self.restore_viewer_ui()
        self.provider, self.viewer_object = None, None
        if getattr(self, '_pending_lease', None) is not None:
            self._finish_deferred()

    def close_viewer(self):
        if self.viewer_object is not None:
            from org.telegram.ui import PhotoViewer
            if PhotoViewer.isShowingImage(self.viewer_object):
                PhotoViewer.getInstance().closePhoto(False, False)
            if PhotoViewer.isShowingImage(self.viewer_object):
                return False
            self.restore_viewer_ui()
            self.provider, self.viewer_object = None, None
        return True

    def _finish_deferred(self, attempt=0):
        if getattr(self, '_pending_lease', None) is None:
            return
        try:
            if self.close_viewer() and self.stop_player():
                pending, self._pending_lease = self._pending_lease, None
                if pending is not None:
                    pending.close()
                for row in self.rows:
                    row.pop('_object', None)
                return
        except Exception:
            pass
        if attempt >= 40:
            return
        from android.os import Handler, Looper
        Handler(Looper.getMainLooper()).postDelayed(local_runnable(lambda: self._finish_deferred(attempt + 1)), 250)

    def dispose(self):
        if self.disposed:
            return
        self.disposed = True
        self._player_tick_generation += 1
        self._player_tick_pending = False
        self._remove_player_observer()
        viewer_closed = False
        try:
            viewer_closed = self.close_viewer()
        except Exception:
            pass
        if self.list is not None:
            try:
                self.list.setAdapter(None)
            except Exception:
                pass
        player_stopped = self.stop_player()
        if player_stopped:
            for row in self.rows:
                row.pop('_object', None)
        for cell, _, _, _ in list(self._round_frozen.values()):
            self._round_restore(cell)
        self.bound.clear()
        self.refs.clear()
        self.__dict__.pop('_status_clicks', None)
        if self.lease is not None:
            if viewer_closed and player_stopped:
                self.lease.close()
            else:
                self._pending_lease = self.lease
            self.lease = None
        if getattr(self, '_pending_lease', None) is not None:
            try:
                self._finish_deferred()
            except Exception:
                pass
        if getattr(self.plugin, '_vj_native', None) is self:
            self.plugin._vj_native = None
            self.plugin._vj_request += 1


class NativeMediaLease:
    MAX_BYTES = 100 * 1024 * 1024

    def __init__(self, root, cache, plugin, valid):
        self.root, self.cache = os.path.abspath(root), os.path.abspath(cache)
        self.plugin, self.valid = plugin, valid
        self.entries, self.used, self.closed = [], 0, False
        os.makedirs(self.root, mode=0o700, exist_ok=True)

    @staticmethod
    def process_key():
        try:
            with open('/proc/self/stat', encoding='ascii') as stream:
                birth = stream.read().rsplit(')', 1)[-1].split()[19]
            return os.getpid(), birth
        except (OSError, IndexError):
            return os.getpid(), 'unknown'

    @staticmethod
    def sweep(root, cache):
        if not os.path.isdir(root) or os.path.islink(root):
            return
        for name in os.listdir(root):
            if not re.fullmatch(r'native-[0-9a-f]{32}\.json', name):
                continue
            manifest = os.path.join(root, name)
            try:
                if os.path.islink(manifest) or os.path.getsize(manifest) > 1024:
                    continue
                with open(manifest, encoding='utf-8') as stream:
                    meta = json.load(stream)
                pid, birth = NativeMediaLease.process_key()
                if meta.get('pid') == pid and meta.get('birth') == birth:
                    continue
                leaf = meta.get('leaf', '')
                if not re.fullmatch(r'-2147483648_-[1-9][0-9]{0,9}\.(jpg|mp4|ogg|webp|webm|tgs|temp)', leaf):
                    continue
                path = os.path.join(cache, leaf)
                if not os.path.islink(path) and os.path.isfile(path):
                    if 'inode' not in meta or int(meta['inode']) == os.stat(path).st_ino:
                        os.unlink(path)
                os.unlink(manifest)
            except (OSError, ValueError, TypeError):
                pass

    def add(self, source):
        if self.closed or not self.valid():
            raise InterruptedError('Stale native preview')
        size = int(source['size'])
        if size <= 0 or self.used + size > self.MAX_BYTES:
            raise OverflowError('Native preview page budget')
        ext = {'photo': 'jpg', 'voice': 'ogg'}.get(source['kind'], 'mp4')
        if source['kind'] == 'sticker':
            ext = source.get('sticker_ext')
            if ext not in ('webp', 'webm', 'tgs'):
                raise ValueError('Unsupported sticker format')
            if ext == 'webm':
                ext = 'temp'
        for _ in range(16):
            local_id = -1 - int.from_bytes(os.urandom(4), 'big') % 2147483646
            leaf = '-2147483648_%d.%s' % (local_id, ext)
            path = os.path.join(self.cache, leaf)
            if not os.path.lexists(path):
                break
        else:
            raise FileExistsError('No unique native preview name')
        stamp = os.urandom(16).hex()
        manifest = os.path.join(self.root, 'native-' + stamp + '.json')
        pid, birth = self.process_key()
        metadata = {'leaf': leaf, 'pid': pid, 'birth': birth}
        with open(manifest, 'x', encoding='utf-8') as out:
            os.chmod(manifest, 0o600)
            json.dump(metadata, out)
            out.flush()
            os.fsync(out.fileno())
        stream, output, created = None, None, False
        try:
            output = open(path, 'xb')
            created = True
            os.chmod(path, 0o600)
            if source.get('encrypted'):
                from java import jarray, jbyte
                stream = self.plugin._vj_stream(source)
                buffer = jarray(jbyte)(65536)
                total = 0
                while True:
                    if not self.valid():
                        raise InterruptedError('Stale native preview')
                    count = int(stream.read(buffer, 0, len(buffer)))
                    if count < 0:
                        break
                    if count == 0 or total + count > size:
                        raise OSError('Incomplete native media stream')
                    output.write(bytes((int(v) & 255 for v in buffer[:count])))
                    total += count
            else:
                stream = open(source['path'], 'rb')
                initial = os.fstat(stream.fileno())
                total = 0
                while True:
                    if not self.valid():
                        raise InterruptedError('Stale native preview')
                    chunk = stream.read(min(65536, size - total + 1))
                    if not chunk:
                        break
                    total += len(chunk)
                    if total > size:
                        raise OSError('Native preview source changed')
                    output.write(chunk)
                final = os.fstat(stream.fileno())
                if (initial.st_size, initial.st_mtime_ns) != (final.st_size, final.st_mtime_ns):
                    raise OSError('Native preview source changed')
            if total != size or not self.valid():
                raise OSError('Incomplete native preview')
            output.flush()
            os.fsync(output.fileno())
            metadata['inode'] = os.fstat(output.fileno()).st_ino
            with open(manifest, 'w', encoding='utf-8') as out:
                json.dump(metadata, out)
                out.flush()
                os.fsync(out.fileno())
            entry = dict(source, path=path, local_id=local_id, manifest=manifest, encrypted=False, key_path=None)
            self.entries.append(entry)
            self.used += size
            return entry
        except Exception:
            if output is not None:
                output.close()
                output = None
            if created and os.path.isfile(path):
                os.unlink(path)
            if os.path.isfile(manifest):
                os.unlink(manifest)
            raise
        finally:
            if stream is not None:
                stream.close()
            if output is not None:
                output.close()

    def close(self):
        if self.closed:
            return
        self.closed = True
        for entry in self.entries:
            try:
                if os.path.isfile(entry['path']) and not os.path.islink(entry['path']):
                    with open(entry['manifest'], encoding='utf-8') as stream:
                        meta = json.load(stream)
                    if int(meta['inode']) == os.stat(entry['path']).st_ino:
                        os.unlink(entry['path'])
                if os.path.isfile(entry['manifest']):
                    os.unlink(entry['manifest'])
            except (OSError, ValueError, TypeError):
                pass
        self.entries.clear()


import hashlib
import os
try:
    import sqlite3
except ImportError:
    sqlite3 = None
import stat
import threading


class SnapshotError(Exception):
    pass


class SnapshotStore:
    def __init__(self, path):
        self.path = os.path.abspath(path)
        self.lock = threading.RLock()
        parent = os.path.dirname(self.path)
        os.makedirs(parent, mode=0o700, exist_ok=True)
        if os.path.islink(parent) or os.path.islink(self.path):
            raise SnapshotError('unsafe location')
        flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY | getattr(os, 'O_NOFOLLOW', 0)
        try:
            fd = os.open(self.path, flags, 0o600)
        except FileExistsError:
            st = os.stat(self.path, follow_symlinks=False)
            if not stat.S_ISREG(st.st_mode):
                raise SnapshotError('not a regular file')
        else:
            os.close(fd)
        with self.lock:
            db=self._open()
            try:
                version=int(db.execute('PRAGMA user_version').fetchone()[0])
                if version not in (0,1): raise SnapshotError('unsupported store version')
                db.execute('CREATE TABLE IF NOT EXISTS records (owner INTEGER NOT NULL, account INTEGER NOT NULL, dialog INTEGER NOT NULL, mid INTEGER NOT NULL, data BLOB NOT NULL, sha BLOB NOT NULL, date INTEGER NOT NULL, outgoing INTEGER NOT NULL, PRIMARY KEY(owner,account,dialog,mid)) WITHOUT ROWID')
                db.execute('CREATE TABLE IF NOT EXISTS locally_deleted (owner INTEGER NOT NULL, account INTEGER NOT NULL, dialog INTEGER NOT NULL, mid INTEGER NOT NULL, PRIMARY KEY(owner,account,dialog,mid)) WITHOUT ROWID')
                db.execute('CREATE TABLE IF NOT EXISTS completeness (owner INTEGER NOT NULL, account INTEGER NOT NULL, dialog INTEGER NOT NULL, mid INTEGER NOT NULL, media_state INTEGER NOT NULL, PRIMARY KEY(owner,account,dialog,mid)) WITHOUT ROWID')
                db.execute('CREATE TABLE IF NOT EXISTS media_gc (sha TEXT PRIMARY KEY) WITHOUT ROWID')
                if version == 0: db.execute('PRAGMA user_version=1')
                db.commit()
            finally:
                db.close()
    def _open(self):
        db = sqlite3.connect(self.path, timeout=10)
        db.execute('PRAGMA synchronous=FULL')
        return db
    def _media_lock(self):
        from contextlib import contextmanager
        import fcntl
        @contextmanager
        def acquire():
            flags = os.O_CREAT | os.O_RDWR | getattr(os, 'O_NOFOLLOW', 0)
            fd = os.open(self.path + '.lock', flags, 0o600)
            try:
                if not stat.S_ISREG(os.fstat(fd).st_mode):
                    raise SnapshotError('unsafe lock')
                fcntl.flock(fd, fcntl.LOCK_EX)
                try:
                    yield
                finally:
                    fcntl.flock(fd, fcntl.LOCK_UN)
            finally:
                os.close(fd)
        return acquire()
    @staticmethod
    def _scope(owner, account, dialog):
        owner, account, dialog = int(owner), int(account), int(dialog)
        if owner <= 0 or not 0 <= account < 32 or not dialog:
            raise ValueError('invalid scope')
        return owner, account, dialog
    def put_batch(self, owner, account, dialog, records):
        scope = self._scope(owner, account, dialog)
        with self.lock:
            db = self._open()
            try:
                db.execute('BEGIN IMMEDIATE')
                count=0
                for mid, data, date, outgoing in records:
                    mid=int(mid)
                    if mid <= 0 or not isinstance(data, (bytes, bytearray, memoryview)) or not data:
                        raise ValueError('invalid record')
                    data=bytes(data); digest=hashlib.sha256(data).digest()
                    if db.execute('SELECT 1 FROM locally_deleted WHERE owner=? AND account=? AND dialog=? AND mid=?', (*scope, mid)).fetchone():
                        continue
                    existing=db.execute('SELECT sha,date,outgoing FROM records WHERE owner=? AND account=? AND dialog=? AND mid=?', (*scope,mid)).fetchone()
                    if existing:
                        if existing != (digest,int(date),int(bool(outgoing))):
                            raise SnapshotError('conflicting record; refusing overwrite')
                        continue
                    db.execute('INSERT INTO records VALUES(?,?,?,?,?,?,?,?)', (*scope,mid,sqlite3.Binary(data),sqlite3.Binary(digest),int(date),int(bool(outgoing))))
                    count+=1
                db.commit()
                return count
            except Exception:
                db.rollback()
                raise
            finally:
                db.close()

    def excluded(self, owner, account, dialog, mids):
        scope = self._scope(owner, account, dialog)
        ids = sorted({int(mid) for mid in mids if int(mid) > 0})
        found = set()
        db = self._open()
        try:
            for start in range(0, len(ids), 400):
                batch = ids[start:start + 400]
                sql = ('SELECT mid FROM locally_deleted WHERE owner=? AND account=? AND dialog=? AND mid IN ('
                       + ','.join('?' for _ in batch) + ')')
                found.update(row[0] for row in db.execute(sql, (*scope, *batch)))
            return found
        finally:
            db.close()

    def forget(self, owner, account, dialog, mids):
        scope = self._scope(owner, account, dialog)
        ids = sorted({int(mid) for mid in mids if int(mid) > 0})
        if not ids:
            return []
        db = self._open()
        hashes = set()
        try:
            db.execute('BEGIN IMMEDIATE')
            has_media = db.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='media'").fetchone()
            for start in range(0, len(ids), 400):
                batch = ids[start:start + 400]
                placeholders = ','.join('?' for _ in batch)
                args = (*scope, *batch)
                db.executemany('INSERT OR IGNORE INTO locally_deleted VALUES(?,?,?,?)',
                               [(*scope, mid) for mid in batch])
                db.execute('DELETE FROM records WHERE owner=? AND account=? AND dialog=? AND mid IN (' + placeholders + ')', args)
                db.execute('DELETE FROM completeness WHERE owner=? AND account=? AND dialog=? AND mid IN (' + placeholders + ')', args)
                if has_media:
                    hashes.update(row[0] for row in db.execute(
                        'SELECT sha FROM media WHERE owner=? AND account=? AND dialog=? AND mid IN (' + placeholders + ')', args))
                    db.execute('DELETE FROM media WHERE owner=? AND account=? AND dialog=? AND mid IN (' + placeholders + ')', args)
            db.executemany('INSERT OR IGNORE INTO media_gc VALUES(?)', [(sha,) for sha in hashes])
            db.commit()
            return sorted(hashes)
        except Exception:
            db.rollback()
            raise
        finally:
            db.close()

    def set_completeness(self, owner, account, dialog, states):
        scope = self._scope(owner, account, dialog)
        with self.lock:
            db = self._open()
            try:
                db.execute('BEGIN IMMEDIATE')
                for mid, state in states.items():
                    mid, state = int(mid), int(state)
                    if state not in (0, 1, 2):
                        raise ValueError('invalid completeness')
                    key = (*scope, mid)
                    db.execute('''INSERT OR REPLACE INTO completeness
                        SELECT ?,?,?,?,? WHERE EXISTS (
                            SELECT 1 FROM records WHERE owner=? AND account=? AND dialog=? AND mid=?
                        ) AND NOT EXISTS (
                            SELECT 1 FROM locally_deleted WHERE owner=? AND account=? AND dialog=? AND mid=?
                        )''', (*key, state, *key, *key))
                db.commit()
            except Exception:
                db.rollback()
                raise
            finally:
                db.close()

    def get_completeness(self, owner, account, dialog, mids):
        scope = self._scope(owner, account, dialog)
        ids = sorted({int(mid) for mid in mids if int(mid) > 0})
        out = {}
        with self.lock:
            db = self._open()
            try:
                for start in range(0, len(ids), 400):
                    batch = ids[start:start + 400]
                    sql = ('SELECT mid,media_state FROM completeness WHERE owner=? AND account=? AND dialog=? AND mid IN ('
                           + ','.join('?' for _ in batch) + ')')
                    out.update(db.execute(sql, (*scope, *batch)))
                return out
            finally:
                db.close()

    def collect_media(self, candidates):
        files = self.path + '.media'
        if os.path.islink(files) or not os.path.isdir(files):
            return
        with self.lock, self._media_lock():
            db = self._open()
            try:
                db.execute('BEGIN IMMEDIATE')
                has_media = db.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='media'").fetchone()
                for sha in set(candidates):
                    if not isinstance(sha, str) or len(sha) != 64 or any(c not in '0123456789abcdef' for c in sha):
                        continue
                    if has_media and db.execute('SELECT 1 FROM media WHERE sha=? LIMIT 1', (sha,)).fetchone():
                        db.execute('DELETE FROM media_gc WHERE sha=?', (sha,))
                        continue
                    path = os.path.join(files, sha)
                    if os.path.islink(path):
                        continue
                    if os.path.isfile(path):
                        try:
                            os.unlink(path)
                        except FileNotFoundError:
                            pass
                    db.execute('DELETE FROM media_gc WHERE sha=?', (sha,))
                db.commit()
            except Exception:
                db.rollback()
                raise
            finally:
                db.close()

    def sweep_orphan_media(self):
        files = self.path + '.media'
        if os.path.islink(files) or not os.path.isdir(files):
            return
        with self.lock, self._media_lock():
            db = self._open()
            try:
                db.execute('BEGIN IMMEDIATE')
                has_media = db.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='media'").fetchone()
                for name in os.listdir(files):
                    is_hash = len(name) == 64 and all(c in '0123456789abcdef' for c in name)
                    is_pending = bool(re.fullmatch(r'\.pending-[A-Za-z0-9_-]{8,32}', name))
                    if not (is_hash or is_pending):
                        continue
                    if is_hash and has_media and db.execute('SELECT 1 FROM media WHERE sha=? LIMIT 1', (name,)).fetchone():
                        continue
                    path = os.path.join(files, name)
                    if not os.path.islink(path) and os.path.isfile(path):
                        try:
                            os.unlink(path)
                        except FileNotFoundError:
                            pass
                    if is_hash:
                        db.execute('DELETE FROM media_gc WHERE sha=?', (name,))
                db.commit()
            except Exception:
                db.rollback()
                raise
            finally:
                db.close()

    def sweep_orphan_keys(self):
        import errno
        parent = os.path.dirname(self.path)
        if os.path.islink(parent) or not os.path.isdir(parent):
            return
        for name in os.listdir(parent):
            match = re.fullmatch(r'\.mt-key-([0-9]+)-([0-9]+)-[A-Za-z0-9_-]{8,32}', name)
            if not match:
                continue
            pid, expected_birth = int(match.group(1)), match.group(2)
            stale = False
            try:
                with open('/proc/%d/stat' % pid, encoding='ascii') as stream:
                    actual_birth = stream.read().rsplit(')', 1)[-1].split()[19]
                stale = actual_birth != expected_birth
            except (OSError, IndexError):
                try:
                    os.kill(pid, 0)
                except OSError as exc:
                    stale = exc.errno == errno.ESRCH
            if stale:
                path = os.path.join(parent, name)
                if not os.path.islink(path) and os.path.isfile(path):
                    try:
                        os.unlink(path)
                    except FileNotFoundError:
                        pass
    def get_many(self, owner, account, dialog, mids):
        scope = self._scope(owner, account, dialog)
        ids = sorted({int(mid) for mid in mids if int(mid)>0})
        out={}
        with self.lock:
            db=self._open()
            try:
                for offset in range(0,len(ids),400):
                    batch=ids[offset:offset+400]
                    sql='SELECT mid,data,sha,date,outgoing FROM records WHERE owner=? AND account=? AND dialog=? AND mid IN ('+','.join('?' for _ in batch)+')'
                    for mid,data,digest,date,outgoing in db.execute(sql,(*scope,*batch)):
                        data=bytes(data)
                        if hashlib.sha256(data).digest()!=bytes(digest):
                            raise SnapshotError('checksum mismatch')
                        out[mid]=(data,date,bool(outgoing))
            finally:
                db.close()
        return out

    def save_media(self, owner, account, dialog, mid, source_path, kind, encryption_key=None):
        import tempfile
        scope=self._scope(owner,account,dialog)
        mid=int(mid)
        if mid <= 0 or kind not in ('photo','video','voice','round','sticker','file'):
            raise ValueError('invalid media')
        if encryption_key is not None and len(encryption_key)!=48:
            raise ValueError('invalid media key')
        files=self.path+'.media'
        if os.path.islink(files): raise SnapshotError('unsafe directory')
        os.makedirs(files,mode=0o700,exist_ok=True)
        if os.path.islink(source_path): raise SnapshotError('unsafe source')
        fd=None; temp=None; sha=None
        with self.lock, self._media_lock():
            try:
                if self.excluded(*scope, [mid]):
                    raise SnapshotError('locally deleted')
                fd,temp=tempfile.mkstemp(prefix='.pending-',dir=files)
                digest=hashlib.sha256(); count=0
                with open(source_path,'rb') as inp, os.fdopen(fd,'wb') as out:
                    fd=None
                    initial=os.fstat(inp.fileno())
                    if not stat.S_ISREG(initial.st_mode): raise SnapshotError('non-regular source')
                    while True:
                        chunk=inp.read(1024*1024)
                        if not chunk: break
                        count+=len(chunk); digest.update(chunk); out.write(chunk)
                    final=os.fstat(inp.fileno())
                    if not count or (initial.st_size,initial.st_mtime_ns)!=(final.st_size,final.st_mtime_ns) or count!=final.st_size:
                        raise SnapshotError('source changed')
                    out.flush(); os.fsync(out.fileno())
                sha=digest.hexdigest(); target=os.path.join(files,sha)
                try: os.link(temp,target)
                except FileExistsError:
                    if os.path.islink(target) or not os.path.isfile(target): raise SnapshotError('unsafe media object')
                    check=hashlib.sha256()
                    with open(target,'rb') as old:
                        for chunk in iter(lambda:old.read(1024*1024),b''): check.update(chunk)
                    if check.hexdigest()!=sha: raise SnapshotError('media object corrupt')
                dfd=os.open(files,os.O_RDONLY | getattr(os,'O_DIRECTORY',0))
                try: os.fsync(dfd)
                finally: os.close(dfd)
                db=self._open()
                try:
                    db.execute('BEGIN IMMEDIATE')
                    db.execute('CREATE TABLE IF NOT EXISTS media (owner INTEGER NOT NULL, account INTEGER NOT NULL, dialog INTEGER NOT NULL, mid INTEGER NOT NULL, sha TEXT NOT NULL, size INTEGER NOT NULL, kind TEXT NOT NULL, key BLOB, PRIMARY KEY(owner,account,dialog,mid)) WITHOUT ROWID')
                    if db.execute('SELECT 1 FROM locally_deleted WHERE owner=? AND account=? AND dialog=? AND mid=?', (*scope, mid)).fetchone():
                        raise SnapshotError('locally deleted')
                    item=db.execute('SELECT sha,size,kind,key FROM media WHERE owner=? AND account=? AND dialog=? AND mid=?',(*scope,mid)).fetchone()
                    proposed=(sha,count,kind,encryption_key)
                    if item is not None and item!=proposed: raise SnapshotError('conflicting media; refusing overwrite')
                    if item is None:
                        db.execute('INSERT INTO media VALUES(?,?,?,?,?,?,?,?)',(*scope,mid,*proposed))
                    db.commit()
                except Exception:
                    db.rollback(); raise
                finally: db.close()
                return item is None
            except Exception:
                if sha is not None:
                    try:
                        db = self._open()
                        try:
                            db.execute('INSERT OR IGNORE INTO media_gc VALUES(?)', (sha,))
                            db.commit()
                        finally:
                            db.close()
                        threading.Thread(target=self.collect_media, args=([sha],),
                                         name='multi_tools-media-gc', daemon=True).start()
                    except Exception:
                        pass
                raise
            finally:
                if fd is not None: os.close(fd)
                if temp is not None:
                    try: os.unlink(temp)
                    except FileNotFoundError: pass

    def get_media(self, owner, account, dialog, mid):
        scope=self._scope(owner,account,dialog)
        with self.lock:
            db=self._open()
            try:
                exists=db.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='media'").fetchone()
                if not exists: return None
                row=db.execute('SELECT sha,size,kind,key FROM media WHERE owner=? AND account=? AND dialog=? AND mid=?',(*scope,int(mid))).fetchone()
            finally: db.close()
            if row is None: return None
            sha,size,kind,key=row
            if len(sha)!=64 or any(c not in '0123456789abcdef' for c in sha): raise SnapshotError('invalid object name')
            if kind not in ('photo','video','voice','round','sticker','file') or (key is not None and len(key)!=48): raise SnapshotError('invalid media metadata')
            if os.path.islink(self.path+'.media'): raise SnapshotError('unsafe media directory')
            path=os.path.join(self.path+'.media',sha)
            if os.path.islink(path) or not os.path.isfile(path): raise SnapshotError('missing media')
            digest=hashlib.sha256(); count=0
            with open(path,'rb') as inp:
                for chunk in iter(lambda:inp.read(1024*1024),b''): digest.update(chunk); count+=len(chunk)
            if count!=size or digest.hexdigest()!=sha: raise SnapshotError('corrupt media')
            return {'path':path,'size':size,'kind':kind,'key':key}


import threading


class CaptureUnavailable(Exception):
    pass


class TelegramCaptureProvider:
    def __init__(self, plugin, storage, owner, alive, runnable, tlrpc):
        self.plugin, self.storage, self.owner = plugin, storage, owner
        self.alive, self.runnable, self.tlrpc = alive, runnable, tlrpc

    def read(self, account, dialog, mids):
        if not self.alive(): raise CaptureUnavailable('cancelled')
        done=threading.Event(); state={}
        def load():
            try: state['rows']=self._read_on_queue(account,dialog,mids)
            except Exception as exc: state['error']=exc
            finally: done.set()
        self.storage.getStorageQueue().postRunnable(self.runnable(load))
        for _ in range(300):
            if done.wait(.1): break
            if not self.alive(): raise CaptureUnavailable('cancelled')
        if not done.is_set(): raise CaptureUnavailable('storage queue timeout')
        if 'error' in state: raise CaptureUnavailable('read failed') from state['error']
        return state['rows']

    def _read_on_queue(self, account, dialog, mids):
        if not self.alive() or self.plugin._vj_owner(account)!=self.owner:
            raise CaptureUnavailable('stale account')
        mids=sorted(set(int(x) for x in mids if int(x)>0))
        if not mids: return {}
        if len(mids)>100: raise ValueError('batch too large')
        mid_set=set(mids)
        query=('SELECT mid, data, date, out FROM messages_v2 WHERE uid = %d AND mid IN (%s)'
               % (int(dialog),','.join(str(x) for x in mids)))
        db=self.storage.getDatabase()
        if db is None: raise CaptureUnavailable('database unavailable')
        try: cursor=db.queryFinalized(query)
        except TypeError:
            from java import jarray
            from java.lang import Object
            cursor=db.queryFinalized(query,jarray(Object)([]))
        rows={}
        try:
            while cursor.next():
                native=None
                try:
                    mid=int(cursor.intValue(0))
                    if mid not in mid_set: raise CaptureUnavailable('unexpected row')
                    raw=cursor.byteArrayValue(1)
                    if raw is None: raise CaptureUnavailable('empty data')
                    blob=bytes(int(value) & 255 for value in raw)
                    if not blob: raise CaptureUnavailable('empty data')
                    native=cursor.byteBufferValue(1)
                    if native is None: raise CaptureUnavailable('buffer unavailable')
                    message=self.tlrpc.Message.TLdeserialize(native,native.readInt32(False),False)
                    if message is None: raise CaptureUnavailable('unreadable message')
                    message.readAttachPath(native,int(self.owner))
                    message.id, message.dialog_id=mid,int(dialog)
                    row={'data':blob,'date':int(cursor.intValue(2)),'outgoing':bool(cursor.intValue(3))}
                    reply=getattr(message,'reply_to',None)
                    if reply is not None and getattr(reply,'reply_to_peer_id',None) is None:
                        reply_mid=int(getattr(reply,'reply_to_msg_id',0) or 0)
                        if reply_mid>0: row['reply_mid']=reply_mid
                    media=getattr(message,'media',None)
                    attachment=media is not None and (getattr(media,'document',None) is not None or getattr(media,'photo',None) is not None)
                    if attachment:
                        row['media_required']=True
                        source=self.plugin._vj_source(account,message,{},include_stickers=True)
                        if source is None and getattr(media,'document',None) is not None:
                            source=self.plugin._mt_capture_document_source(account,message)
                        if source:
                            key=None
                            if source.get('encrypted'):
                                with open(source['key_path'],'rb') as f: key=f.read(49)
                                if len(key)!=48: raise CaptureUnavailable('invalid key')
                            row['media']={'path':source['path'],'kind':source['kind'],'key':key,
                                          'sticker_ext':source.get('sticker_ext')}
                    rows[mid]=row
                finally:
                    if native is not None: native.reuse()
        finally:
            cursor.dispose()
        return rows


class CaptureIncomplete(Exception):
    pass


class MigrationRunner:
    def __init__(self, store, provider, marker_source, alive=lambda: True):
        self.store, self.provider, self.marker_source, self.alive = store, provider, marker_source, alive

    def run(self, owner, account, dialog, batch_size=100):
        if not 1 <= batch_size <= 100: raise ValueError('invalid batch size')
        initial=set(self.marker_source(account,dialog))
        if any(type(i) is not int or i <= 0 for i in initial): raise CaptureIncomplete('invalid marker')
        ordered=sorted(initial)
        captured=missing_rows=missing_media=0
        replies=set()
        for start in range(0,len(ordered),batch_size):
            if not self.alive(): raise CaptureIncomplete('operation cancelled')
            mids=ordered[start:start+batch_size]
            records=self.provider.read(account,dialog,mids)
            if set(records)-set(mids): raise CaptureIncomplete('unexpected message data')
            previous=self.store.get_many(owner,account,dialog,mids)
            absent=set(mids)-set(records)-set(previous)
            missing_rows+=len(absent)
            states = {}
            for mid,record in records.items():
                if record.get('reply_mid'): replies.add(int(record['reply_mid']))
                if record.get('media_required'):
                    media=record.get('media')
                    if media:
                        self.store.save_media(owner,account,dialog,mid,media['path'],media['kind'],media.get('key'))
                    saved_media = self.store.get_media(owner,account,dialog,mid)
                    if saved_media is None or saved_media.get('kind') == 'file':
                        missing_media+=1
                        states[mid] = 2
                    else:
                        states[mid] = 1
                else:
                    states[mid] = 0
            self.store.put_batch(owner,account,dialog,[(mid,r['data'],r['date'],r['outgoing']) for mid,r in records.items()])
            self.store.set_completeness(owner,account,dialog,states)
            reread=self.store.get_many(owner,account,dialog,mids)
            if set(reread) != set(mids)-absent: raise CaptureIncomplete('snapshot readback incomplete')
            checks = self.store.get_completeness(owner,account,dialog,reread)
            for mid,record in records.items():
                if reread[mid] != (record['data'],record['date'],bool(record['outgoing'])):
                    raise CaptureIncomplete('snapshot readback mismatch')
                if checks.get(mid) != states[mid]:
                    raise CaptureIncomplete('snapshot verification state mismatch')
            for mid in set(previous)-set(records):
                state = checks.get(mid)
                if state not in (0, 1):
                    missing_media += 1
                elif state == 1:
                    saved_media = self.store.get_media(owner,account,dialog,mid)
                    if saved_media is None or saved_media.get('kind') == 'file':
                        missing_media += 1
            captured+=len(reread)
        missing_replies=len(replies-initial)
        if not self.alive() or initial!=set(self.marker_source(account,dialog)):
            raise CaptureIncomplete('scope changed during capture')
        return {'captured':captured,'missing_rows':missing_rows,'missing_media':missing_media,
                'missing_replies':missing_replies,'ready_for_deletion':False}


class MultiToolsPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._lock = threading.RLock()
        self._mutes = MuteStore()
        self._mutes_loaded = False
        self._labels = None
        self._handled = {}
        self._command_guard = {}
        self._command_echo = {}
        self._own_notices = {}
        self._observer = None
        self._observed = set()
        self._observing = set()
        self._mute_queue = {}
        self._ghosted = set()
        self._mute_flush_pending = False
        self._active = True
        self._dm_purge_generation = 0
        self._spam_runs = {}
        self._spam_last = {}
        self._dm_store = DeletedStore()
        self._mt_snapshots = None
        self._mt_snapshot_running = set()
        self._mt_snapshot_pending = {}
        self._mt_snapshot_full = set()
        self._mt_snapshot_ready = {}
        self._mt_snapshot_incomplete = {}
        self._mt_deleting = {}
        self._updater = None
        self._lifecycle_generation = 0
        self._chat_menu_id = None
        self._vj_menu_ids = []
        self._vj_files = None
        self._vj_request = 0
        self._vj_window = None
        self._vj_native = None
        self._vj_workers = threading.BoundedSemaphore(2)
        self._vj_capture_slots = threading.BoundedSemaphore(2)
        self._dm_cfg_cache = None
        self._dm_pend = {}
        self._dm_clear = {}
        self._dm_migr = {}
        self._dm_dimmed = {}
        self._dm_dedup = {}
        self._dm_factories = {}
        self._dm_live = {}
        self._dm_preview_views = []
        self._dm_listeners = []
        self._dm_master_native = {}
        self._dm_info_views = {}
        self._dm_palette_views = []
        self._dm_master_rows = []
        self._dm_ticks = []
        self._dm_media_queue = MediaDownloadQueue()
        self._dm_media_recent = {}
        self._dm_media_timer = None
        self._dm_media_generation = 0
        self._dm_media_error_at = -100.0
        self._dm_store_notice_at = -100.0

    def _register_chat_menu(self):
        self._unregister_chat_menu()
        try:
            from base_plugin import MenuItemData, MenuItemType
            items = [
                dict(menu_type=MenuItemType.CHAT_ACTION_MENU, text="Очистить удалённые в этом чате",
                     icon="msg_delete", item_id="multi_tools.clear_deleted_chat", on_click=self._dm_on_clear_chat),
                dict(menu_type=MenuItemType.CHAT_ACTION_MENU, text="Посмотреть удалённые сообщения",
                     icon="msg_archive", item_id="multi_tools.view_deleted_chat", on_click=self._vj_on_deleted),
                dict(menu_type=MenuItemType.MESSAGE_CONTEXT_MENU, text="История", icon="msg_log",
                     item_id="multi_tools.expired_media_journal", on_click=self._vj_on_journal,
                     condition="message != null && message.messageOwner != null && message.messageOwner.media != null && message.messageOwner.media.ttl_seconds != 0 && message.type == 10"),
            ]
            for index, spec in enumerate(items):
                try:
                    item = self.add_menu_item(MenuItemData(**spec))
                    if index == 0:
                        self._chat_menu_id = item
                    else:
                        self._vj_menu_ids.append(item)
                except Exception:
                    pass
        except Exception:
            pass

    def _unregister_chat_menu(self):
        items = list(getattr(self, "_vj_menu_ids", []))
        if getattr(self, "_chat_menu_id", None) is not None:
            items.append(self._chat_menu_id)
        self._chat_menu_id, self._vj_menu_ids = None, []
        for item in items:
            try:
                self.remove_menu_item(item)
            except Exception:
                pass

    @staticmethod
    def _dm_chat_scope(account, dialog_id):
        values = []
        for value in (account, dialog_id):
            raw = str(value).strip()
            if not re.fullmatch(r"-?[0-9]{1,20}", raw):
                raise ValueError("Invalid chat scope")
            values.append(int(raw))
        acc, did = values
        if acc < 0 or acc > 31 or did == 0 or not -(1 << 63) <= did < (1 << 63):
            raise ValueError("Invalid chat scope")
        return acc, did

    def _dm_on_clear_chat(self, context):
        try:
            if not self._active:
                return
            get = getattr(context, "get", None)
            if not callable(get):
                raise ValueError("Menu context has no mapping accessor")
            account, dialog_id = get("account"), get("dialog_id")
            if get("encryptedChat") is not None:
                toast_info("Очистка в секретных чатах не поддерживается")
                return
            scope = self._dm_chat_scope(account, dialog_id)
            with self._lock:
                epoch = getattr(self, "_lifecycle_generation", 0)
            count = sum(len(mids) for a, d, mids in self._dm_store.snapshot() if (a, d) == scope)
            if not count:
                toast_info("В этом чате нет сохранённых удалённых сообщений")
                return
            def accept():
                self._dm_clear_now(scope=scope, expected_epoch=epoch)
            def show():
                if not self._active or getattr(self, "_lifecycle_generation", 0) != epoch:
                    return
                try:
                    self._confirm("Очистить удалённые в этом чате?",
                                  "Уверены? Сохранённые удалённые сообщения (%d) будут убраны "
                                  "только из этого чата на этом устройстве. Обычная история, другие "
                                  "чаты и аккаунты не затрагиваются. Отменить очистку нельзя." % count,
                                  "Очистить", accept)
                except Exception:
                    toast_err("Не удалось показать подтверждение — действие отменено")
            ui(show)
        except Exception:
            toast_err("Не удалось определить чат и аккаунт — очистка отменена")

    def _vj_owner(self, account):
        owner = int(get_user_config(int(account)).getClientUserId())
        if owner <= 0:
            raise ValueError("Account is not active")
        return owner

    @staticmethod
    def _vj_account(controller):
        field = java_field("org.telegram.messenger.BaseController", "currentAccount")
        try:
            account = int(field.getInt(controller)) if field is not None else int(controller.getCurrentAccount())
        except Exception:
            account = int(controller.getCurrentAccount())
        if not 0 <= account < 32:
            raise ValueError("Invalid controller account")
        return account

    def _vj_archive(self):
        with self._lock:
            archive = self._vj_files
            if archive is None:
                archive = SingleMediaArchive(os.path.join(os.path.dirname(self._dm_store.path()), "multi_tools_journal_v1"))
                try:
                    from org.telegram.messenger import FileLoader
                    cache = str(FileLoader.getDirectory(FileLoader.MEDIA_DIR_CACHE).getAbsolutePath())
                    NativeMediaLease.sweep(archive.root, cache)
                except Exception:
                    pass
                self._vj_files = archive
            return archive

    def _vj_scope(self, context):
        get = getattr(context, "get", None)
        if not callable(get) or get("encryptedChat") is not None:
            raise ValueError("Unsupported context")
        account, did = self._dm_chat_scope(get("account"), get("dialog_id"))
        if is_special_dialog(did):
            raise ValueError("Unsupported dialog")
        return account, did

    def _vj_token(self, account, did):
        owner = self._vj_owner(account)
        with self._lock:
            self._vj_request += 1
            return self._lifecycle_generation, account, did, owner, self._vj_request

    def _vj_live(self, token):
        try:
            if not self._vj_live_storage(token):
                return False
            fragment = get_last_fragment()
            if fragment is None or int(fragment.getCurrentAccount()) != token[1]:
                return False
            screen = getattr(self, '_vj_native', None)
            if screen is not None and not screen.disposed and screen.peer is not None and fragment == screen.peer.java:
                return True
            return int(fragment.getDialogId()) == token[2]
        except Exception:
            return False

    def _vj_read_messages(self, storage, did, mids, owner):
        mids = sorted(set(int(mid) for mid in mids if int(mid) > 0))
        if not mids:
            return {}
        result = {}
        for offset in range(0, len(mids), 50):
            batch = mids[offset:offset + 50]
            sql = ("SELECT mid, data, date, out FROM messages_v2 WHERE uid = %d AND mid IN (%s)"
                   % (int(did), ",".join(str(mid) for mid in batch)))
            db = storage.getDatabase()
            if db is None:
                raise OSError("Message database unavailable")
            try:
                cursor = db.queryFinalized(sql)
            except TypeError:
                from java import jarray
                from java.lang import Object
                cursor = db.queryFinalized(sql, jarray(Object)([]))
            try:
                while cursor.next():
                    data = None
                    try:
                        mid = int(cursor.intValue(0))
                        if mid not in batch:
                            continue
                        data = cursor.byteBufferValue(1)
                        if data is None:
                            continue
                        message = TLRPC.Message.TLdeserialize(data, data.readInt32(False), False)
                        if message is None:
                            continue
                        message.readAttachPath(data, int(owner))
                        message.id, message.dialog_id = mid, int(did)
                        message.date = int(cursor.intValue(2))
                        result[mid] = {"mid": mid, "message": message,
                                       "text": str(getattr(message, "message", "") or "")[:65536],
                                       "date": message.date, "out": bool(cursor.intValue(3))}
                    except Exception:
                        pass
                    finally:
                        if data is not None:
                            data.reuse()
            finally:
                cursor.dispose()
        missing = [mid for mid in mids if mid not in result]
        if missing:
            try:
                result.update(self._mt_snapshot_rows(storage, did, missing, owner))
            except Exception:
                pass
        return result

    def _mt_snapshot_rows(self, storage, did, mids, owner):
        path = os.path.join(os.path.dirname(self._dm_store.path()), 'multi_tools_records_v1.sqlite')
        if not os.path.isfile(path) or os.path.islink(path):
            return {}
        account = self._vj_account(storage)
        if self._vj_owner(account) != owner:
            raise ValueError('Account owner changed')
        records = self._mt_snapshot_store().get_many(owner, account, did, mids)
        from java import jarray, jbyte
        from org.telegram.tgnet import NativeByteBuffer
        rows = {}
        for mid, (blob, date, outgoing) in records.items():
            data = None
            try:
                data = NativeByteBuffer(len(blob))
                data.writeBytes(jarray(jbyte)([value if value < 128 else value - 256 for value in blob]))
                data.rewind()
                message = TLRPC.Message.TLdeserialize(data, data.readInt32(False), False)
                if message is None:
                    raise ValueError('Message could not be decoded')
                message.readAttachPath(data, int(owner))
                message.id, message.dialog_id, message.date = mid, int(did), int(date)
                rows[mid] = {'mid': mid, 'message': message, 'text': str(getattr(message, 'message', '') or '')[:65536], 'date': int(date), 'out': bool(outgoing), '_snapshot': True}
            except Exception:
                pass
            finally:
                if data is not None:
                    data.reuse()
        return rows

    def _mt_snapshot_media(self, token, row):
        path = os.path.join(os.path.dirname(self._dm_store.path()), 'multi_tools_records_v1.sqlite')
        if not os.path.isfile(path) or os.path.islink(path):
            return None
        saved = self._mt_snapshot_store().get_media(token[3], token[1], token[2], int(row['mid']))
        if saved is None or saved.get('kind') == 'file':
            return None
        saved = dict(saved)
        saved['encrypted'] = saved['key'] is not None
        saved['key_path'] = None
        if saved['kind'] == 'sticker':
            original = row.get('message')
            doc = getattr(getattr(original, 'media', None), 'document', None)
            mime = str(getattr(doc, 'mime_type', '') or '').lower()
            saved['sticker_ext'] = {'image/webp':'webp', 'video/webm':'webm', 'application/x-tgsticker':'tgs'}.get(mime)
            if not saved['sticker_ext']:
                raise ValueError('Unsupported sticker')
        if saved['encrypted']:
            pid, birth = NativeMediaLease.process_key()
            if not str(birth).isdigit():
                raise ValueError('Process identity unavailable')
            fd, key_path = tempfile.mkstemp(prefix='.mt-key-%d-%s-' % (pid, birth), dir=os.path.dirname(path))
            try:
                with os.fdopen(fd, 'wb') as stream:
                    stream.write(saved['key'])
                    stream.flush()
                saved['key_path'] = key_path
                saved['_temporary_key'] = key_path
            except Exception:
                try: os.unlink(key_path)
                except OSError: pass
                raise
        saved.pop('key', None)
        return saved

    def _vj_attach_local_replies(self, storage, did, rows, owner):
        wanted = set()
        for row in rows:
            header = getattr(row.get('message'), 'reply_to', None)
            if header is not None and getattr(header, 'reply_to_peer_id', None) is None:
                mid = int(getattr(header, 'reply_to_msg_id', 0) or 0)
                if mid > 0:
                    wanted.add(mid)
        if not wanted:
            return
        try:
            found = self._vj_read_messages(storage, did, wanted, owner)
            for row in rows:
                header = getattr(row.get('message'), 'reply_to', None)
                if header is None or getattr(header, 'reply_to_peer_id', None) is not None:
                    continue
                item = found.get(int(getattr(header, 'reply_to_msg_id', 0) or 0))
                if item is not None:
                    row['_reply'] = item['message']
        except Exception:
            pass

    @staticmethod
    def _vj_kind(message, include_stickers=False):
        media = getattr(message, "media", None)
        if media is None:
            return None
        photo = getattr(media, "photo", None)
        if photo is not None and int(getattr(photo, "id", 0) or 0) > 0:
            return "photo"
        document = getattr(media, "document", None)
        if document is None or int(getattr(document, "id", 0) or 0) <= 0:
            return None
        mime = str(getattr(document, "mime_type", "") or "")
        if include_stickers:
            from org.telegram.messenger import MessageObject
            if MessageObject.isAnyKindOfStickerOrEmoji(document):
                return 'sticker'
        attrs = jlist(getattr(document, "attributes", None))
        if mime.startswith("video/"):
            return "round" if any(bool(getattr(a, "round_message", False)) for a in attrs) else "video"
        if mime.startswith("audio/") and any(bool(getattr(a, "voice", False)) for a in attrs):
            return "voice"
        return None

    @staticmethod
    def _vj_media_meta(message):
        meta = {}
        try:
            document = getattr(getattr(message, "media", None), "document", None)
            for attr in jlist(getattr(document, "attributes", None)):
                duration = float(getattr(attr, "duration", 0) or 0)
                if 0 < duration <= 86400 and "duration" not in meta:
                    meta["duration"] = duration
                if bool(getattr(attr, "voice", False)):
                    wave = getattr(attr, "waveform", None)
                    if wave is not None and 0 < len(wave) <= 128:
                        meta["waveform"] = bytes(int(v) & 255 for v in wave).hex()
        except Exception:
            pass
        return meta

    @staticmethod
    def _vj_expired(obj):
        message = getattr(obj, "messageOwner", None)
        media = getattr(message, "media", None)
        if media is None or int(getattr(media, "ttl_seconds", 0) or 0) == 0:
            return False
        if int(getattr(obj, "type", -1)) != 10:
            return False
        name = str(media.getClass().getSimpleName())
        return "messageMediaPhoto" in name or "messageMediaDocument" in name

    @staticmethod
    def _mt_capture_document_source(account, message):
        from org.telegram.messenger import FileLoader
        doc = getattr(getattr(message, 'media', None), 'document', None)
        if doc is None:
            return None
        loader = FileLoader.getInstance(int(account))
        paths = []
        def add(value):
            if value is None:
                return
            value = str(value.getAbsolutePath()) if hasattr(value, 'getAbsolutePath') else str(value)
            if value and os.path.isabs(value) and value not in paths:
                paths.append(value)
        add(getattr(message, 'attachPath', None))
        add(loader.getPathToMessage(message))
        add(loader.getPathToAttach(doc, True))
        add(loader.getPathToAttach(doc, False))
        for path in paths:
            encrypted = path if path.endswith('.enc') else path + '.enc'
            if not os.path.islink(encrypted) and os.path.isfile(encrypted) and os.path.getsize(encrypted) > 0:
                key = os.path.join(str(FileLoader.getInternalCacheDir().getAbsolutePath()), os.path.basename(encrypted) + '.key')
                if not os.path.islink(key) and os.path.isfile(key) and os.path.getsize(key) == 48:
                    return {'path':encrypted, 'key_path':key, 'encrypted':True, 'kind':'file'}
            if not path.endswith('.enc') and not os.path.islink(path) and os.path.isfile(path) and os.path.getsize(path) > 0:
                return {'path':path, 'key_path':None, 'encrypted':False, 'kind':'file'}
        return None

    @staticmethod
    def _vj_source(account, message, include_stickers=False):
        from org.telegram.messenger import FileLoader, AndroidUtilities
        kind = MultiToolsPlugin._vj_kind(message, include_stickers=include_stickers)
        if kind is None:
            return None
        sticker_ext = None
        if kind == 'sticker':
            mime = str(getattr(message.media.document, 'mime_type', '') or '').lower()
            sticker_ext = {'image/webp': 'webp', 'video/webm': 'webm',
                           'application/x-tgsticker': 'tgs'}.get(mime)
            if sticker_ext is None:
                return None
        loader = FileLoader.getInstance(int(account))
        paths = []
        def add(path):
            value = str(path.getAbsolutePath()) if hasattr(path, 'getAbsolutePath') else str(path or '')
            if value and os.path.isabs(value) and value not in paths:
                paths.append(value)
        add(getattr(message, 'attachPath', None))
        add(loader.getPathToMessage(message))
        if kind == 'photo':
            sizes = jlist(getattr(message.media.photo, "sizes", None))
            try:
                full = FileLoader.getClosestPhotoSizeWithSize(message.media.photo.sizes, AndroidUtilities.getPhotoSize(), False, None, True)
                if full is not None:
                    add(loader.getPathToAttach(full, True))
                    add(loader.getPathToAttach(full, False))
            except Exception:
                pass
            full_sizes = []
            for size in sizes:
                cls = str(size.getClass().getSimpleName())
                if 'Stripped' in cls or 'PathSize' in cls or 'SizeEmpty' in cls:
                    continue
                side = max(int(size.w), int(size.h))
                if side > 0:
                    full_sizes.append((side, size))
            largest = max((side for side, size in full_sizes), default=0)
            for side, size in sorted(full_sizes, key=lambda pair: pair[0], reverse=True):
                if side >= min(800, largest):
                    add(loader.getPathToAttach(size, True))
                    add(loader.getPathToAttach(size, False))
        elif getattr(message.media, 'document', None) is not None:
            add(loader.getPathToAttach(message.media.document, True))
            add(loader.getPathToAttach(message.media.document, False))
        for path in paths:
            encrypted = path if path.endswith('.enc') else path + '.enc'
            if os.path.isfile(encrypted) and os.path.getsize(encrypted) > 0:
                key = os.path.join(str(FileLoader.getInternalCacheDir().getAbsolutePath()), os.path.basename(encrypted) + '.key')
                if os.path.isfile(key) and os.path.getsize(key) == 48:
                    return {'path': encrypted, 'key_path': key, 'encrypted': True, 'kind': kind, 'size': os.path.getsize(encrypted), 'sticker_ext': sticker_ext}
            if not path.endswith('.enc') and os.path.isfile(path) and os.path.getsize(path) > 0:
                return {'path': path, 'key_path': None, 'encrypted': False, 'kind': kind, 'size': os.path.getsize(path), 'sticker_ext': sticker_ext}
        return None

    def _vj_capture_empty(self, param):
        if not self._active or not self.get_setting('dm_enabled', True) or not self.get_setting('dm_selfdestruct', False):
            return
        try:
            storage = param.thisObject
            account = self._vj_account(storage)
            account, did = self._dm_chat_scope(account, int(num(param.args[0])))
            if is_special_dialog(did):
                return
            mids = tuple(m for m in ids_of(param.args[1]) if m > 0)
            if not mids:
                return
            owner, epoch = self._vj_owner(account), self._lifecycle_generation
            archive, limit = self._vj_archive(), self._dm_media_settings()[2]
            def valid():
                try:
                    return self._active and self._lifecycle_generation == epoch and self.get_setting('dm_enabled', True) and self.get_setting('dm_selfdestruct', False) and self._vj_owner(account) == owner
                except Exception:
                    return False
            def capture():
                if not valid():
                    return
                try:
                    rows = self._vj_read_messages(storage, did, mids, owner)
                    for row in rows.values():
                        if not valid():
                            return
                        try:
                            message = row['message']
                            media = getattr(message, 'media', None)
                            if media is None or int(getattr(media, 'ttl_seconds', 0) or 0) == 0:
                                continue
                            key = archive.key(owner, account, did, row['mid'])
                            if archive.get(key) is not None:
                                continue
                            source = self._vj_source(account, message)
                            if source is not None:
                                archive.put(key, source['path'], source['kind'], source['key_path'], limit, valid, self._vj_media_meta(message))
                        except Exception:
                            pass
                except Exception:
                    pass
            storage.getStorageQueue().postRunnable(local_runnable(capture))
        except Exception:
            pass

    def _vj_on_deleted(self, context):
        try:
            if not self._active:
                return
            account, did = self._vj_scope(context)
            self._vj_deleted_page(account, did, None)
        except Exception:
            toast_err("Не удалось определить чат и аккаунт")

    def _vj_deleted_page(self, account, did, before):
        if not self._active:
            return
        token = self._vj_token(account, did)
        selected, more = self._dm_store.page(account, did, before, 'older')
        if not selected:
            toast_info('В этом чате нет сохранённых удалённых сообщений')
            self._vj_recover_request(token)
            return
        from org.telegram.messenger import MessagesStorage
        storage = MessagesStorage.getInstance(account)
        def load():
            try:
                if not self._vj_live_storage(token):
                    return
                found = self._vj_read_messages(storage, did, selected, token[3])
                rows = []
                for mid in selected:
                    if self._dm_store.has(account, did, mid):
                        rows.append(found.get(mid) or {'mid': mid, 'date': 0, 'out': False, 'text': 'Сообщение недоступно в локальной базе', 'message': None})
                self._vj_attach_local_replies(storage, did, rows, token[3])
                ui(lambda: self._vj_open_rows(token, rows, before=before, older=selected[0] if more else None) if self._vj_live(token) else None)
            except Exception:
                ui(lambda: toast_err('Не удалось прочитать удалённые сообщения') if self._vj_live(token) else None)
        storage.getStorageQueue().postRunnable(local_runnable(load))

    def _vj_load_adjacent(self, state, direction):
        token = state.token
        try:
            from org.telegram.messenger import MessagesStorage
            storage = MessagesStorage.getInstance(token[1])
            edge = int(state.rows[0 if direction == 'older' else -1]['mid'])
            def load():
                try:
                    if not self._vj_live_storage(token):
                        ui(lambda: setattr(state, 'page_loading', False))
                        return
                    selected, _ = self._dm_store.page(token[1], token[2], edge, direction)
                    if not selected:
                        def end():
                            if direction == 'older': state.top_end = True
                            else: state.bottom_end = True
                            state.page_loading = False
                        ui(end)
                        return
                    found = self._vj_read_messages(storage, token[2], selected, token[3])
                    rows = [found.get(mid) or {'mid': mid, 'date': 0, 'out': False,
                            'text': 'Сообщение недоступно в локальной базе', 'message': None} for mid in selected
                            if self._dm_store.has(token[1], token[2], mid)]
                    self._vj_attach_local_replies(storage, token[2], rows, token[3])
                    if rows:
                        ui(lambda: self._vj_open_rows(token, rows, page_state=state, direction=direction))
                    else:
                        ui(lambda: setattr(state, 'page_loading', False))
                except Exception:
                    ui(lambda: setattr(state, 'page_loading', False))
            storage.getStorageQueue().postRunnable(local_runnable(load))
        except Exception:
            state.page_loading = False

    def _vj_live_storage(self, token):
        try:
            return (self._active and token[0] == self._lifecycle_generation
                    and token[4] == self._vj_request and self._vj_owner(token[1]) == token[3])
        except Exception:
            return False

    def _vj_on_journal(self, context):
        try:
            if not self._active:
                return
            account, did = self._vj_scope(context)
            obj = context.get('message')
            if not self._vj_expired(obj):
                return
            if int(obj.getDialogId()) != did or int(getattr(obj, 'currentAccount', account)) != account:
                raise ValueError('Message context mismatch')
            token = self._vj_token(account, did)
            key = SingleMediaArchive.key(token[3], account, did, int(obj.getId()))
            self._vj_preview(token, archive_key=key, message=obj.messageOwner)
        except Exception:
            toast_err('Не удалось открыть копию этого сообщения')

    @staticmethod
    def _vj_stream(source):
        from java.io import File, FileInputStream
        if source["encrypted"]:
            from org.telegram.messenger.secretmedia import EncryptedFileInputStream
            return EncryptedFileInputStream(File(source["path"]), File(source["key_path"]))
        return FileInputStream(File(source["path"]))

    def _vj_preview(self, token, archive_key=None, message=None):
        if not self._vj_live(token):
            return
        row = {'mid': int(getattr(message, 'id', 0) or 0), 'date': int(getattr(message, 'date', 0) or 0),
               'out': bool(getattr(message, 'out', False)), 'text': str(getattr(message, 'message', '') or ''),
               'message': message, 'archive_key': archive_key}
        self._vj_open_rows(token, [row], journal=bool(archive_key))

    def _vj_open_rows(self, token, rows, before=None, older=None, journal=False, page_state=None, direction=None):
        if not self._vj_live_storage(token):
            if page_state is not None: page_state.page_loading = False
            return
        if not self._vj_workers.acquire(False):
            if page_state is not None:
                page_state.page_loading = False
            else:
                ui(lambda: (self._vj_recover_request(token), toast_info('Дождитесь открытия предыдущего медиа')))
            return
        def work():
            lease = None
            handed_off = False
            try:
                from org.telegram.messenger import FileLoader
                archive = self._vj_archive()
                cache = str(FileLoader.getDirectory(FileLoader.MEDIA_DIR_CACHE).getAbsolutePath())
                lease = NativeMediaLease(archive.root, cache, self, lambda: self._vj_live_storage(token))
                prepared = []
                for raw in rows:
                    if not self._vj_live_storage(token):
                        return
                    row = dict(raw)
                    message = row.get('message')
                    source = None
                    try:
                        if row.get('archive_key'):
                            source = archive.get(row['archive_key'])
                        elif message is not None and self._vj_kind(message, include_stickers=not journal):
                            source = self._vj_source(token[1], message, include_stickers=not journal)
                            if source is None:
                                if not journal:
                                    source = self._mt_snapshot_media(token, row)
                        if source is not None:
                            if source['size'] > self._dm_media_settings()[2]:
                                raise OverflowError('Native media size limit')
                            source = dict(source)
                            if message is not None:
                                for key, value in clean_media_meta(self._vj_media_meta(message)).items():
                                    if not source.get(key):
                                        source[key] = value
                            temporary_key = source.pop('_temporary_key', None)
                            try:
                                row['local'] = lease.add(source)
                            finally:
                                if temporary_key is not None:
                                    try: os.unlink(temporary_key)
                                    except OSError: pass
                            if row['local']['kind'] in ('voice', 'round', 'video') and not row['local'].get('duration'):
                                self._vj_file_duration(row['local'])
                            self._vj_dimensions(row['local'])
                        elif journal:
                            ui(lambda: (self._vj_recover_request(token), toast_info('Копия этого медиа не сохранена. Уже уничтоженный файл восстановить нельзя.')) if self._vj_live(token) else None)
                            return
                        else:
                            row['missing'] = self._vj_kind(message, include_stickers=not journal) if message is not None else None
                    except InterruptedError:
                        return
                    except Exception:
                        if journal:
                            raise
                        row['local'] = None
                        row['missing'] = 'media'
                    finally:
                        pending_key = source.get('_temporary_key') if isinstance(source, dict) else None
                        if pending_key is not None:
                            try: os.unlink(pending_key)
                            except OSError: pass
                    prepared.append(row)
                def show():
                    if not self._vj_live(token):
                        lease.close()
                        if page_state is not None: page_state.page_loading = False
                        return
                    try:
                        if page_state is not None:
                            page_state.attach_page(prepared, lease, direction)
                        else:
                            self._vj_present_native(token, prepared, before, older, journal, lease)
                    except Exception:
                        lease.close()
                        if page_state is not None:
                            page_state.page_loading = False
                        else:
                            self._vj_recover_request(token)
                            toast_err('Не удалось открыть сохранённые сообщения.')
                ui(show)
                handed_off = True
            except Exception:
                if page_state is None:
                    ui(lambda: (self._vj_recover_request(token), toast_err('Не удалось подготовить локальные медиа')) if self._vj_live(token) else None)
            finally:
                if lease is not None and not handed_off:
                    lease.close()
                if page_state is not None and not handed_off:
                    ui(lambda: setattr(page_state, 'page_loading', False))
                self._vj_workers.release()
        try:
            threading.Thread(target=work, name='multi_tools-native-chat', daemon=True).start()
        except Exception:
            self._vj_workers.release()
            raise

    def _vj_file_duration(self, local):
        retriever = None
        try:
            from android.media import MediaMetadataRetriever
            path = local.get('path')
            if not path or not os.path.isfile(path):
                return
            retriever = MediaMetadataRetriever()
            retriever.setDataSource(path)
            value = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION)
            seconds = float(str(value)) / 1000.0 if value is not None else 0.0
            if 0 < seconds <= 86400:
                local['duration'] = seconds
                return
        except Exception:
            pass
        finally:
            if retriever is not None:
                try:
                    retriever.release()
                except Exception:
                    pass

    @staticmethod
    def _vj_dimensions(local):
        if local['kind'] == 'sticker':
            return
        if local['kind'] == 'photo':
            from android.graphics import BitmapFactory
            options = BitmapFactory.Options()
            options.inJustDecodeBounds = True
            BitmapFactory.decodeFile(local['path'], options)
            width, height = int(options.outWidth), int(options.outHeight)
            if min(width, height) <= 0 or max(width, height) > 100000:
                raise ValueError('Invalid native photo dimensions')
            local.update(width=width, height=height)
        elif local['kind'] == 'voice':
            local.setdefault('duration', 0)
        else:
            from android.media import MediaMetadataRetriever
            retriever = MediaMetadataRetriever()
            try:
                retriever.setDataSource(local['path'])
                duration = int(retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION) or 0) / 1000.0
                if local['kind'] != 'voice':
                    width = int(retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_VIDEO_WIDTH) or 640)
                    height = int(retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_VIDEO_HEIGHT) or 360)
                    local.update(width=width, height=height)
                if duration > 0 or 'duration' not in local:
                    local.update(duration=duration)
            finally:
                retriever.release()

    def _vj_present_native(self, token, rows, before, older, journal, lease):
        from org.telegram.messenger import UserConfig
        if int(UserConfig.selectedAccount) != token[1]:
            raise ValueError('UI account changed')
        try:
            classes = native_chat_types()
        except NativeUIAPIError:
            raise
        host = get_last_fragment()
        old = getattr(self, '_vj_native', None)
        title = self._dialog_title(token[1], token[2], False).split(' · ', 1)[-1]
        state = NativeHistoryState(self, token, rows, title, before, older, journal, lease)
        state.peer = classes[0].new_instance(init_args=[state])
        state.peer.java.setCurrentAccount(token[1])
        self._vj_native = state
        try:
            replace = old is not None and not old.disposed and old.peer is not None and host == old.peer.java
            if not host.presentFragment(state.peer.java, bool(replace)):
                raise RuntimeError('Native fragment was rejected')
        except Exception:
            if self._vj_native is state:
                self._vj_native = old
            state.dispose()
            raise

    def _vj_message_object(self, token, row, viewer=False):
        from java import jarray, jbyte
        from org.telegram.messenger import MessageObject
        original = row.get('message')
        local = row.get('local')
        message = TLRPC.TL_message()
        message.id = -0x40000000 - int.from_bytes(os.urandom(4), 'big') % 0x20000000
        message.date = int(row.get('date', 0))
        message.dialog_id = token[2]
        message.out = bool(row.get('out', False))
        message.unread = False
        message.media_unread = False
        message.edit_hide = True
        message.flags = 256
        message.from_id = getattr(original, 'from_id', None)
        if message.from_id is None:
            message.from_id = TLRPC.TL_peerUser()
            message.from_id.user_id = token[3] if message.out else max(1, token[2])
        message.peer_id = getattr(original, 'peer_id', None)
        if message.peer_id is None:
            if token[2] < 0:
                message.peer_id = TLRPC.TL_peerChat()
                message.peer_id.chat_id = -token[2]
            else:
                message.peer_id = TLRPC.TL_peerUser()
                message.peer_id.user_id = token[2]
        message.message = str(row.get('text', '') or '')
        forwarded = getattr(original, 'fwd_from', None)
        if forwarded is not None:
            message.fwd_from = forwarded
            message.flags |= 4
        reply = row.get('_reply')
        if reply is not None and getattr(original, 'reply_to', None) is not None:
            message.reply_to = original.reply_to
            message.flags |= 8
        entities = getattr(original, 'entities', None)
        if entities is not None:
            message.entities.addAll(entities)
            if message.entities.size():
                message.flags |= 128
        if local is not None:
            message.flags |= 512
            message.attachPath = local['path']
            if local['kind'] == 'photo':
                media = TLRPC.TL_messageMediaPhoto()
                media.flags = 1
                photo = TLRPC.TL_photo()
                photo.id, photo.date, photo.dc_id = int(local['local_id']), message.date, -2147483648
                photo.file_reference = jarray(jbyte)([])
                size = TLRPC.TL_photoSize_layer127()
                size.type, size.w, size.h, size.size = 'x', int(local['width']), int(local['height']), int(local['size'])
                location = TLRPC.TL_fileLocationToBeDeprecated()
                location.volume_id, location.dc_id, location.local_id = -2147483648, -2147483648, int(local['local_id'])
                location.file_reference = jarray(jbyte)([])
                size.location = location
                photo.sizes.add(size)
                media.photo = photo
            else:
                media = TLRPC.TL_messageMediaDocument()
                media.flags = 1
                doc = TLRPC.TL_document()
                doc.id, doc.dc_id, doc.date = int(local['local_id']), -2147483648, message.date
                doc.file_reference = jarray(jbyte)([])
                kind = local['kind']
                doc.size, doc.mime_type, doc.localPath = int(local['size']), 'audio/ogg' if kind == 'voice' else 'video/mp4', local['path']
                if kind == 'sticker':
                    original_doc = getattr(getattr(original, 'media', None), 'document', None)
                    if original_doc is None:
                        raise ValueError('Original sticker metadata unavailable')
                    doc.mime_type = str(original_doc.mime_type)
                    doc.attributes.addAll(original_doc.attributes)
                    if local['sticker_ext'] == 'webm':
                        doc.size = 0
                    if local['sticker_ext'] == 'tgs':
                        thumb = TLRPC.TL_photoSizeEmpty()
                        thumb.type = 's'
                        doc.thumbs.add(thumb)
                    filename = TLRPC.TL_documentAttributeFilename()
                    filename.file_name = 'local_sticker.' + local['sticker_ext']
                    doc.attributes.add(filename)
                elif kind == 'voice':
                    attr = TLRPC.TL_documentAttributeAudio()
                    attr.voice, attr.flags = True, 1024
                    attr.duration = self._vj_duration(local.get('duration', 0))
                    wave = local.get('waveform')
                    if wave:
                        attr.waveform = jarray(jbyte)([v - 256 if v > 127 else v for v in bytes.fromhex(wave)])
                        attr.flags |= 4
                    doc.attributes.add(attr)
                else:
                    attr = TLRPC.TL_documentAttributeVideo()
                    attr.w, attr.h = int(local.get('width', 640)), int(local.get('height', 360))
                    attr.duration = self._vj_duration(local.get('duration', 0))
                    attr.supports_streaming = False
                    if kind == 'round' and not viewer:
                        attr.round_message = True
                        attr.flags |= 1
                    doc.attributes.add(attr)
                    if kind != 'round' or viewer:
                        filename = TLRPC.TL_documentAttributeFilename()
                        filename.file_name = 'local_video.mp4'
                        doc.attributes.add(filename)
                media.document = doc
            media.ttl_seconds = 0
            message.media = media
        else:
            if row.get('missing'):
                label = {'photo': 'Фотография', 'video': 'Видео', 'round': 'Видеосообщение', 'voice': 'Голосовое сообщение', 'sticker': 'Стикер'}.get(row['missing'], 'Медиа')
                message.message = (message.message + '\n\n' if message.message else '') + label + ' · локальная копия не найдена'
            message.media = TLRPC.TL_messageMediaEmpty()
        obj = MessageObject(token[1], message, True, False)
        if reply is not None:
            try:
                obj.replyMessageObject = MessageObject(token[1], reply, True, False)
            except Exception:
                pass
        if local is not None:
            self._vj_media_flags(obj)
        if viewer:
            self._vj_viewer_isolation(obj)
        return obj

    @staticmethod
    def _vj_viewer_isolation(obj):
        field = java_field('org.telegram.messenger.MessageObject', 'scheduled')
        if field is None or str(field.getType().getName()) != 'boolean':
            raise NativeUIAPIError('message_field_scheduled')
        field.setBoolean(obj, True)
        if not field.getBoolean(obj):
            raise NativeUIAPIError('message_field_scheduled')

    @staticmethod
    def _vj_duration(value):
        field = java_field('org.telegram.tgnet.TLRPC$DocumentAttribute', 'duration')
        try:
            if field is not None and str(field.getType().getName()) == 'double':
                return float(value or 0)
        except Exception:
            pass
        return int(round(float(value or 0)))

    @staticmethod
    def _vj_media_flags(obj):
        for name in ('mediaExists', 'attachPathExists'):
            field = java_field('org.telegram.messenger.MessageObject', name)
            if field is None:
                raise NativeUIAPIError('message_field_' + name)
            field.setBoolean(obj, True)

    @staticmethod
    def _vj_boolean_field(obj, name):
        field = java_field('org.telegram.messenger.MessageObject', name)
        return bool(field.getBoolean(obj)) if field is not None else None

    def _vj_history_object(self, obj):
        state = getattr(self, '_vj_native', None)
        if state is None or state.disposed or obj is None:
            return False
        return ident(obj) in state.history_keys

    def _vj_freeze_history_round(self, cell):
        state = getattr(self, '_vj_native', None)
        if state is None or state.disposed or cell is None:
            return
        try:
            obj = cell.getMessageObject()
            if obj is not None and self._vj_history_object(obj) and obj.isRoundVideo():
                state._round_freeze(cell)
        except Exception:
            pass

    @staticmethod
    def _vj_spec_viewer(name, types):
        if name == 'openMedia' and types == ['org.telegram.messenger.MessageObject',
                'org.telegram.ui.PhotoViewer$PhotoViewerProvider', 'java.lang.Runnable', 'java.lang.Runnable']:
            return 'journal_view'
        return None

    def _vj_capture_viewer(self, param):
        if not self._active or not self.get_setting('dm_enabled', True) or not self.get_setting('dm_selfdestruct', False):
            return
        handles, acquired, handed_off = [], False, False
        try:
            obj = param.args[0]
            if obj is None or not param.thisObject.isVisible() or ident(param.thisObject.getCurrentMessageObject()) != ident(obj):
                return
            message, account = obj.messageOwner, int(obj.currentAccount)
            did, mid = int(obj.getDialogId()), int(obj.getId())
            if not 0 <= account < 32 or mid <= 0 or not did or is_special_dialog(did):
                return
            if int(getattr(getattr(message, 'media', None), 'ttl_seconds', 0) or 0) <= 0 or self._vj_kind(message) is None:
                return
            owner, epoch = self._vj_owner(account), self._lifecycle_generation
            if not self._vj_capture_slots.acquire(False):
                return
            acquired = True
            source = self._vj_source(account, message)
            if source is None:
                return
            limit = self._dm_media_settings()[2]
            if source['size'] > limit:
                return
            paths = []
            for path in [source['path']] + ([source['key_path']] if source['encrypted'] else []):
                handle = open(path, 'rb')
                handles.append(handle)
                paths.append('/proc/self/fd/%d' % handle.fileno())
            if os.fstat(handles[0].fileno()).st_size != source['size'] or (source['encrypted'] and os.fstat(handles[1].fileno()).st_size != 48):
                raise OSError('Source changed before pin')
            from org.telegram.messenger import MessagesStorage
            storage = MessagesStorage.getInstance(account)
            archive = self._vj_archive()
            key = archive.key(owner, account, did, mid)
            meta = self._vj_media_meta(message)
            def valid():
                try:
                    return self._active and self._lifecycle_generation == epoch and self.get_setting('dm_enabled', True) and self.get_setting('dm_selfdestruct', False) and self._vj_owner(account) == owner
                except Exception:
                    return False
            def capture():
                try:
                    if not valid():
                        return
                    archive.put(key, paths[0], source['kind'], paths[1] if source['encrypted'] else None, limit, valid, meta)
                except Exception:
                    pass
                finally:
                    for handle in handles:
                        handle.close()
                    self._vj_capture_slots.release()
            storage.getStorageQueue().postRunnable(local_runnable(capture))
            handed_off = True
        except Exception:
            pass
        finally:
            if not handed_off:
                for handle in handles:
                    handle.close()
                if acquired:
                    self._vj_capture_slots.release()

    def _vj_viewer_menu(self, menu):
        try:
            from org.telegram.messenger import LocaleController, R
            allowed = set()
            for name in ('SaveToGallery', 'ShareFile', 'OpenInExternalApp'):
                try:
                    value = str(LocaleController.getString(name, int(getattr(R.string, name, 0)))).strip()
                    if value and not value.startswith('LOC_ERR'):
                        allowed.add(value)
                except Exception:
                    continue
            popup = menu.getPopupLayout()
            count = int(popup.getItemsCount())
            if not 0 < count <= 128:
                raise NativeUIAPIError('viewer_popup_items')
            hidden, kept = [], 0
            for index in range(count):
                item = popup.getItemAt(index)
                try:
                    text_view = item.getTextView()
                    label = str(text_view.getText()).strip()
                except Exception:
                    label = None
                if label is not None and label in allowed:
                    kept += 1
                else:
                    hidden.append(item)
            if kept:
                return hidden
        except Exception:
            pass
        return [menu]

    def _vj_native_viewer(self, state, cell, row):
        from android.view import View
        from org.telegram.messenger import UserConfig
        from org.telegram.ui import PhotoViewer
        if not state.live() or int(UserConfig.selectedAccount) != state.token[1]:
            return
        if not os.path.isfile(row['local']['path']):
            raise FileNotFoundError('Native preview was removed')
        viewer = PhotoViewer.getInstance()
        if viewer.isVisible():
            return
        viewer.setParentActivity(state.peer.java)
        field_names = ['menuItem', 'sendItem', 'pipItem', 'editItem', 'masksItem', 'deleteItem']
        fields = {}
        for name in field_names:
            field = java_field('org.telegram.ui.PhotoViewer', name)
            if field is None:
                if name in ('menuItem', 'sendItem'):
                    raise NativeUIAPIError('viewer_field_' + name)
                continue
            fields[name] = field.get(viewer)
        obj = self._vj_message_object(state.token, row, viewer=True)
        provider = native_chat_types()[4].new_instance(init_args=[state, cell, row])
        messages = ArrayList()
        messages.add(obj)
        state.provider, state.viewer_object = provider, obj
        try:
            from java import jint, jlong as prim_long
            topic = prim_long(0) if _NATIVE_CHAT_ABI['open'][4] == 'long' else jint(0)
            if not viewer.openPhoto(messages, jint(0), prim_long(0), prim_long(0), topic, provider.java):
                raise RuntimeError('Native PhotoViewer rejected local photo')
            hidden = self._vj_viewer_menu(fields['menuItem'])
            hidden += [fields[name] for name in ['sendItem', 'pipItem', 'editItem', 'masksItem', 'deleteItem'] if fields.get(name) is not None]
            state._viewer_restore = []
            for control in hidden:
                state._viewer_restore.append((control, int(control.getVisibility())))
                control.setVisibility(View.GONE)
        except Exception:
            state.close_viewer()
            raise

    def _vj_remove_copy(self, state):
        if not state.live() or not state.journal or not state.rows:
            return
        key = state.rows[0].get('archive_key')
        if key is None:
            return
        def remove():
            if not state.live():
                return
            try:
                state.close_viewer()
                self._vj_archive().remove(key)
                state.peer.java.finishFragment()
            except Exception:
                toast_err('Не удалось удалить локальную копию')
        self._confirm('Удалить сохранённую копию?', 'Будет удалена только копия этого медиа на устройстве. Обычная история и другие копии не затрагиваются.', 'Удалить', remove)

    def _vj_recover_request(self, token):
        state = getattr(self, '_vj_native', None)
        if state is not None and not state.disposed and state.token[:4] == token[:4] and self._vj_live(token):
            if state.peer is not None and get_last_fragment() == state.peer.java:
                state.token = token

    def _ensure_state(self):
        if not self._mutes_loaded:
            self._reload_mutes()
        if self._labels is None:
            self._load_labels()

    def _reload_mutes(self):
        try:
            raw = self.get_setting(SETTING_MUTES, "")
            self._mutes = MuteStore(raw if isinstance(raw, str) else "")
            self._mutes_loaded = True
        except Exception:
            pass

    def _persist_mutes(self, reload_settings=False):
        payload = self._mutes.dump()
        try:
            self.set_setting(SETTING_MUTES, payload, reload_settings)
            return str(self.get_setting(SETTING_MUTES, "")) == payload
        except Exception:
            return False

    def _load_labels(self):
        data = {}
        try:
            parsed = json.loads(self.get_setting(SETTING_LABELS, "") or "{}")
            if isinstance(parsed, dict):
                for key, value in parsed.items():
                    if isinstance(value, dict):
                        data[key] = {"n": str(value.get("n", ""))[:96], "u": str(value.get("u", ""))[:64]}
        except Exception:
            pass
        self._labels = data

    def _remember_label(self, account, user_id, user):
        if user is None:
            return
        entry = {"n": tidy_text(display_name(user)), "u": public_username(user)}
        if not entry["n"] and not entry["u"]:
            return
        key = mute_key(account, user_id)
        with self._lock:
            if self._labels.get(key) == entry:
                return
            self._labels[key] = entry
            live = {mute_key(a, u) for a, _d, users in self._mutes.entries() for u in users}
            live.add(key)
            self._labels = {k: v for k, v in self._labels.items() if k in live}
            payload = json.dumps(self._labels, ensure_ascii=False, sort_keys=True)
        try:
            self.set_setting(SETTING_LABELS, payload)
        except Exception:
            pass

    def _stored_label(self, account, user_id):
        with self._lock:
            return (self._labels or {}).get(mute_key(account, user_id)) or {}

    def _user_label(self, account, user_id):
        user = self._get_user(account, user_id)
        stored = self._stored_label(account, user_id)
        name = tidy_text(display_name(user)) or stored.get("n", "")
        username = public_username(user) or stored.get("u", "")
        sub = ("@%s · " % username if username else "") + "ID %d" % int(user_id)
        return name or "ID %d" % int(user_id), sub

    def _get_user(self, account, user_id):
        try:
            return get_messages_controller(int(account)).getUser(jlong(user_id))
        except Exception:
            return None

    def _get_chat(self, account, chat_id):
        try:
            return get_messages_controller(int(account)).getChat(jlong(chat_id))
        except Exception:
            return None

    def _dialog_title(self, account, dialog_id, with_account):
        dialog_id = int(dialog_id)
        if dialog_id > 0:
            name = tidy_text(display_name(self._get_user(account, dialog_id))) \
                or self._stored_label(account, dialog_id).get("n", "")
            title = "Личка · %s" % (name or "ID %d" % dialog_id)
        else:
            chat = self._get_chat(account, -dialog_id)
            name = tidy_text(getattr(chat, "title", "") or "") if chat is not None else ""
            title = "Чат · %s" % (name or "ID %d" % dialog_id)
        return "%s · акк. %d" % (title, int(account) + 1) if with_account else title

    def on_plugin_load(self):
        with self._lock:
            self._dm_purge_generation = getattr(self, "_dm_purge_generation", 0) + 1
            self._active = True
            self._lifecycle_generation = getattr(self, "_lifecycle_generation", 0) + 1
        self._register_chat_menu()
        self._reload_mutes()
        self._load_labels()
        try:
            self.add_on_send_message_hook()
        except Exception:
            pass
        for name in NEW_MESSAGE_UPDATES + SHORT_MESSAGE_UPDATES:
            try:
                self.add_hook(name)
            except Exception:
                pass
        self._register_observers()
        self._dm_cfg_cache = None
        try:
            self._dm_store.load()
            if self._dm_store.read_only:
                toast_err("Не удалось прочитать архив удалённых. Исходный файл сохранён, запись отключена.")
        except Exception:
            pass
        try:
            self._mt_reconcile_start()
        except Exception:
            pass
        try:
            self._dm_install()
        except Exception:
            if getattr(self, "_mt_hooks_state", None) is None:
                self._mt_hooks_state = {"critical": ["install"]}
        try:
            self._dm_purge_own()
        except Exception:
            pass
        try:
            self._vj_archive()
        except Exception:
            pass

    def on_plugin_unload(self):
        self._unregister_observers()
        with self._lock:
            self._dm_purge_generation = getattr(self, "_dm_purge_generation", 0) + 1
            self._active = False
            self._lifecycle_generation = getattr(self, "_lifecycle_generation", 0) + 1
        self._unregister_chat_menu()
        self._vj_request += 1
        dialog, self._vj_window = self._vj_window, None
        if dialog is not None:
            def dismiss_old():
                try:
                    dialog.dismiss()
                except Exception:
                    pass
            ui(dismiss_old)
        native, self._vj_native = getattr(self, '_vj_native', None), None
        if native is not None:
            def close_native_old():
                try:
                    native.dispose()
                except Exception:
                    pass
                try:
                    if native.peer is not None:
                        native.peer.java.finishFragment()
                except Exception:
                    pass
            ui(close_native_old)
        archive, self._vj_files = self._vj_files, None
        if archive is not None:
            try:
                archive.close()
            except Exception:
                pass
        ui(self._dm_media_stop)
        self._dm_cfg_cache = None
        try:
            self._dm_store.close()
        except Exception:
            pass
        with self._lock:
            for table in (self._handled, self._command_guard, self._command_echo,
                          self._own_notices, self._spam_runs, self._spam_last):
                table.clear()
        try:
            self._dm_unload_ui()
        except Exception:
            pass

    def _dm_unload_ui(self):
        ticks, self._dm_ticks = self._dm_ticks, []
        dimmed = dict(self._dm_dimmed)

        def _run():
            for cell, tick in ticks:
                try:
                    cell.removeCallbacks(tick)
                except Exception:
                    pass
            if not dimmed:
                return
            try:
                fragment = get_last_fragment()
                list_view = fragment.getChatListView() if fragment is not None and \
                    str(fragment.getClass().getName()) == "org.telegram.ui.ChatActivity" else None
                if list_view is not None:
                    for i in range(int(list_view.getChildCount())):
                        view = list_view.getChildAt(i)
                        key = ident(view)
                        if key in dimmed:
                            view.setAlpha(1.0)
            except Exception:
                pass
        ui(_run)
        for table in (self._dm_dimmed, self._dm_pend, self._dm_clear,
                      self._dm_migr, self._dm_dedup, self._dm_live, self._dm_info_views):
            table.clear()
        self._dm_preview_views = []
        self._dm_palette_views = []
        self._dm_master_rows = []
        self._dm_master_native = {}
        self._dm_listeners = []

    def _account_list(self):
        result = []
        try:
            for index in range(int(UserConfig.MAX_ACCOUNT_COUNT)):
                try:
                    if UserConfig.getInstance(index).isClientActivated():
                        result.append(index)
                except Exception:
                    pass
        except Exception:
            pass
        return result

    def _register_observers(self, accounts=None):
        with self._lock:
            wanted = accounts if accounts is not None else self._account_list()
            targets = [int(a) for a in wanted
                       if int(a) not in self._observed and int(a) not in self._observing]
            self._observing.update(targets)
        if not targets:
            return

        def _run():
            with self._lock:
                self._observing.difference_update(targets)
                if not self._active:
                    return
                try:
                    if self._observer is None:
                        self._observer = observer_class()(self)
                    observer = self._observer
                except Exception:
                    return
            for account in targets:
                try:
                    for event in (NotificationCenter.didReceiveNewMessages,
                                  NotificationCenter.fileLoaded, NotificationCenter.fileLoadFailed):
                        NotificationCenter.getInstance(account).addObserver(observer, event)
                    with self._lock:
                        self._observed.add(account)
                except Exception:
                    pass

        ui(_run)

    def _unregister_observers(self):
        with self._lock:
            self._active = False
            observer, targets = self._observer, sorted(self._observed)
            self._observed.clear()
            self._observing.clear()
            self._observer = None
        if observer is None or not targets:
            return

        def _run():
            for account in targets:
                try:
                    for event in (NotificationCenter.didReceiveNewMessages,
                                  NotificationCenter.fileLoaded, NotificationCenter.fileLoadFailed):
                        NotificationCenter.getInstance(account).removeObserver(observer, event)
                except Exception:
                    pass

        try:
            run_on_ui_thread(_run)
        except Exception:
            pass

    def _ensure_observer(self, account):
        with self._lock:
            known = int(account) in self._observed
        if not known:
            self._register_observers([int(account)])

    def create_settings(self):
        self._ensure_state()
        cfg = self._command_config()
        command = lambda name: cfg["prefix"] + cfg[name]
        status = lambda key: "Включено" if self.get_setting(key, True) else "Выключено"
        mutes, saved = self._mutes.total(), self._dm_store.total()
        bots = self._nv_bots()
        if self._choice("nv_mode", NV_BLACKLIST, (NV_BLACKLIST, NV_WHITELIST)) == NV_WHITELIST:
            nv_scope = ("только %d %s" % (len(bots), plural_word(len(bots), ("бот", "бота", "ботов")))
                        if bots else "список пуст")
        else:
            nv_scope = "все боты, кроме %d" % len(bots) if bots else "все боты"
        items = [
            self._mt_hero_row(),
            Divider(),
            Header(text="Модули"),
            Text(text="Мут", subtext="%s · %s" % (status("mute_enabled"), "в муте %d" % mutes if mutes else "список пуст"),
                 icon="msg_mute", create_sub_fragment=self._page_mute, link_alias="mute",
                 on_long_click=self._mt_quick_toggle("mute_enabled", "Мут")),
            Text(text="Удаление", subtext="%s · %s N" % (status("del_enabled"), command("del")),
                 icon="msg_delete", create_sub_fragment=self._page_del, link_alias="del",
                 on_long_click=self._mt_quick_toggle("del_enabled", "Удаление")),
            Text(text="Спам", subtext="%s · %s N текст" % (status("spam_enabled"), command("spam")),
                 icon="msg_forward", create_sub_fragment=self._page_spam, link_alias="spam",
                 on_long_click=self._mt_quick_toggle("spam_enabled", "Спам")),
            Text(text="Удалённые сообщения", subtext="%s · сохранено %d" % (status("dm_enabled"), saved),
                 icon="msg_archive", create_sub_fragment=self._page_deleted, link_alias="deleted",
                 on_long_click=self._mt_quick_toggle("dm_enabled", "Сохранение удалённых")),
            Text(text="No Via", subtext="%s · %s" % (status("nv_enabled"), nv_scope), icon="msg_bot",
                 create_sub_fragment=self._page_no_via, link_alias="no_via",
                 on_long_click=self._mt_quick_toggle("nv_enabled", "No Via")),
        ]
        items += [
            Divider(text="Удерживайте модуль, чтобы быстро включить или выключить его." if SETTINGS_LONG_CLICK else None),
            Header(text="Общие"),
            Text(text="Команды", subtext="Префикс «%s» · %s" % (cfg["prefix"], " ".join(command(f) for f, _l in COMMAND_FIELDS[1:])),
                 icon="msg_edit", create_sub_fragment=self._page_commands, link_alias="commands"),
            Text(text="Проверить обновления", subtext="Установлена версия %s" % __version__, icon="msg_download",
                 on_click=self._on_check_updates, link_alias="updates"),
            Divider(),
        ]
        return items

    def _mt_status(self):
        if not getattr(self, "_active", False):
            return "wait", "Плагин не запущен"
        hooks = getattr(self, "_mt_hooks_state", None)
        if hooks is None:
            return "wait", "Модули запускаются…"
        if hooks["critical"]:
            return "warn", "Защита удалённых работает не полностью"
        if getattr(self._dm_store, "read_only", False):
            return "warn", "Архив удалённых только для чтения"
        enabled = sum(1 for key, _label in MT_MODULES if self.get_setting(key, True))
        return "ok", "Включено модулей: %d из %d" % (enabled, len(MT_MODULES))

    def _mt_quick_toggle(self, key, label):
        def _apply(value):
            if key == "dm_enabled":
                self._ui_deleted_toggle(value)
            else:
                self.set_setting(key, value, True)
            toast_info("%s: %s" % (label, "включено" if value else "выключено"))

        def _toggle(*_args):
            try:
                value = not self.get_setting(key, True)
                if key == "dm_enabled" and not value:
                    self._confirm("Выключить сохранение?", "Новые удалённые сообщения перестанут сохраняться.",
                                  "Выключить", lambda: _apply(False))
                else:
                    _apply(value)
            except Exception:
                pass
            return True
        return _toggle

    def _mt_hero_row(self):
        if self._dm_custom_ok():
            try:
                factory = self._dm_factories.get("hero")
                if factory is None:
                    try:
                        factory = SimpleSettingFactory(self._mt_hero_create, self._mt_hero_bind, is_clickable=False,
                                                       content_equals=lambda *_args: False)
                    except TypeError:
                        factory = SimpleSettingFactory(self._mt_hero_create, self._mt_hero_bind, is_clickable=False)
                    self._dm_factories["hero"] = factory
                return Custom(factory=factory.instance.java)
            except Exception:
                pass
        return Text(text="MultiTools %s" % __version__, subtext=self._mt_status()[1], icon="msg_info")

    def _mt_hero_create(self, context, list_view, current_account, class_guid, resources_provider):
        try:
            from android.widget import FrameLayout, LinearLayout, TextView
            from android.view import Gravity
            dp = self._dm_dp
            root = LinearLayout(context)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setGravity(Gravity.CENTER_HORIZONTAL)
            root.setPadding(dp(16), dp(22), dp(16), dp(20))
            root.setBackgroundColor(self._dm_theme("key_windowBackgroundWhite", 0xFFFFFFFF))
            box = FrameLayout(context)
            emoji = TextView(context)
            emoji.setText("🧰")
            emoji.setTextSize(54.0)
            emoji.setGravity(Gravity.CENTER)
            box.addView(emoji, FrameLayout.LayoutParams(-1, -1))
            try:
                from org.telegram.ui.Components import BackupImageView
                box.addView(BackupImageView(context), FrameLayout.LayoutParams(-1, -1))
            except Exception:
                pass
            root.addView(box, LinearLayout.LayoutParams(dp(100), dp(100)))
            for size, top in ((21.0, 12), (14.0, 3), (13.0, 14)):
                label = TextView(context)
                label.setTextSize(size)
                label.setGravity(Gravity.CENTER)
                params = LinearLayout.LayoutParams(-2, -2)
                params.topMargin = dp(top)
                root.addView(label, params)
            title, subtitle, badge = root.getChildAt(1), root.getChildAt(2), root.getChildAt(3)
            title.setText("MultiTools")
            title.setTypeface(self._mt_bold())
            title.setTextColor(self._dm_theme("key_windowBackgroundWhiteBlackText", 0xFF222222))
            subtitle.setTextColor(self._dm_theme("key_windowBackgroundWhiteGrayText", 0xFF8A8A8A))
            badge.setPadding(dp(12), dp(5), dp(12), dp(5))
            badge.setTypeface(self._mt_bold())
            self._mt_hero_fill(root)
            return self._dm_full_width(root)
        except Exception:
            return self._dm_error_view(context)

    def _mt_hero_bind(self, view, item, divider, adapter, list_view):
        try:
            self._mt_hero_fill(view)
        except Exception:
            pass

    def _mt_hero_fill(self, root):
        from android.view import View
        from android.graphics.drawable import GradientDrawable
        box, subtitle, badge = root.getChildAt(0), root.getChildAt(2), root.getChildAt(3)
        subtitle.setText("Версия %s" % __version__)
        level, text = self._mt_status()
        if level == "ok":
            color = self._mt_color(("key_windowBackgroundWhiteGreenText", "key_windowBackgroundWhiteGreenText2"), 0xFF26A65B)
            text = "✓  " + text
        elif level == "warn":
            color = self._mt_color(("key_text_RedRegular", "key_windowBackgroundWhiteRedText", "key_dialogTextRed"), 0xFFE53935)
            text = "⚠  " + text
        else:
            color = self._mt_color(("key_windowBackgroundWhiteGrayText",), 0xFF8A8A8A)
        badge.setText(text)
        badge.setTextColor(color)
        background = GradientDrawable()
        background.setCornerRadius(float(self._dm_dp(14)))
        background.setColor((int(color) & 0x00FFFFFF) | 0x22000000)
        badge.setBackground(background)
        image = box.getChildAt(1) if int(box.getChildCount()) > 1 else None
        shown = False
        if image is not None and not getattr(self, "_mt_no_sticker", False):
            try:
                from org.telegram.messenger import MediaDataController
                name, _sep, index = __icon__.partition("/")
                MediaDataController.getInstance(UserConfig.selectedAccount).setPlaceholderImageByIndex(
                    image, name, int(index or 0), "100_100")
                shown = True
            except Exception:
                self._mt_no_sticker = True
        if image is not None:
            image.setVisibility(View.VISIBLE if shown else View.GONE)
        box.getChildAt(0).setVisibility(View.GONE if shown else View.VISIBLE)

    @staticmethod
    def _mt_color(keys, fallback):
        try:
            from org.telegram.ui.ActionBar import Theme
            for key in keys:
                if hasattr(Theme, key):
                    return int(Theme.getColor(getattr(Theme, key)))
        except Exception:
            pass
        return signed_color(fallback)

    @staticmethod
    def _mt_bold():
        try:
            from org.telegram.messenger import AndroidUtilities
            try:
                return AndroidUtilities.bold()
            except Exception:
                return AndroidUtilities.getTypeface("fonts/rmedium.ttf")
        except Exception:
            from android.graphics import Typeface
            return Typeface.DEFAULT_BOLD

    def _on_check_updates(self, *_args):
        try:
            if self._updater is None:
                self._updater = build_updater(__id__, __version__)
            self._updater.check()
        except Exception as exc:
            toast_err("Проверка не запущена: " + type(exc).__name__)

    def _page_mute(self):
        self._ensure_state()
        cfg = self._command_config()
        total = self._mutes.total()
        return [
            Header(text="Мут"),
            Switch(key="mute_enabled", text="Включить мут", default=True, icon="msg_mute",
                   subtext="%s%s @user · %s%s @user" % (cfg["prefix"], cfg["mute"], cfg["prefix"], cfg["unmute"])),
            Text(text="Список мутов",
                 subtext="%d %s" % (total, plural_word(total, ("пользователь", "пользователя", "пользователей")))
                 if total else "Список пуст",
                 icon="msg_contacts", create_sub_fragment=self._page_mute_list, link_alias="mute_list"),
            Divider(text="Или ответьте %s%s на сообщение пользователя." % (cfg["prefix"], cfg["mute"])),
            Header(text="Удаление сообщений"),
            Selector(key="mute_mode", text="Где удалять", default=MODE_ONLY_ME,
                     items=DELETE_MODES, icon="msg_delete"),
            Switch(key="mute_edits", text="Удалять изменения", default=True, icon="msg_edit"),
            Divider(text="Удаление у всех в группах зависит от прав администратора."),
            Header(text="Ответы в чате"),
            Switch(key="mute_silent", text="Тихий режим", default=True, icon="msg_notifications",
                   subtext="Без сообщений о муте и размуте"),
            Text(text="Тексты ответов", subtext="Мут и размут", icon="msg_edit",
                 create_sub_fragment=self._page_mute_notices),
            Divider(),
            Header(text="Управление"),
            Text(text="Снять все муты", subtext="Во всех чатах и аккаунтах", icon="msg_clear",
                 red=True, on_click=self._on_clear_mutes),
            Divider(),
        ]

    def _page_mute_list(self):
        self._ensure_state()
        with self._lock:
            entries = self._mutes.entries()
        if not entries:
            cmd = self._command_text("mute")
            return [
                Header(text="Замученные"),
                Text(text="Пока никого", icon="msg_info"),
                Divider(text="Отправьте %s @user или ответьте %s на сообщение" % (cmd, cmd)),
            ]
        items = []
        multi = len({a for a, _d, _u in entries}) > 1
        for index, (account, dialog_id, users) in enumerate(entries):
            if index:
                items.append(Divider())
            items.append(Header(text=self._dialog_title(account, dialog_id, multi)))
            for user_id in users:
                title, sub = self._user_label(account, user_id)
                items.append(Text(text=title, subtext=sub, icon="msg_mute",
                                  on_click=self._unmute_click(account, dialog_id, user_id)))
        items.append(Divider(text="Нажмите на пользователя, чтобы снять мут · всего: %d" % self._mutes.total()))
        return items

