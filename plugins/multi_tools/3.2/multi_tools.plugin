    def _page_nv_bots(self):
        bots = self._nv_bots()
        whitelist = self.get_setting("nv_mode", NV_BLACKLIST) == NV_WHITELIST
        items = [
            Header(text="Добавить"),
            Input(key="nv_new_bot", text="Юзернейм бота", default="", icon="msg_add",
                  on_change=self._nv_on_new_bot),
            Divider(text="Можно несколько через запятую"),
            Header(text="Только эти боты" if whitelist else "Исключения"),
        ]
        if bots:
            for bot in bots:
                items.append(Text(text="@" + bot, subtext="Нажмите, чтобы убрать", icon="msg_bot",
                                  on_click=lambda _v, n=bot: self._nv_remove_bot(n)))
        else:
            items.append(Text(text="Список пуст", icon="msg_info"))
        recent = [r for r in self._nv_recent() if r not in bots]
        if recent:
            items += [Divider(), Header(text="Недавние inline-боты")]
            for bot in recent:
                items.append(Text(text="@" + bot, subtext="Нажмите, чтобы добавить", icon="msg_add",
                                  accent=True, on_click=lambda _v, n=bot: self._nv_add_bot(n)))
        if bots:
            items += [Divider(), Text(text="Очистить список", subtext="Ботов в списке: %d" % len(bots),
                                      icon="msg_clear", red=True,
                                      on_click=lambda _v: self._confirm(
                                          "Очистить список?", "Все боты будут убраны из списка.", "Очистить",
                                          lambda: self._nv_save_bots([])))]
        items.append(Divider())
        return items

    def _reload_settings(self):
        try:
            self.set_setting("_ui_tick", str(time.time()), True)
        except Exception:
            pass

    def _number_check(self, key, default, minimum, maximum, fraction):
        pattern = re.compile(r"[0-9]{1,3}([.,][0-9])?" if fraction else r"[0-9]{1,3}")

        def canonical(value):
            raw = str(value if value is not None else "").strip()
            if not pattern.fullmatch(raw):
                return None
            number = float(raw.replace(",", "."))
            if not minimum <= number <= maximum:
                return None
            return str(round(number, 1)) if fraction else str(int(number))

        read = self._float_setting if fraction else self._int_setting
        last = [canonical(read(key, default, minimum, maximum))]
        if self.get_setting(key, None) != last[0]:
            self.set_setting(key, last[0], reload_settings=False)

        def _check(value):
            normalized = canonical(value)
            if normalized is None:
                self.set_setting(key, last[0], reload_settings=True)
                message = "Нужно число от %d до %d" % (minimum, maximum)
                if fraction:
                    message += ", не более одного знака после запятой"
                toast_err(message)
                return
            last[0] = normalized
            if self.get_setting(key, None) != normalized:
                self.set_setting(key, normalized, reload_settings=False)
        return _check

    def _int_setting(self, key, default, minimum, maximum):
        try:
            value = int(str(self.get_setting(key, str(default))).strip())
        except Exception:
            value = default
        return max(minimum, min(maximum, value))

    def _float_setting(self, key, default, minimum, maximum):
        try:
            value = round(float(str(self.get_setting(key, str(default))).strip().replace(",", ".")), 1)
        except Exception:
            value = default
        return max(minimum, min(maximum, value))

    def _choice(self, key, default, allowed):
        try:
            value = int(self.get_setting(key, default))
        except Exception:
            return default
        return value if value in allowed else default

    def _validate_commands(self):
        _cfg, error = check_command_config(self._read_commands())
        if error:
            toast_err(error + " · работают команды по умолчанию")

    def _on_commands_reset(self, _view=None):
        self._confirm("Сбросить команды?", "Префикс и имена команд вернутся к значениям по умолчанию.",
                      "Сбросить", self._reset_commands_now)

    def _read_commands(self):
        return {f: self.get_setting("cmd_" + f, DEFAULT_COMMANDS[f]) for f, _l in COMMAND_FIELDS}

    def _command_config(self):
        config, _error = check_command_config(self._read_commands())
        return config or dict(DEFAULT_COMMANDS)

    def _command_text(self, action):
        cfg = self._command_config()
        return cfg["prefix"] + cfg[action]

    def _unmute_click(self, account, dialog_id, user_id):
        def _click(_view=None):
            title, _sub = self._user_label(account, user_id)
            with self._lock:
                changed = self._mutes.remove(account, dialog_id, user_id)
                saved = self._persist_mutes() if changed else True
            if not changed:
                toast_info("Этот мут уже снят")
            elif not saved:
                toast_err("Мут снят, но не сохранился")
            else:
                toast_ok("Мут снят: %s" % title)
            if changed:
                self._reload_settings()
        return _click

    @staticmethod
    def _confirm(title, message, ok_text, action):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment is not None else None
        if activity is None:
            toast_err("Не удалось показать подтверждение — действие отменено")
            return

        def _ok(dialog, _which):
            try:
                dialog.dismiss()
            except Exception:
                pass
            try:
                action()
            except Exception:
                pass

        builder = AlertDialogBuilder(activity)
        builder.set_title(title)
        builder.set_message(message)
        builder.set_positive_button(ok_text, _ok)
        builder.set_negative_button("Отмена", lambda d, _w: d.dismiss())
        builder.set_cancelable(True)
        builder.show()

    def _on_clear_mutes(self, _view=None):
        self._confirm("Снять все муты?", "Списки очистятся во всех чатах и аккаунтах.", "Очистить",
                      self._clear_mutes_now)

    def _clear_mutes_now(self):
        with self._lock:
            self._mutes.clear()
            saved = self._persist_mutes(True)
        (toast_ok if saved else toast_err)("Муты сняты" if saved else "Не удалось сохранить")

    def _prune(self, now):
        with self._lock:
            if len(self._command_guard) + len(self._command_echo) + len(self._own_notices) + len(self._handled) < 128:
                return
            for table, ttl in ((self._command_guard, GUARD_TTL), (self._command_echo, COMMAND_ECHO_TTL),
                               (self._own_notices, GUARD_TTL), (self._handled, HANDLED_TTL)):
                for key in [k for k, ts in table.items() if now - ts > ttl]:
                    table.pop(key, None)

    def _mark_handled(self, account, dialog_id, message_id):
        key = (int(account), int(dialog_id), int(message_id))
        now = time.time()
        with self._lock:
            seen = self._handled.get(key)
            if seen is not None and now - seen < HANDLED_TTL:
                return False
            self._handled[key] = now
        return True

    def _my_id(self, account):
        try:
            return int(get_user_config(int(account)).getClientUserId() or 0)
        except Exception:
            return 0

    def on_send_message_hook(self, account, params):
        try:
            self._ensure_state()
            self._ensure_observer(account)
            text = getattr(params, "message", None)
            if isinstance(text, str) and text:
                result = self._command_hook(account, params, text)
                if result is not None:
                    return result
            fixed = self._dm_reply_fix(account, params)
            result = self._no_via_hook(account, params)
            if fixed and getattr(result, "strategy", None) not in (HookStrategy.CANCEL, HookStrategy.MODIFY):
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            return result
        except Exception:
            return HookResult()

    def _dm_reply_fix(self, account, params):
        try:
            reply = getattr(params, "replyToMsg", None)
            if reply is None or not self._dm_obj_deleted(account, reply):
                return False
            reply_id = int(reply.getId())
            quote_text = ""
            quote = getattr(params, "quote", None)
            if quote is not None:
                try:
                    quote_text = str(getattr(quote, "text", None) or "")
                except Exception:
                    quote_text = ""
            if not quote_text:
                try:
                    quote_text = str(reply.messageOwner.message or "")
                except Exception:
                    quote_text = ""
            if not quote_text:
                quote_text = "Удалённое сообщение (медиа)"
            quote_text = quote_text.strip()[:DM_QUOTE_MAX]
            field = "message"
            if getattr(params, "message", None) is None:
                field = "caption"
            body = getattr(params, field, None) or ""
            new_text = quote_text + ("\n" + body if body else "")
            shift = utf16_len(quote_text) + (1 if body else 0)
            entities = ArrayList()
            old = getattr(params, "entities", None)
            if old is not None:
                for ent in jlist(old):
                    try:
                        ent.offset = int(ent.offset) + shift
                        entities.add(ent)
                    except Exception:
                        pass
            block = TLRPC.TL_messageEntityBlockquote()
            block.offset = 0
            block.length = utf16_len(quote_text)
            entities.add(0, block)
            setattr(params, field, new_text)
            params.entities = entities
            params.replyToMsg = None
            try:
                params.quote = None
            except Exception:
                pass
            top = getattr(params, "replyToTopMsg", None)
            if top is not None and int(top.getId()) == reply_id:
                params.replyToTopMsg = None
            return True
        except Exception:
            return False

    def _command_hook(self, account, params, text):
        dialog_id = int(getattr(params, "peer", 0) or 0)
        key = (int(account), dialog_id, text)
        with self._lock:
            stamp = self._own_notices.pop(key, None)
        if stamp is not None and time.time() - stamp <= COMMAND_ECHO_TTL:
            return HookResult()
        parsed = parse_command(text, self._command_config())
        if parsed is None or dialog_id == 0 or is_special_dialog(dialog_id):
            return None
        action, arg = parsed
        group = "mute" if action in ("mute", "unmute") else action
        if not self.get_setting(group + "_enabled", True):
            return None
        if not self._claim_command(account, dialog_id, text):
            return HookResult(strategy=HookStrategy.CANCEL)
        if group == "mute":
            self._handle_mute(account, dialog_id, arg, params, action == "unmute")
        elif action == "del":
            self._handle_del(account, dialog_id, arg, params)
        else:
            self._handle_spam(account, dialog_id, arg)
        return HookResult(strategy=HookStrategy.CANCEL)

    def _claim_command(self, account, dialog_id, text):
        now = time.time()
        self._prune(now)
        key = (int(account), int(dialog_id), text.strip().lower())
        with self._lock:
            seen = self._command_guard.get(key)
            if seen is not None and now - seen < DEDUP_WINDOW:
                return False
            self._command_guard[key] = now
            self._command_echo[key] = now
        return True

    def _send_notice(self, account, dialog_id, text):
        value = tidy_text(text)
        if not value:
            return
        with self._lock:
            self._own_notices[(int(account), int(dialog_id), value)] = time.time()

        def _send():
            try:
                send_text(int(dialog_id), value, account=int(account))
            except Exception:
                pass
        ui(_send)

    def _report(self, account, dialog_id, silent, text, kind="error"):
        _bulletin(kind, text)
        if not silent:
            self._send_notice(account, dialog_id, text)

    @staticmethod
    def _explicit_reply(params):
        reply = getattr(params, "replyToMsg", None)
        top = getattr(params, "replyToTopMsg", None)
        if reply is None or top is None:
            return reply
        if reply is top:
            return None
        try:
            if int(reply.getId()) == int(top.getId()):
                return None
        except Exception:
            pass
        return reply

    @staticmethod
    def _reply_in_dialog(reply, dialog_id):
        try:
            value = int(reply.getDialogId() or 0)
        except Exception:
            return False
        return value in (0, int(dialog_id))

    def _handle_mute(self, account, dialog_id, arg, params, unmute):
        silent = bool(self.get_setting("mute_silent", True))
        cmd = self._command_text("unmute" if unmute else "mute")
        done = lambda target: self._finish_mute(account, dialog_id, target, unmute, silent)

        if arg:
            username = parse_username(arg)
            if username is None:
                self._report(account, dialog_id, silent, "Использование: %s @username" % cmd)
            else:
                self._resolve_username(account, username, done)
            return

        reply = self._explicit_reply(params)
        if reply is not None:
            if not self._reply_in_dialog(reply, dialog_id):
                self._report(account, dialog_id, silent, "Ответьте на сообщение в этом чате")
                return
            try:
                user_id = int(reply.getSenderId() or 0)
            except Exception:
                user_id = 0
            if user_id <= 0:
                self._report(account, dialog_id, silent, "Не удалось определить автора")
            else:
                done(user_id)
            return

        if dialog_id > 0 and dialog_id != self._my_id(account):
            done(dialog_id)
            return
        self._report(account, dialog_id, silent, "В группе: %s @username или ответом" % cmd)

    def _resolve_username(self, account, username, callback):
        try:
            user = get_messages_controller(int(account)).getUser(username)
        except Exception:
            user = None
        if user is not None:
            callback(user)
            return
        request = TLRPC.TL_contacts_resolveUsername()
        request.username = username

        def _on_response(response, error):
            target = None if error is not None else first_user(response)
            ui(lambda: callback(target))

        try:
            send_request(request, _on_response, account=int(account))
        except Exception:
            callback(None)

    def _finish_mute(self, account, dialog_id, target, unmute, silent):
        try:
            user = target if hasattr(target, "id") else None
            user_id = int(getattr(user, "id", 0) or 0) if user is not None else int(target or 0)
            if user_id <= 0:
                self._report(account, dialog_id, silent, "Пользователь не найден")
                return
            if user_id == self._my_id(account):
                self._report(account, dialog_id, silent, "Себя заглушить нельзя")
                return
            if user is None:
                user = self._get_user(account, user_id)
            identity = notice_identity(user, user_id)

            with self._lock:
                changed = (self._mutes.remove if unmute else self._mutes.add)(account, dialog_id, user_id)
                saved = self._persist_mutes() if changed else True
            if changed and not unmute:
                self._remember_label(account, user_id, user)
            if not saved:
                self._report(account, dialog_id, silent, "Изменение не сохранилось")
                return

            if unmute:
                toast_ok("Мут снят: %s" % identity if changed else "Пользователь не был замучен")
                template, fallback = self.get_setting("unmute_notice", DEFAULT_UNMUTE_NOTICE), DEFAULT_UNMUTE_NOTICE
            else:
                toast_ok("Замучен: %s" % identity if changed else "Уже замучен в этом чате")
                template, fallback = self.get_setting("mute_notice", DEFAULT_NOTICE), DEFAULT_NOTICE
            if changed and not silent:
                self._send_notice(account, dialog_id, render_template(template, identity, fallback))
        except Exception:
            self._report(account, dialog_id, silent, "Не удалось выполнить мут")

    def handle_new_messages(self, account, args):
        try:
            if args is None or not self._active or len(args) < 2:
                return
            if len(args) > 2 and bool(args[2]):
                return
            if len(args) > 3 and int(args[3] or 0) != 0:
                return
            ids = []
            ghosts = []
            for obj in jlist(args[1]):
                if obj is None:
                    continue
                owner = getattr(obj, "messageOwner", None)
                if bool(obj.isOut()):
                    if owner is not None:
                        self._drop_command_echo(account, owner)
                    continue
                self._dm_media_receive(account, owner)
                message_id = int(obj.getId() or 0)
                dialog_id = int(obj.getDialogId() or 0)
                if self._should_delete(account, dialog_id, int(obj.getSenderId() or 0),
                                       message_id, False, getattr(owner, "action", None) is not None):
                    ids.append(message_id)
                elif self._take_ghost(account, dialog_id, message_id):
                    ghosts.append(message_id)
            if ids:
                self._delete_muted(account, int(args[0]), ids)
            if ghosts:
                acc, did = int(account), int(args[0])
                run_on_ui_thread(lambda: self._post_deleted(acc, did, ghosts))
        except Exception:
            pass

    def _muted_obj(self, obj):
        try:
            if obj is None or bool(obj.isOut()):
                return False
            owner = getattr(obj, "messageOwner", None)
            if owner is None or getattr(owner, "action", None) is not None:
                return False
            dialog_id = int(obj.getDialogId() or 0)
            sender_id = int(obj.getSenderId() or 0)
            if dialog_id == 0 or sender_id <= 0 or is_special_dialog(dialog_id):
                return False
            with self._lock:
                return sender_id in self._mutes.users(int(obj.currentAccount), dialog_id)
        except Exception:
            return False

    def _mute_filter(self, kind, param, returns_value):
        if not self._active or not self.get_setting("mute_enabled", True):
            return
        with self._lock:
            if not self._mutes.total():
                return
        index = MUTE_FILTER_ARG[kind]
        if len(param.args) <= index:
            return
        items = jlist(param.args[index])
        if not items:
            return
        kept = [obj for obj in items if not self._muted_obj(obj)]
        if len(kept) == len(items):
            return
        array = ArrayList()
        for obj in kept:
            array.add(obj)
        param.args[index] = array

    def _intercept(self, account, dialog_id, sender_id, message_id, edited, service):
        if self._should_delete(account, dialog_id, sender_id, message_id, edited, service):
            self._delete_muted(account, dialog_id, [message_id], early=True)
        return False

    def on_update_hook(self, update_name, account, update):
        try:
            self._ensure_state()
            self._ensure_observer(account)
            if update_name in SHORT_MESSAGE_UPDATES:
                return self._handle_short_update(update_name, account, update)
            message = getattr(update, "message", None)
            if message is None:
                return HookResult()
            self._dm_media_receive(account, message)
            edited = update_name in EDIT_UPDATES
            if bool(getattr(message, "out", False)):
                if not edited:
                    self._drop_command_echo(account, message)
                return HookResult()
            self._intercept(account, message_dialog_id(message), message_sender_id(message),
                            int(getattr(message, "id", 0) or 0), edited,
                            getattr(message, "action", None) is not None)
        except Exception:
            pass
        return HookResult()

    def on_updates_hook(self, container_name, account, updates):
        try:
            self._ensure_state()
            self._ensure_observer(account)
            if container_name in SHORT_MESSAGE_UPDATES:
                return self._handle_short_update(container_name, account, updates)
        except Exception:
            pass
        return HookResult()

    def _handle_short_update(self, name, account, update):
        if update is None or bool(getattr(update, "out", False)):
            return HookResult()
        message_id = int(getattr(update, "id", 0) or 0)
        if name == "TL_updateShortMessage":
            dialog_id = sender_id = int(getattr(update, "user_id", 0) or 0)
        else:
            chat_id = int(getattr(update, "chat_id", 0) or 0)
            dialog_id = -chat_id if chat_id else 0
            sender_id = int(getattr(update, "from_id", 0) or 0)
        self._intercept(account, dialog_id, sender_id, message_id, False, False)
        return HookResult()

    def _should_delete(self, account, dialog_id, sender_id, message_id, edited, service):
        if service or dialog_id == 0 or message_id <= 0 or sender_id <= 0 or is_special_dialog(dialog_id):
            return False
        with self._lock:
            if int(sender_id) not in self._mutes.users(account, dialog_id):
                return False
        if not self.get_setting("mute_enabled", True):
            return False
        if edited:
            return bool(self.get_setting("mute_edits", True))
        return self._mark_handled(account, dialog_id, message_id)

    def _take_ghost(self, account, dialog_id, message_id):
        key = (int(account), int(dialog_id), int(message_id))
        with self._lock:
            if key not in self._handled or key in self._ghosted:
                return False
            if len(self._ghosted) > 2000:
                self._ghosted.clear()
            self._ghosted.add(key)
        return True

    def _delete_muted(self, account, dialog_id, ids, early=False):
        batch = sorted({int(i) for i in ids if int(i) > 0}, reverse=True)
        if not batch:
            return
        key = (int(account), int(dialog_id))
        with self._lock:
            self._mute_queue.setdefault(key, set()).update(batch)
            if self._mute_flush_pending:
                return
            self._mute_flush_pending = True
        if early:
            run_on_ui_thread(lambda: run_on_ui_thread(self._flush_muted))
        else:
            run_on_ui_thread(self._flush_muted)

    def _flush_muted(self):
        with self._lock:
            queue, self._mute_queue = self._mute_queue, {}
            self._mute_flush_pending = False
        if not queue:
            return
        for_all = self._choice("mute_mode", MODE_ONLY_ME, (MODE_ONLY_ME, MODE_FOR_ALL)) == MODE_FOR_ALL
        for (account, dialog_id), ids in queue.items():
            batch = sorted(ids, reverse=True)
            try:
                self._delete_messages(account, dialog_id, batch, for_all)
            except Exception:
                continue
            self._post_deleted(account, dialog_id, batch)

    def _post_deleted(self, account, dialog_id, ids):
        try:
            channel_id = -int(dialog_id) if self._is_channel(account, dialog_id) else 0
            center = NotificationCenter.getInstance(int(account))
            args = (int_list(ids), Long(channel_id), Boolean(False))
            try:
                center.postNotificationNameInternal(NotificationCenter.messagesDeleted, True, *args)
            except Exception:
                center.postNotificationName(NotificationCenter.messagesDeleted, *args)
        except Exception:
            pass

    def _drop_command_echo(self, account, message):
        text = getattr(message, "message", None)
        if not isinstance(text, str):
            return
        dialog_id = message_dialog_id(message)
        key = (int(account), int(dialog_id), text.strip().lower())
        with self._lock:
            stamp = self._command_echo.pop(key, None)
        message_id = int(getattr(message, "id", 0) or 0)
        if stamp is None or time.time() - stamp > COMMAND_ECHO_TTL or message_id <= 0:
            return
        self._dispatch_delete(account, dialog_id, [message_id], True)

    def _loaded_messages(self, account, dialog_id):
        try:
            fragment = get_last_fragment()
            if fragment is None or int(fragment.getDialogId() or 0) != int(dialog_id):
                return None
            if int(fragment.getCurrentAccount()) != int(account) or int(fragment.getChatMode() or 0) != 0:
                return None
            return jlist(fragment.messages)
        except Exception:
            return None

    @staticmethod
    def _pick_ids(items, wanted, scope, anchor_id, dialog_id, from_objects):
        stats = {"seen": 0, "service": 0, "not_mine": 0, "newer": 0}
        found = set()
        for item in items:
            if item is None:
                continue
            stats["seen"] += 1
            try:
                if from_objects:
                    if bool(getattr(item, "isDateObject", False)):
                        stats["service"] += 1
                        continue
                    message_id = int(item.getId() or 0)
                    if int(item.getDialogId() or 0) != int(dialog_id):
                        continue
                    owner = getattr(item, "messageOwner", None)
                    out = bool(item.isOut())
                    try:
                        if bool(item.isSponsored()):
                            stats["service"] += 1
                            continue
                    except Exception:
                        pass
                else:
                    message_id = int(getattr(item, "id", 0) or 0)
                    owner = item
                    out = bool(getattr(item, "out", False))
                if message_id <= 0:
                    continue
                if anchor_id > 0 and message_id > anchor_id:
                    stats["newer"] += 1
                    continue
                if owner is None or getattr(owner, "action", None) is not None:
                    stats["service"] += 1
                    continue
                if scope == SCOPE_MINE and not out:
                    stats["not_mine"] += 1
                    continue
                found.add(message_id)
            except Exception:
                continue
        return sorted(found, reverse=True)[:int(wanted)], stats

    @staticmethod
    def _nothing_text(scope, stats):
        seen = stats.get("seen", 0)
        if not seen:
            return "Нечего удалять"
        if scope == SCOPE_MINE and stats.get("not_mine", 0):
            return "Среди последних %d сообщений ваших нет" % seen
        if stats.get("newer", 0) >= seen:
            return "Старее этого сообщения ничего нет"
        if stats.get("service", 0) >= seen:
            return "Последние сообщения служебные"
        return "Подходящих сообщений нет"

    def _handle_del(self, account, dialog_id, arg, params):
        silent = bool(self.get_setting("del_silent", True))
        limit = self._int_setting("del_max", DEFAULT_MAX_DELETE, 1, HARD_LIMIT)
        count = parse_count(arg, limit)
        if count is None:
            self._report(account, dialog_id, silent,
                         "Использование: %s N (1–%d)" % (self._command_text("del"), limit))
            return
        scope = self._choice("del_scope", SCOPE_ALL, (SCOPE_ALL, SCOPE_MINE))
        for_all = self._choice("del_mode", MODE_ONLY_ME, (MODE_ONLY_ME, MODE_FOR_ALL)) == MODE_FOR_ALL

        anchor_id = 0
        reply = self._explicit_reply(params)
        if reply is not None:
            if not self._reply_in_dialog(reply, dialog_id):
                self._report(account, dialog_id, silent, "Ответьте на сообщение в этом чате")
                return
            try:
                anchor_id = int(reply.getId() or 0)
            except Exception:
                anchor_id = 0
            if anchor_id <= 0:
                self._report(account, dialog_id, silent, "Не удалось определить сообщение")
                return

        report = (account, dialog_id, silent, count)
        loaded = self._loaded_messages(account, dialog_id)
        local_ids, local_stats = [], {"seen": 0}
        if loaded:
            local_ids, local_stats = self._pick_ids(loaded, count, scope, anchor_id, dialog_id, True)
            if len(local_ids) >= count:
                self._dispatch_delete(account, dialog_id, local_ids, for_all, report)
                return

        if getattr(params, "replyToTopMsg", None) is not None:
            if local_ids:
                self._dispatch_delete(account, dialog_id, local_ids, for_all, report)
            else:
                self._report(account, dialog_id, silent,
                             self._nothing_text(scope, local_stats) if local_stats.get("seen")
                             else "В теме удаляются только загруженные сообщения", "info")
            return

        try:
            request = TLRPC.TL_messages_getHistory()
            request.peer = get_messages_controller(int(account)).getInputPeer(int(dialog_id))
            if request.peer is None:
                raise ValueError("no input peer")
        except Exception:
            self._report(account, dialog_id, silent, "Не удалось запросить историю")
            return
        request.limit = min(count + EXTRA_FETCH, HARD_LIMIT)
        request.offset_id = anchor_id + 1 if anchor_id > 0 else 0
        request.add_offset = 0
        request.offset_date = 0
        request.max_id = 0
        request.min_id = 0
        request.hash = 0

        def _on_history(response, error):
            try:
                if error is not None:
                    self._report(account, dialog_id, silent,
                                 "Ошибка истории: %s" % (getattr(error, "text", "") or "неизвестно"))
                    return
                raw = getattr(response, "messages", None)
                ids, stats = self._pick_ids(jlist(raw), count, scope, anchor_id, dialog_id, False)
                if not ids:
                    self._report(account, dialog_id, silent, self._nothing_text(scope, stats), "info")
                    return
                self._dispatch_delete(account, dialog_id, ids, for_all, report)
            except Exception:
                self._report(account, dialog_id, silent, "Ошибка обработки истории")

        try:
            send_request(request, _on_history, account=int(account))
        except Exception:
            self._report(account, dialog_id, silent, "Не удалось запросить историю")

    def _dispatch_delete(self, account, dialog_id, ids, for_all, report=None):
        clean = sorted({int(i) for i in ids if int(i) > 0}, reverse=True)

        def _run():
            try:
                deleted = self._delete_messages(account, dialog_id, clean, for_all)
                error = None
            except Exception:
                deleted, error = 0, "клиент отклонил удаление"
            if report is None:
                return
            acc, dlg, silent, wanted = report
            if error:
                self._report(acc, dlg, silent, "Не удалось удалить: %s" % error)
            elif deleted != wanted:
                self._report(acc, dlg, silent, "Удалено %d %s из %d" % (deleted, plural_ru(deleted), wanted), "success")
            else:
                self._report(acc, dlg, silent, "Удалено %d %s" % (deleted, plural_ru(deleted)), "success")

        if clean:
            ui(_run)

    def _delete_messages(self, account, dialog_id, ids, for_all):
        controller = get_messages_controller(int(account))
        local_only = not for_all and self._is_channel(account, dialog_id)
        for start in range(0, len(ids), HARD_LIMIT):
            array = ArrayList()
            for message_id in ids[start:start + HARD_LIMIT]:
                array.add(Integer(int(message_id)))
            if local_only:
                controller.deleteMessages(array, None, None, int(dialog_id), 0, False, 0, True)
            else:
                controller.deleteMessages(array, None, None, int(dialog_id), 0, bool(for_all), 0)
        return len(ids)

    def _is_channel(self, account, dialog_id):
        if int(dialog_id) >= 0:
            return False
        chat = self._get_chat(account, -int(dialog_id))
        return True if chat is None else bool(ChatObject.isChannel(chat))

    def _handle_spam(self, account, dialog_id, arg):
        limit = self._int_setting("spam_max", DEFAULT_SPAM_MAX, 1, SPAM_MAX_LIMIT)
        parts = (arg or "").split(None, 1)
        count = parse_count(parts[0], limit) if parts else None
        text = parts[1].strip() if len(parts) > 1 else ""
        if count is None or not text:
            toast_err("Использование: %s N текст (N: 1–%d)" % (self._command_text("spam"), limit))
            return
        cooldown = self._int_setting("spam_cooldown", DEFAULT_SPAM_COOLDOWN, 0, SPAM_COOLDOWN_MAX)
        key = (int(account), int(dialog_id))
        now = time.time()
        with self._lock:
            if self._spam_runs.get(key):
                error = "В этом чате уже идёт отправка"
            elif now - self._spam_last.get(key, 0) < cooldown:
                error = "Подождите ещё %d с" % (int(cooldown - (now - self._spam_last[key])) + 1)
            else:
                error = None
                self._spam_last[key] = now
                self._spam_runs[key] = True
        if error:
            toast_err(error)
            return
        delay = self._float_setting("spam_delay", DEFAULT_SPAM_DELAY, 0, SPAM_DELAY_MAX)
        threading.Thread(target=self._spam_worker, args=(key, count, text, delay), daemon=True).start()

    def _spam_worker(self, key, count, text, delay):
        account, dialog_id = key
        sent = 0
        try:
            for index in range(count):
                if not self._active or not self._spam_send(account, dialog_id, text):
                    break
                sent += 1
                if index < count - 1 and delay > 0:
                    time.sleep(delay)
        finally:
            with self._lock:
                self._spam_runs.pop(key, None)
        if not self._active:
            return
        if sent == count:
            toast_ok("Отправлено %d %s" % (sent, plural_ru(sent)))
        else:
            toast_err("Отправлено %d из %d" % (sent, count))

    def _spam_send(self, account, dialog_id, text):
        result = {"ok": False, "started": False, "cancelled": False}
        gate = threading.Lock()
        done = threading.Event()

        def _do():
            try:
                with gate:
                    if result["cancelled"] or not self._active:
                        return
                    result["started"] = True
                with self._lock:
                    self._own_notices[(account, dialog_id, text)] = time.time()
                send_text(dialog_id, text, account=account)
                result["ok"] = True
            except Exception:
                pass
            finally:
                done.set()

        run_on_ui_thread(_do)
        if not done.wait(SPAM_SEND_TIMEOUT):
            with gate:
                result["cancelled"] = True
            return False
        return result["ok"]

    def _nv_bots(self):
        raw = str(self.get_setting("nv_bots", "") or "").replace("\n", ",").replace(" ", ",")
        result = []
        for bot in raw.split(","):
            bot = bot.strip().lstrip("@").lower()
            if bot and bot not in result:
                result.append(bot)
        return result

    def _nv_recent(self):
        return [r for r in str(self.get_setting("nv_recent", "") or "").split(",") if r]

    def _nv_save_bots(self, bots):
        self.set_setting("nv_bots", ",".join(bots), True)

    def _nv_add_bot(self, name):
        name = (name or "").strip().lstrip("@").lower()
        bots = self._nv_bots()
        if name and name not in bots:
            self._nv_save_bots(bots + [name])
            toast_ok("@%s добавлен" % name)

    def _nv_remove_bot(self, name):
        self._nv_save_bots([b for b in self._nv_bots() if b != name])
        toast_info("@%s убран" % name)

    def _nv_on_new_bot(self, value):
        parts = [p for p in re.split(r"[,;\s]+", str(value or "").strip()) if p]
        names = []
        for part in parts:
            name = parse_username(part)
            if name is None:
                toast_err("Неверный юзернейм: " + part[:40])
                return
            name = name.lower()
            if name not in names:
                names.append(name)
        bots = self._nv_bots()
        added = [name for name in names if name not in bots]
        if added:
            self.set_setting("nv_bots", ",".join(bots + added), reload_settings=False)
        self.set_setting("nv_new_bot", "", reload_settings=True)
        if added:
            toast_ok("Добавлено ботов: %d" % len(added))
        elif names:
            toast_info("Эти боты уже в списке")

    def _nv_remember(self, name):
        name = (name or "").lstrip("@").lower()
        if not name:
            return
        recent = [r for r in self._nv_recent() if r != name]
        self.set_setting("nv_recent", ",".join([name] + recent[:9]))

    def _nv_allowed(self, bot_name):
        name = (bot_name or "").lstrip("@").lower()
        listed = name in self._nv_bots()
        return listed if self.get_setting("nv_mode", NV_BLACKLIST) == NV_WHITELIST else not listed

    @staticmethod
    def _buttons(markup):
        rows = getattr(markup, "rows", None) if markup is not None else None
        result = []
        if rows is not None:
            for row in jlist(rows):
                for btn in jlist(row.buttons):
                    result.append(btn)
        return result

    @staticmethod
    def _is_url_button(btn):
        return btn.getClass().getSimpleName() == "TL_keyboardButtonUrl"

    @staticmethod
    def _server_media(params):
        for field in ("document", "photo"):
            obj = getattr(params, field, None)
            if obj is not None:
                return bool(getattr(obj, "id", 0)) and bool(getattr(obj, "access_hash", 0))
        return None

    def _no_via_hook(self, account, params):
        extra = getattr(params, "params", None)
        if extra is None:
            return HookResult()
        if extra.containsKey(NV_RESEND):
            extra.remove(NV_RESEND)
            self._nv_titles(account, params, True)
            return HookResult(strategy=HookStrategy.MODIFY, params=params)
        if not extra.containsKey("query_id") or not self.get_setting("nv_enabled", True):
            return HookResult()

        bot_name = extra.get("bot_name") or ""
        self._nv_remember(bot_name)
        if not self._nv_allowed(bot_name) or getattr(params, "game", None) is not None:
            return HookResult()
        markup = getattr(params, "replyMarkup", None)
        buttons = self._buttons(markup)
        if self.get_setting("nv_keep_action", True) and any(not self._is_url_button(b) for b in buttons):
            return HookResult()

        media = self._server_media(params)
        if media is False:
            if self.get_setting("nv_fallback", True):
                return HookResult()
            toast_err("Этот результат нельзя отправить без бота")
            return HookResult(strategy=HookStrategy.CANCEL)

        for key in NV_INLINE_KEYS:
            extra.remove(key)
        if media and self.get_setting("nv_strip_caption", True):
            params.caption = None
            params.entities = None
        if buttons and self.get_setting("nv_url_buttons", True):
            self._nv_append_links(params, [b for b in buttons if self._is_url_button(b)], bool(media))
        params.replyMarkup = None

        if media and self._nv_titles(account, params, False) == HookStrategy.CANCEL:
            return HookResult(strategy=HookStrategy.CANCEL)
        return HookResult(strategy=HookStrategy.MODIFY, params=params)

    def _nv_append_links(self, params, buttons, is_media):
        links = [(str(b.text), str(b.url)) for b in buttons if getattr(b, "text", None) and getattr(b, "url", None)]
        if not links:
            return
        field = "caption" if is_media else "message"
        out = str(getattr(params, field, None) or "")
        has_base = bool(out)
        entities = ArrayList()
        if getattr(params, "entities", None) is not None:
            entities.addAll(params.entities)
        for index, (text, url) in enumerate(links):
            out += ("\n\n" if has_base else "") if index == 0 else "\n"
            entity = TLRPC.TL_messageEntityTextUrl()
            entity.offset = utf16_len(out)
            entity.length = utf16_len(text)
            entity.url = url
            entities.add(entity)
            out += text
        setattr(params, field, out)
        params.entities = entities

    @staticmethod
    def _audio_attr(doc):
        for attr in jlist(getattr(doc, "attributes", None)):
            if str(attr.getClass().getSimpleName()).startswith("TL_documentAttributeAudio"):
                return None if getattr(attr, "voice", False) else attr
        return None

    @staticmethod
    def _local_file(account, doc):
        from org.telegram.messenger import FileLoader
        loader = FileLoader.getInstance(account)
        for force in (False, True):
            try:
                path = loader.getPathToAttach(doc, force)
                if path is not None and path.exists() and path.length() > 0:
                    return path
            except Exception:
                pass
        return None

    def _nv_titles(self, account, params, resend):
        doc = getattr(params, "document", None)
        if doc is None or not self.get_setting("nv_clean_titles", True):
            return None
        attr = self._audio_attr(doc)
        if attr is None:
            return None
        words = [w.strip() for w in str(self.get_setting("nv_clean_words", "") or "").split(",") if w.strip()]
        title, performer = getattr(attr, "title", None), getattr(attr, "performer", None)
        new_title = clean_title(title, self.get_setting("nv_remove_feat", False), words) if title else title
        new_performer = clean_title(performer, False, words) if performer else performer
        if new_title == title and new_performer == performer:
            return None
        local = self._local_file(account, doc)
        if local is not None:
            self._nv_reupload(account, params, attr, new_title, new_performer, local)
            return HookStrategy.MODIFY
        if not resend and self.get_setting("nv_clean_download", True):
            self._nv_download_then_send(account, params)
            return HookStrategy.CANCEL
        return None

    def _nv_reupload(self, account, params, attr, title, performer, local):
        from org.telegram.messenger import FileLoader
        old = params.document
        doc = TLRPC.TL_document()
        doc.id = 0
        doc.access_hash = 0
        doc.dc_id = 0
        doc.date = old.date
        doc.mime_type = old.mime_type
        doc.size = old.size
        new_attr = TLRPC.TL_documentAttributeAudio()
        for field in ("flags", "voice", "duration", "title", "performer", "waveform"):
            try:
                setattr(new_attr, field, getattr(attr, field))
            except Exception:
                pass
        if title:
            new_attr.title = title
        if performer:
            new_attr.performer = performer
        flags = int(getattr(new_attr, "flags", 0) or 0) & ~7
        if getattr(new_attr, "title", None):
            flags |= 1
        if getattr(new_attr, "performer", None):
            flags |= 2
        if getattr(new_attr, "waveform", None) is not None:
            flags |= 4
        new_attr.flags = flags
        attributes = ArrayList()
        replaced = False
        for item in jlist(getattr(old, "attributes", None)):
            same = False
            if not replaced:
                try:
                    same = item is attr or bool(item.equals(attr))
                except Exception:
                    same = item is attr
            if same:
                replaced = True
                attributes.add(new_attr)
            else:
                attributes.add(item)
        if not replaced:
            attributes.add(new_attr)
        doc.attributes = attributes
        thumbs = ArrayList()
        loader = FileLoader.getInstance(account)
        for thumb in jlist(getattr(old, "thumbs", None)):
            try:
                path = loader.getPathToAttach(thumb, True)
                if path is not None and path.exists():
                    thumbs.add(thumb)
            except Exception:
                pass
        doc.thumbs = thumbs
        params.document = doc
        params.path = local.getAbsolutePath()

    def _nv_download_then_send(self, account, params):
        from org.telegram.messenger import FileLoader, SendMessagesHelper
        doc = params.document
        try:
            FileLoader.getInstance(account).loadFile(doc, getattr(params, "parentObject", None) or "nvb",
                                                     FileLoader.PRIORITY_HIGH, 0)
        except Exception:
            pass
        toast_info("Скачиваю трек, чтобы почистить название…")
        params.params.put(NV_RESEND, "1")

        def _wait():
            for _ in range(120):
                if self._local_file(account, doc) is not None:
                    break
                time.sleep(0.5)
            run_on_ui_thread(lambda: SendMessagesHelper.getInstance(account).sendMessage(params))

        threading.Thread(target=_wait, name='multi_tools-nv-wait', daemon=True).start()

    def _dm_media_settings(self):
        kinds = {"photo"}
        for kind in ("video", "voice", "file"):
            if self.get_setting("dm_media_" + kind, False):
                kinds.add(kind)
        return (bool(self.get_setting("dm_media_private", True)), kinds,
                self._int_setting("dm_media_max_mb", 20, 1, 100) * 1024 * 1024)

    def _dm_media_enabled(self, reason):
        return (self._active and bool(self.get_setting("dm_enabled", True))
                and bool(self.get_setting("dm_media_rescue" if reason == "delete"
                                          else "dm_media_prefetch", reason == "delete")))

    def _dm_media_task(self, account, message):
        from org.telegram.messenger import AndroidUtilities, FileLoader, ImageLocation, MessageObject
        if message is None or getattr(message, "action", None) is not None:
            return None
        dialog_id = message_dialog_id(message)
        mid = int(getattr(message, "id", 0) or 0)
        if mid <= 0 or is_special_dialog(dialog_id):
            return None
        media = MessageObject.getMedia(message)
        if media is None or int(getattr(media, "ttl_seconds", 0) or 0) != 0 \
                or int(getattr(message, "ttl", 0) or 0) != 0:
            return None
        photo, doc = getattr(media, "photo", None), getattr(media, "document", None)
        if photo is not None and int(getattr(photo, "id", 0) or 0):
            try:
                side = int(AndroidUtilities.getPhotoSize(True))
            except Exception:
                side = int(AndroidUtilities.getPhotoSize())
            attach = FileLoader.getClosestPhotoSizeWithSize(photo.sizes, side, False, None, True)
            if attach is None or getattr(attach, "location", None) is None:
                return None
            size = int(getattr(attach, "size", 0) or 0)
            progressive = jlist(getattr(attach, "sizes", None))
            if progressive:
                size = max(size, max(int(v) for v in progressive))
            location = ImageLocation.getForPhoto(attach, photo)
            if location is None:
                return None
            kind = "photo"
        elif doc is not None and int(getattr(doc, "id", 0) or 0):
            if MessageObject.isAnyKindOfStickerOrEmoji(doc):
                return None
            attach, location, size = doc, None, int(getattr(doc, "size", 0) or 0)
            kind = ("voice" if MessageObject.isVoiceDocument(doc) else
                    "video" if MessageObject.isVideoDocument(doc) or MessageObject.isRoundVideoDocument(doc)
                    else "file")
        else:
            return None
        if size <= 0:
            return None
        filename = str(FileLoader.getAttachFileName(attach, "jpg" if kind == "photo" else None) or "")
        if not filename:
            return None
        return {"account": int(account), "dialog_id": dialog_id, "mid": mid, "message": message,
                "attach": attach, "location": location, "kind": kind, "size": size, "filename": filename}

    def _dm_media_allowed(self, task, reason):
        if not self._dm_media_enabled(reason):
            return False
        private, kinds, limit = self._dm_media_settings()
        account, did, mid = task["account"], task["dialog_id"], task["mid"]
        if self._dm_skip_dialog(account, did, self._dm_cfg()) or self._dm_is_pending(account, did, mid, time.time()):
            return False
        return dm_media_policy(task["kind"], task["size"], did, private, kinds, limit)

    def _dm_media_local(self, task):
        from org.telegram.messenger import FileLoader
        loader = FileLoader.getInstance(task["account"])
        for cache in (True, False):
            path = loader.getPathToAttach(task["attach"], cache)
            if path is not None and path.exists() and path.length() > 0:
                return True
        return False

    def _dm_media_receive(self, account, message):
        if not self._active:
            return
        def _run():
            try:
                if not self._active:
                    return
                task = self._dm_media_task(account, message)
                if task is None:
                    return
                key = (int(account), task["dialog_id"], task["mid"])
                self._dm_media_recent.pop(key, None)
                self._dm_media_recent[key] = (time.monotonic(), message)
                while len(self._dm_media_recent) > DM_MEDIA_RECENT:
                    self._dm_media_recent.pop(next(iter(self._dm_media_recent)))
                self._dm_media_enqueue(task, "receive")
            except Exception as exc:
                self._dm_media_error("receive", exc)
        ui(_run)

    def _dm_media_enqueue(self, task, reason):
        from org.telegram.messenger import FileLoader
        if not self._dm_media_allowed(task, reason) or self._dm_media_local(task):
            return
        key = (task["account"], task["filename"])
        if FileLoader.getInstance(task["account"]).isLoadingFile(task["filename"]):
            return
        if self._dm_media_queue.submit(key, task, reason):
            self._dm_media_pump()

    def _dm_media_rescue(self, account, dialog_id, mids):
        wanted = set(int(m) for m in mids)
        def _run():
            if not self._dm_media_enabled("delete"):
                return
            try:
                now = time.monotonic()
                messages = {}
                for key, (stamp, message) in list(self._dm_media_recent.items()):
                    if now - stamp > DM_MEDIA_RECENT_TTL:
                        self._dm_media_recent.pop(key, None)
                    elif key[0] == account and key[1] == dialog_id and key[2] in wanted:
                        messages[key[2]] = message
                for obj in (self._loaded_messages(account, dialog_id) or []):
                    mid = int(obj.getId())
                    if mid in wanted:
                        messages[mid] = obj.messageOwner
                try:
                    cache = get_messages_controller(account).dialogMessagesByIds
                    for mid in wanted:
                        if mid not in messages:
                            obj = cache.get(mid)
                            if obj is not None and int(obj.getDialogId()) == dialog_id:
                                messages[mid] = obj.messageOwner
                except Exception as exc:
                    self._dm_media_error("rescue_cache", exc)
                for mid, message in messages.items():
                    if self._dm_store.has(account, dialog_id, mid):
                        task = self._dm_media_task(account, message)
                        if task is not None:
                            self._dm_media_enqueue(task, "delete")
            except Exception as exc:
                self._dm_media_error("rescue", exc)
        ui(_run)

    def _dm_media_pump(self):
        from org.telegram.messenger import FileLoader, MessageObject
        if not self._active:
            return
        for key, (task, reason) in list(self._dm_media_queue.running.items()):
            try:
                loader = FileLoader.getInstance(task["account"])
                if time.monotonic() - task.get("started", 0) > 5 and not loader.isLoadingFile(task["filename"]):
                    self._dm_media_queue.finish(key, self._dm_media_local(task))
            except Exception as exc:
                self._dm_media_error("poll", exc)
        while self._active:
            item = self._dm_media_queue.take()
            if item is None:
                break
            key, task, reason = item
            try:
                if not self._dm_media_allowed(task, reason):
                    self._dm_media_queue.finish(key, False)
                    continue
                if self._dm_media_local(task):
                    self._dm_media_queue.finish(key, True)
                    continue
                loader = FileLoader.getInstance(task["account"])
                if loader.isLoadingFile(task["filename"]):
                    self._dm_media_queue.finish(key, False)
                    continue
                task["started"] = time.monotonic()
                parent = MessageObject(task["account"], task["message"], False, False)
                if task["kind"] == "photo":
                    loader.loadFile(task["location"], parent, "jpg", FileLoader.PRIORITY_NORMAL, 0)
                else:
                    loader.loadFile(task["attach"], parent, FileLoader.PRIORITY_NORMAL, 0)
            except Exception as exc:
                self._dm_media_queue.finish(key, False)
                self._dm_media_error("load", exc)
        if self._dm_media_queue.running and self._dm_media_timer is None:
            generation = self._dm_media_generation
            def _tick():
                def _run():
                    if self._active and generation == self._dm_media_generation:
                        self._dm_media_timer = None
                        self._dm_media_pump()
                ui(_run)
            self._dm_media_timer = _default_schedule(2, _tick)

    @staticmethod
    def _dm_spec_download(name, types):
        if name == 'canDownloadMediaType' and types == ['org.telegram.messenger.MessageObject']:
            return 'voice_auto_policy'
        return None

    def _dm_voice_auto_policy(self, param):
        if not self._active or not self.get_setting('dm_enabled', True):
            return
        stack = getattr(_dm_tls, 'file_attach', None)
        obj = param.args[0] if param.args else None
        if not stack or obj is None or stack[-1] is None or ident(stack[-1]) != ident(obj):
            return
        if self._vj_history_object(obj) or not obj.isVoice():
            return
        mid, did, account = int(obj.getId()), int(obj.getDialogId()), int(obj.currentAccount)
        if mid <= 0 or not self._dm_store.has(account, did, mid):
            return
        if self._vj_boolean_field(obj, 'mediaExists') is not False or self._vj_boolean_field(obj, 'attachPathExists') is not False:
            return
        param.setResult(Integer(0))

    def _dm_media_event(self, event, account, args):
        if not self._active or args is None or len(args) < 1:
            return
        key = (int(account), str(args[0]))
        success = int(event) == int(NotificationCenter.fileLoaded)
        item = self._dm_media_queue.finish(key, success)
        if success and item is not None:
            task = item[0]
            self._dm_refresh(task["account"], task["dialog_id"], [task["mid"]])
        self._dm_media_pump()

    def _dm_media_error(self, stage, exc):
        try:
            now = time.monotonic()
            if now - self._dm_media_error_at > 30:
                self._dm_media_error_at = now
        except Exception:
            pass

    def _dm_media_stop(self):
        self._dm_media_generation += 1
        timer, self._dm_media_timer = self._dm_media_timer, None
        if timer is not None:
            timer.cancel()
        self._dm_media_queue.clear()
        self._dm_media_recent.clear()

    def _page_deleted(self):
        self._dm_trim_views()
        media = "Заранее" if self.get_setting("dm_media_prefetch", False) else "При удалении" if self.get_setting("dm_media_rescue", True) else "Выключено"
        return [
            Header(text="Сохранение"),
            Switch(key="dm_enabled", text="Сохранять удалённые", default=True, icon="msg_archive",
                   subtext="Удалённые сообщения остаются в чате с меткой", on_change=self._ui_deleted_toggle),
            Divider(text="Сохраняются внешние удаления входящих и исходящих. Удаление из текущего аккаунта выполняется по-настоящему."),
            Header(text="Где сохранять"),
            Switch(key="dm_private_chats", text="Личные чаты", default=True, icon="msg_contacts",
                   on_change=lambda value: self._dm_scope_changed("dm_private_chats", value)),
            Switch(key="dm_groups", text="Группы", default=True, icon="msg_groups|msg_contacts",
                   on_change=lambda value: self._dm_scope_changed("dm_groups", value)),
            Switch(key="dm_channels", text="Каналы", default=True, icon="msg_channel|msg_contacts",
                   on_change=lambda value: self._dm_scope_changed("dm_channels", value)),
            Switch(key="dm_bots", text="Чаты с ботами", default=False, icon="msg_bot"),
            Divider(),
            Header(text="Дополнительно"),
            Switch(key="dm_notif", text="Оставлять уведомления", default=True, icon="msg_notifications"),
            Switch(key="dm_selfdestruct", text="Оставлять исчезающие сообщения", default=False,
                   subtext="Также сохранять локальную копию исчезающих фото/видео для пункта «История»",
                   icon="msg_delete_auto|msg_timer|msg_delete"),
            Divider(),
            Header(text="Настройка"),
            Text(text="Медиа", subtext=media, icon="msg_media|msg_download", create_sub_fragment=self._page_dm_media,
                 link_alias="dm_media"),
            Text(text="Оформление", subtext=DM_STYLES[self._dm_style()][0], icon="msg_palette|msg_edit",
                 create_sub_fragment=self._page_dm_appearance, link_alias="dm_look"),
            Divider(),
            Header(text="Сохранённые"),
            self._dm_info_row("saved") or Text(text="Сохранено: %d" % self._dm_store.total(), icon="msg_info"),
            Text(text="Удалить сохранённые", subtext="Только на этом устройстве", icon="msg_clear",
                 red=True, on_click=self._dm_on_clear),
            Divider(text="Один чат можно очистить из его меню: «Очистить удалённые в этом чате»."),
        ]

    def _dm_look_items(self):
        self._dm_cfg_cache = None
        self._dm_live = {}
        live = self._dm_custom_ok()

        def _pick(key):
            def _changed(value):
                self.set_setting(key, value, True)
                self._dm_cfg_cache = None
            return _changed

        style = self._dm_style()
        color = self._choice("dm_color", 0, tuple(range(len(DM_COLORS))))
        items = [Header(text="Вид")]
        preview_row = self._dm_custom_row("preview") if live else None
        if preview_row is not None:
            items.append(preview_row)
        items.append(Selector(key="dm_mark_style", text="Метка", default=0,
                              items=[("%s  %s" % (sym, name) if sym != DM_ICON else "%s (иконка)" % name) if sym else name
                                     for name, sym in DM_STYLES],
                              icon="msg_delete", on_change=_pick("dm_mark_style")))
        if style == DM_STYLE_CUSTOM:
            items.append(Input(key="dm_mark_text", text="Свой текст метки", default="удалено", icon="msg_edit",
                               on_change=self._dm_mark_text_changed))
        palette = self._dm_custom_row("palette") if live else None
        if palette is not None:
            items.append(palette)
        if color == DM_COLOR_CUSTOM:
            items.append(Input(key="dm_color_hex", text="HEX цвет, например FF5555", default="FF5555",
                               icon="msg_palette", on_change=self._dm_hex_changed))
        slider = self._dm_custom_row(DM_ALPHA_KEY) if live else None
        if slider is not None:
            items.append(slider)
        if preview_row is None or palette is None or slider is None:
            items.append(Text(text="Обновите exteraGram",
                              subtext="Предпросмотр, цвет и прозрачность недоступны в этой версии",
                              icon="msg_info"))
        items.append(Divider(text="Изменения применятся после повторного открытия чата."))
        return items

    def _dm_style(self):
        try:
            value = self.get_setting("dm_mark_style", None)
            if value is None:
                old = self.get_setting("dm_style", None)
                value = DM_STYLE_MIGRATE.get(int(old), 0) if old is not None else 0
                self.set_setting("dm_mark_style", value)
            value = int(value)
            return value if 0 <= value < len(DM_STYLES) else 0
        except Exception:
            return 0

    def _dm_alpha_pct(self):
        value = None
        try:
            value = self.get_setting(DM_ALPHA_KEY, None)
        except Exception:
            value = None
        if value is None:
            try:
                old = self.get_setting(DM_ALPHA_OLD_KEY, None)
                value = int(old) * 10 if old is not None else DM_ALPHA_DEFAULT
            except Exception:
                value = DM_ALPHA_DEFAULT
            value = max(0, min(DM_PCT_MAX, int(value)))
            try:
                self.set_setting(DM_ALPHA_KEY, value)
            except Exception:
                pass
            return value
        try:
            return max(0, min(DM_PCT_MAX, int(round(float(value)))))
        except Exception:
            return DM_ALPHA_DEFAULT

    def _dm_set_alpha(self, value):
        value = max(0, min(DM_PCT_MAX, int(value)))
        try:
            self.set_setting(DM_ALPHA_KEY, value)
        except Exception:
            pass
        self._dm_live.pop(DM_ALPHA_KEY, None)
        self._dm_cfg_cache = None

    def _dm_custom_ok(self):
        return Custom is not None and SimpleSettingFactory is not None

    def _dm_custom_row(self, kind):
        try:
            factory = self._dm_factories.get(kind)
            if factory is None:
                if kind == "preview":
                    factory = SimpleSettingFactory(self._dm_preview_create, self._dm_preview_bind,
                                                   is_clickable=False)
                elif kind == "master":
                    factory = SimpleSettingFactory(self._dm_master_create, self._dm_master_bind,
                                                   is_clickable=True, on_click=self._dm_master_click)
                elif kind == "palette":
                    factory = SimpleSettingFactory(self._dm_palette_create, self._dm_palette_bind,
                                                   is_clickable=False)
                else:
                    factory = SimpleSettingFactory(self._dm_slider_creator(kind), self._dm_slider_binder(kind),
                                                   is_clickable=False)
                self._dm_factories[kind] = factory
            return Custom(factory=factory.instance.java)
        except Exception:
            return None

    @staticmethod
    def _dm_theme(key_name, fallback):
        try:
            from org.telegram.ui.ActionBar import Theme
            return int(Theme.getColor(getattr(Theme, key_name)))
        except Exception:
            return signed_color(fallback)

    @staticmethod
    def _dm_dp(value):
        try:
            from org.telegram.messenger import AndroidUtilities
            return int(AndroidUtilities.dp(float(value)))
        except Exception:
            return int(value * 3)

    @staticmethod
    def _dm_full_width(view, height=-2):
        try:
            try:
                from androidx.recyclerview.widget import RecyclerView
                params = RecyclerView.LayoutParams(-1, int(height))
            except Exception:
                from android.view import ViewGroup
                params = ViewGroup.LayoutParams(-1, int(height))
            view.setLayoutParams(params)
        except Exception:
            pass
        return view

    def _dm_error_view(self, context):
        from android.widget import TextView
        view = TextView(context)
        view.setText("Не удалось отобразить")
        try:
            view.setTextSize(15.0)
            view.setTextColor(signed_color(0xFFFF4444))
            view.setPadding(self._dm_dp(21), self._dm_dp(12), self._dm_dp(21), self._dm_dp(12))
            self._dm_full_width(view)
        except Exception:
            pass
        return view

    def _dm_slider_creator(self, key):
        def _create(context, list_view, current_account, class_guid, resources_provider):
            try:
                from android.widget import LinearLayout, SeekBar, TextView
                from android.view import Gravity
                dp = self._dm_dp
                root = LinearLayout(context)
                root.setOrientation(LinearLayout.VERTICAL)
                root.setPadding(dp(21), dp(10), dp(21), dp(6))
                root.setBackgroundColor(self._dm_theme("key_windowBackgroundWhite", 0xFFFFFFFF))
                from android.widget import FrameLayout
                head = FrameLayout(context)
                title = TextView(context)
                title.setText(DM_ALPHA_LABEL)
                title.setTextSize(16.0)
                title.setTextColor(self._dm_theme("key_windowBackgroundWhiteBlackText", 0xFF000000))
                head.addView(title, FrameLayout.LayoutParams(-2, -2, int(Gravity.START | Gravity.CENTER_VERTICAL)))
                value = TextView(context)
                value.setTextSize(16.0)
                value.setTextColor(self._dm_theme("key_windowBackgroundWhiteValueText", 0xFF3A8CE6))
                head.addView(value, FrameLayout.LayoutParams(-2, -2, int(Gravity.END | Gravity.CENTER_VERTICAL)))
                root.addView(head, LinearLayout.LayoutParams(-1, -2))
                seek = SeekBar(context)
                seek.setMax(DM_PCT_MAX // DM_PCT_STEP)
                seek.setPadding(dp(4), dp(10), dp(4), dp(10))
                try:
                    from android.content.res import ColorStateList
                    accent = ColorStateList.valueOf(self._dm_theme("key_switchTrackChecked", 0xFF3A8CE6))
                    seek.setProgressTintList(accent)
                    seek.setThumbTintList(accent)
                    track = ColorStateList.valueOf(self._dm_theme("key_windowBackgroundWhiteGrayText", 0xFF8A8A8A))
                    seek.setProgressBackgroundTintList(track)
                except Exception:
                    pass
                listener = self._dm_seek_listener(key, value)
                if listener is not None:
                    self._dm_listeners.append(listener)
                    seek.setOnSeekBarChangeListener(listener)
                root.addView(seek, LinearLayout.LayoutParams(-1, -2))
                return self._dm_full_width(root)
            except Exception:
                return self._dm_error_view(context)
        return _create

    def _dm_slider_binder(self, key):
        def _bind(view, item, divider, adapter, list_view):
            try:
                pct = self._dm_alpha_pct()
                head = view.getChildAt(0)
                seek = view.getChildAt(1)
                if head is None or seek is None:
                    return
                head.getChildAt(1).setText("%d%%" % pct)
                seek.setProgress(0 if pct else 1)
                seek.setProgress(int(pct // DM_PCT_STEP))
            except Exception:
                pass
        return _bind

    def _dm_seek_listener(self, key, value_view):
        try:
            from java import dynamic_proxy
            from android.widget import SeekBar
        except Exception:
            return None
        plugin = self

        class _Listener(dynamic_proxy(SeekBar.OnSeekBarChangeListener)):
            def onProgressChanged(self, seek, progress, from_user):
                try:
                    pct = int(progress) * DM_PCT_STEP
                    value_view.setText("%d%%" % pct)
                    if from_user:
                        plugin._dm_live[key] = pct
                        plugin._dm_refresh_previews()
                except Exception:
                    pass

            def onStartTrackingTouch(self, seek):
                pass

            def onStopTrackingTouch(self, seek):
                try:
                    plugin._dm_set_alpha(int(seek.getProgress()) * DM_PCT_STEP)
                    plugin._dm_refresh_previews()
                except Exception:
                    pass

        return _Listener()

    def _dm_make_bubble(self, context, out):
        from android.widget import TextView
        from android.graphics.drawable import GradientDrawable
        dp = self._dm_dp
        bubble = TextView(context)
        bubble.setTextSize(15.0)
        bubble.setPadding(dp(11), dp(6), dp(11), dp(6))
        try:
            screen = int(context.getResources().getDisplayMetrics().widthPixels)
            bubble.setMaxWidth(max(dp(240), screen - dp(56)))
        except Exception:
            bubble.setMaxWidth(dp(330))
        shape = GradientDrawable()
        big, small = float(dp(16)), float(dp(5))
        radii = [big, big, big, big, small, small, big, big] if out else [big, big, big, big, big, big, small, small]
        try:
            from java import jarray, jfloat
            shape.setCornerRadii(jarray(jfloat)(radii))
        except Exception:
            shape.setCornerRadius(big)
        shape.setColor(self._dm_theme("key_chat_outBubble" if out else "key_chat_inBubble",
                                      0xFF2B5278 if out else 0xFF2A2A2E))
        bubble.setBackground(shape)
        return bubble

    def _dm_checks_span(self, color):
        try:
            from android.graphics import PorterDuff, PorterDuffColorFilter
            from android.graphics.drawable import LayerDrawable
            from android.text.style import ImageSpan
            from org.telegram.messenger import ApplicationLoader
            ctx = ApplicationLoader.applicationContext
            check_id = self._dm_res("msg_check_s")
            half_id = self._dm_res("msg_halfcheck")
            if not check_id or not half_id:
                return None
            check = ctx.getResources().getDrawable(check_id).mutate()
            half = ctx.getResources().getDrawable(half_id).mutate()
            shift = self._dm_dp(4)
            layer = LayerDrawable([check, half])
            layer.setLayerInset(0, 0, 0, shift, 0)
            layer.setLayerInset(1, shift, 0, 0, 0)
            layer.setColorFilter(PorterDuffColorFilter(color, PorterDuff.Mode.SRC_IN))
            w = int(check.getIntrinsicWidth()) + shift
            h = int(check.getIntrinsicHeight())
            layer.setBounds(0, 0, w, h)
            return ImageSpan(layer, ImageSpan.ALIGN_BASELINE)
        except Exception:
            return None

    def _dm_plain_text(self, text, time_text, out, checks=False):
        from android.text import SpannableStringBuilder
        from android.text.style import ForegroundColorSpan, RelativeSizeSpan
        text_color = self._dm_theme("key_chat_messageTextOut" if out else "key_chat_messageTextIn", 0xFFFFFFFF)
        time_color = self._dm_theme("key_chat_outTimeText" if out else "key_chat_inTimeText", 0xFF8A8A8A)
        out_text = SpannableStringBuilder(text)
        out_text.setSpan(ForegroundColorSpan(text_color), 0, len(text), 33)
        start = out_text.length()
        out_text.append("   " + time_text)
        out_text.setSpan(ForegroundColorSpan(time_color), start, out_text.length(), 33)
        out_text.setSpan(RelativeSizeSpan(0.85), start, out_text.length(), 33)
        if checks:
            span = self._dm_checks_span(time_color)
            if span is not None:
                pos = out_text.length()
                out_text.append(" \u2009")
                out_text.setSpan(span, pos + 1, pos + 2, 33)
        return out_text

    def _dm_bubble(self, context):
        from android.widget import FrameLayout, ImageView, LinearLayout
        from android.view import Gravity
        dp = self._dm_dp
        box = FrameLayout(context)
        wall = self._dm_wallpaper_drawable()
        if wall is not None:
            image = ImageView(context)
            image.setAdjustViewBounds(True)
            image.setMaxHeight(1)
            image.setMaxWidth(1)
            image.setScaleType(ImageView.ScaleType.CENTER_CROP)
            image.setImageDrawable(wall)
            box.addView(image, FrameLayout.LayoutParams(-1, -1))
        else:
            box.setBackgroundColor(self._dm_theme("key_windowBackgroundGray", 0xFFF0F0F0))
        column = LinearLayout(context)
        column.setOrientation(LinearLayout.VERTICAL)
        column.setPadding(dp(8), dp(8), dp(8), dp(8))

        def _add(bubble, out):
            lp = LinearLayout.LayoutParams(-2, -2)
            lp.gravity = int(Gravity.END if out else Gravity.START)
            lp.topMargin = dp(3)
            lp.bottomMargin = dp(3)
            column.addView(bubble, lp)

        first = self._dm_make_bubble(context, False)
        first.setText(self._dm_plain_text("Привет, как дела?", "12:30", False))
        _add(first, False)
        mine = self._dm_make_bubble(context, True)
        mine.setText(self._dm_plain_text("Норм, а у тебя?", "12:31", True, checks=True))
        _add(mine, True)
        deleted = self._dm_make_bubble(context, False)
        _add(deleted, False)
        box.addView(column, FrameLayout.LayoutParams(-1, -2))
        return box, deleted

    def _dm_wallpaper_drawable(self):
        try:
            from org.telegram.ui.ActionBar import Theme
            wall = None
            for getter in ("getCachedWallpaperNonBlocking", "getCachedWallpaper"):
                try:
                    wall = getattr(Theme, getter)()
                except Exception:
                    wall = None
                if wall is not None:
                    break
            if wall is None:
                return None
            state = wall.getConstantState()
            return state.newDrawable().mutate() if state is not None else wall
        except Exception:
            return None

    def _dm_preview_create(self, context, list_view, current_account, class_guid, resources_provider):
        try:
            box, bubble = self._dm_bubble(context)
            self._dm_preview_views.append(bubble)
            self._dm_trim_views()
            return self._dm_full_width(box)
        except Exception:
            return self._dm_error_view(context)

    def _dm_preview_bind(self, view, item, divider, adapter, list_view):
        try:
            for bubble in list(self._dm_preview_views):
                self._dm_fill_preview(bubble)
        except Exception:
            pass

    def _dm_fill_preview(self, view):
        cfg = self._dm_live_cfg()
        msg_alpha = float(cfg["alpha"])
        text_color = self._dm_theme("key_chat_messageTextIn", 0xFFFFFFFF)
        time_color = self._dm_theme("key_chat_inTimeText", 0xFF8A8A8A)
        view.setText(self._dm_preview_text(cfg, text_color, time_color, 15))
        view.setAlpha(msg_alpha)

    def _dm_refresh_previews(self):
        def _run():
            for view in list(self._dm_preview_views):
                try:
                    self._dm_fill_preview(view)
                except Exception:
                    pass
        ui(_run)

    def _dm_live_cfg(self):
        cfg = dict(self._dm_cfg())
        live = self._dm_live.get(DM_ALPHA_KEY)
        if live is not None:
            cfg["alpha_pct"] = live
        cfg["alpha"] = 1.0 - cfg["alpha_pct"] / 100.0
        return cfg

    def _dm_native_fill(self, cell):
        on = bool(self.get_setting("dm_enabled", True))
        expanded = bool(self.get_setting("dm_expanded", False))
        text, value = "Сохранять удалённые", "Остаются в чате с меткой"
        res = self._dm_res("msg_archive")
        how = self._dm_master_native.get("how")
        tries = (
            ("reflect", lambda: self._dm_reflect_icon_check(cell, text, value, res, on)),
            ("value5", lambda: cell.setTextAndValueAndCheck(text, value, on, False, False)),
        )
        for name, call in tries:
            if how is not None and name != how:
                continue
            try:
                call()
                if how is None:
                    self._dm_master_native["how"] = name
                break
            except Exception:
                continue
        try:
            cell.setChecked(on)
        except Exception:
            pass
        box = self._dm_master_native.get("arrow")
        if box is not None:
            box.setVisibility(0 if on else 4)
            arrow = box.getChildAt(1)
            arrow.setRotation(180.0 if expanded else 0.0)

    def _dm_master_click(self, plugin, item, view):
        self._dm_master_toggle("list")

    def _dm_master_toggle(self, source):
        try:
            now = time.time()
            if now - getattr(self, "_dm_last_expand", 0.0) < 0.4:
                return
            if now - getattr(self, "_dm_last_toggle", 0.0) < 0.4:
                return
            self._dm_last_toggle = now
            value = not bool(self.get_setting("dm_enabled", True))
            self._dm_cfg_cache = None
            for row in list(getattr(self, "_dm_master_rows", []) or []):
                try:
                    row.setChecked(value)
                except Exception:
                    pass
            self.set_setting("dm_enabled", value, True)
        except Exception:
            pass

    def _dm_reflect_icon_check(self, cell, text, value, res, on):
        from java import jarray
        from java.lang import Boolean, Integer, Object, String
        if not res:
            raise ValueError("no icon")
        methods = [m for m in cell.getClass().getMethods() if "Icon" in str(m.getName())
                   and "Check" in str(m.getName()) and str(m.getName()).startswith("setText")]
        methods.sort(key=lambda m: 0 if "Value" in str(m.getName()) else 1)
        for method in methods:
            types = [str(t.getName()) for t in method.getParameterTypes()]
            args, texts, ints, bools = [], [text, value], 0, 0
            ok = True
            for t in types:
                if t in ("java.lang.String", "java.lang.CharSequence"):
                    args.append(String(texts.pop(0)) if texts else None)
                elif t == "int":
                    args.append(Integer.valueOf(int(res) if ints == 0 else 0))
                    ints += 1
                elif t == "boolean":
                    args.append(Boolean.valueOf(bool(on) if bools == 0 else False))
                    bools += 1
                else:
                    ok = False
                    break
            if not ok or ints == 0:
                continue
            method.invoke(cell, jarray(Object)(args))
            return
        raise ValueError("no suitable method")

    def _dm_master_create(self, context, list_view, current_account, class_guid, resources_provider):
        try:
            from org.telegram.ui.Cells import TextCheckCell
            from java import dynamic_proxy
            from android.view import Gravity, View
            from android.widget import FrameLayout, ImageView, LinearLayout, TextView
            from android.graphics import PorterDuff, PorterDuffColorFilter
            dp = self._dm_dp
            plugin = self
            cell = TextCheckCell(context)
            cell.setBackgroundColor(self._dm_theme("key_windowBackgroundWhite", 0xFFFFFFFF))
            gray = self._dm_theme("key_windowBackgroundWhiteBlueText4",
                                  self._dm_theme("key_switchTrackChecked", 0xFF3A8CE6))
            box = LinearLayout(context)
            box.setOrientation(LinearLayout.HORIZONTAL)
            box.setGravity(int(Gravity.CENTER_VERTICAL))
            box.setPadding(dp(10), dp(10), dp(12), dp(10))
            count = TextView(context)
            count.setText("3")
            count.setTextSize(16.0)
            try:
                from android.graphics import Typeface
                count.setTypeface(Typeface.DEFAULT_BOLD)
            except Exception:
                pass
            count.setTextColor(gray)
            box.addView(count, LinearLayout.LayoutParams(-2, -2))
            arrow = ImageView(context)
            res = self._dm_res("arrow_more") or self._dm_res("msg_expand")
            if res:
                arrow.setImageResource(res)
            arrow.setColorFilter(PorterDuffColorFilter(gray, PorterDuff.Mode.SRC_IN))
            lp = LinearLayout.LayoutParams(dp(22), dp(22))
            lp.leftMargin = dp(3)
            box.addView(arrow, lp)
            line = View(context)
            line.setBackgroundColor(self._dm_theme("key_windowBackgroundWhiteGrayText", 0xFF8A8A8A))
            lp = LinearLayout.LayoutParams(max(1, dp(1)), dp(26))
            lp.leftMargin = dp(12)
            box.addView(line, lp)
            lp = FrameLayout.LayoutParams(-2, -2, int(Gravity.END | Gravity.CENTER_VERTICAL))
            lp.rightMargin = dp(66)
            cell.addView(box, lp)

            class _Toggle(dynamic_proxy(View.OnClickListener)):
                def onClick(self, view):
                    plugin._dm_master_toggle("cell")

            class _Expand(dynamic_proxy(View.OnClickListener)):
                def onClick(self, view):
                    try:
                        plugin._dm_last_expand = time.time()
                        value = not bool(plugin.get_setting("dm_expanded", False))
                        try:
                            arrow.animate().rotation(180.0 if value else 0.0).setDuration(150).start()
                        except Exception:
                            pass
                        plugin.set_setting("dm_expanded", value, True)
                    except Exception:
                        pass

            toggle, expand = _Toggle(), _Expand()
            self._dm_listeners += [toggle, expand]
            cell.setOnClickListener(toggle)
            box.setOnClickListener(expand)
            self._dm_master_native = {"row": cell, "arrow": box, "how": self._dm_master_native.get("how")}
            self._dm_master_rows = [cell]
            self._dm_native_fill(cell)
            return self._dm_full_width(cell)
        except Exception:
            self._dm_master_native = {}
            return self._dm_error_view(context)

    def _dm_master_bind(self, view, item, divider, adapter, list_view):
        try:
            for row in list(getattr(self, "_dm_master_rows", []) or []):
                self._dm_native_fill(row)
        except Exception:
            pass

    def _dm_circle_color(self, index):
        if index == 0:
            return self._dm_theme("key_chat_inTimeText", 0xFF8A8A8A)
        if index == DM_COLOR_CUSTOM:
            raw = str(self.get_setting("dm_color_hex", "FF5555") or "").strip()
            match = _HEX_RE.match(raw)
            return signed_color(0xFF000000 | int(match.group(1) if match else "FF5555", 16))
        return signed_color(DM_COLORS[index][1])

    def _dm_paint_circles(self, strip):
        from android.graphics.drawable import GradientDrawable
        dp = self._dm_dp
        current = self._choice("dm_color", 0, tuple(range(len(DM_COLORS))))
        ring = self._dm_theme("key_windowBackgroundWhiteBlackText", 0xFF000000)
        accent = self._dm_theme("key_switchTrackChecked", 0xFF3A8CE6)
        for index in range(strip.getChildCount()):
            circle = strip.getChildAt(index)
            color = self._dm_circle_color(index)
            shape = GradientDrawable()
            shape.setShape(GradientDrawable.OVAL)
            shape.setColor(color)
            if index == current:
                shape.setStroke(dp(3), accent if (int(color) & 0xFFFFFF) == 0xFFFFFF else ring)
            else:
                shape.setStroke(max(1, dp(1)), self._dm_theme("key_divider", 0xFF3A3A3E))
            circle.setBackground(shape)
            light = (((int(color) >> 16) & 0xFF) * 3 + ((int(color) >> 8) & 0xFF) * 6 + (int(color) & 0xFF)) > 1500
            circle.setTextColor(signed_color(0xFF000000 if light else 0xFFFFFFFF))
            if index == 0:
                circle.setText("A")
            elif index == DM_COLOR_CUSTOM:
                circle.setText("#")
            else:
                circle.setText("\u2713" if index == current else "")

    def _dm_palette_click(self, index):
        def _run():
            try:
                old = self._choice("dm_color", 0, tuple(range(len(DM_COLORS))))
                if index == old and index != DM_COLOR_CUSTOM:
                    return
                need_reload = (index == DM_COLOR_CUSTOM) != (old == DM_COLOR_CUSTOM)
                self.set_setting("dm_color", index, need_reload)
                self._dm_cfg_cache = None
                for strip in list(self._dm_palette_views):
                    try:
                        self._dm_paint_circles(strip)
                    except Exception:
                        pass
                self._dm_refresh_previews()
            except Exception:
                pass
        ui(_run)

    def _dm_palette_create(self, context, list_view, current_account, class_guid, resources_provider):
        try:
            from java import dynamic_proxy
            from android.view import Gravity, View
            from android.widget import HorizontalScrollView, LinearLayout, TextView
            dp = self._dm_dp
            root = LinearLayout(context)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(0, dp(10), 0, dp(8))
            root.setBackgroundColor(self._dm_theme("key_windowBackgroundWhite", 0xFFFFFFFF))
            title = TextView(context)
            title.setText("Цвет метки")
            title.setTextSize(16.0)
            title.setTextColor(self._dm_theme("key_windowBackgroundWhiteBlackText", 0xFF000000))
            title.setPadding(dp(21), 0, dp(21), dp(8))
            root.addView(title, LinearLayout.LayoutParams(-1, -2))
            scroll = HorizontalScrollView(context)
            scroll.setHorizontalScrollBarEnabled(False)
            strip = LinearLayout(context)
            strip.setOrientation(LinearLayout.HORIZONTAL)
            strip.setPadding(dp(15), dp(2), dp(15), dp(2))
            plugin = self

            class _Click(dynamic_proxy(View.OnClickListener)):
                def __init__(self, index):
                    super().__init__()
                    self.index = index

                def onClick(self, view):
                    plugin._dm_palette_click(self.index)

            for index in range(len(DM_COLORS)):
                circle = TextView(context)
                circle.setGravity(Gravity.CENTER)
                circle.setTextSize(15.0)
                circle.setContentDescription(DM_COLORS[index][0])
                listener = _Click(index)
                self._dm_listeners.append(listener)
                circle.setOnClickListener(listener)
                lp = LinearLayout.LayoutParams(dp(38), dp(38))
                lp.leftMargin = dp(6)
                lp.rightMargin = dp(6)
                strip.addView(circle, lp)
            scroll.addView(strip)
            root.addView(scroll, LinearLayout.LayoutParams(-1, -2))
            self._dm_palette_views.append(strip)
            self._dm_trim_views()
            self._dm_paint_circles(strip)
            return self._dm_full_width(root)
        except Exception:
            return self._dm_error_view(context)

    def _dm_palette_bind(self, view, item, divider, adapter, list_view):
        try:
            strip = view.getChildAt(1).getChildAt(0)
            if not any(v == strip for v in self._dm_palette_views):
                self._dm_palette_views.append(strip)
                self._dm_trim_views()
            self._dm_paint_circles(strip)
        except Exception:
            pass

    def _dm_info_values(self, kind):
        return "Сохранено", str(self._dm_store.total())

    def _dm_info_row(self, kind):
        if not self._dm_custom_ok():
            return None
        try:
            factory = self._dm_factories.get("info_" + kind)
            if factory is None:
                factory = SimpleSettingFactory(self._dm_info_creator(kind), self._dm_info_binder(kind),
                                               is_clickable=False)
                self._dm_factories["info_" + kind] = factory
            return Custom(factory=factory.instance.java)
        except Exception:
            return None

    @staticmethod
    def _dm_res(name):
        try:
            from org.telegram.messenger import ApplicationLoader
            ctx = ApplicationLoader.applicationContext
            return int(ctx.getResources().getIdentifier(name, "drawable", ctx.getPackageName()))
        except Exception:
            return 0

    def _dm_trim_views(self, keep=4):
        self._dm_preview_views = self._dm_preview_views[-keep:]
        self._dm_palette_views = self._dm_palette_views[-keep:]
        self._dm_info_views = {k: v[-keep:] for k, v in self._dm_info_views.items()}
        self._dm_listeners = self._dm_listeners[-200:]

    def _dm_info_fill(self, kind, root):
        title, value = self._dm_info_values(kind)
        if not self._dm_info_set(root, title, value):
            for own in self._dm_info_views.get(kind, []):
                self._dm_info_set(own, title, value)

    @staticmethod
    def _dm_info_set(root, title, value):
        try:
            if str(root.getClass().getSimpleName()) == "TextSettingsCell":
                root.setTextAndValue(title, value, False)
                return True
        except Exception:
            pass
        try:
            head = root.getChildAt(0)
            head.getChildAt(0).setText(title)
            head.getChildAt(1).setText(value)
            return True
        except Exception:
            return False

    def _dm_info_creator(self, kind):
        def _create(context, list_view, current_account, class_guid, resources_provider):
            root = None
            try:
                from org.telegram.ui.Cells import TextSettingsCell
                root = TextSettingsCell(context)
                root.setBackgroundColor(self._dm_theme("key_windowBackgroundWhite", 0xFFFFFFFF))
                title, value = self._dm_info_values(kind)
                root.setTextAndValue(title, value, False)
            except Exception:
                root = None
            if root is not None:
                try:
                    self._dm_info_views.setdefault(kind, []).append(root)
                    self._dm_trim_views()
                    self._dm_info_tick(root, kind)
                except Exception:
                    pass
                return self._dm_full_width(root)
            try:
                from android.widget import FrameLayout, LinearLayout, TextView
                from android.view import Gravity
                dp = self._dm_dp
                root = LinearLayout(context)
                root.setOrientation(LinearLayout.VERTICAL)
                root.setPadding(dp(21), dp(15), dp(21), dp(15))
                root.setBackgroundColor(self._dm_theme("key_windowBackgroundWhite", 0xFFFFFFFF))
                head = FrameLayout(context)
                title = TextView(context)
                title.setTextSize(16.0)
                title.setTextColor(self._dm_theme("key_windowBackgroundWhiteBlackText", 0xFF000000))
                head.addView(title, FrameLayout.LayoutParams(-2, -2, int(Gravity.START | Gravity.CENTER_VERTICAL)))
                value = TextView(context)
                value.setTextSize(16.0)
                value.setTextColor(self._dm_theme("key_windowBackgroundWhiteValueText", 0xFF3A8CE6))
                head.addView(value, FrameLayout.LayoutParams(-2, -2, int(Gravity.END | Gravity.CENTER_VERTICAL)))
                root.addView(head, LinearLayout.LayoutParams(-1, -2))
                self._dm_info_views.setdefault(kind, []).append(root)
                self._dm_trim_views()
                self._dm_info_fill(kind, root)
                try:
                    self._dm_info_tick(root, kind)
                except Exception:
                    pass
                return self._dm_full_width(root)
            except Exception:
                return self._dm_error_view(context)
        return _create

    def _dm_info_binder(self, kind):
        def _bind(view, item, divider, adapter, list_view):
            try:
                self._dm_info_fill(kind, view)
            except Exception:
                pass
        return _bind

    def _dm_info_tick(self, cell, kind):
        try:
            from java import dynamic_proxy
            from java.lang import Runnable
            from android.view import View
        except Exception:
            return
        plugin = self
        state = {"on": False}

        class _Tick(dynamic_proxy(Runnable)):
            def run(self):
                state["on"] = False
                try:
                    if not plugin._active or not cell.isAttachedToWindow():
                        return
                    plugin._dm_info_fill(kind, cell)
                    state["on"] = True
                    cell.postDelayed(self, 1000)
                except Exception:
                    pass

        tick = _Tick()

        class _Attach(dynamic_proxy(View.OnAttachStateChangeListener)):
            def onViewAttachedToWindow(self, view):
                try:
                    if plugin._active and not state["on"]:
                        state["on"] = True
                        cell.postDelayed(tick, 1000)
                except Exception:
                    pass

            def onViewDetachedFromWindow(self, view):
                try:
                    cell.removeCallbacks(tick)
                except Exception:
                    pass
                state["on"] = False

        attach = _Attach()
        cell.addOnAttachStateChangeListener(attach)
        self._dm_listeners += [tick, attach]
        self._dm_ticks = [t for t in self._dm_ticks if t[0] in self._dm_info_cells()][-12:] + [(cell, tick)]
        state["on"] = True
        cell.postDelayed(tick, 1000)

    def _dm_info_cells(self):
        return [c for cells in self._dm_info_views.values() for c in cells]

    def _dm_refresh_info(self):
        def _run():
            for kind, cells in list(self._dm_info_views.items()):
                for cell in list(cells):
                    try:
                        self._dm_info_fill(kind, cell)
                    except Exception:
                        pass
        ui(_run)

    def _dm_mark_text_changed(self, _value):
        self._dm_cfg_cache = None
        self._dm_refresh_previews()

    def _dm_hex_changed(self, value):
        self._dm_cfg_cache = None
        if not _HEX_RE.match(str(value or "").strip()):
            toast_err("Нужен HEX из 6 символов, например FF5555")
        else:
            self._dm_refresh_previews()

            def _repaint():
                for strip in list(self._dm_palette_views):
                    try:
                        self._dm_paint_circles(strip)
                    except Exception:
                        pass
            ui(_repaint)

    def _dm_mark_span(self, base_color, size_dp, cfg=None):
        if cfg is None:
            cfg = self._dm_cfg()
        mark = cfg["mark"]
        if not mark:
            return None
        from android.text import SpannableStringBuilder
        from android.text.style import ForegroundColorSpan
        color = cfg["color"] if cfg["color"] else base_color
        builder = SpannableStringBuilder(mark + " ")
        if mark == DM_ICON:
            span = self._dm_icon_span(size_dp)
            if span is None:
                builder = SpannableStringBuilder("\u2715 ")
            else:
                if color is not None:
                    try:
                        span.setOverrideColor(with_alpha(color, ((int(color) >> 24) & 0xFF) / 255.0 or 1.0))
                    except Exception:
                        pass
                builder.setSpan(span, 0, 1, 33)
                return builder
        if cfg["color"]:
            src_alpha = ((int(color) >> 24) & 0xFF) / 255.0 or 1.0
            builder.setSpan(ForegroundColorSpan(with_alpha(color, src_alpha)), 0, builder.length() - 1, 33)
        return builder

    def _dm_icon_span(self, size_dp):
        try:
            from org.telegram.ui.Components import ColoredImageSpan
            from org.telegram.messenger import AndroidUtilities, ApplicationLoader
            res_id = 0
            try:
                from org.telegram.messenger import R
                res_id = int(R.drawable.msg_delete)
            except Exception:
                ctx = ApplicationLoader.applicationContext
                res_id = int(ctx.getResources().getIdentifier("msg_delete", "drawable", ctx.getPackageName()))
            if not res_id:
                return None
            span = ColoredImageSpan(res_id)
            try:
                span.setSize(int(AndroidUtilities.dp(size_dp)))
            except Exception:
                pass
            return span
        except Exception:
            return None

    def _dm_preview_text(self, cfg, text_color, time_color, size_dp, line="Это сообщение было удалено"):
        from android.text import SpannableStringBuilder
        from android.text.style import ForegroundColorSpan, RelativeSizeSpan
        out = SpannableStringBuilder()
        out.append(line)
        out.setSpan(ForegroundColorSpan(with_alpha(text_color, 1.0)), 0, len(line), 33)
        out.append("\u00A0\u00A0\u00A0")
        start = out.length()
        mark = self._dm_mark_span(time_color, max(11, size_dp - 2), cfg=cfg)
        if mark is not None:
            out.append(mark)
            last = out.length() - 1
            if last >= start and str(out.charAt(last)) == " ":
                out.replace(last, last + 1, "\u00A0")
        time_start = out.length()
        out.append("12:32")
        out.setSpan(ForegroundColorSpan(with_alpha(time_color, 1.0)), time_start, out.length(), 33)
        out.setSpan(RelativeSizeSpan(0.85), start, out.length(), 33)
        if mark is not None and not cfg["color"] and time_start - start > 1:
            out.setSpan(ForegroundColorSpan(time_color), start, time_start - 1, 33)
        return out

    def _dm_cfg(self):
        now = time.time()
        cfg = self._dm_cfg_cache
        if cfg is not None and now - cfg["ts"] < DM_CFG_TTL:
            return cfg
        try:
            style = self._dm_style()
            mark = DM_STYLES[style][1]
            if mark is None:
                mark = str(self.get_setting("dm_mark_text", "удалено") or "").strip()[:20]
            color_index = self._choice("dm_color", 0, tuple(range(len(DM_COLORS))))
            hex_raw = str(self.get_setting("dm_color_hex", "FF5555") or "").strip()
            match = _HEX_RE.match(hex_raw)
            hex_value = match.group(1).upper() if match else "FF5555"
            if color_index == DM_COLOR_CUSTOM:
                color = signed_color(0xFF000000 | int(hex_value, 16))
            else:
                color = signed_color(DM_COLORS[color_index][1]) if DM_COLORS[color_index][1] else 0
            alpha_pct = self._dm_alpha_pct()
            cfg = {
                "ts": now,
                "enabled": bool(self.get_setting("dm_enabled", True)) and self._active,
                "bots": bool(self.get_setting("dm_bots", False)),
                "private_chats": bool(self.get_setting("dm_private_chats", True)),
                "groups": bool(self.get_setting("dm_groups", True)),
                "channels": bool(self.get_setting("dm_channels", True)),
                "notif": bool(self.get_setting("dm_notif", True)),
                "selfdestruct": bool(self.get_setting("dm_selfdestruct", False)),
                "mark": mark,
                "color": color,
                "color_index": color_index,
                "hex": hex_value,
                "alpha_pct": alpha_pct,
                "alpha": 1.0 - alpha_pct / 100.0,
            }
        except Exception:
            cfg = {"ts": now, "enabled": False, "bots": False, "notif": False, "selfdestruct": False,
                   "mark": "", "color": 0, "color_index": 0, "hex": "FF5555", "alpha_pct": 0,
                   "alpha": 1.0}
        self._dm_cfg_cache = cfg
        return cfg

    def _dm_install(self):
        self._mt_hooks_state = None
        specs = (
            ("org.telegram.messenger.DownloadController", self._dm_spec_download),
            ("org.telegram.messenger.MessagesStorage", self._dm_spec_storage),
            ("org.telegram.ui.SecretMediaViewer", self._vj_spec_viewer),
            ("org.telegram.messenger.MessagesController", self._dm_spec_controller),
            ("org.telegram.ui.ChatActivity", self._dm_spec_chat),
            ("org.telegram.messenger.NotificationsController", self._dm_spec_notif),
            ("org.telegram.ui.Cells.ChatMessageCell", self._dm_spec_cell),
            ("org.telegram.ui.recyclerview.ChatListItemAnimator", self._dm_spec_anim),
            ("androidx.recyclerview.widget.ChatListItemAnimator", self._dm_spec_anim),
        )
        installed = []
        for class_name, spec in specs:
            self._dm_hook_class(class_name, spec, installed)
        critical = {'delete_dialog', 'storage_delete_guard', 'mark_list', 'mark_range'}
        missing = (critical | {'own_range_context', 'own_range_ids'}) - set(installed)
        self._mt_hooks_state = {'critical': sorted(missing & critical)}
        if missing & critical:
            toast_err('Защита сохранённых сообщений работает не полностью. Не удаляйте чаты.')

    def _dm_hook_class(self, class_name, spec, installed):
        clazz = java_class(class_name)
        if clazz is None:
            return
        try:
            methods = list(clazz.getDeclaredMethods())
        except Exception:
            return
        for method in methods:
            try:
                name = str(method.getName())
                if name not in DM_HOOK_NAMES and not name.startswith(DM_HOOK_PREFIXES):
                    continue
                types = [str(t.getName()) for t in method.getParameterTypes()]
                kind = spec(name, types)
                if not kind:
                    continue
                returns_value = str(method.getReturnType().getName()) != "void"
                method.setAccessible(True)
                unhook = self.hook_method(method, make_hook(self, kind, returns_value))
                if unhook is None:
                    continue
                installed.append(kind)
            except Exception:
                pass

    @staticmethod
    def _dm_spec_storage(name, types):
        if name.startswith('lambda$deleteDialog$') and types == ['int', 'long']:
            return 'storage_delete_guard'
        if name == 'getCachedMessagesInRange' and types == ['long', 'int', 'int']:
            return 'own_range_ids'
        if name == "emptyMessagesMedia" and types == ["long", "java.util.ArrayList"]:
            return "expire_media"
        if name in ("markMessagesAsDeleted", "markMessagesAsDeletedInternal") and len(types) >= 3:
            if types[0] == "long" and types[1] == "java.util.ArrayList":
                return "mark_list"
            if name == "markMessagesAsDeletedInternal" and types == ["long", "int", "boolean"]:
                return "mark_range"
        if name in ("updateDialogsWithDeletedMessages", "updateDialogsWithDeletedMessagesInternal"):
            if len(types) >= 3 and types[0] == "long" and types[1] == "long" and types[2] == "java.util.ArrayList":
                return "update"
        return None

    @staticmethod
    def _dm_spec_controller(name, types):
        if name == 'lambda$processUpdateArray$426' and types == ['long', 'java.util.ArrayList', 'long']:
            return 'quick_reply_context'
        if name.startswith(DM_RANGE_LAMBDA) and types == [
                'long', 'int', 'int', 'long', 'org.telegram.tgnet.TLRPC$TL_messages_affectedHistory',
                'boolean', 'java.lang.Runnable']:
            return 'own_range_context'
        if name == "deleteMessages" and len(types) >= 7 and types[0] == "java.util.ArrayList" and types[3] == "long":
            return "delete"
        if name == "deleteMessagesRange":
            return "range_flag"
        if name == "deleteDialog" and types and types[0] == "long":
            return "delete_dialog"
        if name == "checkDeletingTask" and types == ["boolean"]:
            return "selfdestruct"
        return None

    @staticmethod
    def _dm_spec_chat(name, types):
        if name == "processDeletedMessages" and len(types) >= 2 and types[0] in (
                "java.util.ArrayList", "java.util.List", "java.util.Collection"):
            return "process"
        return None

    @staticmethod
    def _dm_spec_notif(name, types):
        if name == "removeDeletedMessagesFromNotifications" and len(types) == 2 and types[1] == "boolean":
            return "notif"
        if name == "processNewMessages" and len(types) >= 1 and types[0] == "java.util.ArrayList":
            return "mute_notif"
        return None

    @staticmethod
    def _dm_spec_anim(name, types):
        if name == "onAllAnimationsDone" and not types:
            return "anim_done"
        if name == "restoreTransitionParams" and types == ["android.view.View"]:
            return "anim_restore"
        return None

    @staticmethod
    def _dm_spec_cell(name, types):
        if name == 'fileAttach' and types == ['boolean', 'org.telegram.messenger.MessageObject']:
            return 'file_attach_context'
        if name == 'checkVideoPlayback' and types == ['boolean', 'android.graphics.Bitmap']:
            return 'round_check'
        if name == 'onSuccessDownload' and types == ['java.lang.String']:
            return 'round_download'
        if name in ("setMessageObject", "setMessageContent") and len(types) >= 4 \
                and types[0] == "org.telegram.messenger.MessageObject":
            return "cell_content" if name == "setMessageContent" else "cell_bind"
        if name == "onAttachedToWindow" and not types:
            return "cell_attach"
        if name == "measureTime" and types == ["org.telegram.messenger.MessageObject"]:
            return "measure"
        return None

    def _dm_before(self, kind, param, returns_value):
        if kind == 'quick_reply_context':
            _dm_tls.quick_reply = getattr(_dm_tls, 'quick_reply', 0) + 1
            return
        if kind == 'file_attach_context':
            stack = getattr(_dm_tls, 'file_attach', None)
            if stack is None:
                stack = _dm_tls.file_attach = []
            stack.append(param.args[1])
            return
        if kind == 'voice_auto_policy':
            self._dm_voice_auto_policy(param)
            return
        if kind == 'storage_delete_guard':
            stack = getattr(_dm_tls, 'storage_delete', None)
            if stack is None:
                stack = _dm_tls.storage_delete = []
            stack.append(None)
            self._dm_on_storage_delete(param)
            return
        if kind == "expire_media":
            self._vj_capture_empty(param)
            return
        if kind in MUTE_FILTER_ARG:
            self._mute_filter(kind, param, returns_value)
            return
        if kind in DM_UI_KINDS:
            return
        if kind in ("range_flag", "own_range_context"):
            _dm_tls.range = getattr(_dm_tls, "range", 0) + 1
            return
        if kind == "delete":
            self._dm_on_own_delete(param)
            return
        if kind == "delete_dialog":
            self._dm_on_delete_dialog(param)
            return
        cfg = self._dm_cfg()
        if not cfg["enabled"]:
            return
        if kind == "selfdestruct":
            if cfg["selfdestruct"]:
                param.setResult(False if returns_value else None)
            return
        if kind == "notif":
            if cfg["notif"] and not bool(num(param.args[1])):
                param.setResult(None)
            return
        if range_active():
            return
        if kind == "mark_list" and getattr(_dm_tls, 'range_partial', 0):
            return
        if kind == "mark_list":
            self._dm_mark_list(param, cfg, returns_value)
        elif kind == "mark_range":
            self._dm_mark_range(param, cfg, returns_value)
        elif kind == "update":
            self._dm_update_dialogs(param, cfg, returns_value)
        elif kind == "process":
            self._dm_process(param, cfg)

    def _dm_after(self, kind, param):
        if kind == "journal_view":
            self._vj_capture_viewer(param)
        elif kind in ("range_flag", "own_range_context"):
            _dm_tls.range = max(0, getattr(_dm_tls, "range", 0) - 1)
        elif kind == 'quick_reply_context':
            _dm_tls.quick_reply = max(0, getattr(_dm_tls, 'quick_reply', 0) - 1)
        elif kind == 'storage_delete_guard':
            stack = getattr(_dm_tls, 'storage_delete', None)
            item = stack.pop() if stack else None
            if item is not None:
                scope, token = item
                with self._lock:
                    current = self._mt_deleting.get(scope)
                    if current is not None and current[0] is token:
                        self._mt_deleting.pop(scope, None)
        elif kind == 'own_range_ids':
            if range_active():
                account = controller_account(param.thisObject)
                dialog_id = int(num(param.args[0]))
                mids = [m for m in ids_of(param.getResult()) if m > 0]
                if dialog_id and mids:
                    self._dm_forget_own(account, dialog_id, mids)
        elif kind == 'file_attach_context':
            stack = getattr(_dm_tls, 'file_attach', None)
            if stack:
                stack.pop()
        elif kind in ("cell_bind", "cell_content", "cell_attach", "round_check", "round_download"):
            self._vj_freeze_history_round(param.thisObject)
            if kind in ("cell_bind", "cell_content", "cell_attach"):
                self._dm_cell_bind(param)
        elif kind == "measure":
            self._dm_measure(param)
        elif kind == "anim_restore":
            if self._dm_dimmed:
                self._dm_reapply(param.args[0])
        elif kind == "anim_done":
            if self._dm_dimmed:
                self._dm_reapply_visible()

    def _dm_prune_pending(self, now):
        with self._lock:
            if len(self._dm_pend) > 2000:
                for key, dialogs in list(self._dm_pend.items()):
                    recent = {did: stamp for did, stamp in dialogs.items() if now - stamp <= DM_PENDING_TTL}
                    if recent:
                        self._dm_pend[key] = recent
                    else:
                        self._dm_pend.pop(key, None)
        if len(self._dm_clear) > 100:
            for key in [k for k, v in self._dm_clear.items() if now - v[0] > DM_PENDING_TTL]:
                self._dm_clear.pop(key, None)

    def _dm_uncache_delete(self, account, dialog_id, mids):
        with self._lock:
            selected = set(mids)
            self._dm_dedup = {key: value for key, value in self._dm_dedup.items()
                              if not (key[0] == account and key[1] in (0, dialog_id)
                                      and selected.intersection(key[2]))}

    def _dm_on_own_delete(self, param):
        argc = len(param.args)
        if argc in (7, 8):
            mode = int(num(param.args[6]))
        elif argc in (10, 12):
            mode = int(num(param.args[5]))
        else:
            return
        if mode in (1, 5, 9):
            return
        account = controller_account(param.thisObject)
        dialog_id = int(num(param.args[3]))
        mids = [m for m in ids_of(param.args[0]) if m > 0]
        if not mids:
            return
        if getattr(_dm_tls, 'clear_defer_forget', 0):
            with self._lock:
                self._dm_record_pending(account, dialog_id, mids, time.time())
                self._dm_uncache_delete(account, dialog_id, mids)
            return
        if not self._dm_forget_own(account, dialog_id, mids):
            param.setResult(None)

    def _dm_forget_own(self, account, dialog_id, mids):
        now = time.time()
        self._dm_prune_pending(now)
        with self._lock:
            pending_before = {mid: self._dm_pend.get((int(account), int(mid)), {}).get(int(dialog_id))
                              for mid in mids}
            self._dm_record_pending(account, dialog_id, mids, now)
            self._dm_uncache_delete(account, dialog_id, mids)
            scope = (int(account), int(dialog_id))
            ready_before = self._mt_snapshot_ready.get(scope)
            with self._dm_store._lock:
                revision_before = self._dm_store._scope_revision.get(scope, 0)
            forgotten = False
            try:
                owner = self._vj_owner(account)
                store = self._mt_snapshot_store()
                garbage = store.forget(owner, account, dialog_id, mids)
                forgotten = True
            except Exception:
                for mid, previous in pending_before.items():
                    key = (int(account), int(mid))
                    dialogs = self._dm_pend.get(key)
                    if dialogs is not None and dialogs.get(int(dialog_id)) == now:
                        if previous is None:
                            dialogs.pop(int(dialog_id), None)
                            if not dialogs:
                                self._dm_pend.pop(key, None)
                        else:
                            dialogs[int(dialog_id)] = previous
                toast_err('Удаление остановлено: не удалось убрать сохранённую копию сообщения.')
                return False
            if garbage:
                def collect():
                    try:
                        store.collect_media(garbage)
                    except Exception:
                        pass
                try:
                    threading.Thread(target=collect, name='multi_tools-cleanup', daemon=True).start()
                except Exception:
                    pass
            self._dm_store.remove(account, dialog_id, mids)
            if forgotten and ready_before == (owner, revision_before, self._lifecycle_generation):
                with self._dm_store._lock:
                    revision_after = self._dm_store._scope_revision.get(scope, 0)
                self._mt_snapshot_ready[scope] = (owner, revision_after, self._lifecycle_generation)
            return True

    def _mt_snapshot_store(self):
        with self._lock:
            if self._mt_snapshots is None:
                self._mt_snapshots = SnapshotStore(os.path.join(os.path.dirname(self._dm_store.path()), 'multi_tools_records_v1.sqlite'))
            return self._mt_snapshots

    def _mt_reconcile_start(self):
        path = os.path.join(os.path.dirname(self._dm_store.path()), 'multi_tools_records_v1.sqlite')
        if not os.path.isfile(path) or os.path.islink(path):
            return
        epoch = self._lifecycle_generation
        def work():
            try:
                store = self._mt_snapshot_store()
                store.sweep_orphan_media()
                store.sweep_orphan_keys()
                changed = 0
                for account, dialog_id, mids in self._dm_store.snapshot():
                    if not self._active or self._lifecycle_generation != epoch:
                        return
                    try:
                        owner = self._vj_owner(account)
                        excluded = store.excluded(owner, account, dialog_id, mids)
                        if not excluded:
                            continue
                        with self._lock:
                            if (not self._active or self._lifecycle_generation != epoch
                                    or self._vj_owner(account) != owner):
                                return
                            self._dm_store.remove(account, dialog_id, excluded)
                        changed += len(excluded)
                        self._dm_refresh(account, dialog_id, excluded)
                    except Exception:
                        pass
                if changed and not self._dm_store.flush_now():
                    raise OSError('Marker reconciliation write failed')
            except Exception:
                pass
        threading.Thread(target=work, name='multi_tools-reconcile', daemon=True).start()

    def _mt_snapshot_start(self, account, dialog_id, mids=None):
        scope = (int(account), int(dialog_id))
        with self._lock:
            if not self._active:
                return
            if mids is None:
                self._mt_snapshot_full.add(scope)
            else:
                requested = {int(mid) for mid in mids if int(mid) > 0}
                if not requested:
                    return
                self._mt_snapshot_pending.setdefault(scope, set()).update(requested)
            if scope in self._mt_snapshot_running:
                return
            self._mt_snapshot_running.add(scope)
            epoch = self._lifecycle_generation
        def worker():
            detached = False
            try:
                while True:
                    with self._lock:
                        full = scope in self._mt_snapshot_full
                        self._mt_snapshot_full.discard(scope)
                        requested = self._mt_snapshot_pending.pop(scope, set())
                        if not full and not requested:
                            self._mt_snapshot_running.discard(scope)
                            detached = True
                            return
                    revision = None
                    try:
                        from org.telegram.messenger import MessagesStorage
                        owner = self._vj_owner(account)
                        def alive():
                            try:
                                return self._active and self._lifecycle_generation == epoch and self._vj_owner(account) == owner
                            except Exception:
                                return False
                        def markers(a, d):
                            with self._dm_store._lock:
                                current = set(self._dm_store._data.get(a, {}).get(d, ()))
                                return current if full else current.intersection(requested)
                        with self._dm_store._lock:
                            revision = self._dm_store._scope_revision.get(scope, 0)
                        provider = TelegramCaptureProvider(self, MessagesStorage.getInstance(account), owner, alive, local_runnable, TLRPC)
                        runner = MigrationRunner(self._mt_snapshot_store(), provider, markers, alive)
                        result = runner.run(owner, account, dialog_id)
                        ready = False
                        with self._lock:
                            with self._dm_store._lock:
                                bucket = self._dm_store._data.get(account, {}).get(dialog_id, ())
                                ready = (alive() and self._dm_store.loaded and not self._dm_store.read_only
                                         and self._dm_store._scope_revision.get(scope, 0) == revision
                                         and len(bucket) == result['captured']
                                         and result['missing_rows'] == 0 and result['missing_media'] == 0)
                                if ready:
                                    self._mt_snapshot_ready[scope] = (owner, revision, epoch)
                                    self._mt_snapshot_incomplete.pop(scope, None)
                                else:
                                    self._mt_snapshot_ready.pop(scope, None)
                                    if full and alive() and self._dm_store._scope_revision.get(scope, 0) == revision:
                                        self._mt_snapshot_incomplete[scope] = (owner, revision, epoch, result['missing_rows'], result['missing_media'])
                    except Exception:
                        with self._lock:
                            self._mt_snapshot_ready.pop(scope, None)
                            with self._dm_store._lock:
                                changed = (revision is not None and
                                           self._dm_store._scope_revision.get(scope, 0) != revision)
                            if changed and self._active and self._lifecycle_generation == epoch:
                                if full:
                                    self._mt_snapshot_full.add(scope)
                                else:
                                    self._mt_snapshot_pending.setdefault(scope, set()).update(requested)
                    with self._lock:
                        if (not self._active or self._lifecycle_generation != epoch or
                                (scope not in self._mt_snapshot_full and not self._mt_snapshot_pending.get(scope))):
                            self._mt_snapshot_running.discard(scope)
                            self._mt_snapshot_full.discard(scope)
                            self._mt_snapshot_pending.pop(scope, None)
                            detached = True
                            return
            finally:
                if not detached:
                    with self._lock:
                        self._mt_snapshot_running.discard(scope)
                        self._mt_snapshot_full.discard(scope)
                        self._mt_snapshot_pending.pop(scope, None)
        try:
            threading.Thread(target=worker, name='multi_tools-snapshot', daemon=True).start()
        except Exception:
            with self._lock:
                self._mt_snapshot_running.discard(scope)
            raise

    def _mt_delete_ready_locked(self, account, dialog_id, owner):
        scope = (int(account), int(dialog_id))
        with self._dm_store._lock:
            if not self._dm_store.loaded or self._dm_store.read_only:
                raise OSError('Marker store unavailable')
            count = len(self._dm_store._data.get(scope[0], {}).get(scope[1], ()))
            revision = self._dm_store._scope_revision.get(scope, 0)
            valid = (not count or self._mt_snapshot_ready.get(scope) ==
                     (int(owner), revision, self._lifecycle_generation))
        return count, valid

    def _mt_deleting_active_locked(self, account, dialog_id):
        scope = (int(account), int(dialog_id))
        item = self._mt_deleting.get(scope)
        if item is None:
            return False
        if time.monotonic() - item[1] > 120:
            self._mt_deleting.pop(scope, None)
            return False
        return True

    def _dm_on_storage_delete(self, param):
        try:
            account = self._vj_account(param.thisObject)
            dialog_id = int(num(param.args[1]))
            if not dialog_id:
                raise ValueError('Invalid dialog')
            owner = self._vj_owner(account)
            scope = (account, dialog_id)
            with self._lock:
                ready = self._mt_delete_ready_locked(account, dialog_id, owner)[1]
                if ready:
                    current = self._mt_deleting.get(scope)
                    if current is None or not self._mt_deleting_active_locked(account, dialog_id):
                        current = (object(), time.monotonic())
                        self._mt_deleting[scope] = current
                    stack = getattr(_dm_tls, 'storage_delete', None)
                    if stack:
                        stack[-1] = (scope, current[0])
            if not ready:
                param.setResult(None)
                self._mt_snapshot_start(account, dialog_id)
                toast_err('Удаление остановлено: не все сохранённые сообщения удалось проверить.')
        except Exception:
            param.setResult(None)
            toast_err('Удаление записей чата остановлено: не удалось проверить сохранённые сообщения.')

    def _dm_on_delete_dialog(self, param):
        try:
            account = self._vj_account(param.thisObject)
            dialog_id = int(num(param.args[0]))
            if not dialog_id:
                raise ValueError('Invalid dialog')
            owner = self._vj_owner(account)
            now = time.time()
            self._dm_prune_pending(now)
            migration = self._dm_is_migration(account, dialog_id, now)
            bounds = []
            try:
                if len(param.args) >= 7: bounds.append(int(num(param.args[3])))
            except Exception: pass
            try:
                dialog = get_messages_controller(account).dialogs_dict.get(int(dialog_id))
                if dialog is not None: bounds.append(int(dialog.top_message))
            except Exception: pass
            scope = (account, dialog_id)
            with self._lock:
                ready = self._mt_delete_ready_locked(account, dialog_id, owner)[1]
                incomplete = self._mt_snapshot_incomplete.get(scope)
                with self._dm_store._lock:
                    revision = self._dm_store._scope_revision.get(scope, 0)
                incomplete = incomplete if incomplete and incomplete[:3] == (owner, revision, self._lifecycle_generation) else None
                if ready:
                    if not self._mt_deleting_active_locked(account, dialog_id):
                        self._mt_deleting[scope] = (object(), time.monotonic())
                    if not migration:
                        prev = self._dm_clear.get(scope)
                        if prev is not None and now - prev[0] < DM_PENDING_TTL and prev[1]:
                            bounds.append(prev[1])
                        max_mid = max([b for b in bounds if b > 0] or [0]) or None
                        self._dm_clear[scope] = (now, max_mid)
            if not ready:
                param.setResult(None)
                self._mt_snapshot_start(account, dialog_id)
                if incomplete and (incomplete[3] or incomplete[4]):
                    toast_info('Удаление чата остановлено: не удалось подготовить некоторые сохранённые сообщения или файлы. Сохранённые копии защищены.')
                else:
                    toast_info('Подготовка сохранённых сообщений. После завершения попробуйте удалить чат ещё раз.')
                return
        except Exception:
            param.setResult(None)
            toast_err('Удаление чата отменено: не удалось проверить сохранённые сообщения.')
            return

    def _dm_is_migration(self, account, dialog_id, now):
        if dialog_id >= 0:
            return False
        try:
            stamp = self._dm_migr.get((account, dialog_id))
            if stamp is not None and now - stamp < DM_PENDING_TTL:
                return True
            chat = self._get_chat(account, -dialog_id)
            migrated = getattr(chat, "migrated_to", None) if chat is not None else None
            channel_id = int(num(getattr(migrated, "channel_id", 0))) if migrated is not None else 0
            if channel_id:
                self._dm_migr[(account, -channel_id)] = now
                return True
        except Exception:
            pass
        return False

    def _dm_clear_active(self, account, dialog_id, mid, now):
        stamp = self._dm_clear.get((account, dialog_id))
        if stamp is None or now - stamp[0] >= DM_PENDING_TTL:
            return False
        return stamp[1] is None or mid <= stamp[1]

    def _dm_record_pending(self, account, dialog_id, mids, now):
        with self._lock:
            for mid in mids:
                self._dm_pend.setdefault((int(account), int(mid)), {})[int(dialog_id)] = now

    def _dm_is_pending(self, account, dialog_id, mid, now):
        with self._lock:
            dialogs = self._dm_pend.get((int(account), int(mid)), {})
            if dialog_id == 0:
                pending = any(now - stamp < DM_PENDING_TTL for stamp in dialogs.values())
            else:
                pending = any(stamp is not None and now - stamp < DM_PENDING_TTL
                              for stamp in (dialogs.get(int(dialog_id)), dialogs.get(0)))
        return pending or self._dm_clear_active(account, dialog_id, mid, now)

    def _dm_split(self, account, dialog_id, mids):
        keep, save = [], []
        now = time.time()
        for mid in mids:
            if mid <= 0 or self._dm_is_pending(account, dialog_id, mid, now):
                keep.append(mid)
            else:
                save.append(mid)
        return keep, save

    def _dm_skip_dialog(self, account, dialog_id, cfg):
        if dialog_id == 0:
            return False
        if dialog_id > 0 and (dialog_id & 0x4000000000000000) != 0:
            return True
        if dialog_id > 0:
            if not cfg.get("private_chats", True):
                return True
            if not cfg["bots"]:
                user = self._get_user(account, dialog_id)
                if user is not None and bool(getattr(user, "bot", False)):
                    return True
            return False
        groups, channels = cfg.get("groups", True), cfg.get("channels", True)
        if groups == channels:
            return not groups
        chat = self._get_chat(account, -dialog_id)
        if chat is None:
            return True
        try:
            is_channel = bool(ChatObject.isChannel(chat)) and not bool(getattr(chat, "megagroup", False))
            return not (channels if is_channel else groups)
        except Exception:
            return True

    @staticmethod
    def _dm_query(storage, sql, strict=False):
        rows = []
        db = storage.getDatabase()
        if db is None:
            if strict:
                raise OSError("Message database is unavailable")
            return rows
        try:
            cursor = db.queryFinalized(sql)
        except TypeError:
            from java import jarray
            from java.lang import Object
            cursor = db.queryFinalized(sql, jarray(Object)([]))
        try:
            while cursor.next():
                rows.append((int(cursor.longValue(0)), int(cursor.intValue(1))))
        finally:
            try:
                cursor.dispose()
            except Exception:
                pass
        return rows

    def _dm_resolve(self, account, storage, mids):
        groups = {}
        left = set(mids)
        try:
            sql = ("SELECT uid, mid FROM messages_v2 WHERE mid IN (%s) AND is_channel = 0"
                   % ",".join(str(int(m)) for m in mids))
            rows = self._dm_query(storage, sql)
            for uid, mid in rows:
                if mid in left and uid != 0:
                    groups.setdefault(uid, []).append(mid)
                    left.discard(mid)
        except Exception:
            pass
        if left:
            try:
                cache = get_messages_controller(account).dialogMessagesByIds
                for mid in list(left):
                    obj = cache.get(int(mid))
                    if obj is not None:
                        uid = int(obj.getDialogId())
                        if uid:
                            groups.setdefault(uid, []).append(mid)
                            left.discard(mid)
            except Exception:
                pass
        if left:
            try:
                fragment = get_last_fragment()
                if fragment is not None and str(fragment.getClass().getName()) == "org.telegram.ui.ChatActivity" \
                        and int(fragment.getCurrentAccount()) == int(account):
                    did = int(fragment.getDialogId())
                    for obj in jlist(fragment.messages):
                        mid = int(obj.getId())
                        if mid in left:
                            groups.setdefault(did, []).append(mid)
                            left.discard(mid)
            except Exception:
                pass
        if left:
            groups[0] = sorted(left)
        return groups

    def _dm_purge_own(self):
        with self._lock:
            self._dm_purge_generation = getattr(self, "_dm_purge_generation", 0) + 1

    def _dm_intercept(self, account, storage, dialog_id, mids, cfg):
        key = (int(account), int(dialog_id), tuple(sorted(int(m) for m in mids)))
        now = time.time()
        with self._lock:
            hit = self._dm_dedup.get(key)
            if hit is not None and now - hit[0] < DM_DEDUP_TTL:
                hit = (list(hit[1]), hit[2])
            else:
                hit = None
        if hit is not None:
            return hit
        keep, saved = self._dm_intercept_now(account, storage, dialog_id, mids, cfg)
        with self._lock:
            if len(self._dm_dedup) > 200:
                self._dm_dedup = {k: v for k, v in self._dm_dedup.items() if now - v[0] < DM_DEDUP_TTL}
            self._dm_dedup[key] = (now, list(keep), saved)
        return keep, saved

    def _dm_intercept_now(self, account, storage, dialog_id, mids, cfg):
        keep, save = self._dm_split(account, dialog_id, mids)
        if not save:
            return keep, False
        if dialog_id != 0:
            if self._dm_skip_dialog(account, dialog_id, cfg):
                return mids, False
            groups = {dialog_id: save}
        else:
            groups = self._dm_resolve(account, storage, save)
            keep += groups.pop(0, [])
        saved = False
        for did, part in groups.items():
            if self._dm_skip_dialog(account, did, cfg):
                keep += part
                continue
            own = self._dm_save(account, did, part)
            keep += own
            if len(own) < len(part):
                saved = True
        return keep, saved

    def _dm_mark_own(self, account, dialog_id, mids):
        now = time.time()
        self._dm_record_pending(account, dialog_id, mids, now)

    def _dm_filter_own(self, account, dialog_id, mids):
        with self._lock:
            if self._mt_deleting_active_locked(account, dialog_id):
                return list(mids), []
        own, rest = [], []
        now = time.time()
        for mid in mids:
            (own if self._dm_is_pending(account, dialog_id, mid, now) else rest).append(mid)
        return own, rest

    def _dm_save(self, account, dialog_id, mids):
        with self._lock:
            own, mids = self._dm_filter_own(account, dialog_id, list(mids))
            if own:
                self._dm_mark_own(account, dialog_id, own)
            if not mids:
                return own
            try:
                owner = self._vj_owner(account)
                excluded = self._mt_snapshot_store().excluded(owner, account, dialog_id, mids)
                own += [mid for mid in mids if mid in excluded]
                mids = [mid for mid in mids if mid not in excluded]
                added = self._dm_store.add(account, dialog_id, mids) if mids else []
            except Exception as exc:
                self._dm_store_notice(exc)
                return own + [m for m in mids if not self._dm_store.has(account, dialog_id, m)]
        if added:
            try:
                self._mt_snapshot_start(account, dialog_id, added)
            except Exception:
                pass
            self._dm_media_rescue(int(account), int(dialog_id), added)
            self._dm_refresh(account, dialog_id, added)
        return own

    def _dm_store_notice(self, exc):
        try:
            now = time.monotonic()
            with self._lock:
                if now - self._dm_store_notice_at < 30:
                    return
                self._dm_store_notice_at = now
        except Exception:
            pass
        if isinstance(exc, OverflowError):
            toast_err("Достигнут лимит меток удаления в чате. Новое сообщение не сохранено. "
                      "Удалите сохранённые через настройки плагина, если они больше не нужны.")
        else:
            toast_err("Не удалось записать метку удаления. Сообщение не сохранено: "
                      "проверьте свободное место и доступ к хранилищу.")

    def _dm_mark_list(self, param, cfg, returns_value):
        argc = len(param.args)
        if argc == 6:
            mode = int(num(param.args[4]))
        elif argc == 5:
            mode = int(num(param.args[3]))
        else:
            return
        if mode in (1, 5, 9):
            return
        mids = ids_of(param.args[1])
        if not mids:
            return
        account = controller_account(param.thisObject)
        dialog_id = int(num(param.args[0]))
        keep, saved = self._dm_intercept(account, param.thisObject, dialog_id, mids, cfg)
        if not saved:
            return
        param.args[1] = int_list(keep)
        if not keep:
            param.setResult(ArrayList() if returns_value else None)

    def _dm_mark_range(self, param, cfg, returns_value):
        account = controller_account(param.thisObject)
        raw = int(num(param.args[0]))
        dialog_id = -raw
        max_mid = int(num(param.args[1]))
        if not raw or max_mid <= 0:
            return
        if self._dm_skip_dialog(account, dialog_id, cfg):
            return
        now = time.time()
        if self._dm_clear_active(account, dialog_id, max_mid, now):
            return
        try:
            if JavaThread.currentThread() != param.thisObject.getStorageQueue():
                param.setResult(ArrayList() if returns_value else None)
                return
            rows = self._dm_query(param.thisObject,
                                  "SELECT mid, 0 FROM messages_v2 WHERE uid = %d AND mid <= %d "
                                  "ORDER BY mid DESC" % (dialog_id, max_mid), strict=True)
        except Exception:
            param.setResult(ArrayList() if returns_value else None)
            return
        mids = [int(r[0]) for r in rows if int(r[0]) > 0]
        if not mids:
            return
        result = ArrayList() if returns_value else None
        param.setResult(result)
        passthrough = self._dm_save(account, dialog_id, mids)
        remove = [int(r[0]) for r in rows if int(r[0]) <= 0]
        remove.extend(passthrough)
        if remove:
            try:
                _dm_tls.range_partial = getattr(_dm_tls, 'range_partial', 0) + 1
                for pos in range(0, len(remove), 300):
                    affected = param.thisObject.markMessagesAsDeleted(
                        dialog_id, int_list(remove[pos:pos + 300]), False,
                        bool(num(param.args[2])), 0, 0)
                    if result is not None and affected is not None:
                        for value in jlist(affected):
                            if not result.contains(value):
                                result.add(value)
            except Exception:
                pass
            finally:
                _dm_tls.range_partial = max(0, getattr(_dm_tls, 'range_partial', 0) - 1)

    def _dm_update_dialogs(self, param, cfg, returns_value):
        if getattr(_dm_tls, 'quick_reply', 0):
            return
        mids = ids_of(param.args[2])
        if not mids:
            return
        account = controller_account(param.thisObject)
        uid = int(num(param.args[0]))
        channel_id = int(num(param.args[1]))
        dialog_id = -channel_id if channel_id else uid
        keep, saved = self._dm_intercept(account, param.thisObject, dialog_id, mids, cfg)
        if not saved:
            return
        param.args[2] = int_list(keep)
        if not keep and not returns_value:
            param.setResult(None)

    def _dm_process(self, param, cfg):
        chat = param.thisObject
        try:
            if int(chat.getChatMode()) in (1, 5, 9):
                return
        except Exception:
            pass
        account = int(chat.getCurrentAccount())
        dialog_id = int(chat.getDialogId())
        channel_id = int(num(param.args[1])) if len(param.args) > 1 else 0
        if channel_id and -channel_id != dialog_id:
            return
        if not channel_id and dialog_id < 0 and self._is_channel(account, dialog_id):
            return
        if self._dm_skip_dialog(account, dialog_id, cfg):
            return
        keep, save = self._dm_split(account, dialog_id, ids_of(param.args[0]))
        if not save:
            return
        keep += self._dm_save(account, dialog_id, save)
        param.args[0] = int_list(keep)

    def _dm_obj_deleted(self, account, obj):
        if obj is None:
            return False
        if self._vj_history_object(obj) or bool(getattr(obj, "deleted", False)):
            return True
        return self._dm_store.has(account, int(obj.getDialogId()), int(obj.getId()))

    def _dm_cell_deleted(self, cell, obj):
        if obj is None:
            return False
        account = int(obj.currentAccount)
        if not self._vj_history_object(obj) and not self._dm_store.any_for(account) and not bool(getattr(obj, "deleted", False)):
            return False
        try:
            group = cell.getCurrentMessagesGroup()
            messages = group.messages if group is not None else None
            if messages is not None and messages.size() > 0:
                for item in jlist(messages):
                    if not self._dm_obj_deleted(account, item):
                        return False
                return True
        except Exception:
            pass
        return self._dm_obj_deleted(account, obj)

    def _dm_cell_bind(self, param):
        cell = param.thisObject
        obj = cell.getMessageObject()
        if not self._dm_dimmed and (obj is None or (not self._vj_history_object(obj) and not bool(getattr(obj, "deleted", False))
                                                     and not self._dm_store.any_for(int(obj.currentAccount)))):
            return
        cfg = self._dm_cfg()
        key = ident(cell)
        dim = (cfg["enabled"] and cfg["alpha"] < 1.0 and obj is not None
               and not bool(getattr(obj, "deletedByThanos", False)) and self._dm_cell_deleted(cell, obj))
        if dim:
            if key not in self._dm_dimmed and len(self._dm_dimmed) > 600:
                for old in list(self._dm_dimmed)[:300]:
                    self._dm_dimmed.pop(old, None)
            target = float(cfg["alpha"])
            self._dm_dimmed[key] = target
            if abs(float(cell.getAlpha()) - target) >= 0.01:
                cell.setAlpha(target)
        elif self._dm_dimmed.pop(key, None) is not None:
            cell.setAlpha(1.0)

    def _dm_reapply(self, view):
        target = self._dm_dimmed.get(ident(view))
        if target is None or not self._dm_cfg()["enabled"]:
            return
        if abs(float(view.getAlpha()) - target) >= 0.01:
            view.setAlpha(target)

    def _dm_reapply_visible(self):
        fragment = get_last_fragment()
        if fragment is None or str(fragment.getClass().getName()) != "org.telegram.ui.ChatActivity":
            return
        list_view = fragment.getChatListView()
        if list_view is None:
            return
        for i in range(int(list_view.getChildCount())):
            self._dm_reapply(list_view.getChildAt(i))

    def _dm_measure(self, param):
        cfg = self._dm_cfg()
        mark = cfg["mark"]
        if not cfg["enabled"] or not mark:
            return
        cell = param.thisObject
        obj = param.args[0]
        if obj is None or not self._dm_cell_deleted(cell, obj):
            return

        cls = "org.telegram.ui.Cells.ChatMessageCell"
        field = java_field(cls, "currentTimeString")
        if field is None:
            return
        current = field.get(cell)
        if current is None:
            return
        text = current if isinstance(current, str) else str(current.toString())
        if text.startswith(mark + " ") or text.startswith("\u2715 ") and mark == DM_ICON:
            return
        from android.text import SpannableStringBuilder
        from org.telegram.ui.ActionBar import Theme
        import math
        paint = Theme.chat_timePaint
        prefix = self._dm_mark_span(None, 13)
        if prefix is None:
            return
        try:
            builder = current if isinstance(current, SpannableStringBuilder) else SpannableStringBuilder(current)
            builder.insert(0, prefix)
            field.set(cell, builder)
        except Exception:
            field.set(cell, str(prefix.toString()) + text)

        width = 0
        try:
            from android.text.style import ReplacementSpan
            spans = prefix.getSpans(0, 1, ReplacementSpan)
            if spans is not None and len(spans) > 0:
                width = int(spans[0].getSize(paint, prefix, 0, 1, None)) + \
                    int(math.ceil(float(paint.measureText(" "))))
        except Exception:
            width = 0
        if width <= 0:
            width = int(math.ceil(float(paint.measureText(str(prefix.toString())))))
        for name in ("timeTextWidth", "timeWidth"):
            fld = java_field(cls, name)
            if fld is not None:
                fld.setInt(cell, int(fld.getInt(cell)) + width)

    def _dm_refresh(self, account, dialog_id, mids):
        wanted = set(int(m) for m in mids)

        def _run():
            try:
                from org.telegram.ui.Cells import ChatMessageCell
                fragment = get_last_fragment()
                if fragment is None or str(fragment.getClass().getName()) != "org.telegram.ui.ChatActivity":
                    return
                if int(fragment.getCurrentAccount()) != account or int(fragment.getDialogId()) != dialog_id:
                    return
                list_view = fragment.getChatListView()
                if list_view is None:
                    return
                adapter = list_view.getAdapter()
                for i in range(int(list_view.getChildCount())):
                    view = list_view.getChildAt(i)
                    if not isinstance(view, ChatMessageCell):
                        continue
                    obj = view.getMessageObject()
                    if obj is None or int(obj.getId()) not in wanted:
                        continue
                    try:
                        view.forceResetMessageObject()
                    except Exception:
                        pass
                    pos = int(list_view.getChildAdapterPosition(view))
                    if adapter is not None and pos >= 0:
                        adapter.notifyItemChanged(pos)
                    view.requestLayout()
                    view.invalidate()
            except Exception:
                pass
        ui(_run)

    def _dm_on_clear(self, _view=None):
        total = self._dm_store.total()
        if not total:
            toast_info("Сохранённых нет")
            return
        self._confirm("Удалить сохранённые?",
                      "%d %s исчезнут из чатов на этом устройстве." % (total, plural_ru(total)),
                      "Удалить", self._dm_clear_now)

    def _dm_clear_now(self, scope=None, expected_epoch=None):
        if scope is not None:
            try:
                if not isinstance(scope, tuple) or len(scope) != 2:
                    raise ValueError("Invalid scope")
                scope = self._dm_chat_scope(*scope)
            except Exception:
                toast_err("Не удалось определить чат — очистка отменена")
                return
        entries = [entry for entry in self._dm_store.snapshot()
                   if scope is None or (entry[0], entry[1]) == scope]

        def _run():
            with self._lock:
                if not self._active or (expected_epoch is not None and
                        getattr(self, "_lifecycle_generation", 0) != expected_epoch):
                    return
                if not entries:
                    toast_info("Сохранённых удалённых сообщений нет")
                    return
                try:
                    self.set_setting("dm_purged_own_v3", False)
                    prepared = not bool(self.get_setting("dm_purged_own_v3", True))
                except Exception:
                    prepared = False
                if prepared:
                    self._dm_purge_generation = getattr(self, "_dm_purge_generation", 0) + 1
            if not prepared:
                toast_err("Не удалось подготовить очистку журнала — действие отменено")
                return
            failed = 0
            for account, dialog_id, mids in entries:
                try:
                    controller = get_messages_controller(int(account))
                except Exception:
                    failed += len(mids)
                    continue
                for start in range(0, len(mids), HARD_LIMIT):
                    batch = mids[start:start + HARD_LIMIT]
                    with self._lock:
                        pending_before = {mid: self._dm_pend.get((int(account), int(mid)), {}).get(int(dialog_id))
                                          for mid in batch}
                    self._dm_uncache_delete(account, dialog_id, batch)
                    try:
                        _dm_tls.clear_defer_forget = getattr(_dm_tls, 'clear_defer_forget', 0) + 1
                        try:
                            controller.deleteMessages(int_list(batch), None, None, int(dialog_id), 0, False, 0, True)
                        finally:
                            _dm_tls.clear_defer_forget = max(0, getattr(_dm_tls, 'clear_defer_forget', 0) - 1)
                    except Exception:
                        failed += len(batch)
                        with self._lock:
                            for mid, previous in pending_before.items():
                                key = (int(account), int(mid))
                                if previous is None:
                                    dialogs = self._dm_pend.get(key)
                                    if dialogs is not None:
                                        dialogs.pop(int(dialog_id), None)
                                        if not dialogs:
                                            self._dm_pend.pop(key, None)
                                else:
                                    self._dm_pend.setdefault(key, {})[int(dialog_id)] = previous
                        try:
                            self._dm_store.add(account, dialog_id, batch)
                        except Exception:
                            self._dm_store._restore_pending(account, dialog_id, batch)
                    else:
                        if not self._dm_forget_own(account, dialog_id, batch):
                            failed += len(batch)
            saved = self._dm_store.flush_now()
            if not saved:
                try:
                    self._dm_store.save_later()
                except Exception:
                    pass
            self._dm_refresh_info()
            if not saved:
                toast_err("Не удалось сохранить журнал удалённых")
            elif failed:
                toast_err("Не удалось убрать %d %s" % (failed, plural_ru(failed)))
            else:
                toast_ok("Очистка отправлена клиенту")
            self._reload_settings()
        ui(_run)

    def _page_mute_notices(self):
        return [Header(text="Тексты ответов"),
                Input(key="mute_notice", text="Мут", default=DEFAULT_NOTICE, icon="msg_mute"),
                Input(key="unmute_notice", text="Размут", default=DEFAULT_UNMUTE_NOTICE, icon="msg_unmute"),
                Divider(text="{name} — имя пользователя или ID. Тихий режим отключает ответы.")]

    def _dm_scope_changed(self, key, value):
        self.set_setting(key, bool(value))
        self._dm_cfg_cache = None
        with self._lock:
            self._dm_dedup.clear()

    def _ui_deleted_toggle(self, value):
        self._dm_cfg_cache = None
        self.set_setting("dm_enabled", bool(value), True)

    def _page_dm_media(self):
        return [
            Header(text="Скачивание"),
            Switch(key="dm_media_prefetch", text="Скачивать заранее", default=False, icon="msg_download"),
            Switch(key="dm_media_rescue", text="Скачивать при удалении", default=True,
                   subtext="Старая ссылка может не сработать", icon="msg_retry"),
            Divider(), Header(text="Фильтры"),
            Switch(key="dm_media_private", text="Только личные чаты", default=True, icon="msg_contacts|msg_secret"),
            Switch(key="dm_media_video", text="Видео и видеосообщения", default=False, icon="msg_video|msg_media"),
            Switch(key="dm_media_voice", text="Голосовые", default=False, icon="msg_voicechat|msg_discussion"),
            Switch(key="dm_media_file", text="Файлы и музыка", default=False, icon="msg_download"),
            Input(key="dm_media_max_mb", text="Лимит на файл", subtext="1–100 МБ", default="20", icon="msg_edit",
                  on_change=self._number_check("dm_media_max_mb", 20, 1, 100, False)),
            Divider(text="До 200 МБ за сеанс, 3 загрузки одновременно. Доступность медиа зависит от локальной копии. Исчезающие и секретные медиа пропускаются."),
        ]

    def _page_dm_appearance(self):
        return self._dm_look_items()

    def _reset_commands_now(self):
        for field, _label in COMMAND_FIELDS:
            self.set_setting("cmd_" + field, DEFAULT_COMMANDS[field])
        self._reload_settings()
        toast_ok("Команды сброшены")
