_USERNAME_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_]{2,31}$")
_COUNT_RE = re.compile(r"^[0-9]{1,3}$")


_JUNK_BRACKETS = re.compile(
    r"\s*[\(\[\{【]\s*(?:"
    r"official(?:\s+(?:music|lyric|audio|hd))?(?:\s+(?:video|audio|visualizer))?"
    r"|(?:music|lyric|lyrics)\s+video|lyrics?|audio|video|visualizer|clip|клип|премьера[^\)\]]*"
    r"|hq|hd|4k|320\s*kbps?|\d{3}\s*kbps|mp3|flac|explicit|clean|bass\s*boosted"
    r"|prod\.?[^\)\]\}】]*|produced\s+by[^\)\]\}】]*"
    r"|[^\)\]\}】]*\.(?:ru|com|net|org|me|cc|fm|pro|su|io|xyz)"
    r"|@[\w_]+|t\.me/[\w_/]+"
    r")\s*[\)\]\}】]",
    re.IGNORECASE,
)
_JUNK_TAIL = re.compile(
    r"\s*(?:\||//|•|·)\s*.*$|\s*[-–—]\s*(?:скачать|слушать|бесплатно|музыка)\b.*$",
    re.IGNORECASE,
)
_JUNK_ANY = re.compile(
    r"https?://\S+|t\.me/\S+|@[\w_]{4,}|\b[\w-]+\.(?:ru|com|net|org|me|cc|fm|pro|su|io|xyz)\b",
    re.IGNORECASE,
)
_FEAT = re.compile(r"\s*[\(\[]?\s*(?:feat|ft|featuring)\.?\s+[^\)\]]*[\)\]]?", re.IGNORECASE)
_EMOJI = re.compile("[\U0001F000-\U0001FAFF\u2600-\u27BF\uFE0F\u200d]+")


def jlong(value):
    return Long(int(value))


