def toast_ok(text):
    _bulletin("success", text)


def toast_err(text):
    _bulletin("error", text)


def toast_info(text):
    _bulletin("info", text)


def parse_command(text, config):
    if not isinstance(text, str):
        return None
    prefix = str(config.get("prefix") or "")
    raw = text.strip()
    if not prefix or not raw.startswith(prefix):
        return None
    parts = raw[len(prefix):].lstrip().split(None, 1)
    if not parts:
        return None
    token = parts[0].lower()
    arg = parts[1].strip() if len(parts) > 1 else ""
    for action in ACTIONS:
        if token == str(config.get(action) or "").lower():
            return action, arg
    return None


def check_command_config(values):
    labels = dict(COMMAND_FIELDS)
    cleaned = {}
    for field, label in COMMAND_FIELDS:
        value = str(values.get(field) or "").strip()
        if not value:
            return None, "%s: пустое значение" % label
        if re.search(r"\s", value):
            return None, "%s: без пробелов" % label
        cleaned[field] = value
    prefix = cleaned["prefix"].lower()
    for field in ACTIONS:
        if prefix in cleaned[field].lower():
            return None, "%s: не должна содержать префикс" % labels[field]
    names = [cleaned[a].lower() for a in ACTIONS]
    if len(set(names)) != len(names):
        return None, "Команды не должны совпадать"
    return cleaned, None


def parse_count(arg, limit):
    value = (arg or "").strip()
    if not _COUNT_RE.match(value):
        return None
    value = int(value)
    return value if 1 <= value <= int(limit) else None


def parse_username(arg):
    value = (arg or "").strip().lstrip("@")
    return value if _USERNAME_RE.match(value) else None


def peer_dialog_id(peer):
    if peer is None:
        return 0
    try:
        uid = int(getattr(peer, "user_id", 0) or 0)
        if uid:
            return uid
        cid = int(getattr(peer, "chat_id", 0) or 0)
        if cid:
            return -cid
        chid = int(getattr(peer, "channel_id", 0) or 0)
        if chid:
            return -chid
    except Exception:
        pass
    return 0


def message_dialog_id(message):
    if message is None:
        return 0
    try:
        known = int(getattr(message, "dialog_id", 0) or 0)
        if known:
            return known
        peer = getattr(message, "peer_id", None)
        if peer is None:
            return 0
        cid = int(getattr(peer, "chat_id", 0) or 0)
        if cid:
            return -cid
        chid = int(getattr(peer, "channel_id", 0) or 0)
        if chid:
            return -chid
        if not bool(getattr(message, "out", False)):
            uid = int(getattr(getattr(message, "from_id", None), "user_id", 0) or 0)
            if uid:
                return uid
        return int(getattr(peer, "user_id", 0) or 0)
    except Exception:
        return 0


def message_sender_id(message):
    if message is None:
        return 0
    sender = peer_dialog_id(getattr(message, "from_id", None))
    if sender:
        return sender
    try:
        if bool(getattr(message, "out", False)):
            return 0
        return int(getattr(getattr(message, "peer_id", None), "user_id", 0) or 0)
    except Exception:
        return 0


def is_special_dialog(dialog_id):
    try:
        value = int(dialog_id)
    except Exception:
        return True
    if value & -9223372036854775808:
        return False
    return bool(value & 4611686018427387904) or bool(value & 2305843009213693952)


def plural_ru(count):
    value = abs(int(count or 0))
    if value % 100 in (11, 12, 13, 14):
        return "сообщений"
    if value % 10 == 1:
        return "сообщение"
    if value % 10 in (2, 3, 4):
        return "сообщения"
    return "сообщений"


def tidy_text(text):
    value = re.sub(r"\s+", " ", str(text or "")).strip()
    value = re.sub(r"\s+([,.;:!?])", r"\1", value)
    return re.sub(r",\s*([.!?])", r"\1", value).strip()


def render_template(template, name, fallback):
    try:
        text = str(template).format(name=name or "")
    except Exception:
        text = fallback.format(name=name or "")
    return tidy_text(text)


def display_name(user):
    if user is None:
        return ""
    full = ("%s %s" % (getattr(user, "first_name", "") or "", getattr(user, "last_name", "") or "")).strip()
    return full or str(getattr(user, "username", "") or "")


def public_username(user):
    if user is None:
        return ""
    try:
        value = UserObject.getPublicUsername(user)
        if value:
            return str(value)
    except Exception:
        pass
    return str(getattr(user, "username", "") or "")


def notice_identity(user, user_id):
    username = public_username(user)
    if username:
        return "@" + username
    return "ID %d" % int(user_id) if int(user_id or 0) > 0 else ""


def first_user(response):
    users = getattr(response, "users", None) if response is not None else None
    if users is None:
        return None
    for user in users:
        if user is not None:
            return user
    return None


def jlist(value):
    if value is None:
        return []
    try:
        return [item for item in value]
    except Exception:
        try:
            return [value.get(i) for i in range(int(value.size()))]
        except Exception:
            return []


def mute_key(account, dialog_id):
    return "%d:%d" % (int(account), int(dialog_id))


def clean_title(text, remove_feat=False, extra_words=()):
    if not text:
        return text
    t = _JUNK_ANY.sub("", str(text))
    for _ in range(3):
        t = _JUNK_BRACKETS.sub("", t)
    t = _JUNK_TAIL.sub("", t)
    if remove_feat:
        t = _FEAT.sub("", t)
    for word in extra_words:
        t = re.sub(re.escape(word), "", t, flags=re.IGNORECASE)
    t = _EMOJI.sub("", t)
    t = re.sub(r"[\(\[]\s*[\)\]]", "", t)
    t = re.sub(r"\s{2,}", " ", t).strip(" -–—_|.,")
    return t or str(text).strip()


def utf16_len(text):
    return len(text.encode("utf-16-le")) // 2


_OBSERVER_CLASS = None


def observer_class():
    global _OBSERVER_CLASS
    if _OBSERVER_CLASS is None:
        from java import dynamic_proxy

        class NewMessagesObserver(dynamic_proxy(NotificationCenter.NotificationCenterDelegate)):
            def __init__(self, plugin):
                super().__init__()
                self.plugin = plugin

            def didReceivedNotification(self, id, account, args):
                try:
                    if int(id) == int(NotificationCenter.didReceiveNewMessages):
                        self.plugin.handle_new_messages(int(account), args)
                except Exception:
                    pass

        _OBSERVER_CLASS = NewMessagesObserver
    return _OBSERVER_CLASS


class MuteStore(object):
    def __init__(self, raw_json=""):
        self._data = {}
        try:
            parsed = json.loads(raw_json) if raw_json else {}
        except Exception:
            parsed = {}
        if isinstance(parsed, dict):
            for key, value in parsed.items():
                if isinstance(key, str) and isinstance(value, (list, tuple)):
                    users = {int(v) for v in value if isinstance(v, int) and not isinstance(v, bool) and v > 0}
                    if users:
                        self._data[key] = users

    def dump(self):
        return json.dumps({k: sorted(v) for k, v in self._data.items() if v}, sort_keys=True)

    def users(self, account, dialog_id):
        return self._data.get(mute_key(account, dialog_id), ())

    def add(self, account, dialog_id, user_id):
        users = self._data.setdefault(mute_key(account, dialog_id), set())
        if int(user_id) in users:
            return False
        users.add(int(user_id))
        return True

    def remove(self, account, dialog_id, user_id):
        key = mute_key(account, dialog_id)
        users = self._data.get(key)
        if not users or int(user_id) not in users:
            return False
        users.discard(int(user_id))
        if not users:
            self._data.pop(key, None)
        return True

    def clear(self):
        self._data = {}

    def entries(self):
        result = []
        for key, users in self._data.items():
            try:
                account, dialog_id = (int(x) for x in key.split(":", 1))
            except Exception:
                continue
            result.append((account, dialog_id, sorted(users)))
        result.sort()
        return result

    def total(self):
        return sum(len(u) for u in self._data.values())


def signed_color(value):
    value = int(value) & 0xFFFFFFFF
    return value - 0x100000000 if value >= 0x80000000 else value


def with_alpha(color, alpha):
    color = int(color) & 0x00FFFFFF
    return signed_color((int(round(max(0.0, min(1.0, alpha)) * 255)) << 24) | color)
MUTE_FILTER_ARG = {"mute_notif": 0}


_reflect_cache = {}


def java_class(name):
    cached = _reflect_cache.get(("class", name))
    if cached is not None:
        return cached
    clazz = None
    try:
        from java.lang import Class
        from org.telegram.messenger import ApplicationLoader
        loader = ApplicationLoader.applicationContext.getClassLoader()
        clazz = Class.forName(name, False, loader)
    except Exception:
        try:
            from java.lang import Class
            clazz = Class.forName(name)
        except Exception:
            clazz = None
    if clazz is not None:
        _reflect_cache[("class", name)] = clazz
    return clazz


def int_list(values):
    array = ArrayList()
    for value in values:
        array.add(Integer(int(value)))
    return array


RELEASES_BASE = "https://raw.githubusercontent.com/Darkichyoyo/exteragram-plugin-releases/main/"
MANIFEST_URL = RELEASES_BASE + "releases.json"
API_CONTENTS_BASE = "https://api.github.com/repos/Darkichyoyo/exteragram-plugin-releases/contents/"
API_REF = "main"
MAX_MANIFEST_BYTES = 64 * 1024
MAX_PLUGIN_BYTES = 2 * 1024 * 1024
BUSY_TIMEOUT_SECONDS = 180
INSTALL_RESPONSE_TIMEOUT_SECONDS = 90
STALE_TEMP_SECONDS = 600
TEMP_PREFIX = "eg_update_"


def _default_schedule(delay, fn):
    timer = threading.Timer(delay, fn)
    timer.daemon = True
    timer.start()
    return timer
_VERSION = re.compile(r"[0-9]{1,6}(\.[0-9]{1,6}){0,3}")
_SHA = re.compile(r"[0-9a-f]{64}")


class UpdateError(Exception):
    pass


def parse_version(text):
    if not isinstance(text, str) or not _VERSION.fullmatch(text):
        raise UpdateError("Некорректный формат версии")
    parts = tuple(int(p) for p in text.split("."))
    return parts + (0,) * (4 - len(parts))


class ReleaseInfo:
    def __init__(self, plugin_id, version, url, sha256, size):
        self.plugin_id, self.version, self.url, self.sha256, self.size = plugin_id, version, url, sha256, size


def parse_manifest(raw, plugin_id):
    try:
        data = json.loads(raw.decode("utf-8") if isinstance(raw, (bytes, bytearray)) else raw)
    except (ValueError, UnicodeDecodeError):
        raise UpdateError("Манифест обновлений повреждён")
    if not isinstance(data, dict) or data.get("schema") != 1 or not isinstance(data.get("plugins"), dict):
        raise UpdateError("Неподдерживаемый формат манифеста")
    entry = data["plugins"].get(plugin_id)
    if entry is None:
        return None
    if not isinstance(entry, dict):
        raise UpdateError("Некорректная запись манифеста")
    version, url, digest, size = (entry.get(k) for k in ("version", "url", "sha256", "size"))
    parse_version(version)
    if not (isinstance(url, str) and url.startswith(RELEASES_BASE) and url.endswith(".plugin")
            and ".." not in url and len(url) < 300):
        raise UpdateError("Адрес файла обновления не из доверенного репозитория")
    if not (isinstance(digest, str) and _SHA.fullmatch(digest)):
        raise UpdateError("Некорректная контрольная сумма в манифесте")
    if not (isinstance(size, int) and not isinstance(size, bool) and 0 < size <= MAX_PLUGIN_BYTES):
        raise UpdateError("Некорректный размер файла в манифесте")
    return ReleaseInfo(plugin_id, version, url, digest, size)


def read_plugin_metadata(source):
    try:
        tree = ast.parse(source)
    except (SyntaxError, ValueError):
        raise UpdateError("Файл обновления не является корректным Python")
    found = {}
    for node in tree.body:
        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
            name = node.targets[0].id
            if name in ("__id__", "__version__") and isinstance(node.value, ast.Constant) \
                    and isinstance(node.value.value, str):
                found[name] = node.value.value
    return found.get("__id__"), found.get("__version__")


def verify_payload(payload, info, current_id, current_version, stage=None):
    stage = stage or (lambda *_args, **_kwargs: None)
    if len(payload) != info.size:
        raise UpdateError("Размер файла не совпал с манифестом")
    stage("verify.size", "OK", bytes=len(payload))
    digest = hashlib.sha256(payload).hexdigest()
    if digest != info.sha256:
        raise UpdateError("Контрольная сумма SHA-256 не совпала")
    stage("verify.sha256", "OK", sha256=digest[:12])
    try:
        source = payload.decode("utf-8")
    except UnicodeDecodeError:
        raise UpdateError("Файл обновления не в UTF-8")
    file_id, file_version = read_plugin_metadata(source)
    if file_id != current_id or info.plugin_id != current_id:
        raise UpdateError("Идентификатор плагина в файле не совпал")
    if file_version != info.version:
        raise UpdateError("Версия в файле не совпала с манифестом")
    stage("verify.metadata", "OK", id=file_id, version=file_version)
    return source


class UpdateController:
    def __init__(self, plugin_id, version, http_get, install, notify, confirm, background, log=None,
                 clock=time.monotonic, tmp_root=None, source=None, schedule=None, wall_clock=time.time):
        parse_version(version)
        self.plugin_id, self.version = plugin_id, version
        self._http_get, self._install, self._notify = http_get, install, notify
        self._confirm, self._background = confirm, background
        self._log = log or (lambda *_args, **_kwargs: None)
        self._clock, self._tmp_root = clock, tmp_root
        self._lock = threading.Lock()
        self._operation = None
        self._phase = None
        self._busy_since = None
        self._source = source
        self._schedule = schedule or _default_schedule
        self._wall = wall_clock

    def _enter(self):
        with self._lock:
            now = self._clock()
            if self._phase == "handoff" or (self._busy_since is not None and
                    now - self._busy_since < BUSY_TIMEOUT_SECONDS):
                return None
            operation = object()
            self._operation, self._phase = operation, "check"
            self._busy_since = now
            return operation

    def _current(self, operation):
        with self._lock:
            return self._operation is operation

    def _transition(self, operation, before, after):
        with self._lock:
            if self._operation is not operation or self._phase != before:
                return False
            self._phase = after
            self._busy_since = self._clock()
            return True

    def _leave(self, operation):
        with self._lock:
            if self._operation is not operation:
                return False
            self._operation, self._phase = None, None
            self._busy_since = None
            return True

    def _stage(self, stage, result, level="INFO", **details):
        try:
            self._log(stage, result, level, details)
        except Exception:
            pass

    def _fetch(self, stage, url, max_bytes):
        started = self._clock()
        try:
            raw = self._http_get(url, max_bytes)
        except Exception as exc:
            reason = str(exc) if isinstance(exc, UpdateError) else type(exc).__name__
            self._stage(stage, "FAILED", "ERROR", reason=reason, ms=int((self._clock() - started) * 1000))
            raise
        try:
            host = str(self._source()) if self._source is not None else "injected"
        except Exception:
            host = "unknown"
        self._stage(stage, "OK", bytes=len(raw), limit=max_bytes, ms=int((self._clock() - started) * 1000),
                    host=host)
        return raw

    def check(self, *_args):
        operation = self._enter()
        if operation is None:
            self._stage("check", "IGNORED_BUSY", "WARN")
            self._notify("Проверка или установка уже выполняется")
            return
        self._stage("check", "STARTED", installed=self.version)
        try:
            self._background(lambda: self._check_work(operation))
        except Exception as exc:
            self._leave(operation)
            self._stage("check", "NOT_STARTED", "ERROR", reason=type(exc).__name__)
            self._notify("Проверка не запущена: " + type(exc).__name__, True)

    def find_update(self):
        try:
            raw = self._fetch("manifest.fetch", MANIFEST_URL, MAX_MANIFEST_BYTES)
        except UpdateError:
            raise
        except Exception as exc:
            raise UpdateError("Не удалось получить манифест: " + type(exc).__name__)
        if len(raw) > MAX_MANIFEST_BYTES:
            self._stage("manifest.parse", "FAILED", "ERROR", reason="too large", bytes=len(raw))
            raise UpdateError("Манифест слишком большой")
        try:
            info = parse_manifest(raw, self.plugin_id)
        except UpdateError as exc:
            self._stage("manifest.parse", "FAILED", "ERROR", reason=str(exc))
            raise
        if info is None:
            self._stage("manifest.parse", "NO_ENTRY", "WARN", plugin=self.plugin_id)
            return None
        self._stage("manifest.parse", "OK", remote=info.version, size=info.size, sha256=info.sha256[:12])
        newer = parse_version(info.version) > parse_version(self.version)
        self._stage("version.compare", "NEWER" if newer else "NOT_NEWER", installed=self.version,
                    remote=info.version)
        return info if newer else None

    def _check_work(self, operation):
        if not self._current(operation):
            return
        try:
            info = self.find_update()
        except UpdateError as exc:
            if not self._leave(operation):
                return
            self._notify(str(exc), True)
            return
        except Exception as exc:
            if not self._leave(operation):
                return
            self._stage("check", "CRASHED", "ERROR", reason=type(exc).__name__)
            self._notify("Проверка не выполнена: " + type(exc).__name__, True)
            return
        if info is None:
            if not self._leave(operation):
                return
            self._stage("check", "UP_TO_DATE", installed=self.version)
            self._notify(f"Установлена последняя версия ({self.version})")
            return
        if not self._transition(operation, "check", "confirm"):
            return
        self._stage("confirm", "SHOWN", remote=info.version)

        def declined():
            if not self._transition(operation, "confirm", "declined"):
                return
            self._stage("confirm", "DECLINED")
            self._leave(operation)
        try:
            self._confirm(info, lambda: self.start_install(info, operation), declined)
        except Exception as exc:
            self._leave(operation)
            self._stage("confirm", "FAILED", "ERROR", reason=type(exc).__name__)
            self._notify("Диалог обновления не открыт: " + type(exc).__name__, True)

    def start_install(self, info, operation):
        if not self._transition(operation, "confirm", "install"):
            return
        self._stage("confirm", "ACCEPTED", remote=info.version)
        try:
            self._background(lambda: self._install_work(info, operation))
        except Exception as exc:
            self._leave(operation)
            self._notify("Установка не запущена: " + type(exc).__name__, True)

    def _sweep_stale(self):
        root = self._tmp_root or tempfile.gettempdir()
        removed = 0
        try:
            names = os.listdir(root)
        except OSError:
            return
        now = self._wall()
        for name in names:
            path = os.path.join(root, name)
            try:
                if (name.startswith(TEMP_PREFIX) and os.path.isdir(path)
                        and now - os.path.getmtime(path) > STALE_TEMP_SECONDS):
                    shutil.rmtree(path, ignore_errors=True)
                    removed += 1
            except OSError:
                continue
        if removed:
            self._stage("install.cleanup", "STALE_REMOVED", count=removed)

    def _install_work(self, info, operation):
        if not self._current(operation):
            return
        directory = None
        try:
            self._sweep_stale()
            payload = self._fetch("download", info.url, min(info.size, MAX_PLUGIN_BYTES))
            try:
                verify_payload(payload, info, self.plugin_id, self.version, self._stage)
            except UpdateError as exc:
                self._stage("verify", "FAILED", "ERROR", reason=str(exc))
                raise
            if parse_version(info.version) <= parse_version(self.version):
                raise UpdateError("Версия не новее установленной")
            directory = tempfile.mkdtemp(prefix=TEMP_PREFIX, dir=self._tmp_root)
            path = os.path.join(directory, self.plugin_id + ".plugin")
            with open(path, "xb") as output:
                output.write(payload)
            self._stage("install.handoff", "STARTED", note="file verified; passing to plugin engine")
        except UpdateError as exc:
            self._finish(directory, False, str(exc), operation)
            return
        except Exception as exc:
            self._finish(directory, False, "Скачивание не выполнено: " + type(exc).__name__, operation)
            return
        if not self._transition(operation, "install", "handoff"):
            shutil.rmtree(directory, ignore_errors=True)
            return
        state = {"done": False, "timed_out": False}
        guard = threading.Lock()

        def outcome(result):
            if result is None:
                return True, f"Движок подтвердил установку версии {info.version}"
            first = str(result).strip().splitlines()[0][:120] if str(result).strip() else "без описания"
            return False, "Установка не выполнена движком: " + first

        def callback(result):
            with guard:
                if state["done"]:
                    return
                state["done"] = True
                late = state["timed_out"]
            ok, message = outcome(result)
            if not late:
                self._finish(directory, ok, message, operation)
                return
            shutil.rmtree(directory, ignore_errors=True)
            self._stage("install.result", "LATE_OK" if ok else "LATE_FAILED", "INFO" if ok else "ERROR",
                        message=message[:160])
            self._notify(message, not ok)

        def no_response():
            with guard:
                if state["done"] or state["timed_out"]:
                    return
                state["timed_out"] = True
            self._leave(operation)
            self._stage("install.result", "NO_RESPONSE", "WARN", waited_s=INSTALL_RESPONSE_TIMEOUT_SECONDS,
                        note="request sent, installation NOT confirmed; temp file kept for the engine")
            self._notify(f"Установщик не ответил за {INSTALL_RESPONSE_TIMEOUT_SECONDS} с — установка не "
                         "подтверждена. Проверьте версию в списке плагинов.", True)

        try:
            route = self._install(path, callback)
            self._stage("install.handoff", "RETURNED", route=str(route), callback_received=state["done"],
                        note="request handed over; this is not an installation result")
        except Exception as exc:
            with guard:
                if state["done"]:
                    return
                state["done"] = True
            self._finish(directory, False, "Установщик недоступен: " + type(exc).__name__, operation)
            return
        self._transition(operation, "handoff", "waiting")
        with guard:
            waiting = not state["done"]
        if waiting:
            try:
                self._schedule(INSTALL_RESPONSE_TIMEOUT_SECONDS, no_response)
            except Exception as exc:
                self._stage("install.watchdog", "NOT_STARTED", "ERROR", reason=type(exc).__name__)

    def _finish(self, directory, ok, message, operation):
        if directory:
            shutil.rmtree(directory, ignore_errors=True)
        self._leave(operation)
        self._stage("install.result", "OK" if ok else "FAILED", "INFO" if ok else "ERROR", message=message[:160])
        self._notify(message, not ok)


def no_cache_url(url, now=None):
    if url != MANIFEST_URL:
        return url
    stamp = int((time.time() if now is None else now) * 1000)
    return f"{url}?nocache={stamp}"


def api_url(url):
    if not url.startswith(RELEASES_BASE):
        return None
    path = url[len(RELEASES_BASE):]
    if not path or ".." in path or "?" in path or "#" in path:
        return None
    return API_CONTENTS_BASE + path + "?ref=" + API_REF


class UpdaterBindings:
    def __init__(self):
        self.last_source = "none"

    def http_get(self, url, max_bytes):
        if not url.startswith("https://"):
            raise UpdateError("Допускается только HTTPS")
        primary = api_url(url)
        if primary is not None:
            try:
                data = self._get(primary, max_bytes, api=True)
                self.last_source = "api.github.com"
                return data
            except Exception as exc:
                reason = str(exc) if isinstance(exc, UpdateError) else type(exc).__name__
                data = self._get(url, max_bytes)
                self.last_source = "raw.githubusercontent.com (api: " + reason[:60] + ")"
                return data
        data = self._get(url, max_bytes)
        self.last_source = "raw.githubusercontent.com"
        return data

    def _get(self, url, max_bytes, api=False):
        from java.net import URL
        conn = URL(url if api else no_cache_url(url)).openConnection()
        if api:
            conn.setRequestProperty("Accept", "application/vnd.github.raw")
            conn.setRequestProperty("X-GitHub-Api-Version", "2022-11-28")
        conn.setUseCaches(False)
        conn.setRequestProperty("Cache-Control", "no-cache")
        conn.setRequestProperty("Pragma", "no-cache")
        conn.setInstanceFollowRedirects(False)
        conn.setConnectTimeout(10000)
        conn.setReadTimeout(20000)
        conn.setRequestProperty("User-Agent", "exteragram-plugin-updater/1")
        stream, chunks, total = None, [], 0
        try:
            code = conn.getResponseCode()
            if code != 200:
                raise UpdateError(f"Сервер ответил HTTP {code}")
            stream = conn.getInputStream()
            from java import jarray, jbyte
            buffer = jarray(jbyte)(8192)
            while True:
                count = stream.read(buffer)
                if count < 0:
                    break
                total += count
                if total > max_bytes:
                    raise UpdateError("Ответ сервера больше допустимого размера")
                chunks.append(bytes(bytearray(b & 0xFF for b in buffer[:count])))
        finally:
            if stream is not None:
                try:
                    stream.close()
                except Exception:
                    pass
            conn.disconnect()
        return b"".join(chunks)

    def install(self, path, callback):
        from java import dynamic_proxy, jclass
        Utilities = jclass("org.telegram.messenger.Utilities")
        PluginsController = jclass("com.exteragram.messenger.plugins.PluginsController")

        class Result(dynamic_proxy(Utilities.Callback)):
            def run(self, arg):
                callback(None if arg is None else str(arg))

        proxy = Result()
        controller = PluginsController.getInstance()
        engine = None
        try:
            engine = controller.engines.get("python")
        except Exception:
            engine = None
        if engine is not None:
            try:
                engine.loadPluginFromFile(path, None, proxy)
                return "engine"
            except TypeError:
                pass
        controller.loadPluginFromFile(path, proxy)
        return "controller"


def _upd_background(fn):
    thread = threading.Thread(target=fn, name="multi_tools-updater")
    thread.daemon = True
    thread.start()


def _upd_notify(text, error=False):
    (toast_err if error else toast_info)(text)


def show_update_sheet(context, title, versions, note, button, decision):
    from java import dynamic_proxy
    from android.content import DialogInterface
    from android.graphics.drawable import GradientDrawable
    from android.view import Gravity, View
    from android.widget import LinearLayout, TextView
    from org.telegram.ui.ActionBar import BottomSheet, Theme
    density = context.getResources().getDisplayMetrics().density
    dp = lambda v: int(density * v + 0.5)

    def color(name, default):
        try:
            return Theme.getColor(getattr(Theme, name))
        except Exception:
            return default

    def signed(argb):
        argb &= 0xFFFFFFFF
        return argb - (1 << 32) if argb >= (1 << 31) else argb

    def with_alpha(value, alpha):
        return signed((alpha << 24) | (value & 0xFFFFFF))

    def readable_on(value):
        red, green, blue = (value >> 16) & 255, (value >> 8) & 255, value & 255
        return signed(0xFF1B1B1B) if (0.299 * red + 0.587 * green + 0.114 * blue) > 150 else -1

    def rounded(fill, radius):
        shape = GradientDrawable()
        shape.setColor(fill)
        shape.setCornerRadius(float(dp(radius)))
        return shape

    sheet = BottomSheet(context, False)

    class Click(dynamic_proxy(View.OnClickListener)):
        def __init__(self, action):
            super().__init__()
            self.action = action

        def onClick(self, view):
            self.action(view)

    class Dismissed(dynamic_proxy(DialogInterface.OnDismissListener)):
        def onDismiss(self, dialog):
            decision.close()

    def text_view(text, size, text_color):
        view = TextView(context)
        view.setText(text)
        view.setTextSize(size)
        view.setTextColor(text_color)
        return view

    main_color = color("key_windowBackgroundWhiteBlackText", -1)
    gray_color = color("key_windowBackgroundWhiteGrayText2", -5592406)
    accent = color("key_featuredStickers_addButton", -14443544)

    root = LinearLayout(context)
    root.setOrientation(LinearLayout.VERTICAL)
    root.setPadding(dp(20), dp(10), dp(20), dp(20))
    info = LinearLayout(context)
    info.setOrientation(LinearLayout.VERTICAL)
    info.setClickable(True)
    handle = View(context)
    handle.setBackground(rounded(with_alpha(gray_color, 0x80), 2))
    handle_params = LinearLayout.LayoutParams(dp(36), dp(4))
    handle_params.gravity = Gravity.CENTER_HORIZONTAL
    info.addView(handle, handle_params)

    heading = text_view(title, 22, main_color)
    try:
        from org.telegram.messenger import AndroidUtilities
        heading.setTypeface(AndroidUtilities.bold())
    except Exception:
        pass
    heading_params = LinearLayout.LayoutParams(-2, -2)
    heading_params.topMargin = dp(18)
    info.addView(heading, heading_params)

    chip = text_view(versions, 14, accent)
    chip.setPadding(dp(10), dp(4), dp(10), dp(4))
    chip.setBackground(rounded(with_alpha(accent, 0x2E), 10))
    chip_params = LinearLayout.LayoutParams(-2, -2)
    chip_params.topMargin = dp(10)
    info.addView(chip, chip_params)

    note_view = text_view(note, 14, gray_color)
    note_params = LinearLayout.LayoutParams(-1, -2)
    note_params.topMargin = dp(10)
    note_params.bottomMargin = dp(18)
    info.addView(note_view, note_params)
    root.addView(info, LinearLayout.LayoutParams(-1, -2))

    action = text_view(button, 16, readable_on(accent))
    action.setGravity(Gravity.CENTER)
    action.setBackground(rounded(accent, 14))
    action.setClickable(True)
    try:
        from org.telegram.messenger import AndroidUtilities
        action.setTypeface(AndroidUtilities.bold())
    except Exception:
        pass
    root.addView(action, LinearLayout.LayoutParams(-1, dp(52)))

    def on_download(view):
        if decision.download():
            view.setEnabled(False)
            sheet.dismiss()

    def on_info(view):
        decision.close()
        sheet.dismiss()

    action.setOnClickListener(Click(on_download))
    info.setOnClickListener(Click(on_info))
    sheet.setCustomView(root)
    sheet.setOnDismissListener(Dismissed())
    sheet.show()


class UpdateSheetDecision:
    def __init__(self, accepted, declined):
        self._accepted, self._declined = accepted, declined
        self._lock, self._decided = threading.Lock(), False

    def _take(self):
        with self._lock:
            if self._decided:
                return False
            self._decided = True
            return True

    def download(self):
        if not self._take():
            return False
        self._accepted()
        return True

    def close(self):
        if not self._take():
            return False
        self._declined()
        return True


def _upd_confirm(current):
    def confirm(info, accepted, declined):
        def show():
            decision = UpdateSheetDecision(accepted, declined)
            try:
                fragment = get_last_fragment()
                activity = fragment.getParentActivity() if fragment is not None else None
                if activity is None:
                    raise RuntimeError("no activity")
            except Exception as exc:
                decision.close()
                _upd_notify("Диалог обновления не открыт: " + type(exc).__name__, True)
                return
            try:
                show_update_sheet(activity, "Доступно обновление", "%s → %s" % (current, info.version),
                                  "Перед установкой файл будет проверен.", "Скачать", decision)
                return
            except Exception:
                pass
            try:
                def close(dialog):
                    try:
                        dialog.dismiss()
                    except Exception:
                        pass

                def yes(dialog, _which):
                    close(dialog)
                    decision.download()

                def no(dialog, _which):
                    close(dialog)
                    decision.close()

                builder = AlertDialogBuilder(activity)
                builder.set_title("Доступно обновление")
                builder.set_message("Версия %s → %s. Файл будет скачан, проверен (SHA-256, ID, версия) "
                                    "и передан движку плагинов для установки." % (current, info.version))
                builder.set_positive_button("Установить", yes)
                builder.set_negative_button("Отмена", no)
                builder.set_cancelable(False)
                builder.show()
            except Exception as exc:
                decision.close()
                _upd_notify("Диалог обновления не открыт: " + type(exc).__name__, True)
        ui(show)
    return confirm


def build_updater(plugin_id, version, log=None):
    android = UpdaterBindings()
    return UpdateController(plugin_id, version, android.http_get, android.install, _upd_notify,
                            _upd_confirm(version), _upd_background, log=log, source=lambda: android.last_source)


import hashlib
import os
try:
    import sqlite3
except ImportError:
    sqlite3 = None
import threading


import threading


class MultiToolsPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._lock = threading.RLock()
        self._mutes = MuteStore()
        self._mutes_loaded = False
        self._labels = None
        self._handled = {}
        self._command_guard = {}
        self._command_echo = {}
        self._own_notices = {}
        self._observer = None
        self._observed = set()
        self._observing = set()
        self._mute_queue = {}
        self._ghosted = set()
        self._mute_flush_pending = False
        self._active = True
        self._spam_runs = {}
        self._spam_last = {}
        self._updater = None
        self._factories = {}


    def _ensure_state(self):
        if not self._mutes_loaded:
            self._reload_mutes()
        if self._labels is None:
            self._load_labels()

    def _reload_mutes(self):
        try:
            raw = self.get_setting(SETTING_MUTES, "")
            self._mutes = MuteStore(raw if isinstance(raw, str) else "")
            self._mutes_loaded = True
        except Exception:
            pass

    def _persist_mutes(self, reload_settings=False):
        payload = self._mutes.dump()
        try:
            self.set_setting(SETTING_MUTES, payload, reload_settings)
            return str(self.get_setting(SETTING_MUTES, "")) == payload
        except Exception:
            return False

    def _load_labels(self):
        data = {}
        try:
            parsed = json.loads(self.get_setting(SETTING_LABELS, "") or "{}")
            if isinstance(parsed, dict):
                for key, value in parsed.items():
                    if isinstance(value, dict):
                        data[key] = {"n": str(value.get("n", ""))[:96], "u": str(value.get("u", ""))[:64]}
        except Exception:
            pass
        self._labels = data

    def _remember_label(self, account, user_id, user):
        if user is None:
            return
        entry = {"n": tidy_text(display_name(user)), "u": public_username(user)}
        if not entry["n"] and not entry["u"]:
            return
        key = mute_key(account, user_id)
        with self._lock:
            if self._labels.get(key) == entry:
                return
            self._labels[key] = entry
            live = {mute_key(a, u) for a, _d, users in self._mutes.entries() for u in users}
            live.add(key)
            self._labels = {k: v for k, v in self._labels.items() if k in live}
            payload = json.dumps(self._labels, ensure_ascii=False, sort_keys=True)
        try:
            self.set_setting(SETTING_LABELS, payload)
        except Exception:
            pass

    def _stored_label(self, account, user_id):
        with self._lock:
            return (self._labels or {}).get(mute_key(account, user_id)) or {}

    def _user_label(self, account, user_id):
        user = self._get_user(account, user_id)
        stored = self._stored_label(account, user_id)
        name = tidy_text(display_name(user)) or stored.get("n", "")
        username = public_username(user) or stored.get("u", "")
        sub = ("@%s · " % username if username else "") + "ID %d" % int(user_id)
        return name or "ID %d" % int(user_id), sub

    def _get_user(self, account, user_id):
        try:
            return get_messages_controller(int(account)).getUser(jlong(user_id))
        except Exception:
            return None

    def _get_chat(self, account, chat_id):
        try:
            return get_messages_controller(int(account)).getChat(jlong(chat_id))
        except Exception:
            return None

    def _dialog_title(self, account, dialog_id, with_account):
        dialog_id = int(dialog_id)
        if dialog_id > 0:
            name = tidy_text(display_name(self._get_user(account, dialog_id))) \
                or self._stored_label(account, dialog_id).get("n", "")
            title = "Личка · %s" % (name or "ID %d" % dialog_id)
        else:
            chat = self._get_chat(account, -dialog_id)
            name = tidy_text(getattr(chat, "title", "") or "") if chat is not None else ""
            title = "Чат · %s" % (name or "ID %d" % dialog_id)
        return "%s · акк. %d" % (title, int(account) + 1) if with_account else title

    def on_plugin_load(self):
        with self._lock:
            self._active = True
        self._reload_mutes()
        self._load_labels()
        try:
            self.add_on_send_message_hook()
        except Exception:
            pass
        for name in NEW_MESSAGE_UPDATES + SHORT_MESSAGE_UPDATES:
            try:
                self.add_hook(name)
            except Exception:
                pass
        self._register_observers()
        try:
            self._mute_install()
        except Exception:
            pass

    def _mute_install(self):
        from base_plugin import MethodHook
        plugin = self

        class _MuteNotifHook(MethodHook):
            def before_hooked_method(self, param):
                try:
                    plugin._mute_filter("mute_notif", param, False)
                except Exception:
                    pass

        clazz = java_class("org.telegram.messenger.NotificationsController")
        if clazz is None:
            return
        try:
            methods = list(clazz.getDeclaredMethods())
        except Exception:
            return
        for method in methods:
            try:
                types = [str(t.getName()) for t in method.getParameterTypes()]
                if str(method.getName()) != "processNewMessages" or not types or types[0] != "java.util.ArrayList":
                    continue
                method.setAccessible(True)
                self.hook_method(method, _MuteNotifHook())
            except Exception:
                pass

    def on_plugin_unload(self):
        self._unregister_observers()
        with self._lock:
            self._active = False
            for table in (self._handled, self._command_guard, self._command_echo,
                          self._own_notices, self._spam_runs, self._spam_last):
                table.clear()


    def _account_list(self):
        result = []
        try:
            for index in range(int(UserConfig.MAX_ACCOUNT_COUNT)):
                try:
                    if UserConfig.getInstance(index).isClientActivated():
                        result.append(index)
                except Exception:
                    pass
        except Exception:
            pass
        return result

    def _register_observers(self, accounts=None):
        with self._lock:
            wanted = accounts if accounts is not None else self._account_list()
            targets = [int(a) for a in wanted
                       if int(a) not in self._observed and int(a) not in self._observing]
            self._observing.update(targets)
        if not targets:
            return

        def _run():
            with self._lock:
                self._observing.difference_update(targets)
                if not self._active:
                    return
                try:
                    if self._observer is None:
                        self._observer = observer_class()(self)
                    observer = self._observer
                except Exception:
                    return
            for account in targets:
                try:
                    NotificationCenter.getInstance(account).addObserver(observer, NotificationCenter.didReceiveNewMessages)
                    with self._lock:
                        self._observed.add(account)
                except Exception:
                    pass

        ui(_run)

    def _unregister_observers(self):
        with self._lock:
            self._active = False
            observer, targets = self._observer, sorted(self._observed)
            self._observed.clear()
            self._observing.clear()
            self._observer = None
        if observer is None or not targets:
            return

        def _run():
            for account in targets:
                try:
                    NotificationCenter.getInstance(account).removeObserver(observer, NotificationCenter.didReceiveNewMessages)
                except Exception:
                    pass

        try:
            run_on_ui_thread(_run)
        except Exception:
            pass

    def _ensure_observer(self, account):
        with self._lock:
            known = int(account) in self._observed
        if not known:
            self._register_observers([int(account)])

    def create_settings(self):
        self._ensure_state()
        cfg = self._command_config()
        command = lambda name: cfg["prefix"] + cfg[name]
        status = lambda key: "Включено" if self.get_setting(key, True) else "Выключено"
        mutes = self._mutes.total()
        bots = self._nv_bots()
        if self._choice("nv_mode", NV_BLACKLIST, (NV_BLACKLIST, NV_WHITELIST)) == NV_WHITELIST:
            nv_scope = ("только %d %s" % (len(bots), plural_word(len(bots), ("бот", "бота", "ботов")))
                        if bots else "список пуст")
        else:
            nv_scope = "все боты, кроме %d" % len(bots) if bots else "все боты"
        items = [
            self._mt_hero_row(),
            Divider(),
            Header(text="Модули"),
            Text(text="Мут", subtext="%s · %s" % (status("mute_enabled"), "в муте %d" % mutes if mutes else "список пуст"),
                 icon="msg_mute", create_sub_fragment=self._page_mute, link_alias="mute",
                 on_long_click=self._mt_quick_toggle("mute_enabled", "Мут")),
            Text(text="Удаление", subtext="%s · %s N" % (status("del_enabled"), command("del")),
                 icon="msg_delete", create_sub_fragment=self._page_del, link_alias="del",
                 on_long_click=self._mt_quick_toggle("del_enabled", "Удаление")),
            Text(text="Спам", subtext="%s · %s N текст" % (status("spam_enabled"), command("spam")),
                 icon="msg_forward", create_sub_fragment=self._page_spam, link_alias="spam",
                 on_long_click=self._mt_quick_toggle("spam_enabled", "Спам")),
            Text(text="No Via", subtext="%s · %s" % (status("nv_enabled"), nv_scope), icon="msg_bot",
                 create_sub_fragment=self._page_no_via, link_alias="no_via",
                 on_long_click=self._mt_quick_toggle("nv_enabled", "No Via")),
        ]
        items += [
            Divider(text="Удерживайте модуль, чтобы быстро включить или выключить его." if SETTINGS_LONG_CLICK else None),
            Header(text="Общие"),
            Text(text="Команды", subtext="Префикс «%s» · %s" % (cfg["prefix"], " ".join(command(f) for f, _l in COMMAND_FIELDS[1:])),
                 icon="msg_edit", create_sub_fragment=self._page_commands, link_alias="commands"),
            Text(text="Проверить обновления", subtext="Установлена версия %s" % __version__, icon="msg_download",
                 on_click=self._on_check_updates, link_alias="updates"),
            Divider(),
        ]
        return items

    def _mt_status(self):
        if not getattr(self, "_active", False):
            return "wait", "Плагин не запущен"
        enabled = sum(1 for key, _label in MT_MODULES if self.get_setting(key, True))
        return "ok", "Включено модулей: %d из %d" % (enabled, len(MT_MODULES))

    def _mt_quick_toggle(self, key, label):
        def _toggle(*_args):
            try:
                value = not self.get_setting(key, True)
                self.set_setting(key, value, True)
                toast_info("%s: %s" % (label, "включено" if value else "выключено"))
            except Exception:
                pass
            return True
        return _toggle

    def _mt_hero_row(self):
        if self._custom_ok():
            try:
                factory = self._factories.get("hero")
                if factory is None:
                    try:
                        factory = SimpleSettingFactory(self._mt_hero_create, self._mt_hero_bind, is_clickable=False,
                                                       content_equals=lambda *_args: False)
                    except TypeError:
                        factory = SimpleSettingFactory(self._mt_hero_create, self._mt_hero_bind, is_clickable=False)
                    self._factories["hero"] = factory
                return Custom(factory=factory.instance.java)
            except Exception:
                pass
        return Text(text="MultiTools %s" % __version__, subtext=self._mt_status()[1], icon="msg_info")

    def _mt_hero_create(self, context, list_view, current_account, class_guid, resources_provider):
        try:
            from android.widget import FrameLayout, LinearLayout, TextView
            from android.view import Gravity
            dp = self._dp
            root = LinearLayout(context)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setGravity(Gravity.CENTER_HORIZONTAL)
            root.setPadding(dp(16), dp(22), dp(16), dp(20))
            root.setBackgroundColor(self._theme("key_windowBackgroundWhite", 0xFFFFFFFF))
            box = FrameLayout(context)
            emoji = TextView(context)
            emoji.setText("🧰")
            emoji.setTextSize(54.0)
            emoji.setGravity(Gravity.CENTER)
            box.addView(emoji, FrameLayout.LayoutParams(-1, -1))
            try:
                from org.telegram.ui.Components import BackupImageView
                box.addView(BackupImageView(context), FrameLayout.LayoutParams(-1, -1))
            except Exception:
                pass
            root.addView(box, LinearLayout.LayoutParams(dp(100), dp(100)))
            for size, top in ((21.0, 12), (14.0, 3), (13.0, 14)):
                label = TextView(context)
                label.setTextSize(size)
                label.setGravity(Gravity.CENTER)
                params = LinearLayout.LayoutParams(-2, -2)
                params.topMargin = dp(top)
                root.addView(label, params)
            title, subtitle, badge = root.getChildAt(1), root.getChildAt(2), root.getChildAt(3)
            title.setText("MultiTools")
            title.setTypeface(self._mt_bold())
            title.setTextColor(self._theme("key_windowBackgroundWhiteBlackText", 0xFF222222))
            subtitle.setTextColor(self._theme("key_windowBackgroundWhiteGrayText", 0xFF8A8A8A))
            badge.setPadding(dp(12), dp(5), dp(12), dp(5))
            badge.setTypeface(self._mt_bold())
            self._mt_hero_fill(root)
            return self._full_width(root)
        except Exception:
            return self._error_view(context)

    def _mt_hero_bind(self, view, item, divider, adapter, list_view):
        try:
            self._mt_hero_fill(view)
        except Exception:
            pass

    def _mt_hero_fill(self, root):
        from android.view import View
        from android.graphics.drawable import GradientDrawable
        box, subtitle, badge = root.getChildAt(0), root.getChildAt(2), root.getChildAt(3)
        subtitle.setText("Версия %s" % __version__)
        level, text = self._mt_status()
        if level == "ok":
            color = self._mt_color(("key_windowBackgroundWhiteGreenText", "key_windowBackgroundWhiteGreenText2"), 0xFF26A65B)
            text = "✓  " + text
        elif level == "warn":
            color = self._mt_color(("key_text_RedRegular", "key_windowBackgroundWhiteRedText", "key_dialogTextRed"), 0xFFE53935)
            text = "⚠  " + text
        else:
            color = self._mt_color(("key_windowBackgroundWhiteGrayText",), 0xFF8A8A8A)
        badge.setText(text)
        badge.setTextColor(color)
        background = GradientDrawable()
        background.setCornerRadius(float(self._dp(14)))
        background.setColor((int(color) & 0x00FFFFFF) | 0x22000000)
        badge.setBackground(background)
        image = box.getChildAt(1) if int(box.getChildCount()) > 1 else None
        shown = False
        if image is not None and not getattr(self, "_mt_no_sticker", False):
            try:
                from org.telegram.messenger import MediaDataController
                name, _sep, index = __icon__.partition("/")
                MediaDataController.getInstance(UserConfig.selectedAccount).setPlaceholderImageByIndex(
                    image, name, int(index or 0), "100_100")
                shown = True
            except Exception:
                self._mt_no_sticker = True
        if image is not None:
            image.setVisibility(View.VISIBLE if shown else View.GONE)
        box.getChildAt(0).setVisibility(View.GONE if shown else View.VISIBLE)

    @staticmethod
    def _mt_color(keys, fallback):
        try:
            from org.telegram.ui.ActionBar import Theme
            for key in keys:
                if hasattr(Theme, key):
                    return int(Theme.getColor(getattr(Theme, key)))
        except Exception:
            pass
        return signed_color(fallback)

    @staticmethod
    def _mt_bold():
        try:
            from org.telegram.messenger import AndroidUtilities
            try:
                return AndroidUtilities.bold()
            except Exception:
                return AndroidUtilities.getTypeface("fonts/rmedium.ttf")
        except Exception:
            from android.graphics import Typeface
            return Typeface.DEFAULT_BOLD

    def _on_check_updates(self, *_args):
        try:
            if self._updater is None:
                self._updater = build_updater(__id__, __version__)
            self._updater.check()
        except Exception as exc:
            toast_err("Проверка не запущена: " + type(exc).__name__)

    def _page_mute(self):
        self._ensure_state()
        cfg = self._command_config()
        total = self._mutes.total()
        return [
            Header(text="Мут"),
            Switch(key="mute_enabled", text="Включить мут", default=True, icon="msg_mute",
                   subtext="%s%s @user · %s%s @user" % (cfg["prefix"], cfg["mute"], cfg["prefix"], cfg["unmute"])),
            Text(text="Список мутов",
                 subtext="%d %s" % (total, plural_word(total, ("пользователь", "пользователя", "пользователей")))
                 if total else "Список пуст",
                 icon="msg_contacts", create_sub_fragment=self._page_mute_list, link_alias="mute_list"),
            Divider(text="Или ответьте %s%s на сообщение пользователя." % (cfg["prefix"], cfg["mute"])),
            Header(text="Удаление сообщений"),
            Selector(key="mute_mode", text="Где удалять", default=MODE_ONLY_ME,
                     items=DELETE_MODES, icon="msg_delete"),
            Switch(key="mute_edits", text="Удалять изменения", default=True, icon="msg_edit"),
            Divider(text="Удаление у всех в группах зависит от прав администратора."),
            Header(text="Ответы в чате"),
            Switch(key="mute_silent", text="Тихий режим", default=True, icon="msg_notifications",
                   subtext="Без сообщений о муте и размуте"),
            Text(text="Тексты ответов", subtext="Мут и размут", icon="msg_edit",
                 create_sub_fragment=self._page_mute_notices),
            Divider(),
            Header(text="Управление"),
            Text(text="Снять все муты", subtext="Во всех чатах и аккаунтах", icon="msg_clear",
                 red=True, on_click=self._on_clear_mutes),
            Divider(),
        ]

    def _page_mute_list(self):
        self._ensure_state()
        with self._lock:
            entries = self._mutes.entries()
        if not entries:
            cmd = self._command_text("mute")
            return [
                Header(text="Замученные"),
                Text(text="Пока никого", icon="msg_info"),
                Divider(text="Отправьте %s @user или ответьте %s на сообщение" % (cmd, cmd)),
            ]
        items = []
        multi = len({a for a, _d, _u in entries}) > 1
        for index, (account, dialog_id, users) in enumerate(entries):
            if index:
                items.append(Divider())
            items.append(Header(text=self._dialog_title(account, dialog_id, multi)))
            for user_id in users:
                title, sub = self._user_label(account, user_id)
                items.append(Text(text=title, subtext=sub, icon="msg_mute",
                                  on_click=self._unmute_click(account, dialog_id, user_id)))
        items.append(Divider(text="Нажмите на пользователя, чтобы снять мут · всего: %d" % self._mutes.total()))
        return items

    def _page_del(self):
        return [
            Header(text="Удаление"),
            Switch(key="del_enabled", text="Включить команду", default=True,
                   subtext="%s N · можно ответом на сообщение" % self._command_text("del"), icon="msg_delete"),
            Switch(key="del_silent", text="Тихий режим", default=True,
                   subtext="Отчёт только на этом устройстве", icon="msg_notifications"),
            Divider(),
            Header(text="Параметры"),
            Selector(key="del_scope", text="Чьи сообщения", default=SCOPE_ALL,
                     items=SCOPE_LABELS, icon="msg_contacts"),
            Selector(key="del_mode", text="Где удалять", default=MODE_ONLY_ME,
                     items=DELETE_MODES, icon="msg_list"),
            Input(key="del_max", text="Лимит за запуск", subtext="1–%d сообщений" % HARD_LIMIT,
                  default=str(DEFAULT_MAX_DELETE), icon="msg_edit",
                  on_change=self._number_check("del_max", DEFAULT_MAX_DELETE, 1, HARD_LIMIT, False)),
            Divider(text="Удаление у всех в группах зависит от прав администратора."),
        ]

    def _page_spam(self):
        return [
            Header(text="Спам"),
            Switch(key="spam_enabled", text="Включить команду", default=True,
                   subtext="%s N текст" % self._command_text("spam"), icon="msg_forward"),
            Divider(),
            Header(text="Лимиты"),
            Input(key="spam_max", text="Сообщений за запуск", subtext="1–%d" % SPAM_MAX_LIMIT,
                  default=str(DEFAULT_SPAM_MAX), icon="msg_edit",
                  on_change=self._number_check("spam_max", DEFAULT_SPAM_MAX, 1, SPAM_MAX_LIMIT, False)),
            Input(key="spam_delay", text="Между сообщениями", subtext="0–%d с" % SPAM_DELAY_MAX,
                  default=str(DEFAULT_SPAM_DELAY), icon="msg_recent",
                  on_change=self._number_check("spam_delay", DEFAULT_SPAM_DELAY, 0, SPAM_DELAY_MAX, True)),
            Input(key="spam_cooldown", text="Между запусками в чате", subtext="0–%d с" % SPAM_COOLDOWN_MAX,
                  default=str(DEFAULT_SPAM_COOLDOWN), icon="msg_recent",
                  on_change=self._number_check("spam_cooldown", DEFAULT_SPAM_COOLDOWN, 0, SPAM_COOLDOWN_MAX, False)),
            Divider(text="Паузы снижают риск ограничений Telegram за флуд."),
        ]

    def _page_commands(self):
        icons = {"prefix": "msg_edit", "mute": "msg_mute", "unmute": "msg_unmute",
                 "del": "msg_delete", "spam": "msg_forward"}
        cfg = self._command_config()
        items = [Header(text="Префикс"),
                 Input(key="cmd_prefix", text="Префикс", default=DEFAULT_COMMANDS["prefix"], icon="msg_edit",
                       on_change=lambda _v: self._validate_commands()),
                 Divider(), Header(text="Имена команд")]
        for field, label in COMMAND_FIELDS[1:]:
            items.append(Input(key="cmd_" + field, text=label, default=DEFAULT_COMMANDS[field], icon=icons[field],
                               on_change=lambda _v: self._validate_commands()))
        preview = " · ".join(cfg["prefix"] + cfg[field] for field, _label in COMMAND_FIELDS[1:])
        items += [Divider(text="Сейчас: %s\nБез пробелов, совпадений и префикса в имени." % preview),
                  Text(text="Сбросить команды", subtext="Префикс и имена по умолчанию", icon="msg_retry", red=True,
                       on_click=self._on_commands_reset),
                  Divider()]
        return items

    def _page_no_via(self):
        bots = self._nv_bots()
        whitelist = self._choice("nv_mode", NV_BLACKLIST, (NV_BLACKLIST, NV_WHITELIST)) == NV_WHITELIST
        return [
            Header(text="No Via"),
            Switch(key="nv_enabled", text="Убирать via @bot", default=True,
                   subtext="Inline-результат отправляется от вашего имени", icon="msg_bot"),
            Switch(key="nv_keep_action", text="Сохранять игры и кнопки-действия", default=True,
                   subtext="Для таких результатов via остаётся", icon="msg_secret"),
            Divider(),
            Header(text="Боты"),
            Selector(key="nv_mode", text="Применять", default=NV_BLACKLIST,
                     items=["Все, кроме списка", "Только из списка"], icon="msg_list",
                     on_change=lambda i: self.set_setting("nv_mode", int(i), True)),
            Text(text="Разрешённые боты" if whitelist else "Исключения",
                 subtext="В списке: %d" % len(bots) if bots else "Список пуст",
                 icon="msg_contacts" if whitelist else "msg_block", create_sub_fragment=self._page_nv_bots,
                 link_alias="nv_bots"),
            Divider(),
            Header(text="Содержимое"),
            Switch(key="nv_strip_caption", text="Убирать подпись бота", default=True, icon="msg_edit"),
            Switch(key="nv_url_buttons", text="Ссылки из кнопок в текст", default=True, icon="msg_link"),
            Text(text="Названия треков", subtext="Включено" if self.get_setting("nv_clean_titles", True) else "Выключено",
                 icon="msg_music|msg_edit", create_sub_fragment=self._page_nv_music),
            Divider(),
            Header(text="Если отправка без via невозможна"),
            Switch(key="nv_fallback", text="Отправлять оригинал", default=True,
                   subtext="С via @bot. Иначе отправка отменяется.", icon="msg_retry"),
            Divider(),
        ]

    def _page_nv_music(self):
        return [
            Header(text="Названия треков"),
            Switch(key="nv_clean_titles", text="Очищать названия", default=True, icon="msg_edit"),
            Switch(key="nv_clean_download", text="Перезагружать файл", default=True,
                   subtext="Необходимо для изменения названия", icon="msg_download"),
