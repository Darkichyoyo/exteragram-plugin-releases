    def _page_nv_bots(self):
        bots = self._nv_bots()
        whitelist = self.get_setting("nv_mode", NV_BLACKLIST) == NV_WHITELIST
        items = [
            Header(text="Добавить"),
            Input(key="nv_new_bot", text="Юзернейм бота", default="", icon="msg_add",
                  on_change=self._nv_on_new_bot),
            Divider(text="Можно несколько через запятую"),
            Header(text="Только эти боты" if whitelist else "Исключения"),
        ]
        if bots:
            for bot in bots:
                items.append(Text(text="@" + bot, subtext="Нажмите, чтобы убрать", icon="msg_bot",
                                  on_click=lambda _v, n=bot: self._nv_remove_bot(n)))
        else:
            items.append(Text(text="Список пуст", icon="msg_info"))
        recent = [r for r in self._nv_recent() if r not in bots]
        if recent:
            items += [Divider(), Header(text="Недавние inline-боты")]
            for bot in recent:
                items.append(Text(text="@" + bot, subtext="Нажмите, чтобы добавить", icon="msg_add",
                                  accent=True, on_click=lambda _v, n=bot: self._nv_add_bot(n)))
        if bots:
            items += [Divider(), Text(text="Очистить список", subtext="Ботов в списке: %d" % len(bots),
                                      icon="msg_clear", red=True,
                                      on_click=lambda _v: self._confirm(
                                          "Очистить список?", "Все боты будут убраны из списка.", "Очистить",
                                          lambda: self._nv_save_bots([])))]
        items.append(Divider())
        return items

    def _reload_settings(self):
        try:
            self.set_setting("_ui_tick", str(time.time()), True)
        except Exception:
            pass

    def _number_check(self, key, default, minimum, maximum, fraction):
        pattern = re.compile(r"[0-9]{1,3}([.,][0-9])?" if fraction else r"[0-9]{1,3}")

        def canonical(value):
            raw = str(value if value is not None else "").strip()
            if not pattern.fullmatch(raw):
                return None
            number = float(raw.replace(",", "."))
            if not minimum <= number <= maximum:
                return None
            return str(round(number, 1)) if fraction else str(int(number))

        read = self._float_setting if fraction else self._int_setting
        last = [canonical(read(key, default, minimum, maximum))]
        if self.get_setting(key, None) != last[0]:
            self.set_setting(key, last[0], reload_settings=False)

        def _check(value):
            normalized = canonical(value)
            if normalized is None:
                self.set_setting(key, last[0], reload_settings=True)
                message = "Нужно число от %d до %d" % (minimum, maximum)
                if fraction:
                    message += ", не более одного знака после запятой"
                toast_err(message)
                return
            last[0] = normalized
            if self.get_setting(key, None) != normalized:
                self.set_setting(key, normalized, reload_settings=False)
        return _check

    def _int_setting(self, key, default, minimum, maximum):
        try:
            value = int(str(self.get_setting(key, str(default))).strip())
        except Exception:
            value = default
        return max(minimum, min(maximum, value))

    def _float_setting(self, key, default, minimum, maximum):
        try:
            value = round(float(str(self.get_setting(key, str(default))).strip().replace(",", ".")), 1)
        except Exception:
            value = default
        return max(minimum, min(maximum, value))

    def _choice(self, key, default, allowed):
        try:
            value = int(self.get_setting(key, default))
        except Exception:
            return default
        return value if value in allowed else default

    def _validate_commands(self):
        _cfg, error = check_command_config(self._read_commands())
        if error:
            toast_err(error + " · работают команды по умолчанию")

    def _on_commands_reset(self, _view=None):
        self._confirm("Сбросить команды?", "Префикс и имена команд вернутся к значениям по умолчанию.",
                      "Сбросить", self._reset_commands_now)

    def _read_commands(self):
        return {f: self.get_setting("cmd_" + f, DEFAULT_COMMANDS[f]) for f, _l in COMMAND_FIELDS}

    def _command_config(self):
        config, _error = check_command_config(self._read_commands())
        return config or dict(DEFAULT_COMMANDS)

    def _command_text(self, action):
        cfg = self._command_config()
        return cfg["prefix"] + cfg[action]

    def _unmute_click(self, account, dialog_id, user_id):
        def _click(_view=None):
            title, _sub = self._user_label(account, user_id)
            with self._lock:
                changed = self._mutes.remove(account, dialog_id, user_id)
                saved = self._persist_mutes() if changed else True
            if not changed:
                toast_info("Этот мут уже снят")
            elif not saved:
                toast_err("Мут снят, но не сохранился")
            else:
                toast_ok("Мут снят: %s" % title)
            if changed:
                self._reload_settings()
        return _click

    @staticmethod
    def _confirm(title, message, ok_text, action):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment is not None else None
        if activity is None:
            toast_err("Не удалось показать подтверждение — действие отменено")
            return

        def _ok(dialog, _which):
            try:
                dialog.dismiss()
            except Exception:
                pass
            try:
                action()
            except Exception:
                pass

        builder = AlertDialogBuilder(activity)
        builder.set_title(title)
        builder.set_message(message)
        builder.set_positive_button(ok_text, _ok)
        builder.set_negative_button("Отмена", lambda d, _w: d.dismiss())
        builder.set_cancelable(True)
        builder.show()

    def _on_clear_mutes(self, _view=None):
        self._confirm("Снять все муты?", "Списки очистятся во всех чатах и аккаунтах.", "Очистить",
                      self._clear_mutes_now)

    def _clear_mutes_now(self):
        with self._lock:
            self._mutes.clear()
            saved = self._persist_mutes(True)
        (toast_ok if saved else toast_err)("Муты сняты" if saved else "Не удалось сохранить")

    def _prune(self, now):
        with self._lock:
            if len(self._command_guard) + len(self._command_echo) + len(self._own_notices) + len(self._handled) < 128:
                return
            for table, ttl in ((self._command_guard, GUARD_TTL), (self._command_echo, COMMAND_ECHO_TTL),
                               (self._own_notices, GUARD_TTL), (self._handled, HANDLED_TTL)):
                for key in [k for k, ts in table.items() if now - ts > ttl]:
                    table.pop(key, None)

    def _mark_handled(self, account, dialog_id, message_id):
        key = (int(account), int(dialog_id), int(message_id))
        now = time.time()
        with self._lock:
            seen = self._handled.get(key)
            if seen is not None and now - seen < HANDLED_TTL:
                return False
            self._handled[key] = now
        return True

    def _my_id(self, account):
        try:
            return int(get_user_config(int(account)).getClientUserId() or 0)
        except Exception:
            return 0

    def on_send_message_hook(self, account, params):
        try:
            self._ensure_state()
            self._ensure_observer(account)
            text = getattr(params, "message", None)
            if isinstance(text, str) and text:
                result = self._command_hook(account, params, text)
                if result is not None:
                    return result
            return self._no_via_hook(account, params)
        except Exception:
            return HookResult()


    def _command_hook(self, account, params, text):
        dialog_id = int(getattr(params, "peer", 0) or 0)
        key = (int(account), dialog_id, text)
        with self._lock:
            stamp = self._own_notices.pop(key, None)
        if stamp is not None and time.time() - stamp <= COMMAND_ECHO_TTL:
            return HookResult()
        parsed = parse_command(text, self._command_config())
        if parsed is None or dialog_id == 0 or is_special_dialog(dialog_id):
            return None
        action, arg = parsed
        group = "mute" if action in ("mute", "unmute") else action
        if not self.get_setting(group + "_enabled", True):
            return None
        if not self._claim_command(account, dialog_id, text):
            return HookResult(strategy=HookStrategy.CANCEL)
        if group == "mute":
            self._handle_mute(account, dialog_id, arg, params, action == "unmute")
        elif action == "del":
            self._handle_del(account, dialog_id, arg, params)
        else:
            self._handle_spam(account, dialog_id, arg)
        return HookResult(strategy=HookStrategy.CANCEL)

    def _claim_command(self, account, dialog_id, text):
        now = time.time()
        self._prune(now)
        key = (int(account), int(dialog_id), text.strip().lower())
        with self._lock:
            seen = self._command_guard.get(key)
            if seen is not None and now - seen < DEDUP_WINDOW:
                return False
            self._command_guard[key] = now
            self._command_echo[key] = now
        return True

    def _send_notice(self, account, dialog_id, text):
        value = tidy_text(text)
        if not value:
            return
        with self._lock:
            self._own_notices[(int(account), int(dialog_id), value)] = time.time()

        def _send():
            try:
                send_text(int(dialog_id), value, account=int(account))
            except Exception:
                pass
        ui(_send)

    def _report(self, account, dialog_id, silent, text, kind="error"):
        _bulletin(kind, text)
        if not silent:
            self._send_notice(account, dialog_id, text)

    @staticmethod
    def _explicit_reply(params):
        reply = getattr(params, "replyToMsg", None)
        top = getattr(params, "replyToTopMsg", None)
        if reply is None or top is None:
            return reply
        if reply is top:
            return None
        try:
            if int(reply.getId()) == int(top.getId()):
                return None
        except Exception:
            pass
        return reply

    @staticmethod
    def _reply_in_dialog(reply, dialog_id):
        try:
            value = int(reply.getDialogId() or 0)
        except Exception:
            return False
        return value in (0, int(dialog_id))

    def _handle_mute(self, account, dialog_id, arg, params, unmute):
        silent = bool(self.get_setting("mute_silent", True))
        cmd = self._command_text("unmute" if unmute else "mute")
        done = lambda target: self._finish_mute(account, dialog_id, target, unmute, silent)

        if arg:
            username = parse_username(arg)
            if username is None:
                self._report(account, dialog_id, silent, "Использование: %s @username" % cmd)
            else:
                self._resolve_username(account, username, done)
            return

        reply = self._explicit_reply(params)
        if reply is not None:
            if not self._reply_in_dialog(reply, dialog_id):
                self._report(account, dialog_id, silent, "Ответьте на сообщение в этом чате")
                return
            try:
                user_id = int(reply.getSenderId() or 0)
            except Exception:
                user_id = 0
            if user_id <= 0:
                self._report(account, dialog_id, silent, "Не удалось определить автора")
            else:
                done(user_id)
            return

        if dialog_id > 0 and dialog_id != self._my_id(account):
            done(dialog_id)
            return
        self._report(account, dialog_id, silent, "В группе: %s @username или ответом" % cmd)

    def _resolve_username(self, account, username, callback):
        try:
            user = get_messages_controller(int(account)).getUser(username)
        except Exception:
            user = None
        if user is not None:
            callback(user)
            return
        request = TLRPC.TL_contacts_resolveUsername()
        request.username = username

        def _on_response(response, error):
            target = None if error is not None else first_user(response)
            ui(lambda: callback(target))

        try:
            send_request(request, _on_response, account=int(account))
        except Exception:
            callback(None)

    def _finish_mute(self, account, dialog_id, target, unmute, silent):
        try:
            user = target if hasattr(target, "id") else None
            user_id = int(getattr(user, "id", 0) or 0) if user is not None else int(target or 0)
            if user_id <= 0:
                self._report(account, dialog_id, silent, "Пользователь не найден")
                return
            if user_id == self._my_id(account):
                self._report(account, dialog_id, silent, "Себя заглушить нельзя")
                return
            if user is None:
                user = self._get_user(account, user_id)
            identity = notice_identity(user, user_id)

            with self._lock:
                changed = (self._mutes.remove if unmute else self._mutes.add)(account, dialog_id, user_id)
                saved = self._persist_mutes() if changed else True
            if changed and not unmute:
                self._remember_label(account, user_id, user)
            if not saved:
                self._report(account, dialog_id, silent, "Изменение не сохранилось")
                return

            if unmute:
                toast_ok("Мут снят: %s" % identity if changed else "Пользователь не был замучен")
                template, fallback = self.get_setting("unmute_notice", DEFAULT_UNMUTE_NOTICE), DEFAULT_UNMUTE_NOTICE
            else:
                toast_ok("Замучен: %s" % identity if changed else "Уже замучен в этом чате")
                template, fallback = self.get_setting("mute_notice", DEFAULT_NOTICE), DEFAULT_NOTICE
            if changed and not silent:
                self._send_notice(account, dialog_id, render_template(template, identity, fallback))
        except Exception:
            self._report(account, dialog_id, silent, "Не удалось выполнить мут")

    def handle_new_messages(self, account, args):
        try:
            if args is None or not self._active or len(args) < 2:
                return
            if len(args) > 2 and bool(args[2]):
                return
            if len(args) > 3 and int(args[3] or 0) != 0:
                return
            ids = []
            ghosts = []
            for obj in jlist(args[1]):
                if obj is None:
                    continue
                owner = getattr(obj, "messageOwner", None)
                if bool(obj.isOut()):
                    if owner is not None:
                        self._drop_command_echo(account, owner)
                    continue
                message_id = int(obj.getId() or 0)
                dialog_id = int(obj.getDialogId() or 0)
                if self._should_delete(account, dialog_id, int(obj.getSenderId() or 0),
                                       message_id, False, getattr(owner, "action", None) is not None):
                    ids.append(message_id)
                elif self._take_ghost(account, dialog_id, message_id):
                    ghosts.append(message_id)
            if ids:
                self._delete_muted(account, int(args[0]), ids)
            if ghosts:
                acc, did = int(account), int(args[0])
                run_on_ui_thread(lambda: self._post_deleted(acc, did, ghosts))
        except Exception:
            pass

    def _muted_obj(self, obj):
        try:
            if obj is None or bool(obj.isOut()):
                return False
            owner = getattr(obj, "messageOwner", None)
            if owner is None or getattr(owner, "action", None) is not None:
                return False
            dialog_id = int(obj.getDialogId() or 0)
            sender_id = int(obj.getSenderId() or 0)
            if dialog_id == 0 or sender_id <= 0 or is_special_dialog(dialog_id):
                return False
            with self._lock:
                return sender_id in self._mutes.users(int(obj.currentAccount), dialog_id)
        except Exception:
            return False

    def _mute_filter(self, kind, param, returns_value):
        if not self._active or not self.get_setting("mute_enabled", True):
            return
        with self._lock:
            if not self._mutes.total():
                return
        index = MUTE_FILTER_ARG[kind]
        if len(param.args) <= index:
            return
        items = jlist(param.args[index])
        if not items:
            return
        kept = [obj for obj in items if not self._muted_obj(obj)]
        if len(kept) == len(items):
            return
        array = ArrayList()
        for obj in kept:
            array.add(obj)
        param.args[index] = array

    def _intercept(self, account, dialog_id, sender_id, message_id, edited, service):
        if self._should_delete(account, dialog_id, sender_id, message_id, edited, service):
            self._delete_muted(account, dialog_id, [message_id], early=True)
        return False

    def on_update_hook(self, update_name, account, update):
        try:
            self._ensure_state()
            self._ensure_observer(account)
            if update_name in SHORT_MESSAGE_UPDATES:
                return self._handle_short_update(update_name, account, update)
            message = getattr(update, "message", None)
            if message is None:
                return HookResult()
            edited = update_name in EDIT_UPDATES
            if bool(getattr(message, "out", False)):
                if not edited:
                    self._drop_command_echo(account, message)
                return HookResult()
            self._intercept(account, message_dialog_id(message), message_sender_id(message),
                            int(getattr(message, "id", 0) or 0), edited,
                            getattr(message, "action", None) is not None)
        except Exception:
            pass
        return HookResult()

    def on_updates_hook(self, container_name, account, updates):
        try:
            self._ensure_state()
            self._ensure_observer(account)
            if container_name in SHORT_MESSAGE_UPDATES:
                return self._handle_short_update(container_name, account, updates)
        except Exception:
            pass
        return HookResult()

    def _handle_short_update(self, name, account, update):
        if update is None or bool(getattr(update, "out", False)):
            return HookResult()
        message_id = int(getattr(update, "id", 0) or 0)
        if name == "TL_updateShortMessage":
            dialog_id = sender_id = int(getattr(update, "user_id", 0) or 0)
        else:
            chat_id = int(getattr(update, "chat_id", 0) or 0)
            dialog_id = -chat_id if chat_id else 0
            sender_id = int(getattr(update, "from_id", 0) or 0)
        self._intercept(account, dialog_id, sender_id, message_id, False, False)
        return HookResult()

    def _should_delete(self, account, dialog_id, sender_id, message_id, edited, service):
        if service or dialog_id == 0 or message_id <= 0 or sender_id <= 0 or is_special_dialog(dialog_id):
            return False
        with self._lock:
            if int(sender_id) not in self._mutes.users(account, dialog_id):
                return False
        if not self.get_setting("mute_enabled", True):
            return False
        if edited:
            return bool(self.get_setting("mute_edits", True))
        return self._mark_handled(account, dialog_id, message_id)

    def _take_ghost(self, account, dialog_id, message_id):
        key = (int(account), int(dialog_id), int(message_id))
        with self._lock:
            if key not in self._handled or key in self._ghosted:
                return False
            if len(self._ghosted) > 2000:
                self._ghosted.clear()
            self._ghosted.add(key)
        return True

    def _delete_muted(self, account, dialog_id, ids, early=False):
        batch = sorted({int(i) for i in ids if int(i) > 0}, reverse=True)
        if not batch:
            return
        key = (int(account), int(dialog_id))
        with self._lock:
            self._mute_queue.setdefault(key, set()).update(batch)
            if self._mute_flush_pending:
                return
            self._mute_flush_pending = True
        if early:
            run_on_ui_thread(lambda: run_on_ui_thread(self._flush_muted))
        else:
            run_on_ui_thread(self._flush_muted)

    def _flush_muted(self):
        with self._lock:
            queue, self._mute_queue = self._mute_queue, {}
            self._mute_flush_pending = False
        if not queue:
            return
        for_all = self._choice("mute_mode", MODE_ONLY_ME, (MODE_ONLY_ME, MODE_FOR_ALL)) == MODE_FOR_ALL
        for (account, dialog_id), ids in queue.items():
            batch = sorted(ids, reverse=True)
            try:
                self._delete_messages(account, dialog_id, batch, for_all)
            except Exception:
                continue
            self._post_deleted(account, dialog_id, batch)

    def _post_deleted(self, account, dialog_id, ids):
        try:
            channel_id = -int(dialog_id) if self._is_channel(account, dialog_id) else 0
            center = NotificationCenter.getInstance(int(account))
            args = (int_list(ids), Long(channel_id), Boolean(False))
            try:
                center.postNotificationNameInternal(NotificationCenter.messagesDeleted, True, *args)
            except Exception:
                center.postNotificationName(NotificationCenter.messagesDeleted, *args)
        except Exception:
            pass

    def _drop_command_echo(self, account, message):
        text = getattr(message, "message", None)
        if not isinstance(text, str):
            return
        dialog_id = message_dialog_id(message)
        key = (int(account), int(dialog_id), text.strip().lower())
        with self._lock:
            stamp = self._command_echo.pop(key, None)
        message_id = int(getattr(message, "id", 0) or 0)
        if stamp is None or time.time() - stamp > COMMAND_ECHO_TTL or message_id <= 0:
            return
        self._dispatch_delete(account, dialog_id, [message_id], True)

    def _loaded_messages(self, account, dialog_id):
        try:
            fragment = get_last_fragment()
            if fragment is None or int(fragment.getDialogId() or 0) != int(dialog_id):
                return None
            if int(fragment.getCurrentAccount()) != int(account) or int(fragment.getChatMode() or 0) != 0:
                return None
            return jlist(fragment.messages)
        except Exception:
            return None

    @staticmethod
    def _pick_ids(items, wanted, scope, anchor_id, dialog_id, from_objects):
        stats = {"seen": 0, "service": 0, "not_mine": 0, "newer": 0}
        found = set()
        for item in items:
            if item is None:
                continue
            stats["seen"] += 1
            try:
                if from_objects:
                    if bool(getattr(item, "isDateObject", False)):
                        stats["service"] += 1
                        continue
                    message_id = int(item.getId() or 0)
                    if int(item.getDialogId() or 0) != int(dialog_id):
                        continue
                    owner = getattr(item, "messageOwner", None)
                    out = bool(item.isOut())
                    try:
                        if bool(item.isSponsored()):
                            stats["service"] += 1
                            continue
                    except Exception:
                        pass
                else:
                    message_id = int(getattr(item, "id", 0) or 0)
                    owner = item
                    out = bool(getattr(item, "out", False))
                if message_id <= 0:
                    continue
                if anchor_id > 0 and message_id > anchor_id:
                    stats["newer"] += 1
                    continue
                if owner is None or getattr(owner, "action", None) is not None:
                    stats["service"] += 1
                    continue
                if scope == SCOPE_MINE and not out:
                    stats["not_mine"] += 1
                    continue
                found.add(message_id)
            except Exception:
                continue
        return sorted(found, reverse=True)[:int(wanted)], stats

    @staticmethod
    def _nothing_text(scope, stats):
        seen = stats.get("seen", 0)
        if not seen:
            return "Нечего удалять"
        if scope == SCOPE_MINE and stats.get("not_mine", 0):
            return "Среди последних %d сообщений ваших нет" % seen
        if stats.get("newer", 0) >= seen:
            return "Старее этого сообщения ничего нет"
        if stats.get("service", 0) >= seen:
            return "Последние сообщения служебные"
        return "Подходящих сообщений нет"

    def _handle_del(self, account, dialog_id, arg, params):
        silent = bool(self.get_setting("del_silent", True))
        limit = self._int_setting("del_max", DEFAULT_MAX_DELETE, 1, HARD_LIMIT)
        count = parse_count(arg, limit)
        if count is None:
            self._report(account, dialog_id, silent,
                         "Использование: %s N (1–%d)" % (self._command_text("del"), limit))
            return
        scope = self._choice("del_scope", SCOPE_ALL, (SCOPE_ALL, SCOPE_MINE))
        for_all = self._choice("del_mode", MODE_ONLY_ME, (MODE_ONLY_ME, MODE_FOR_ALL)) == MODE_FOR_ALL

        anchor_id = 0
        reply = self._explicit_reply(params)
        if reply is not None:
            if not self._reply_in_dialog(reply, dialog_id):
                self._report(account, dialog_id, silent, "Ответьте на сообщение в этом чате")
                return
            try:
                anchor_id = int(reply.getId() or 0)
            except Exception:
                anchor_id = 0
            if anchor_id <= 0:
                self._report(account, dialog_id, silent, "Не удалось определить сообщение")
                return

        report = (account, dialog_id, silent, count)
        loaded = self._loaded_messages(account, dialog_id)
        local_ids, local_stats = [], {"seen": 0}
        if loaded:
            local_ids, local_stats = self._pick_ids(loaded, count, scope, anchor_id, dialog_id, True)
            if len(local_ids) >= count:
                self._dispatch_delete(account, dialog_id, local_ids, for_all, report)
                return

        if getattr(params, "replyToTopMsg", None) is not None:
            if local_ids:
                self._dispatch_delete(account, dialog_id, local_ids, for_all, report)
            else:
                self._report(account, dialog_id, silent,
                             self._nothing_text(scope, local_stats) if local_stats.get("seen")
                             else "В теме удаляются только загруженные сообщения", "info")
            return

        try:
            request = TLRPC.TL_messages_getHistory()
            request.peer = get_messages_controller(int(account)).getInputPeer(int(dialog_id))
            if request.peer is None:
                raise ValueError("no input peer")
        except Exception:
            self._report(account, dialog_id, silent, "Не удалось запросить историю")
            return
        request.limit = min(count + EXTRA_FETCH, HARD_LIMIT)
        request.offset_id = anchor_id + 1 if anchor_id > 0 else 0
        request.add_offset = 0
        request.offset_date = 0
        request.max_id = 0
        request.min_id = 0
        request.hash = 0

        def _on_history(response, error):
            try:
                if error is not None:
                    self._report(account, dialog_id, silent,
                                 "Ошибка истории: %s" % (getattr(error, "text", "") or "неизвестно"))
                    return
                raw = getattr(response, "messages", None)
                ids, stats = self._pick_ids(jlist(raw), count, scope, anchor_id, dialog_id, False)
                if not ids:
                    self._report(account, dialog_id, silent, self._nothing_text(scope, stats), "info")
                    return
                self._dispatch_delete(account, dialog_id, ids, for_all, report)
            except Exception:
                self._report(account, dialog_id, silent, "Ошибка обработки истории")

        try:
            send_request(request, _on_history, account=int(account))
        except Exception:
            self._report(account, dialog_id, silent, "Не удалось запросить историю")

    def _dispatch_delete(self, account, dialog_id, ids, for_all, report=None):
        clean = sorted({int(i) for i in ids if int(i) > 0}, reverse=True)

        def _run():
            try:
                deleted = self._delete_messages(account, dialog_id, clean, for_all)
                error = None
            except Exception:
                deleted, error = 0, "клиент отклонил удаление"
            if report is None:
                return
            acc, dlg, silent, wanted = report
            if error:
                self._report(acc, dlg, silent, "Не удалось удалить: %s" % error)
            elif deleted != wanted:
                self._report(acc, dlg, silent, "Удалено %d %s из %d" % (deleted, plural_ru(deleted), wanted), "success")
            else:
                self._report(acc, dlg, silent, "Удалено %d %s" % (deleted, plural_ru(deleted)), "success")

        if clean:
            ui(_run)

    def _delete_messages(self, account, dialog_id, ids, for_all):
        controller = get_messages_controller(int(account))
        local_only = not for_all and self._is_channel(account, dialog_id)
        for start in range(0, len(ids), HARD_LIMIT):
            array = ArrayList()
            for message_id in ids[start:start + HARD_LIMIT]:
                array.add(Integer(int(message_id)))
            if local_only:
                controller.deleteMessages(array, None, None, int(dialog_id), 0, False, 0, True)
            else:
                controller.deleteMessages(array, None, None, int(dialog_id), 0, bool(for_all), 0)
        return len(ids)

    def _is_channel(self, account, dialog_id):
        if int(dialog_id) >= 0:
            return False
        chat = self._get_chat(account, -int(dialog_id))
        return True if chat is None else bool(ChatObject.isChannel(chat))

    def _handle_spam(self, account, dialog_id, arg):
        limit = self._int_setting("spam_max", DEFAULT_SPAM_MAX, 1, SPAM_MAX_LIMIT)
        parts = (arg or "").split(None, 1)
        count = parse_count(parts[0], limit) if parts else None
        text = parts[1].strip() if len(parts) > 1 else ""
        if count is None or not text:
            toast_err("Использование: %s N текст (N: 1–%d)" % (self._command_text("spam"), limit))
            return
        cooldown = self._int_setting("spam_cooldown", DEFAULT_SPAM_COOLDOWN, 0, SPAM_COOLDOWN_MAX)
        key = (int(account), int(dialog_id))
        now = time.time()
        with self._lock:
            if self._spam_runs.get(key):
                error = "В этом чате уже идёт отправка"
            elif now - self._spam_last.get(key, 0) < cooldown:
                error = "Подождите ещё %d с" % (int(cooldown - (now - self._spam_last[key])) + 1)
            else:
                error = None
                self._spam_last[key] = now
                self._spam_runs[key] = True
        if error:
            toast_err(error)
            return
        delay = self._float_setting("spam_delay", DEFAULT_SPAM_DELAY, 0, SPAM_DELAY_MAX)
        threading.Thread(target=self._spam_worker, args=(key, count, text, delay), daemon=True).start()

    def _spam_worker(self, key, count, text, delay):
        account, dialog_id = key
        sent = 0
        try:
            for index in range(count):
                if not self._active or not self._spam_send(account, dialog_id, text):
                    break
                sent += 1
                if index < count - 1 and delay > 0:
                    time.sleep(delay)
        finally:
            with self._lock:
                self._spam_runs.pop(key, None)
        if not self._active:
            return
        if sent == count:
            toast_ok("Отправлено %d %s" % (sent, plural_ru(sent)))
        else:
            toast_err("Отправлено %d из %d" % (sent, count))

    def _spam_send(self, account, dialog_id, text):
        result = {"ok": False, "started": False, "cancelled": False}
        gate = threading.Lock()
        done = threading.Event()

        def _do():
            try:
                with gate:
                    if result["cancelled"] or not self._active:
                        return
                    result["started"] = True
                with self._lock:
                    self._own_notices[(account, dialog_id, text)] = time.time()
                send_text(dialog_id, text, account=account)
                result["ok"] = True
            except Exception:
                pass
            finally:
                done.set()

        run_on_ui_thread(_do)
        if not done.wait(SPAM_SEND_TIMEOUT):
            with gate:
                result["cancelled"] = True
            return False
        return result["ok"]

    def _nv_bots(self):
        raw = str(self.get_setting("nv_bots", "") or "").replace("\n", ",").replace(" ", ",")
        result = []
        for bot in raw.split(","):
            bot = bot.strip().lstrip("@").lower()
            if bot and bot not in result:
                result.append(bot)
        return result

    def _nv_recent(self):
        return [r for r in str(self.get_setting("nv_recent", "") or "").split(",") if r]

    def _nv_save_bots(self, bots):
        self.set_setting("nv_bots", ",".join(bots), True)

    def _nv_add_bot(self, name):
        name = (name or "").strip().lstrip("@").lower()
        bots = self._nv_bots()
        if name and name not in bots:
            self._nv_save_bots(bots + [name])
            toast_ok("@%s добавлен" % name)

    def _nv_remove_bot(self, name):
        self._nv_save_bots([b for b in self._nv_bots() if b != name])
        toast_info("@%s убран" % name)

    def _nv_on_new_bot(self, value):
        parts = [p for p in re.split(r"[,;\s]+", str(value or "").strip()) if p]
        names = []
        for part in parts:
            name = parse_username(part)
            if name is None:
                toast_err("Неверный юзернейм: " + part[:40])
                return
            name = name.lower()
            if name not in names:
                names.append(name)
        bots = self._nv_bots()
        added = [name for name in names if name not in bots]
        if added:
            self.set_setting("nv_bots", ",".join(bots + added), reload_settings=False)
        self.set_setting("nv_new_bot", "", reload_settings=True)
        if added:
            toast_ok("Добавлено ботов: %d" % len(added))
        elif names:
            toast_info("Эти боты уже в списке")

    def _nv_remember(self, name):
        name = (name or "").lstrip("@").lower()
        if not name:
            return
        recent = [r for r in self._nv_recent() if r != name]
        self.set_setting("nv_recent", ",".join([name] + recent[:9]))

    def _nv_allowed(self, bot_name):
        name = (bot_name or "").lstrip("@").lower()
        listed = name in self._nv_bots()
        return listed if self.get_setting("nv_mode", NV_BLACKLIST) == NV_WHITELIST else not listed

    @staticmethod
    def _buttons(markup):
        rows = getattr(markup, "rows", None) if markup is not None else None
        result = []
        if rows is not None:
            for row in jlist(rows):
                for btn in jlist(row.buttons):
                    result.append(btn)
        return result

    @staticmethod
    def _is_url_button(btn):
        return btn.getClass().getSimpleName() == "TL_keyboardButtonUrl"

    @staticmethod
    def _server_media(params):
        for field in ("document", "photo"):
            obj = getattr(params, field, None)
            if obj is not None:
                return bool(getattr(obj, "id", 0)) and bool(getattr(obj, "access_hash", 0))
        return None

    def _no_via_hook(self, account, params):
        extra = getattr(params, "params", None)
        if extra is None:
            return HookResult()
        if extra.containsKey(NV_RESEND):
            extra.remove(NV_RESEND)
            self._nv_titles(account, params, True)
            return HookResult(strategy=HookStrategy.MODIFY, params=params)
        if not extra.containsKey("query_id") or not self.get_setting("nv_enabled", True):
            return HookResult()

        bot_name = extra.get("bot_name") or ""
        self._nv_remember(bot_name)
        if not self._nv_allowed(bot_name) or getattr(params, "game", None) is not None:
            return HookResult()
        markup = getattr(params, "replyMarkup", None)
        buttons = self._buttons(markup)
        if self.get_setting("nv_keep_action", True) and any(not self._is_url_button(b) for b in buttons):
            return HookResult()

        media = self._server_media(params)
        if media is False:
            if self.get_setting("nv_fallback", True):
                return HookResult()
            toast_err("Этот результат нельзя отправить без бота")
            return HookResult(strategy=HookStrategy.CANCEL)

        for key in NV_INLINE_KEYS:
            extra.remove(key)
        if media and self.get_setting("nv_strip_caption", True):
            params.caption = None
            params.entities = None
        if buttons and self.get_setting("nv_url_buttons", True):
            self._nv_append_links(params, [b for b in buttons if self._is_url_button(b)], bool(media))
        params.replyMarkup = None

        if media and self._nv_titles(account, params, False) == HookStrategy.CANCEL:
            return HookResult(strategy=HookStrategy.CANCEL)
        return HookResult(strategy=HookStrategy.MODIFY, params=params)

    def _nv_append_links(self, params, buttons, is_media):
        links = [(str(b.text), str(b.url)) for b in buttons if getattr(b, "text", None) and getattr(b, "url", None)]
        if not links:
            return
        field = "caption" if is_media else "message"
        out = str(getattr(params, field, None) or "")
        has_base = bool(out)
        entities = ArrayList()
        if getattr(params, "entities", None) is not None:
            entities.addAll(params.entities)
        for index, (text, url) in enumerate(links):
            out += ("\n\n" if has_base else "") if index == 0 else "\n"
            entity = TLRPC.TL_messageEntityTextUrl()
            entity.offset = utf16_len(out)
            entity.length = utf16_len(text)
            entity.url = url
            entities.add(entity)
            out += text
        setattr(params, field, out)
        params.entities = entities

    @staticmethod
    def _audio_attr(doc):
        for attr in jlist(getattr(doc, "attributes", None)):
            if str(attr.getClass().getSimpleName()).startswith("TL_documentAttributeAudio"):
                return None if getattr(attr, "voice", False) else attr
        return None

    @staticmethod
    def _local_file(account, doc):
        from org.telegram.messenger import FileLoader
        loader = FileLoader.getInstance(account)
        for force in (False, True):
            try:
                path = loader.getPathToAttach(doc, force)
                if path is not None and path.exists() and path.length() > 0:
                    return path
            except Exception:
                pass
        return None

    def _nv_titles(self, account, params, resend):
        doc = getattr(params, "document", None)
        if doc is None or not self.get_setting("nv_clean_titles", True):
            return None
        attr = self._audio_attr(doc)
        if attr is None:
            return None
        words = [w.strip() for w in str(self.get_setting("nv_clean_words", "") or "").split(",") if w.strip()]
        title, performer = getattr(attr, "title", None), getattr(attr, "performer", None)
        new_title = clean_title(title, self.get_setting("nv_remove_feat", False), words) if title else title
        new_performer = clean_title(performer, False, words) if performer else performer
        if new_title == title and new_performer == performer:
            return None
        local = self._local_file(account, doc)
        if local is not None:
            self._nv_reupload(account, params, attr, new_title, new_performer, local)
            return HookStrategy.MODIFY
        if not resend and self.get_setting("nv_clean_download", True):
            self._nv_download_then_send(account, params)
            return HookStrategy.CANCEL
        return None

    def _nv_reupload(self, account, params, attr, title, performer, local):
        from org.telegram.messenger import FileLoader
        old = params.document
        doc = TLRPC.TL_document()
        doc.id = 0
        doc.access_hash = 0
        doc.dc_id = 0
        doc.date = old.date
        doc.mime_type = old.mime_type
        doc.size = old.size
        new_attr = TLRPC.TL_documentAttributeAudio()
        for field in ("flags", "voice", "duration", "title", "performer", "waveform"):
            try:
                setattr(new_attr, field, getattr(attr, field))
            except Exception:
                pass
        if title:
            new_attr.title = title
        if performer:
            new_attr.performer = performer
        flags = int(getattr(new_attr, "flags", 0) or 0) & ~7
        if getattr(new_attr, "title", None):
            flags |= 1
        if getattr(new_attr, "performer", None):
            flags |= 2
        if getattr(new_attr, "waveform", None) is not None:
            flags |= 4
        new_attr.flags = flags
        attributes = ArrayList()
        replaced = False
        for item in jlist(getattr(old, "attributes", None)):
            same = False
            if not replaced:
                try:
                    same = item is attr or bool(item.equals(attr))
                except Exception:
                    same = item is attr
            if same:
                replaced = True
                attributes.add(new_attr)
            else:
                attributes.add(item)
        if not replaced:
            attributes.add(new_attr)
        doc.attributes = attributes
        thumbs = ArrayList()
        loader = FileLoader.getInstance(account)
        for thumb in jlist(getattr(old, "thumbs", None)):
            try:
                path = loader.getPathToAttach(thumb, True)
                if path is not None and path.exists():
                    thumbs.add(thumb)
            except Exception:
                pass
        doc.thumbs = thumbs
        params.document = doc
        params.path = local.getAbsolutePath()

    def _nv_download_then_send(self, account, params):
        from org.telegram.messenger import FileLoader, SendMessagesHelper
        doc = params.document
        try:
            FileLoader.getInstance(account).loadFile(doc, getattr(params, "parentObject", None) or "nvb",
                                                     FileLoader.PRIORITY_HIGH, 0)
        except Exception:
            pass
        toast_info("Скачиваю трек, чтобы почистить название…")
        params.params.put(NV_RESEND, "1")

        def _wait():
            for _ in range(120):
                if self._local_file(account, doc) is not None:
                    break
                time.sleep(0.5)
            run_on_ui_thread(lambda: SendMessagesHelper.getInstance(account).sendMessage(params))

        threading.Thread(target=_wait, name='multi_tools-nv-wait', daemon=True).start()


    def _custom_ok(self):
        return Custom is not None and SimpleSettingFactory is not None


    @staticmethod
    def _theme(key_name, fallback):
        try:
            from org.telegram.ui.ActionBar import Theme
            return int(Theme.getColor(getattr(Theme, key_name)))
        except Exception:
            return signed_color(fallback)

    @staticmethod
    def _dp(value):
        try:
            from org.telegram.messenger import AndroidUtilities
            return int(AndroidUtilities.dp(float(value)))
        except Exception:
            return int(value * 3)

    @staticmethod
    def _full_width(view, height=-2):
        try:
            try:
                from androidx.recyclerview.widget import RecyclerView
                params = RecyclerView.LayoutParams(-1, int(height))
            except Exception:
                from android.view import ViewGroup
                params = ViewGroup.LayoutParams(-1, int(height))
            view.setLayoutParams(params)
        except Exception:
            pass
        return view

    def _error_view(self, context):
        from android.widget import TextView
        view = TextView(context)
        view.setText("Не удалось отобразить")
        try:
            view.setTextSize(15.0)
            view.setTextColor(signed_color(0xFFFF4444))
            view.setPadding(self._dp(21), self._dp(12), self._dp(21), self._dp(12))
            self._full_width(view)
        except Exception:
            pass
        return view


    def _page_mute_notices(self):
        return [Header(text="Тексты ответов"),
                Input(key="mute_notice", text="Мут", default=DEFAULT_NOTICE, icon="msg_mute"),
                Input(key="unmute_notice", text="Размут", default=DEFAULT_UNMUTE_NOTICE, icon="msg_unmute"),
                Divider(text="{name} — имя пользователя или ID. Тихий режим отключает ответы.")]


    def _reset_commands_now(self):
        for field, _label in COMMAND_FIELDS:
            self.set_setting("cmd_" + field, DEFAULT_COMMANDS[field])
        self._reload_settings()
        toast_ok("Команды сброшены")
