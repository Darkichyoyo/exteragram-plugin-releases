_reflect_cache = {}


def num(value, default=0):
    if value is None:
        return default
    if isinstance(value, bool):
        return int(value)
    if isinstance(value, (int, float)):
        return value
    for name in ("longValue", "intValue", "doubleValue", "floatValue"):
        try:
            return getattr(value, name)()
        except Exception:
            continue
    try:
        return int(str(value))
    except Exception:
        return default


def java_class(name):
    cached = _reflect_cache.get(("class", name))
    if cached is not None:
        return cached
    clazz = None
    try:
        from java.lang import Class
        from org.telegram.messenger import ApplicationLoader
        loader = ApplicationLoader.applicationContext.getClassLoader()
        clazz = Class.forName(name, False, loader)
    except Exception:
        try:
            from java.lang import Class
            clazz = Class.forName(name)
        except Exception:
            clazz = None
    if clazz is not None:
        _reflect_cache[("class", name)] = clazz
    return clazz


def java_field(class_name, field_name):
    key = ("field", class_name, field_name)
    if key in _reflect_cache:
        return _reflect_cache[key]
    field = None
    try:
        clazz = java_class(class_name)
        while clazz is not None and field is None:
            try:
                field = clazz.getDeclaredField(field_name)
                field.setAccessible(True)
            except Exception:
                field = None
                clazz = clazz.getSuperclass()
    except Exception:
        field = None
    _reflect_cache[key] = field
    return field


def controller_account(obj):
    try:
        field = java_field("org.telegram.messenger.BaseController", "currentAccount")
        if field is not None:
            return int(field.getInt(obj))
    except Exception:
        pass
    try:
        return int(obj.getCurrentAccount())
    except Exception:
        return int(UserConfig.selectedAccount)


def ids_of(array):
    result = []
    if array is None:
        return result
    try:
        size = int(array.size())
        for i in range(size):
            item = array.get(i)
            if item is not None:
                result.append(int(num(item)))
    except Exception:
        try:
            for item in array:
                if item is not None:
                    result.append(int(num(item)))
        except Exception:
            pass
    return result


def int_list(values):
    array = ArrayList()
    for value in values:
        array.add(Integer(int(value)))
    return array


def range_active():
    return bool(getattr(_dm_tls, "range", 0))


class DeletedStore(object):

    def __init__(self):
        self._data = {}
        self._lock = threading.RLock()
        self._io_lock = threading.Lock()
        self._timer = None
        self._path = None
        self.loaded = False
        self.read_only = False
        self.last_error = None

    def path(self):
        if self._path is None:
            import os
            try:
                from org.telegram.messenger import ApplicationLoader
                base = str(ApplicationLoader.getFilesDirFixed().getAbsolutePath())
            except Exception:
                base = os.path.dirname(os.path.abspath(__file__))
            self._path = os.path.join(base, DM_FILE)
        return self._path

    def load(self):
        import os
        with self._lock:
            self._data = {}
            self.read_only = False
            path = self.path()
            try:
                if os.path.exists(path):
                    with open(path, "r", encoding="utf-8") as fh:
                        raw = json.load(fh)
                    data = {}
                    for acc, dialogs in (raw or {}).items():
                        for did, mids in (dialogs or {}).items():
                            bucket = data.setdefault(int(acc), {}).setdefault(int(did), set())
                            bucket.update(int(m) for m in mids)
                    self._data = data
            except Exception:
                # Corrupt/unreadable file: keep it aside instead of overwriting it with an empty store.
                try:
                    os.replace(path, "%s.corrupt-%d" % (path, int(time.time())))
                except Exception:
                    self.read_only = True
            self.loaded = True

    @staticmethod
    def _payload(data):
        return {str(a): {str(d): sorted(m) for d, m in dialogs.items() if m}
                for a, dialogs in data.items()}

    def _write_payload(self, payload):
        # Caller holds _io_lock. Write in the same directory, then atomically replace.
        # fsync before replace closes the ordinary app-restart window; not a guarantee
        # against filesystem/device failure or power loss (directory is not fsynced).
        import os
        import tempfile
        path = self.path()
        tmp = None
        try:
            with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", delete=False,
                                             dir=os.path.dirname(path), prefix=".mt-deleted-", suffix=".tmp") as fh:
                tmp = fh.name
                json.dump(payload, fh, separators=(",", ":"))
                fh.flush()
                os.fsync(fh.fileno())
            os.replace(tmp, path)
            tmp = None
            self.last_error = None
        except Exception as exc:
            self.last_error = type(exc).__name__  # No path or message content in diagnostics.
            raise
        finally:
            if tmp is not None:
                try:
                    os.remove(tmp)
                except OSError:
                    pass

    def _flush(self):
        with self._io_lock:
            with self._lock:
                self._timer = None
                if self.read_only:
                    self.last_error = "ReadOnly"
                    return False
                try:
                    self._write_payload(self._payload(self._data))
                    return True
                except Exception:
                    return False

    def save_later(self):
        with self._lock:
            if self._timer is not None:
                return
            self._timer = threading.Timer(2.0, self._flush)
            self._timer.daemon = True
            self._timer.start()

    def flush_now(self):
        with self._lock:
            timer, self._timer = self._timer, None
        if timer is not None:
            try:
                timer.cancel()
            except Exception:
                pass
        # Must retry a failed write even if its timer has already fired.
        return self._flush()

    def add(self, account, dialog_id, mids):
        # Persist BEFORE the deletion hook is permitted to keep the Telegram row.
        # No two-second timer for new tombstones and no uncommitted in-memory marks.
        account, dialog_id = int(account), int(dialog_id)
        with self._io_lock:
            with self._lock:
                if self.read_only:
                    self.last_error = "ReadOnly"
                    raise OSError("Deleted marker store is read-only")
                bucket = set(self._data.get(account, {}).get(dialog_id, set()))
                added = []
                for value in mids:
                    mid = int(value)
                    if mid > 0 and mid not in bucket:
                        bucket.add(mid)
                        added.append(mid)
                if not added:
                    return []
                if len(bucket) > DM_MAX_PER_DIALOG:
                    self.last_error = "Capacity"
                    # Dropping old tombstones would turn previously retained messages into ghosts.
                    raise OverflowError("Deleted marker capacity reached")
                candidate = dict(self._data)
                dialogs = dict(candidate.get(account, {}))
                dialogs[dialog_id] = bucket
                candidate[account] = dialogs
                self._write_payload(self._payload(candidate))
                self._data = candidate
                return added

    def has(self, account, dialog_id, mid):
        dialogs = self._data.get(account)
        if not dialogs:
            return False
        bucket = dialogs.get(dialog_id)
        return bool(bucket) and mid in bucket

    def any_for(self, account):
        return bool(self._data.get(account))

    def remove(self, account, dialog_id, mids):
        changed = False
        with self._lock:
            bucket = self._data.get(int(account), {}).get(int(dialog_id))
            if bucket:
                for mid in mids:
                    if mid in bucket:
                        bucket.discard(mid)
                        changed = True
                if not bucket:
                    self._data[int(account)].pop(int(dialog_id), None)
        if changed:
            self.save_later()

    def snapshot(self):
        with self._lock:
            return [(a, d, sorted(m)) for a, dialogs in self._data.items() for d, m in dialogs.items() if m]

    def clear(self):
        with self._lock:
            self._data = {}
        self.save_later()

    def total(self):
        with self._lock:
            return sum(len(m) for dialogs in self._data.values() for m in dialogs.values())


_IDENT = []


def ident(view):
    if not _IDENT:
        from java.lang import System
        _IDENT.append(System)
    return int(_IDENT[0].identityHashCode(view))


def make_hook(plugin, kind, returns_value=False):
    from base_plugin import MethodHook

    class _BeforeHook(MethodHook):
        def before_hooked_method(self, param):
            try:
                plugin._dm_before(kind, param, returns_value)
            except Exception:
                pass

    class _AfterHook(MethodHook):
        def after_hooked_method(self, param):
            try:
                plugin._dm_after(kind, param)
            except Exception:
                pass

    class _BothHook(_BeforeHook):
        def after_hooked_method(self, param):
            try:
                plugin._dm_after(kind, param)
            except Exception:
                pass

    if kind in DM_UI_KINDS:
        return _AfterHook()
    if kind in DM_AFTER_KINDS:
        return _BothHook()
    return _BeforeHook()


# --- Manual, user-confirmed updater (shared module from exteragram_diagnostics/updater.py) ---
# Trust model: HTTPS + fixed repository prefix + SHA-256 from the manifest. This detects corruption and
# wrong files; it does NOT defend against a compromised release repository (no signature).
RELEASES_BASE = "https://raw.githubusercontent.com/Darkichyoyo/exteragram-plugin-releases/main/"
MANIFEST_URL = RELEASES_BASE + "releases.json"
# Primary transport since 0.5.2: GitHub Contents API (raw media type). raw.githubusercontent.com is a
# Fastly CDN with max-age=300 that IGNORES query strings (x-cache: HIT for a fresh ?nocache=..., checked
# 2026-10-10), so a just-published manifest could stay invisible for up to 5 minutes. The API answers
# with `cache-control: public, max-age=60, s-maxage=60` (checked 2026-10-10): a new release can still be
# invisible for up to ~1 minute. Unauthenticated limit is 60 requests/hour per IP, so raw stays as the
# fallback.
API_CONTENTS_BASE = "https://api.github.com/repos/Darkichyoyo/exteragram-plugin-releases/contents/"
API_REF = "main"
MAX_MANIFEST_BYTES = 64 * 1024
MAX_PLUGIN_BYTES = 2 * 1024 * 1024
BUSY_TIMEOUT_SECONDS = 180
# The engine answers through a callback. If it stays silent, the button is released after this delay and
# the result is reported as NOT confirmed. The temp file is kept (the engine may still be reading it) and
# is removed by the late callback or by the stale sweep at the next install.
INSTALL_RESPONSE_TIMEOUT_SECONDS = 90
STALE_TEMP_SECONDS = 600
TEMP_PREFIX = "eg_update_"


def _default_schedule(delay, fn):
    timer = threading.Timer(delay, fn)
    timer.daemon = True
    timer.start()
    return timer
_VERSION = re.compile(r"[0-9]{1,6}(\.[0-9]{1,6}){0,3}")
_SHA = re.compile(r"[0-9a-f]{64}")


class UpdateError(Exception):
    """Message is safe to show to the user (no URLs, paths or tracebacks)."""


def parse_version(text):
    if not isinstance(text, str) or not _VERSION.fullmatch(text):
        raise UpdateError("Некорректный формат версии")
    parts = tuple(int(p) for p in text.split("."))
    return parts + (0,) * (4 - len(parts))


class ReleaseInfo:
    def __init__(self, plugin_id, version, url, sha256, size):
        self.plugin_id, self.version, self.url, self.sha256, self.size = plugin_id, version, url, sha256, size


def parse_manifest(raw, plugin_id):
    """Returns ReleaseInfo for plugin_id, or None when the manifest has no entry for it."""
    try:
        data = json.loads(raw.decode("utf-8") if isinstance(raw, (bytes, bytearray)) else raw)
    except (ValueError, UnicodeDecodeError):
        raise UpdateError("Манифест обновлений повреждён")
    if not isinstance(data, dict) or data.get("schema") != 1 or not isinstance(data.get("plugins"), dict):
        raise UpdateError("Неподдерживаемый формат манифеста")
    entry = data["plugins"].get(plugin_id)
    if entry is None:
        return None
    if not isinstance(entry, dict):
        raise UpdateError("Некорректная запись манифеста")
    version, url, digest, size = (entry.get(k) for k in ("version", "url", "sha256", "size"))
    parse_version(version)
    if not (isinstance(url, str) and url.startswith(RELEASES_BASE) and url.endswith(".plugin")
            and ".." not in url and len(url) < 300):
        raise UpdateError("Адрес файла обновления не из доверенного репозитория")
    if not (isinstance(digest, str) and _SHA.fullmatch(digest)):
        raise UpdateError("Некорректная контрольная сумма в манифесте")
    if not (isinstance(size, int) and not isinstance(size, bool) and 0 < size <= MAX_PLUGIN_BYTES):
        raise UpdateError("Некорректный размер файла в манифесте")
    return ReleaseInfo(plugin_id, version, url, digest, size)


def read_plugin_metadata(source):
    """Static AST read of top-level __id__/__version__; the downloaded code is never executed."""
    try:
        tree = ast.parse(source)
    except (SyntaxError, ValueError):
        raise UpdateError("Файл обновления не является корректным Python")
    found = {}
    for node in tree.body:
        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
            name = node.targets[0].id
            if name in ("__id__", "__version__") and isinstance(node.value, ast.Constant) \
                    and isinstance(node.value.value, str):
                found[name] = node.value.value
    return found.get("__id__"), found.get("__version__")


def verify_payload(payload, info, current_id, current_version, stage=None):
    stage = stage or (lambda *_args, **_kwargs: None)
    if len(payload) != info.size:
        raise UpdateError("Размер файла не совпал с манифестом")
    stage("verify.size", "OK", bytes=len(payload))
    digest = hashlib.sha256(payload).hexdigest()
    if digest != info.sha256:
        raise UpdateError("Контрольная сумма SHA-256 не совпала")
    stage("verify.sha256", "OK", sha256=digest[:12])
    try:
        source = payload.decode("utf-8")
    except UnicodeDecodeError:
        raise UpdateError("Файл обновления не в UTF-8")
    file_id, file_version = read_plugin_metadata(source)
    if file_id != current_id or info.plugin_id != current_id:
        raise UpdateError("Идентификатор плагина в файле не совпал")
    if file_version != info.version:
        raise UpdateError("Версия в файле не совпала с манифестом")
    stage("verify.metadata", "OK", id=file_id, version=file_version)
    return source


class UpdateController:
    """All platform access is injected: http_get(url, max_bytes), install(path, callback), ui(fn).

    log(stage, result, level="INFO", details=None) receives one structured record per stage:
    check -> manifest.fetch -> manifest.parse -> version.compare -> confirm -> download ->
    verify.size / verify.sha256 / verify.metadata -> install.handoff -> install.result.
    """

    def __init__(self, plugin_id, version, http_get, install, notify, confirm, background, log=None,
                 clock=time.monotonic, tmp_root=None, source=None, schedule=None, wall_clock=time.time):
        parse_version(version)
        self.plugin_id, self.version = plugin_id, version
        self._http_get, self._install, self._notify = http_get, install, notify
        self._confirm, self._background = confirm, background
        self._log = log or (lambda *_args, **_kwargs: None)
        self._clock, self._tmp_root = clock, tmp_root
        self._lock = threading.Lock()
        self._busy_since = None
        self._source = source  # optional () -> str: which transport answered the last request
        self._schedule = schedule or _default_schedule  # (delay_s, fn) -> timer; tests inject a fake
        self._wall = wall_clock

    def _enter(self):
        with self._lock:
            now = self._clock()
            if self._busy_since is not None and now - self._busy_since < BUSY_TIMEOUT_SECONDS:
                return False
            self._busy_since = now
            return True

    def _leave(self):
        with self._lock:
            self._busy_since = None

    def _stage(self, stage, result, level="INFO", **details):
        try:
            self._log(stage, result, level, details)
        except Exception:
            pass  # diagnostics must never break the update flow

    def _fetch(self, stage, url, max_bytes):
        started = self._clock()
        try:
            raw = self._http_get(url, max_bytes)
        except Exception as exc:
            reason = str(exc) if isinstance(exc, UpdateError) else type(exc).__name__
            self._stage(stage, "FAILED", "ERROR", reason=reason, ms=int((self._clock() - started) * 1000))
            raise
        try:
            host = str(self._source()) if self._source is not None else "injected"
        except Exception:
            host = "unknown"
        self._stage(stage, "OK", bytes=len(raw), limit=max_bytes, ms=int((self._clock() - started) * 1000),
                    host=host)
        return raw

    def check(self, *_args):
        """Button handler: ignores repeated presses while an operation is in flight."""
        if not self._enter():
            self._stage("check", "IGNORED_BUSY", "WARN")
            self._notify("Проверка или установка уже выполняется")
            return
        self._stage("check", "STARTED", installed=self.version)
        try:
            self._background(self._check_work)
        except Exception as exc:
            self._leave()
            self._stage("check", "NOT_STARTED", "ERROR", reason=type(exc).__name__)
            self._notify("Проверка не запущена: " + type(exc).__name__, True)

    def find_update(self):
        try:
            raw = self._fetch("manifest.fetch", MANIFEST_URL, MAX_MANIFEST_BYTES)
        except UpdateError:
            raise
        except Exception as exc:
            raise UpdateError("Не удалось получить манифест: " + type(exc).__name__)
        if len(raw) > MAX_MANIFEST_BYTES:
            self._stage("manifest.parse", "FAILED", "ERROR", reason="too large", bytes=len(raw))
            raise UpdateError("Манифест слишком большой")
        try:
            info = parse_manifest(raw, self.plugin_id)
        except UpdateError as exc:
            self._stage("manifest.parse", "FAILED", "ERROR", reason=str(exc))
            raise
        if info is None:
            self._stage("manifest.parse", "NO_ENTRY", "WARN", plugin=self.plugin_id)
            return None
        self._stage("manifest.parse", "OK", remote=info.version, size=info.size, sha256=info.sha256[:12])
        newer = parse_version(info.version) > parse_version(self.version)
        self._stage("version.compare", "NEWER" if newer else "NOT_NEWER", installed=self.version,
                    remote=info.version)
        return info if newer else None

    def _check_work(self):
        try:
            info = self.find_update()
        except UpdateError as exc:
            self._leave()
            self._notify(str(exc), True)
            return
        except Exception as exc:  # defensive: never leave the button locked
            self._leave()
            self._stage("check", "CRASHED", "ERROR", reason=type(exc).__name__)
            self._notify("Проверка не выполнена: " + type(exc).__name__, True)
            return
        if info is None:
            self._leave()
            self._stage("check", "UP_TO_DATE", installed=self.version)
            self._notify(f"Установлена последняя версия ({self.version})")
            return
        self._stage("confirm", "SHOWN", remote=info.version)

        def declined():
            self._stage("confirm", "DECLINED")
            self._leave()
        try:
            self._confirm(info, lambda: self.start_install(info), declined)
        except Exception as exc:
            self._leave()
            self._stage("confirm", "FAILED", "ERROR", reason=type(exc).__name__)
            self._notify("Диалог обновления не открыт: " + type(exc).__name__, True)

    def start_install(self, info):
        """Called only after explicit user confirmation. The busy flag is still held."""
        self._stage("confirm", "ACCEPTED", remote=info.version)
        try:
            self._background(lambda: self._install_work(info))
        except Exception as exc:
            self._leave()
            self._notify("Установка не запущена: " + type(exc).__name__, True)

    def _sweep_stale(self):
        """Remove our own temp folders left by an installer that never answered (older than
        STALE_TEMP_SECONDS). Only eg_update_* directories in the temp root are touched."""
        root = self._tmp_root or tempfile.gettempdir()
        removed = 0
        try:
            names = os.listdir(root)
        except OSError:
            return
        now = self._wall()
        for name in names:
            path = os.path.join(root, name)
            try:
                if (name.startswith(TEMP_PREFIX) and os.path.isdir(path)
                        and now - os.path.getmtime(path) > STALE_TEMP_SECONDS):
                    shutil.rmtree(path, ignore_errors=True)
                    removed += 1
            except OSError:
                continue
        if removed:
            self._stage("install.cleanup", "STALE_REMOVED", count=removed)

    def _install_work(self, info):
        directory = None
        try:
            self._sweep_stale()
            payload = self._fetch("download", info.url, min(info.size, MAX_PLUGIN_BYTES))
            try:
                verify_payload(payload, info, self.plugin_id, self.version, self._stage)
            except UpdateError as exc:
                self._stage("verify", "FAILED", "ERROR", reason=str(exc))
                raise
            if parse_version(info.version) <= parse_version(self.version):
                raise UpdateError("Версия не новее установленной")
            directory = tempfile.mkdtemp(prefix=TEMP_PREFIX, dir=self._tmp_root)
            path = os.path.join(directory, self.plugin_id + ".plugin")
            with open(path, "xb") as output:
                output.write(payload)
            self._stage("install.handoff", "STARTED", note="file verified; passing to plugin engine")
        except UpdateError as exc:
            self._finish(directory, False, str(exc))
            return
        except Exception as exc:
            self._finish(directory, False, "Скачивание не выполнено: " + type(exc).__name__)
            return
        state = {"done": False, "timed_out": False}
        guard = threading.Lock()

        def outcome(result):
            if result is None:
                return True, f"Движок подтвердил установку версии {info.version}"
            first = str(result).strip().splitlines()[0][:120] if str(result).strip() else "без описания"
            return False, "Установка не выполнена движком: " + first

        def callback(result):
            with guard:
                if state["done"]:
                    return
                state["done"] = True
                late = state["timed_out"]
            ok, message = outcome(result)
            if not late:
                self._finish(directory, ok, message)
                return
            # The button was already released by the watchdog; report the real (late) outcome.
            shutil.rmtree(directory, ignore_errors=True)
            self._stage("install.result", "LATE_OK" if ok else "LATE_FAILED", "INFO" if ok else "ERROR",
                        message=message[:160])
            self._notify(message, not ok)

        def no_response():
            with guard:
                if state["done"] or state["timed_out"]:
                    return
                state["timed_out"] = True
            self._leave()
            self._stage("install.result", "NO_RESPONSE", "WARN", waited_s=INSTALL_RESPONSE_TIMEOUT_SECONDS,
                        note="request sent, installation NOT confirmed; temp file kept for the engine")
            self._notify(f"Установщик не ответил за {INSTALL_RESPONSE_TIMEOUT_SECONDS} с — установка не "
                         "подтверждена. Проверьте версию в списке плагинов.", True)

        try:
            route = self._install(path, callback)
            self._stage("install.handoff", "RETURNED", route=str(route), callback_received=state["done"],
                        note="request handed over; this is not an installation result")
        except Exception as exc:
            with guard:
                if state["done"]:
                    return
                state["done"] = True
            self._finish(directory, False, "Установщик недоступен: " + type(exc).__name__)
            return
        with guard:
            waiting = not state["done"]
        if waiting:
            try:
                self._schedule(INSTALL_RESPONSE_TIMEOUT_SECONDS, no_response)
            except Exception as exc:
                self._stage("install.watchdog", "NOT_STARTED", "ERROR", reason=type(exc).__name__)

    def _finish(self, directory, ok, message):
        if directory:
            shutil.rmtree(directory, ignore_errors=True)
        self._leave()
        self._stage("install.result", "OK" if ok else "FAILED", "INFO" if ok else "ERROR", message=message[:160])
        self._notify(message, not ok)


def no_cache_url(url, now=None):
    """Unique query for the mutable manifest on the raw fallback path. NOT a working cache bypass:
    raw.githubusercontent.com (Fastly, max-age=300) ignores the query string (checked 2026-10-10, see
    LEARNING_LOG L-20261010-raw-cdn-ignores-query); it is kept only because it is harmless. Freshness
    comes from the GitHub Contents API path. Versioned .plugin URLs are immutable and stay untouched."""
    if url != MANIFEST_URL:
        return url
    stamp = int((time.time() if now is None else now) * 1000)
    return f"{url}?nocache={stamp}"


def api_url(url):
    """Same file through the GitHub Contents API, or None for URLs outside the releases repository."""
    if not url.startswith(RELEASES_BASE):
        return None
    path = url[len(RELEASES_BASE):]
    if not path or ".." in path or "?" in path or "#" in path:
        return None
    return API_CONTENTS_BASE + path + "?ref=" + API_REF


class UpdaterBindings:
    """Android/SDK glue. Signatures come from third-party sources; NOT verified on ExteraGram 12.9.0."""

    def __init__(self):
        self.last_source = "none"

    def http_get(self, url, max_bytes):
        """Releases-repo files: GitHub API first (no CDN delay), raw.githubusercontent.com as fallback
        (API rate limit, outage). Size limits, HTTPS and SHA-256 checks are identical for both."""
        if not url.startswith("https://"):
            raise UpdateError("Допускается только HTTPS")
        primary = api_url(url)
        if primary is not None:
            try:
                data = self._get(primary, max_bytes, api=True)
                self.last_source = "api.github.com"
                return data
            except Exception as exc:
                reason = str(exc) if isinstance(exc, UpdateError) else type(exc).__name__
                data = self._get(url, max_bytes)
                self.last_source = "raw.githubusercontent.com (api: " + reason[:60] + ")"
                return data
        data = self._get(url, max_bytes)
        self.last_source = "raw.githubusercontent.com"
        return data

    def _get(self, url, max_bytes, api=False):
        from java.net import URL
        conn = URL(url if api else no_cache_url(url)).openConnection()
        if api:
            conn.setRequestProperty("Accept", "application/vnd.github.raw")
            conn.setRequestProperty("X-GitHub-Api-Version", "2022-11-28")
        conn.setUseCaches(False)
        conn.setRequestProperty("Cache-Control", "no-cache")
        conn.setRequestProperty("Pragma", "no-cache")
        conn.setInstanceFollowRedirects(False)
        conn.setConnectTimeout(10000)
        conn.setReadTimeout(20000)
        conn.setRequestProperty("User-Agent", "exteragram-plugin-updater/1")
        code = conn.getResponseCode()
        if code != 200:
            conn.disconnect()  # the error body is never read; do not keep the socket until GC
            raise UpdateError(f"Сервер ответил HTTP {code}")
        stream = conn.getInputStream()
        chunks, total = [], 0
        try:
            from java import jarray, jbyte
            buffer = jarray(jbyte)(8192)
            while True:
                count = stream.read(buffer)
                if count < 0:
                    break
                total += count
                if total > max_bytes:
                    raise UpdateError("Ответ сервера больше допустимого размера")
                chunks.append(bytes(bytearray(b & 0xFF for b in buffer[:count])))
        finally:
            stream.close()
            conn.disconnect()
        return b"".join(chunks)

    def install(self, path, callback):
        """Engine route first (12.x community usage), then legacy controller route.
        Only a TypeError raised BEFORE the call (wrong overload) falls through to the legacy route."""
        from java import dynamic_proxy, jclass
        Utilities = jclass("org.telegram.messenger.Utilities")
        PluginsController = jclass("com.exteragram.messenger.plugins.PluginsController")

        class Result(dynamic_proxy(Utilities.Callback)):
            def run(self, arg):
                callback(None if arg is None else str(arg))

        proxy = Result()
        controller = PluginsController.getInstance()
        engine = None
        try:
            engine = controller.engines.get("python")
        except Exception:
            engine = None
        if engine is not None:
            try:
                engine.loadPluginFromFile(path, None, proxy)
                return "engine"
            except TypeError:
                pass
        controller.loadPluginFromFile(path, proxy)
        return "controller"


def _upd_background(fn):
    thread = threading.Thread(target=fn, name="multi_tools-updater")
    thread.daemon = True
    thread.start()


def _upd_notify(text, error=False):
    (toast_err if error else toast_info)(text)


# Bottom sheet + decision from exteragram_diagnostics adapter.py (same UI as diagnostics 0.5.3).
def show_update_sheet(context, title, versions, note, button, decision):
    """Telegram's BottomSheet with a custom view (signatures: BottomSheet(Context, boolean),
    setCustomView(View), show(), dismiss(), setOnDismissListener(OnDismissListener) from the open-source
    client). It is NOT part of the documented plugin SDK, so any failure BEFORE show() raises and the
    caller falls back to AlertDialog. Must run on the UI thread."""
    from java import dynamic_proxy
    from android.content import DialogInterface
    from android.graphics.drawable import GradientDrawable
    from android.view import Gravity, View
    from android.widget import LinearLayout, TextView
    from org.telegram.ui.ActionBar import BottomSheet, Theme
    density = context.getResources().getDisplayMetrics().density
    dp = lambda v: int(density * v + 0.5)

    def color(name, default):
        try:
            return Theme.getColor(getattr(Theme, name))
        except Exception:
            return default

    def signed(argb):
        argb &= 0xFFFFFFFF
        return argb - (1 << 32) if argb >= (1 << 31) else argb

    def with_alpha(value, alpha):
        return signed((alpha << 24) | (value & 0xFFFFFF))

    def readable_on(value):
        red, green, blue = (value >> 16) & 255, (value >> 8) & 255, value & 255
        return signed(0xFF1B1B1B) if (0.299 * red + 0.587 * green + 0.114 * blue) > 150 else -1

    def rounded(fill, radius):
        shape = GradientDrawable()
        shape.setColor(fill)
        shape.setCornerRadius(float(dp(radius)))
        return shape

    sheet = BottomSheet(context, False)

    class Click(dynamic_proxy(View.OnClickListener)):
        def __init__(self, action):
            super().__init__()
            self.action = action

        def onClick(self, view):
            self.action(view)

    class Dismissed(dynamic_proxy(DialogInterface.OnDismissListener)):
        def onDismiss(self, dialog):
            decision.close()

    def text_view(text, size, text_color):
        view = TextView(context)
        view.setText(text)
        view.setTextSize(size)
        view.setTextColor(text_color)
        return view

    main_color = color("key_windowBackgroundWhiteBlackText", -1)
    gray_color = color("key_windowBackgroundWhiteGrayText2", -5592406)
    accent = color("key_featuredStickers_addButton", -14443544)

    root = LinearLayout(context)
    root.setOrientation(LinearLayout.VERTICAL)
    root.setPadding(dp(20), dp(10), dp(20), dp(20))
    # Info area (handle + texts): the only "close" target; it does not overlap the button.
    info = LinearLayout(context)
    info.setOrientation(LinearLayout.VERTICAL)
    info.setClickable(True)
    handle = View(context)
    handle.setBackground(rounded(with_alpha(gray_color, 0x80), 2))
    handle_params = LinearLayout.LayoutParams(dp(36), dp(4))
    handle_params.gravity = Gravity.CENTER_HORIZONTAL
    info.addView(handle, handle_params)

    heading = text_view(title, 22, main_color)
    try:  # optional styling only; the sheet works without it
        from org.telegram.messenger import AndroidUtilities
        heading.setTypeface(AndroidUtilities.bold())
    except Exception:
        pass
    heading_params = LinearLayout.LayoutParams(-2, -2)
    heading_params.topMargin = dp(18)
    info.addView(heading, heading_params)

    chip = text_view(versions, 14, accent)
    chip.setPadding(dp(10), dp(4), dp(10), dp(4))
    chip.setBackground(rounded(with_alpha(accent, 0x2E), 10))
    chip_params = LinearLayout.LayoutParams(-2, -2)
    chip_params.topMargin = dp(10)
    info.addView(chip, chip_params)

    note_view = text_view(note, 14, gray_color)
    note_params = LinearLayout.LayoutParams(-1, -2)
    note_params.topMargin = dp(10)
    note_params.bottomMargin = dp(18)
    info.addView(note_view, note_params)
    root.addView(info, LinearLayout.LayoutParams(-1, -2))

    action = text_view(button, 16, readable_on(accent))
    action.setGravity(Gravity.CENTER)
    action.setBackground(rounded(accent, 14))
    action.setClickable(True)
    try:
        from org.telegram.messenger import AndroidUtilities
        action.setTypeface(AndroidUtilities.bold())
    except Exception:
        pass
    root.addView(action, LinearLayout.LayoutParams(-1, dp(52)))

    def on_download(view):
        if decision.download():
            view.setEnabled(False)
            sheet.dismiss()

    def on_info(view):
        decision.close()
        sheet.dismiss()

    action.setOnClickListener(Click(on_download))
    info.setOnClickListener(Click(on_info))
    sheet.setCustomView(root)
    sheet.setOnDismissListener(Dismissed())
    sheet.show()


class UpdateSheetDecision:
    """First outcome wins: 'Скачать' -> accepted(); close/info tap/swipe/outside tap/dismiss -> declined()."""
    def __init__(self, accepted, declined):
        self._accepted, self._declined = accepted, declined
        self._lock, self._decided = threading.Lock(), False

    def _take(self):
        with self._lock:
            if self._decided:
                return False
            self._decided = True
            return True

    def download(self):
        if not self._take():
            return False
        self._accepted()
        return True

    def close(self):
        if not self._take():
            return False
        self._declined()
        return True


def _upd_confirm(current):
    def confirm(info, accepted, declined):
        def show():
            # Runs on the UI thread. Every failure path must call declined() exactly once so the
            # button is released; nothing is installed without an explicit tap on "Скачать"/"Установить".
            decision = UpdateSheetDecision(accepted, declined)
            try:
                fragment = get_last_fragment()
                activity = fragment.getParentActivity() if fragment is not None else None
                if activity is None:
                    raise RuntimeError("no activity")
            except Exception as exc:
                decision.close()
                _upd_notify("Диалог обновления не открыт: " + type(exc).__name__, True)
                return
            try:
                show_update_sheet(activity, "Доступно обновление", "%s → %s" % (current, info.version),
                                  "Перед установкой файл будет проверен.", "Скачать", decision)
                return
            except Exception:
                pass  # the sheet is not part of the documented SDK: fall back to the plain dialog
            try:
                def close(dialog):
                    try:
                        dialog.dismiss()
                    except Exception:
                        pass

                def yes(dialog, _which):
                    close(dialog)
                    decision.download()

                def no(dialog, _which):
                    close(dialog)
                    decision.close()

                builder = AlertDialogBuilder(activity)
                builder.set_title("Доступно обновление")
                builder.set_message("Версия %s → %s. Файл будет скачан, проверен (SHA-256, ID, версия) "
                                    "и передан движку плагинов для установки." % (current, info.version))
                builder.set_positive_button("Установить", yes)
                builder.set_negative_button("Отмена", no)
                builder.set_cancelable(False)
                builder.show()
            except Exception as exc:
                decision.close()
                _upd_notify("Диалог обновления не открыт: " + type(exc).__name__, True)
        ui(show)
    return confirm


def build_updater(plugin_id, version):
    android = UpdaterBindings()
    return UpdateController(plugin_id, version, android.http_get, android.install, _upd_notify,
                            _upd_confirm(version), _upd_background, source=lambda: android.last_source)


# Media downloads use Telegram's normal cache; this is NOT a durable archive.
DM_MEDIA_SESSION_BYTES = 200 * 1024 * 1024
DM_MEDIA_PENDING = 32
DM_MEDIA_PARALLEL = 3
DM_MEDIA_RECENT = 512
DM_MEDIA_RECENT_TTL = 2 * 3600


def dm_media_policy(kind, size, dialog_id, private_only, kinds, limit):
    return (kind in kinds and 0 < size <= limit and dialog_id != 0
            and (not private_only or dialog_id > 0) and not is_special_dialog(dialog_id))


class MediaDownloadQueue:
    """UI-thread owned, bounded queue; budget charges attempts, not successful downloads.

    A deletion can retry one failed prefetch, never an active or completed download.
    Forgetting old dedup entries does not refund the session budget.
    """
    def __init__(self, budget=DM_MEDIA_SESSION_BYTES):
        self.budget = budget
        self.used = 0
        self.pending = {}
        self.running = {}
        self.seen = {}

    def submit(self, key, task, reason):
        if task["size"] <= 0:
            return False
        if key in self.pending or key in self.running:
            return False
        previous = self.seen.get(key)
        if previous is not None and not (reason == "delete" and previous == ("receive", "failed")):
            return False
        if len(self.pending) >= DM_MEDIA_PENDING or self.used + task["size"] > self.budget:
            return False
        self.used += task["size"]
        self.pending[key] = (task, reason)
        self.seen[key] = (reason, "queued")
        while len(self.seen) > DM_MEDIA_RECENT:
            old = next((k for k in self.seen if k not in self.pending and k not in self.running), None)
            if old is None:
                break
            self.seen.pop(old)
        return True

    def take(self):
        if not self.pending or len(self.running) >= DM_MEDIA_PARALLEL:
            return None
        key = next(iter(self.pending))
        item = self.pending.pop(key)
        self.running[key] = item
        return key, item[0], item[1]

    def finish(self, key, success):
        item = self.running.pop(key, None)
        if item is not None:
            self.seen[key] = (item[1], "done" if success else "failed")
        return item

    def clear(self):
        self.pending.clear()
        self.running.clear()
        self.seen.clear()
        # Do not refund bytes when disabling/re-enabling during this plugin session.


class MultiToolsPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self._lock = threading.RLock()
        self._mutes = MuteStore()
        self._mutes_loaded = False
        self._labels = None
        self._handled = {}
        self._command_guard = {}
        self._command_echo = {}
        self._own_notices = {}
        self._observer = None
        self._observed = set()
        self._observing = set()
        self._mute_queue = {}
        self._ghosted = set()
        self._mute_flush_pending = False
        self._active = True
        self._spam_runs = {}
        self._spam_last = {}
        self._dm_store = DeletedStore()
        self._updater = None
        self._dm_cfg_cache = None
        self._dm_pend = {}
        self._dm_clear = {}
        self._dm_migr = {}
        self._dm_dimmed = {}
        self._dm_dedup = {}
        self._dm_factories = {}
        self._dm_live = {}
        self._dm_preview_views = []
        self._dm_listeners = []
        self._dm_master_native = {}
        self._dm_info_views = {}
        self._dm_palette_views = []
        self._dm_master_rows = []
        self._dm_ticks = []
        self._dm_media_queue = MediaDownloadQueue()
        self._dm_media_recent = {}
        self._dm_media_watched = {}
        self._dm_media_timer = None
        self._dm_media_generation = 0
        self._dm_media_notice_at = -100.0
        self._dm_media_error_at = -100.0
        self._dm_store_notice_at = -100.0


    def _ensure_state(self):
        if not self._mutes_loaded:
            self._reload_mutes()
        if self._labels is None:
            self._load_labels()

    def _reload_mutes(self):
        try:
            raw = self.get_setting(SETTING_MUTES, "")
            self._mutes = MuteStore(raw if isinstance(raw, str) else "")
            self._mutes_loaded = True
        except Exception:
            pass

    def _persist_mutes(self, reload_settings=False):
        payload = self._mutes.dump()
        try:
            self.set_setting(SETTING_MUTES, payload, reload_settings)
            return str(self.get_setting(SETTING_MUTES, "")) == payload
        except Exception:
            return False

    def _load_labels(self):
        data = {}
        try:
            parsed = json.loads(self.get_setting(SETTING_LABELS, "") or "{}")
            if isinstance(parsed, dict):
                for key, value in parsed.items():
                    if isinstance(value, dict):
                        data[key] = {"n": str(value.get("n", ""))[:96], "u": str(value.get("u", ""))[:64]}
        except Exception:
            pass
        self._labels = data

    def _remember_label(self, account, user_id, user):
        if user is None:
            return
        entry = {"n": tidy_text(display_name(user)), "u": public_username(user)}
        if not entry["n"] and not entry["u"]:
            return
        key = mute_key(account, user_id)
        with self._lock:
            if self._labels.get(key) == entry:
                return
            self._labels[key] = entry
            live = {mute_key(a, u) for a, _d, users in self._mutes.entries() for u in users}
            live.add(key)
            self._labels = {k: v for k, v in self._labels.items() if k in live}
            payload = json.dumps(self._labels, ensure_ascii=False, sort_keys=True)
        try:
            self.set_setting(SETTING_LABELS, payload)
        except Exception:
            pass

    def _stored_label(self, account, user_id):
        with self._lock:
            return (self._labels or {}).get(mute_key(account, user_id)) or {}

    def _user_label(self, account, user_id):
        user = self._get_user(account, user_id)
        stored = self._stored_label(account, user_id)
        name = tidy_text(display_name(user)) or stored.get("n", "")
        username = public_username(user) or stored.get("u", "")
        sub = ("@%s · " % username if username else "") + "ID %d" % int(user_id)
        return name or "ID %d" % int(user_id), sub

    def _get_user(self, account, user_id):
        try:
            return get_messages_controller(int(account)).getUser(jlong(user_id))
        except Exception:
            return None

    def _get_chat(self, account, chat_id):
        try:
            return get_messages_controller(int(account)).getChat(jlong(chat_id))
        except Exception:
            return None

    def _dialog_title(self, account, dialog_id, with_account):
        dialog_id = int(dialog_id)
        if dialog_id > 0:
            name = tidy_text(display_name(self._get_user(account, dialog_id))) \
                or self._stored_label(account, dialog_id).get("n", "")
            title = "Личка · %s" % (name or "ID %d" % dialog_id)
        else:
            chat = self._get_chat(account, -dialog_id)
            name = tidy_text(getattr(chat, "title", "") or "") if chat is not None else ""
            title = "Чат · %s" % (name or "ID %d" % dialog_id)
        return "%s · акк. %d" % (title, int(account) + 1) if with_account else title


    def on_plugin_load(self):
        self._active = True
        self._reload_mutes()
        self._load_labels()
        try:
            self.add_on_send_message_hook()
        except Exception:
            pass
        for name in NEW_MESSAGE_UPDATES + SHORT_MESSAGE_UPDATES:
            try:
                self.add_hook(name)
            except Exception:
                pass
        self._register_observers()
        self._dm_cfg_cache = None
        try:
            self._dm_store.load()
        except Exception:
            pass
        try:
            self._dm_install()
        except Exception:
            pass
        try:
            self._dm_purge_own()
        except Exception:
            pass

    def on_plugin_unload(self):
        self._unregister_observers()
        self._active = False
        ui(self._dm_media_stop)
        self._dm_cfg_cache = None
        try:
            self._dm_store.flush_now()
        except Exception:
            pass
        with self._lock:
            for table in (self._handled, self._command_guard, self._command_echo,
                          self._own_notices, self._spam_runs, self._spam_last):
                table.clear()
        try:
            self._dm_unload_ui()
        except Exception:
            pass

    def _dm_unload_ui(self):
        ticks, self._dm_ticks = self._dm_ticks, []
        dimmed = dict(self._dm_dimmed)

        def _run():
            for cell, tick in ticks:
                try:
                    cell.removeCallbacks(tick)
                except Exception:
                    pass
            if not dimmed:
                return
            try:
                fragment = get_last_fragment()
                list_view = fragment.getChatListView() if fragment is not None and \
                    str(fragment.getClass().getName()) == "org.telegram.ui.ChatActivity" else None
                if list_view is not None:
                    for i in range(int(list_view.getChildCount())):
                        view = list_view.getChildAt(i)
                        key = ident(view)
                        if key in dimmed:
                            view.setAlpha(1.0)
            except Exception:
                pass
        ui(_run)
        for table in (self._dm_dimmed, self._dm_pend, self._dm_clear,
                      self._dm_migr, self._dm_dedup, self._dm_live, self._dm_info_views):
            table.clear()
        self._dm_preview_views = []
        self._dm_palette_views = []
        self._dm_master_rows = []
        self._dm_master_native = {}
        self._dm_listeners = []

    def _account_list(self):
        result = []
        try:
            for index in range(int(UserConfig.MAX_ACCOUNT_COUNT)):
                try:
                    if UserConfig.getInstance(index).isClientActivated():
                        result.append(index)
                except Exception:
                    pass
        except Exception:
            pass
        return result

    def _register_observers(self, accounts=None):
        with self._lock:
            wanted = accounts if accounts is not None else self._account_list()
            targets = [int(a) for a in wanted
                       if int(a) not in self._observed and int(a) not in self._observing]
            self._observing.update(targets)
        if not targets:
            return

        def _run():
            with self._lock:
                self._observing.difference_update(targets)
                if not self._active:
                    return
                try:
                    if self._observer is None:
                        self._observer = observer_class()(self)
                    observer = self._observer
                except Exception:
                    return
            for account in targets:
                try:
                    for event in (NotificationCenter.didReceiveNewMessages,
                                  NotificationCenter.fileLoaded, NotificationCenter.fileLoadFailed):
                        NotificationCenter.getInstance(account).addObserver(observer, event)
                    with self._lock:
                        self._observed.add(account)
                except Exception:
                    pass

        ui(_run)

    def _unregister_observers(self):
        with self._lock:
            self._active = False
            observer, targets = self._observer, sorted(self._observed)
            self._observed.clear()
            self._observing.clear()
            self._observer = None
        if observer is None or not targets:
            return

        def _run():
            for account in targets:
                try:
                    for event in (NotificationCenter.didReceiveNewMessages,
                                  NotificationCenter.fileLoaded, NotificationCenter.fileLoadFailed):
                        NotificationCenter.getInstance(account).removeObserver(observer, event)
                except Exception:
                    pass

        try:
            run_on_ui_thread(_run)
        except Exception:
            pass

    def _ensure_observer(self, account):
        with self._lock:
            known = int(account) in self._observed
        if not known:
            self._register_observers([int(account)])


    def create_settings(self):
        self._ensure_state()
        cmd = self._command_text
        nv_on = self.get_setting("nv_enabled", True)
        dm_on = self.get_setting("dm_enabled", True)
        on_off = lambda v: "включено" if v else "выключено"
        return [
            Header(text="Команды в чате"),
            Text(
                text="Мут",
                subtext=cmd("mute"),
                icon="msg_mute",
                create_sub_fragment=self._page_mute,
                link_alias="mute",
            ),
            Text(
                text="Удаление",
                subtext="%s N · последние сообщения" % cmd("del"),
                icon="msg_delete",
                create_sub_fragment=self._page_del,
                link_alias="del",
            ),
            Text(
                text="Спам",
                subtext="%s N текст · повтор сообщения" % cmd("spam"),
                icon="msg_forward",
                create_sub_fragment=self._page_spam,
                link_alias="spam",
            ),
            Divider(text="Команда не уходит собеседнику — её перехватывает плагин"),
            Header(text="Автоматически"),
            Text(
                text="Удалённые",
                subtext=on_off(dm_on).capitalize(),
                icon="msg_archive",
                create_sub_fragment=self._page_deleted,
                link_alias="deleted",
            ),
            Text(
                text="No Via",
                subtext=on_off(nv_on).capitalize(),
                icon="msg_bot",
                create_sub_fragment=self._page_no_via,
                link_alias="no_via",
            ),
            Divider(),
            Header(text="Общее"),
            Text(
                text="Команды",
                subtext="Префикс «%s» и имена команд" % self._command_config()["prefix"],
                icon="msg_edit",
                create_sub_fragment=self._page_commands,
                link_alias="commands",
            ),
            Divider(),
            Header(text="Обновления"),
            Text(
                text="Проверить обновления",
                subtext="Установлена версия %s" % __version__,
                icon="msg_download",
                on_click=self._on_check_updates,
            ),
            Divider(text="MultiTools %s · автор @darkaxq" % __version__),
        ]

    def _on_check_updates(self, *_args):
        try:
            if self._updater is None:
                self._updater = build_updater(__id__, __version__)
            self._updater.check()
        except Exception as exc:
            toast_err("Проверка не запущена: " + type(exc).__name__)

    def _page_mute(self):
        self._ensure_state()
        cmd = self._command_text("mute")
        silent = self.get_setting("mute_silent", True)
        total = self._mutes.total()
        items = [
            Header(text="Основное"),
            Switch(key="mute_enabled", text="Мут", default=True,
                   subtext="%s @user, ответом или в личке без аргумента" % cmd, icon="msg_mute"),
            Text(text="Замученные", subtext=("Всего: %d" % total) if total else "Пока никого",
                 icon="msg_contacts", create_sub_fragment=self._page_mute_list),
            Divider(text="Размут — %s тем же способом" % self._command_text("unmute")),
            Header(text="Сообщения замученных"),
            Selector(key="mute_mode", text="Где удалять", default=MODE_ONLY_ME,
                     items=DELETE_MODES, icon="msg_delete"),
            Switch(key="mute_edits", text="Удалять правки", default=True,
                   subtext="Изменённые сообщения тоже исчезают", icon="msg_edit"),
            Divider(text="«У всех» работает только с правами администратора"),
            Header(text="Уведомления"),
            Switch(key="mute_silent", text="Тихий режим", default=True,
                   subtext="Не писать в чат о муте и размуте", icon="msg_notifications",
                   on_change=lambda v: self.set_setting("mute_silent", bool(v), True)),
        ]
        if not silent:
            items += [
                Input(key="mute_notice", text="Текст мута", default=DEFAULT_NOTICE, icon="msg_text"),
                Input(key="unmute_notice", text="Текст размута", default=DEFAULT_UNMUTE_NOTICE,
                      icon="msg_text"),
                Divider(text="{name} заменится на @username или ID"),
            ]
        else:
            items.append(Divider())
        items += [
            Text(text="Снять все муты", icon="msg_clear", red=True, on_click=self._on_clear_mutes),
            Divider(text="Во всех чатах и аккаунтах"),
        ]
        return items

    def _page_mute_list(self):
        self._ensure_state()
        with self._lock:
            entries = self._mutes.entries()
        if not entries:
            cmd = self._command_text("mute")
            return [
                Header(text="Замученные"),
                Text(text="Пока никого", icon="msg_info"),
                Divider(text="Отправьте %s @user или ответьте %s на сообщение" % (cmd, cmd)),
            ]
        items = []
        multi = len({a for a, _d, _u in entries}) > 1
        for index, (account, dialog_id, users) in enumerate(entries):
            if index:
                items.append(Divider())
            items.append(Header(text=self._dialog_title(account, dialog_id, multi)))
            for user_id in users:
                title, sub = self._user_label(account, user_id)
                items.append(Text(text=title, subtext=sub, icon="msg_mute",
                                  on_click=self._unmute_click(account, dialog_id, user_id)))
        items.append(Divider(text="Нажмите на пользователя, чтобы снять мут · всего: %d" % self._mutes.total()))
        return items

    def _page_del(self):
        cmd = self._command_text("del")
        return [
            Header(text="Основное"),
            Switch(key="del_enabled", text="Удаление", default=True,
                   subtext="%s N — последние N сообщений" % cmd, icon="msg_delete"),
            Switch(key="del_silent", text="Тихий режим", default=True,
                   subtext="Отчёт только у вас, без сообщения в чат", icon="msg_notifications"),
            Divider(text="Ответьте командой на сообщение — удаление начнётся с него"),
            Header(text="Параметры"),
            Selector(key="del_scope", text="Чьи сообщения", default=SCOPE_ALL,
                     items=SCOPE_LABELS, icon="msg_contacts"),
            Selector(key="del_mode", text="Где удалять", default=MODE_ONLY_ME,
                     items=DELETE_MODES, icon="msg_list"),
            Input(key="del_max", text="Максимум за раз (1–%d)" % HARD_LIMIT,
                  default=str(DEFAULT_MAX_DELETE), icon="msg_text",
                  on_change=self._number_check(1, HARD_LIMIT, False)),
            Divider(text="«У всех» работает только с правами администратора"),
        ]

    def _page_spam(self):
        cmd = self._command_text("spam")
        return [
            Header(text="Основное"),
            Switch(key="spam_enabled", text="Спам", default=True,
                   subtext="%s 5 привет — отправит «привет» 5 раз" % cmd, icon="msg_forward"),
            Divider(),
            Header(text="Ограничения"),
            Input(key="spam_max", text="Максимум сообщений (1–%d)" % SPAM_MAX_LIMIT,
                  default=str(DEFAULT_SPAM_MAX), icon="msg_text",
                  on_change=self._number_check(1, SPAM_MAX_LIMIT, False)),
            Input(key="spam_delay", text="Задержка, сек (0–%d)" % SPAM_DELAY_MAX,
                  default=str(DEFAULT_SPAM_DELAY), icon="msg_recent",
                  on_change=self._number_check(0, SPAM_DELAY_MAX, True)),
            Input(key="spam_cooldown", text="Кулдаун в чате, сек (0–%d)" % SPAM_COOLDOWN_MAX,
                  default=str(DEFAULT_SPAM_COOLDOWN), icon="msg_timer",
                  on_change=self._number_check(0, SPAM_COOLDOWN_MAX, False)),
            Divider(text="Задержка — между сообщениями, кулдаун — между запусками"),
        ]

    def _page_commands(self):
        keys = {"prefix": "cmd_prefix", "mute": "cmd_mute", "unmute": "cmd_unmute",
                "del": "cmd_del", "spam": "cmd_spam"}
        icons = {"prefix": "msg_edit", "mute": "msg_mute", "unmute": "msg_unmute",
                 "del": "msg_delete", "spam": "msg_forward"}

        def _row(field, label):
            return Input(key=keys[field], text=label, default=DEFAULT_COMMANDS[field],
                         icon=icons[field], on_change=lambda _v: self._validate_commands())

        items = [Header(text="Префикс"), _row("prefix", "Префикс"),
                 Divider(text="Пробел после префикса не важен: «. mute» = «.mute»"),
                 Header(text="Команды")]
        for field, label in COMMAND_FIELDS[1:]:
            items.append(_row(field, label))
        items += [
            Divider(text="Без пробелов, не совпадают друг с другом и не содержат префикс"),
            Text(text="Сбросить команды", icon="msg_retry", red=True, on_click=self._on_commands_reset),
            Divider(text="По умолчанию: .mute .unmute .del .spam"),
        ]
        return items

    def _page_no_via(self):
        bots = self._nv_bots()
        whitelist = self.get_setting("nv_mode", NV_BLACKLIST) == NV_WHITELIST
        if bots:
            shown = ", ".join("@" + b for b in bots[:3]) + (" и ещё %d" % (len(bots) - 3) if len(bots) > 3 else "")
        else:
            shown = "Пусто · нажмите, чтобы добавить"
        clean_on = self.get_setting("nv_clean_titles", True)
        return [
            Header(text="Основное"),
            Switch(key="nv_enabled", text="Убирать «via @bot»", default=True,
                   subtext="Результат inline-бота уйдёт как ваше сообщение", icon="msg_bot"),
            Selector(key="nv_mode", text="Режим", default=NV_BLACKLIST,
                     items=["Все, кроме списка", "Только из списка"], icon="msg_list",
                     on_change=lambda i: self.set_setting("nv_mode", int(i), True)),
            Text(text="Разрешённые боты" if whitelist else "Исключения", subtext=shown,
                 icon="msg_contacts" if whitelist else "msg_block", create_sub_fragment=self._page_nv_bots),
            Switch(key="nv_keep_action", text="Не трогать шёпот и игры", default=True,
                   subtext="Если у бота кнопки-действия, «via» остаётся", icon="msg_secret"),
            Divider(),
            Header(text="Очистка"),
            Switch(key="nv_strip_caption", text="Удалять подпись бота", default=True,
                   subtext="Текст бота под аудио, фото и видео", icon="msg_edit"),
            Switch(key="nv_url_buttons", text="Кнопки-ссылки в текст", default=True,
                   subtext="Ссылки из кнопок добавятся в подпись", icon="msg_link"),
            Text(text="Названия треков", subtext="Включено" if clean_on else "Выключено",
                 icon="msg_filled_menu_music", create_sub_fragment=self._page_nv_music),
            Divider(),
            Header(text="Прочее"),
            Switch(key="nv_fallback", text="Запасной режим", default=True,
                   subtext="Если без бота отправить нельзя — отправить с «via»", icon="msg_retry"),
            Divider(text="Иначе такой результат не отправится"),
        ]

    def _page_nv_music(self):
        return [
            Header(text="Названия треков"),
            Switch(key="nv_clean_titles", text="Чистить названия", default=True,
                   subtext="(Official Audio), [prod. …], сайты, @каналы, эмодзи", icon="msg_filled_menu_music"),
            Switch(key="nv_clean_download", text="Скачивать перед отправкой", default=True,
                   subtext="Без этого название не поменять", icon="msg_download"),
            Switch(key="nv_remove_feat", text="Убирать feat.", default=False,
                   subtext="«Трек (feat. Кто-то)» → «Трек»", icon="msg_contacts"),
            Divider(),
            Header(text="Свои слова"),
            Input(key="nv_clean_words", text="Слова через запятую", default="", icon="msg_clear"),
            Divider(text="Название меняется только при повторной загрузке файла"),
        ]

    def _page_nv_bots(self):
        bots = self._nv_bots()
        whitelist = self.get_setting("nv_mode", NV_BLACKLIST) == NV_WHITELIST
        items = [
            Header(text="Добавить"),
            Input(key="nv_new_bot", text="Юзернейм бота", default="", icon="msg_add",
                  on_change=self._nv_on_new_bot),
            Divider(text="Можно несколько через запятую"),
            Header(text="Только эти боты" if whitelist else "Исключения"),
        ]
        if bots:
            for bot in bots:
                items.append(Text(text="@" + bot, subtext="Нажмите, чтобы убрать", icon="msg_bot",
                                  on_click=lambda _v, n=bot: self._nv_remove_bot(n)))
        else:
            items.append(Text(text="Список пуст", icon="msg_info"))
        recent = [r for r in self._nv_recent() if r not in bots]
        if recent:
            items += [Divider(), Header(text="Недавние inline-боты")]
            for bot in recent:
                items.append(Text(text="@" + bot, subtext="Нажмите, чтобы добавить", icon="msg_add",
                                  accent=True, on_click=lambda _v, n=bot: self._nv_add_bot(n)))
        if bots:
            items += [Divider(), Text(text="Очистить список", icon="msg_clear", red=True,
                                      on_click=lambda _v: self._nv_save_bots([]))]
        items.append(Divider())
        return items

    def _reload_settings(self):
        try:
            self.set_setting("_ui_tick", str(time.time()), True)
        except Exception:
            pass

    def _number_check(self, minimum, maximum, fraction):
        pattern = r"^[0-9]{1,3}([.,][0-9])?$" if fraction else r"^[0-9]{1,3}$"

        def _check(value):
            raw = str(value or "").strip()
            ok = bool(re.match(pattern, raw)) and minimum <= float(raw.replace(",", ".")) <= maximum
            if not ok:
                toast_err("Нужно число от %d до %d" % (minimum, maximum))
        return _check

    def _int_setting(self, key, default, minimum, maximum):
        try:
            value = int(str(self.get_setting(key, str(default))).strip())
        except Exception:
            value = default
        return max(minimum, min(maximum, value))

    def _float_setting(self, key, default, minimum, maximum):
        try:
            value = round(float(str(self.get_setting(key, str(default))).strip().replace(",", ".")), 1)
        except Exception:
            value = default
        return max(minimum, min(maximum, value))

    def _choice(self, key, default, allowed):
        try:
            value = int(self.get_setting(key, default))
        except Exception:
            return default
        return value if value in allowed else default

    def _validate_commands(self):
        _cfg, error = check_command_config(self._read_commands())
        if error:
            toast_err(error + " · работают команды по умолчанию")

    def _on_commands_reset(self, _view=None):
        for field in COMMAND_FIELDS:
            self.set_setting("cmd_" + field[0], DEFAULT_COMMANDS[field[0]])
        self._reload_settings()
        toast_ok("Команды сброшены")

    def _read_commands(self):
        return {f: self.get_setting("cmd_" + f, DEFAULT_COMMANDS[f]) for f, _l in COMMAND_FIELDS}

    def _command_config(self):
        config, _error = check_command_config(self._read_commands())
        return config or dict(DEFAULT_COMMANDS)

    def _command_text(self, action):
        cfg = self._command_config()
        return cfg["prefix"] + cfg[action]

    def _unmute_click(self, account, dialog_id, user_id):
        def _click(_view=None):
            title, _sub = self._user_label(account, user_id)
            with self._lock:
                changed = self._mutes.remove(account, dialog_id, user_id)
                saved = self._persist_mutes(True) if changed else True
            if not changed:
                toast_info("Этот мут уже снят")
            elif not saved:
                toast_err("Мут снят, но не сохранился")
            else:
                toast_ok("Мут снят: %s" % title)
        return _click

    @staticmethod
    def _confirm(title, message, ok_text, action):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment is not None else None
        if activity is None:
            toast_err("Не удалось показать подтверждение — действие отменено")
            return

        def _ok(dialog, _which):
            try:
                dialog.dismiss()
            except Exception:
                pass
            try:
                action()
            except Exception:
                pass

        builder = AlertDialogBuilder(activity)
        builder.set_title(title)
        builder.set_message(message)
        builder.set_positive_button(ok_text, _ok)
        builder.set_negative_button("Отмена", lambda d, _w: d.dismiss())
        builder.set_cancelable(True)
        builder.show()

    def _on_clear_mutes(self, _view=None):
        self._confirm("Снять все муты?", "Списки очистятся во всех чатах и аккаунтах.", "Очистить",
                      self._clear_mutes_now)

    def _clear_mutes_now(self):
        with self._lock:
            self._mutes.clear()
            saved = self._persist_mutes(True)
        (toast_ok if saved else toast_err)("Муты сняты" if saved else "Не удалось сохранить")


    def _prune(self, now):
        with self._lock:
            if len(self._command_guard) + len(self._command_echo) + len(self._own_notices) + len(self._handled) < 128:
                return
            for table, ttl in ((self._command_guard, GUARD_TTL), (self._command_echo, COMMAND_ECHO_TTL),
                               (self._own_notices, GUARD_TTL), (self._handled, HANDLED_TTL)):
                for key in [k for k, ts in table.items() if now - ts > ttl]:
                    table.pop(key, None)

    def _mark_handled(self, account, dialog_id, message_id):
        key = (int(account), int(dialog_id), int(message_id))
        now = time.time()
        with self._lock:
            seen = self._handled.get(key)
            if seen is not None and now - seen < HANDLED_TTL:
                return False
            self._handled[key] = now
        return True

    def _my_id(self, account):
        try:
            return int(get_user_config(int(account)).getClientUserId() or 0)
        except Exception:
            return 0


    def on_send_message_hook(self, account, params):
        try:
            self._ensure_state()
            self._ensure_observer(account)
            text = getattr(params, "message", None)
            if isinstance(text, str) and text:
                result = self._command_hook(account, params, text)
                if result is not None:
                    return result
            fixed = self._dm_reply_fix(account, params)
            result = self._no_via_hook(account, params)
            if fixed and getattr(result, "strategy", None) not in (HookStrategy.CANCEL, HookStrategy.MODIFY):
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            return result
        except Exception:
            return HookResult()

    def _dm_reply_fix(self, account, params):
        try:
            reply = getattr(params, "replyToMsg", None)
            if reply is None or not self._dm_obj_deleted(account, reply):
                return False
            reply_id = int(reply.getId())
            quote_text = ""
            quote = getattr(params, "quote", None)
            if quote is not None:
                try:
                    quote_text = str(getattr(quote, "text", None) or "")
                except Exception:
                    quote_text = ""
            if not quote_text:
                try:
                    quote_text = str(reply.messageOwner.message or "")
                except Exception:
                    quote_text = ""
            if not quote_text:
                quote_text = "Удалённое сообщение (медиа)"
            quote_text = quote_text.strip()[:DM_QUOTE_MAX]
            field = "message"
            if getattr(params, "message", None) is None:
                field = "caption"
            body = getattr(params, field, None) or ""
            new_text = quote_text + ("\n" + body if body else "")
            shift = utf16_len(quote_text) + (1 if body else 0)
            entities = ArrayList()
            old = getattr(params, "entities", None)
            if old is not None:
                for ent in jlist(old):
                    try:
                        ent.offset = int(ent.offset) + shift
                        entities.add(ent)
                    except Exception:
                        pass
            block = TLRPC.TL_messageEntityBlockquote()
            block.offset = 0
            block.length = utf16_len(quote_text)
            entities.add(0, block)
            setattr(params, field, new_text)
            params.entities = entities
            params.replyToMsg = None
            try:
                params.quote = None
            except Exception:
                pass
            top = getattr(params, "replyToTopMsg", None)
            if top is not None and int(top.getId()) == reply_id:
                params.replyToTopMsg = None
            return True
        except Exception:
            return False

    def _command_hook(self, account, params, text):
        dialog_id = int(getattr(params, "peer", 0) or 0)
        key = (int(account), dialog_id, text)
        with self._lock:
            stamp = self._own_notices.pop(key, None)
        if stamp is not None and time.time() - stamp <= COMMAND_ECHO_TTL:
            return HookResult()
        parsed = parse_command(text, self._command_config())
        if parsed is None or dialog_id == 0 or is_special_dialog(dialog_id):
            return None
        action, arg = parsed
        group = "mute" if action in ("mute", "unmute") else action
        if not self.get_setting(group + "_enabled", True):
            return None
        if not self._claim_command(account, dialog_id, text):
            return HookResult(strategy=HookStrategy.CANCEL)
        if group == "mute":
            self._handle_mute(account, dialog_id, arg, params, action == "unmute")
        elif action == "del":
            self._handle_del(account, dialog_id, arg, params)
        else:
            self._handle_spam(account, dialog_id, arg)
        return HookResult(strategy=HookStrategy.CANCEL)

    def _claim_command(self, account, dialog_id, text):
        now = time.time()
        self._prune(now)
        key = (int(account), int(dialog_id), text.strip().lower())
        with self._lock:
            seen = self._command_guard.get(key)
            if seen is not None and now - seen < DEDUP_WINDOW:
                return False
            self._command_guard[key] = now
            self._command_echo[key] = now
        return True

    def _send_notice(self, account, dialog_id, text):
        value = tidy_text(text)
        if not value:
            return
        with self._lock:
            self._own_notices[(int(account), int(dialog_id), value)] = time.time()

        def _send():
            try:
                send_text(int(dialog_id), value, account=int(account))
            except Exception:
                pass
        ui(_send)

    def _report(self, account, dialog_id, silent, text, kind="error"):
        _bulletin(kind, text)
        if not silent:
            self._send_notice(account, dialog_id, text)

    @staticmethod
    def _explicit_reply(params):
        reply = getattr(params, "replyToMsg", None)
        top = getattr(params, "replyToTopMsg", None)
        if reply is None or top is None:
            return reply
        if reply is top:
            return None
        try:
            if int(reply.getId()) == int(top.getId()):
                return None
        except Exception:
            pass
        return reply

    @staticmethod
    def _reply_in_dialog(reply, dialog_id):
        try:
            value = int(reply.getDialogId() or 0)
        except Exception:
            return False
        return value in (0, int(dialog_id))


    def _handle_mute(self, account, dialog_id, arg, params, unmute):
        silent = bool(self.get_setting("mute_silent", True))
        cmd = self._command_text("unmute" if unmute else "mute")
        done = lambda target: self._finish_mute(account, dialog_id, target, unmute, silent)

        if arg:
            username = parse_username(arg)
            if username is None:
                self._report(account, dialog_id, silent, "Использование: %s @username" % cmd)
            else:
                self._resolve_username(account, username, done)
            return

        reply = self._explicit_reply(params)
        if reply is not None:
            if not self._reply_in_dialog(reply, dialog_id):
                self._report(account, dialog_id, silent, "Ответьте на сообщение в этом чате")
                return
            try:
                user_id = int(reply.getSenderId() or 0)
            except Exception:
                user_id = 0
            if user_id <= 0:
                self._report(account, dialog_id, silent, "Не удалось определить автора")
            else:
                done(user_id)
            return

        if dialog_id > 0 and dialog_id != self._my_id(account):
            done(dialog_id)
            return
        self._report(account, dialog_id, silent, "В группе: %s @username или ответом" % cmd)

    def _resolve_username(self, account, username, callback):
        try:
            user = get_messages_controller(int(account)).getUser(username)
        except Exception:
            user = None
        if user is not None:
            callback(user)
            return
        request = TLRPC.TL_contacts_resolveUsername()
        request.username = username

        def _on_response(response, error):
            target = None if error is not None else first_user(response)
            ui(lambda: callback(target))

        try:
            send_request(request, _on_response, account=int(account))
        except Exception:
            callback(None)

    def _finish_mute(self, account, dialog_id, target, unmute, silent):
        try:
            user = target if hasattr(target, "id") else None
            user_id = int(getattr(user, "id", 0) or 0) if user is not None else int(target or 0)
            if user_id <= 0:
                self._report(account, dialog_id, silent, "Пользователь не найден")
                return
            if user_id == self._my_id(account):
                self._report(account, dialog_id, silent, "Себя заглушить нельзя")
                return
            if user is None:
                user = self._get_user(account, user_id)
            identity = notice_identity(user, user_id)

            with self._lock:
                changed = (self._mutes.remove if unmute else self._mutes.add)(account, dialog_id, user_id)
                saved = self._persist_mutes() if changed else True
            if changed and not unmute:
                self._remember_label(account, user_id, user)
            if not saved:
                self._report(account, dialog_id, silent, "Изменение не сохранилось")
                return

            if unmute:
                toast_ok("Мут снят: %s" % identity if changed else "Пользователь не был замучен")
                template, fallback = self.get_setting("unmute_notice", DEFAULT_UNMUTE_NOTICE), DEFAULT_UNMUTE_NOTICE
            else:
                toast_ok("Замучен: %s" % identity if changed else "Уже замучен в этом чате")
                template, fallback = self.get_setting("mute_notice", DEFAULT_NOTICE), DEFAULT_NOTICE
            if changed and not silent:
                self._send_notice(account, dialog_id, render_template(template, identity, fallback))
        except Exception:
            self._report(account, dialog_id, silent, "Не удалось выполнить мут")


    def handle_new_messages(self, account, args):
        try:
            if args is None or not self._active or len(args) < 2:
                return
            if len(args) > 2 and bool(args[2]):
                return
            if len(args) > 3 and int(args[3] or 0) != 0:
                return
            ids = []
            ghosts = []
            for obj in jlist(args[1]):
                if obj is None:
                    continue
                owner = getattr(obj, "messageOwner", None)
                if bool(obj.isOut()):
                    if owner is not None:
                        self._drop_command_echo(account, owner)
                    continue
                self._dm_media_receive(account, owner)
                message_id = int(obj.getId() or 0)
                dialog_id = int(obj.getDialogId() or 0)
                if self._should_delete(account, dialog_id, int(obj.getSenderId() or 0),
                                       message_id, False, getattr(owner, "action", None) is not None):
                    ids.append(message_id)
                elif self._take_ghost(account, dialog_id, message_id):
                    ghosts.append(message_id)
            if ids:
                self._delete_muted(account, int(args[0]), ids)
            if ghosts:
                acc, did = int(account), int(args[0])
                run_on_ui_thread(lambda: self._post_deleted(acc, did, ghosts))
        except Exception:
            pass

    def _muted_obj(self, obj):
        try:
            if obj is None or bool(obj.isOut()):
                return False
            owner = getattr(obj, "messageOwner", None)
            if owner is None or getattr(owner, "action", None) is not None:
                return False
            dialog_id = int(obj.getDialogId() or 0)
            sender_id = int(obj.getSenderId() or 0)
            if dialog_id == 0 or sender_id <= 0 or is_special_dialog(dialog_id):
                return False
            with self._lock:
                return sender_id in self._mutes.users(int(obj.currentAccount), dialog_id)
        except Exception:
            return False

    def _mute_filter(self, kind, param, returns_value):
        if not self._active or not self.get_setting("mute_enabled", True):
            return
        with self._lock:
            if not self._mutes.total():
                return
        index = MUTE_FILTER_ARG[kind]
        if len(param.args) <= index:
            return
        items = jlist(param.args[index])
        if not items:
            return
        kept = [obj for obj in items if not self._muted_obj(obj)]
        if len(kept) == len(items):
            return
        array = ArrayList()
        for obj in kept:
            array.add(obj)
        param.args[index] = array

    def _intercept(self, account, dialog_id, sender_id, message_id, edited, service):
        if self._should_delete(account, dialog_id, sender_id, message_id, edited, service):
            self._delete_muted(account, dialog_id, [message_id], early=True)
        return False

    def on_update_hook(self, update_name, account, update):
        try:
            self._ensure_state()
            self._ensure_observer(account)
            if update_name in SHORT_MESSAGE_UPDATES:
                return self._handle_short_update(update_name, account, update)
            message = getattr(update, "message", None)
            if message is None:
                return HookResult()
            self._dm_media_receive(account, message)
            edited = update_name in EDIT_UPDATES
            if bool(getattr(message, "out", False)):
                if not edited:
                    self._drop_command_echo(account, message)
                return HookResult()
            self._intercept(account, message_dialog_id(message), message_sender_id(message),
                            int(getattr(message, "id", 0) or 0), edited,
                            getattr(message, "action", None) is not None)
        except Exception:
            pass
        return HookResult()

    def on_updates_hook(self, container_name, account, updates):
        try:
            self._ensure_state()
            self._ensure_observer(account)
            if container_name in SHORT_MESSAGE_UPDATES:
                return self._handle_short_update(container_name, account, updates)
        except Exception:
            pass
        return HookResult()

    def _handle_short_update(self, name, account, update):
        if update is None or bool(getattr(update, "out", False)):
            return HookResult()
        message_id = int(getattr(update, "id", 0) or 0)
        if name == "TL_updateShortMessage":
            dialog_id = sender_id = int(getattr(update, "user_id", 0) or 0)
        else:
            chat_id = int(getattr(update, "chat_id", 0) or 0)
            dialog_id = -chat_id if chat_id else 0
            sender_id = int(getattr(update, "from_id", 0) or 0)
        self._intercept(account, dialog_id, sender_id, message_id, False, False)
        return HookResult()

    def _should_delete(self, account, dialog_id, sender_id, message_id, edited, service):
        if service or dialog_id == 0 or message_id <= 0 or sender_id <= 0 or is_special_dialog(dialog_id):
            return False
        with self._lock:
            if int(sender_id) not in self._mutes.users(account, dialog_id):
                return False
        if not self.get_setting("mute_enabled", True):
            return False
        if edited:
            return bool(self.get_setting("mute_edits", True))
        return self._mark_handled(account, dialog_id, message_id)

    def _take_ghost(self, account, dialog_id, message_id):
        key = (int(account), int(dialog_id), int(message_id))
        with self._lock:
            if key not in self._handled or key in self._ghosted:
                return False
            if len(self._ghosted) > 2000:
                self._ghosted.clear()
            self._ghosted.add(key)
        return True

    def _delete_muted(self, account, dialog_id, ids, early=False):
        batch = sorted({int(i) for i in ids if int(i) > 0}, reverse=True)
        if not batch:
            return
        key = (int(account), int(dialog_id))
        with self._lock:
            self._mute_queue.setdefault(key, set()).update(batch)
            if self._mute_flush_pending:
                return
            self._mute_flush_pending = True
        if early:
            run_on_ui_thread(lambda: run_on_ui_thread(self._flush_muted))
        else:
            run_on_ui_thread(self._flush_muted)

    def _flush_muted(self):
        with self._lock:
            queue, self._mute_queue = self._mute_queue, {}
            self._mute_flush_pending = False
        if not queue:
            return
        for_all = self._choice("mute_mode", MODE_ONLY_ME, (MODE_ONLY_ME, MODE_FOR_ALL)) == MODE_FOR_ALL
        for (account, dialog_id), ids in queue.items():
            batch = sorted(ids, reverse=True)
            try:
                self._delete_messages(account, dialog_id, batch, for_all)
            except Exception:
                continue
            self._post_deleted(account, dialog_id, batch)

    def _post_deleted(self, account, dialog_id, ids):
        try:
            channel_id = -int(dialog_id) if self._is_channel(account, dialog_id) else 0
            center = NotificationCenter.getInstance(int(account))
            args = (int_list(ids), Long(channel_id), Boolean(False))
            try:
                center.postNotificationNameInternal(NotificationCenter.messagesDeleted, True, *args)
            except Exception:
                center.postNotificationName(NotificationCenter.messagesDeleted, *args)
        except Exception:
            pass

    def _drop_command_echo(self, account, message):
        text = getattr(message, "message", None)
        if not isinstance(text, str):
            return
        dialog_id = message_dialog_id(message)
        key = (int(account), int(dialog_id), text.strip().lower())
        with self._lock:
            stamp = self._command_echo.pop(key, None)
        message_id = int(getattr(message, "id", 0) or 0)
        if stamp is None or time.time() - stamp > COMMAND_ECHO_TTL or message_id <= 0:
            return
        self._dispatch_delete(account, dialog_id, [message_id], True)


    def _loaded_messages(self, account, dialog_id):
        try:
            fragment = get_last_fragment()
            if fragment is None or int(fragment.getDialogId() or 0) != int(dialog_id):
                return None
            if int(fragment.getCurrentAccount()) != int(account) or int(fragment.getChatMode() or 0) != 0:
                return None
            return jlist(fragment.messages)
        except Exception:
            return None

    @staticmethod
    def _pick_ids(items, wanted, scope, anchor_id, dialog_id, from_objects):
        stats = {"seen": 0, "service": 0, "not_mine": 0, "newer": 0}
        found = set()
        for item in items:
            if item is None:
                continue
            stats["seen"] += 1
            try:
                if from_objects:
                    if bool(getattr(item, "isDateObject", False)):
                        stats["service"] += 1
                        continue
                    message_id = int(item.getId() or 0)
                    if int(item.getDialogId() or 0) != int(dialog_id):
                        continue
                    owner = getattr(item, "messageOwner", None)
                    out = bool(item.isOut())
                    try:
                        if bool(item.isSponsored()):
                            stats["service"] += 1
                            continue
                    except Exception:
                        pass
                else:
                    message_id = int(getattr(item, "id", 0) or 0)
                    owner = item
                    out = bool(getattr(item, "out", False))
                if message_id <= 0:
                    continue
                if anchor_id > 0 and message_id > anchor_id:
                    stats["newer"] += 1
                    continue
                if owner is None or getattr(owner, "action", None) is not None:
                    stats["service"] += 1
                    continue
                if scope == SCOPE_MINE and not out:
                    stats["not_mine"] += 1
                    continue
                found.add(message_id)
            except Exception:
                continue
        return sorted(found, reverse=True)[:int(wanted)], stats

    @staticmethod
    def _nothing_text(scope, stats):
        seen = stats.get("seen", 0)
        if not seen:
            return "Нечего удалять"
        if scope == SCOPE_MINE and stats.get("not_mine", 0):
            return "Среди последних %d сообщений ваших нет" % seen
        if stats.get("newer", 0) >= seen:
            return "Старее этого сообщения ничего нет"
        if stats.get("service", 0) >= seen:
            return "Последние сообщения служебные"
        return "Подходящих сообщений нет"

    def _handle_del(self, account, dialog_id, arg, params):
        silent = bool(self.get_setting("del_silent", True))
        limit = self._int_setting("del_max", DEFAULT_MAX_DELETE, 1, HARD_LIMIT)
        count = parse_count(arg, limit)
        if count is None:
            self._report(account, dialog_id, silent,
                         "Использование: %s N (1–%d)" % (self._command_text("del"), limit))
            return
        scope = self._choice("del_scope", SCOPE_ALL, (SCOPE_ALL, SCOPE_MINE))
        for_all = self._choice("del_mode", MODE_ONLY_ME, (MODE_ONLY_ME, MODE_FOR_ALL)) == MODE_FOR_ALL

        anchor_id = 0
        reply = self._explicit_reply(params)
        if reply is not None:
            if not self._reply_in_dialog(reply, dialog_id):
                self._report(account, dialog_id, silent, "Ответьте на сообщение в этом чате")
                return
            try:
                anchor_id = int(reply.getId() or 0)
            except Exception:
                anchor_id = 0
            if anchor_id <= 0:
                self._report(account, dialog_id, silent, "Не удалось определить сообщение")
                return

        report = (account, dialog_id, silent, count)
        loaded = self._loaded_messages(account, dialog_id)
        local_ids, local_stats = [], {"seen": 0}
        if loaded:
            local_ids, local_stats = self._pick_ids(loaded, count, scope, anchor_id, dialog_id, True)
            if len(local_ids) >= count:
                self._dispatch_delete(account, dialog_id, local_ids, for_all, report)
                return

        if getattr(params, "replyToTopMsg", None) is not None:
            if local_ids:
                self._dispatch_delete(account, dialog_id, local_ids, for_all, report)
            else:
                self._report(account, dialog_id, silent,
                             self._nothing_text(scope, local_stats) if local_stats.get("seen")
                             else "В теме удаляются только загруженные сообщения", "info")
            return

        try:
            request = TLRPC.TL_messages_getHistory()
            request.peer = get_messages_controller(int(account)).getInputPeer(int(dialog_id))
            if request.peer is None:
                raise ValueError("no input peer")
        except Exception:
            self._report(account, dialog_id, silent, "Не удалось запросить историю")
            return
        request.limit = min(count + EXTRA_FETCH, HARD_LIMIT)
        request.offset_id = anchor_id + 1 if anchor_id > 0 else 0
        request.add_offset = 0
        request.offset_date = 0
        request.max_id = 0
        request.min_id = 0
        request.hash = 0

        def _on_history(response, error):
            try:
                if error is not None:
                    self._report(account, dialog_id, silent,
                                 "Ошибка истории: %s" % (getattr(error, "text", "") or "неизвестно"))
                    return
                raw = getattr(response, "messages", None)
                ids, stats = self._pick_ids(jlist(raw), count, scope, anchor_id, dialog_id, False)
                if not ids:
                    self._report(account, dialog_id, silent, self._nothing_text(scope, stats), "info")
                    return
                self._dispatch_delete(account, dialog_id, ids, for_all, report)
            except Exception:
                self._report(account, dialog_id, silent, "Ошибка обработки истории")

        try:
            send_request(request, _on_history, account=int(account))
        except Exception:
            self._report(account, dialog_id, silent, "Не удалось запросить историю")

    def _dispatch_delete(self, account, dialog_id, ids, for_all, report=None):
        clean = sorted({int(i) for i in ids if int(i) > 0}, reverse=True)

        def _run():
            try:
                deleted = self._delete_messages(account, dialog_id, clean, for_all)
                error = None
            except Exception:
                deleted, error = 0, "клиент отклонил удаление"
            if report is None:
                return
            acc, dlg, silent, wanted = report
            if error:
                self._report(acc, dlg, silent, "Не удалось удалить: %s" % error)
            elif deleted != wanted:
                self._report(acc, dlg, silent, "Удалено %d %s из %d" % (deleted, plural_ru(deleted), wanted), "success")
            else:
                self._report(acc, dlg, silent, "Удалено %d %s" % (deleted, plural_ru(deleted)), "success")

        if clean:
            ui(_run)

    def _delete_messages(self, account, dialog_id, ids, for_all):
        controller = get_messages_controller(int(account))
        local_only = not for_all and self._is_channel(account, dialog_id)
        for start in range(0, len(ids), HARD_LIMIT):
            array = ArrayList()
            for message_id in ids[start:start + HARD_LIMIT]:
                array.add(Integer(int(message_id)))
            if local_only:
                controller.deleteMessages(array, None, None, int(dialog_id), 0, False, 0, True)
            else:
                controller.deleteMessages(array, None, None, int(dialog_id), 0, bool(for_all), 0)
        return len(ids)

    def _is_channel(self, account, dialog_id):
        if int(dialog_id) >= 0:
            return False
        chat = self._get_chat(account, -int(dialog_id))
        return True if chat is None else bool(ChatObject.isChannel(chat))


    def _handle_spam(self, account, dialog_id, arg):
        limit = self._int_setting("spam_max", DEFAULT_SPAM_MAX, 1, SPAM_MAX_LIMIT)
        parts = (arg or "").split(None, 1)
        count = parse_count(parts[0], limit) if parts else None
        text = parts[1].strip() if len(parts) > 1 else ""
        if count is None or not text:
            toast_err("Использование: %s N текст (N: 1–%d)" % (self._command_text("spam"), limit))
            return
        cooldown = self._int_setting("spam_cooldown", DEFAULT_SPAM_COOLDOWN, 0, SPAM_COOLDOWN_MAX)
        key = (int(account), int(dialog_id))
        now = time.time()
        with self._lock:
            if self._spam_runs.get(key):
                error = "В этом чате уже идёт отправка"
            elif now - self._spam_last.get(key, 0) < cooldown:
                error = "Подождите ещё %d с" % (int(cooldown - (now - self._spam_last[key])) + 1)
            else:
                error = None
                self._spam_last[key] = now
                self._spam_runs[key] = True
        if error:
            toast_err(error)
            return
        delay = self._float_setting("spam_delay", DEFAULT_SPAM_DELAY, 0, SPAM_DELAY_MAX)
        threading.Thread(target=self._spam_worker, args=(key, count, text, delay), daemon=True).start()

    def _spam_worker(self, key, count, text, delay):
        account, dialog_id = key
        sent = 0
        try:
            for index in range(count):
                if not self._active or not self._spam_send(account, dialog_id, text):
                    break
                sent += 1
                if index < count - 1 and delay > 0:
                    time.sleep(delay)
        finally:
            with self._lock:
                self._spam_runs.pop(key, None)
        if not self._active:
            return
        if sent == count:
            toast_ok("Отправлено %d %s" % (sent, plural_ru(sent)))
        else:
            toast_err("Отправлено %d из %d" % (sent, count))

    def _spam_send(self, account, dialog_id, text):
        result = {"ok": False, "started": False, "cancelled": False}
        gate = threading.Lock()
        done = threading.Event()

        def _do():
            try:
                with gate:
                    if result["cancelled"] or not self._active:
                        return
                    result["started"] = True
                with self._lock:
                    self._own_notices[(account, dialog_id, text)] = time.time()
                send_text(dialog_id, text, account=account)
                result["ok"] = True
            except Exception:
                pass
            finally:
                done.set()

        run_on_ui_thread(_do)
        if not done.wait(SPAM_SEND_TIMEOUT):
            with gate:
                # A late UI-thread run must not send after the worker has given up.
                result["cancelled"] = True
            return False
        return result["ok"]


    def _nv_bots(self):
        raw = str(self.get_setting("nv_bots", "") or "").replace("\n", ",").replace(" ", ",")
        result = []
        for bot in raw.split(","):
            bot = bot.strip().lstrip("@").lower()
            if bot and bot not in result:
                result.append(bot)
        return result

    def _nv_recent(self):
        return [r for r in str(self.get_setting("nv_recent", "") or "").split(",") if r]

    def _nv_save_bots(self, bots):
        self.set_setting("nv_bots", ",".join(bots), True)

    def _nv_add_bot(self, name):
        name = (name or "").strip().lstrip("@").lower()
        bots = self._nv_bots()
        if name and name not in bots:
            self._nv_save_bots(bots + [name])
            toast_ok("@%s добавлен" % name)

    def _nv_remove_bot(self, name):
        self._nv_save_bots([b for b in self._nv_bots() if b != name])
        toast_info("@%s убран" % name)

    def _nv_on_new_bot(self, value):
        for part in str(value or "").replace(" ", ",").split(","):
            self._nv_add_bot(part)
        self.set_setting("nv_new_bot", "", True)

    def _nv_remember(self, name):
        name = (name or "").lstrip("@").lower()
        if not name:
            return
        recent = [r for r in self._nv_recent() if r != name]
        self.set_setting("nv_recent", ",".join([name] + recent[:9]))

    def _nv_allowed(self, bot_name):
        name = (bot_name or "").lstrip("@").lower()
        listed = name in self._nv_bots()
        return listed if self.get_setting("nv_mode", NV_BLACKLIST) == NV_WHITELIST else not listed

    @staticmethod
    def _buttons(markup):
        rows = getattr(markup, "rows", None) if markup is not None else None
        result = []
        if rows is not None:
            for row in rows:
                for btn in row.buttons:
                    result.append(btn)
        return result

    @staticmethod
    def _is_url_button(btn):
        return btn.getClass().getSimpleName() == "TL_keyboardButtonUrl"

    @staticmethod
    def _server_media(params):
        for field in ("document", "photo"):
            obj = getattr(params, field, None)
            if obj is not None:
                return bool(getattr(obj, "id", 0)) and bool(getattr(obj, "access_hash", 0))
        return None

    def _no_via_hook(self, account, params):
        extra = getattr(params, "params", None)
        if extra is None:
            return HookResult()
        if extra.containsKey(NV_RESEND):
            extra.remove(NV_RESEND)
            self._nv_titles(account, params, True)
            return HookResult(strategy=HookStrategy.MODIFY, params=params)
        if not extra.containsKey("query_id") or not self.get_setting("nv_enabled", True):
            return HookResult()

        bot_name = extra.get("bot_name") or ""
        self._nv_remember(bot_name)
        if not self._nv_allowed(bot_name) or getattr(params, "game", None) is not None:
            return HookResult()
        markup = getattr(params, "replyMarkup", None)
        buttons = self._buttons(markup)
        if self.get_setting("nv_keep_action", True) and any(not self._is_url_button(b) for b in buttons):
            return HookResult()

        media = self._server_media(params)
        if media is False:
            if self.get_setting("nv_fallback", True):
                return HookResult()
            toast_err("Этот результат нельзя отправить без бота")
            return HookResult(strategy=HookStrategy.CANCEL)

        for key in NV_INLINE_KEYS:
            extra.remove(key)
        if media and self.get_setting("nv_strip_caption", True):
            params.caption = None
            params.entities = None
        if buttons and self.get_setting("nv_url_buttons", True):
            self._nv_append_links(params, [b for b in buttons if self._is_url_button(b)], bool(media))
        params.replyMarkup = None

        if media and self._nv_titles(account, params, False) == HookStrategy.CANCEL:
            return HookResult(strategy=HookStrategy.CANCEL)
        return HookResult(strategy=HookStrategy.MODIFY, params=params)

    def _nv_append_links(self, params, buttons, is_media):
        links = [(str(b.text), str(b.url)) for b in buttons if getattr(b, "text", None) and getattr(b, "url", None)]
        if not links:
            return
        field = "caption" if is_media else "message"
        out = str(getattr(params, field, None) or "")
        has_base = bool(out)
        entities = ArrayList()
        if getattr(params, "entities", None) is not None:
            entities.addAll(params.entities)
        for index, (text, url) in enumerate(links):
            out += ("\n\n" if has_base else "") if index == 0 else "\n"
            entity = TLRPC.TL_messageEntityTextUrl()
            entity.offset = utf16_len(out)
            entity.length = utf16_len(text)
            entity.url = url
            entities.add(entity)
            out += text
        setattr(params, field, out)
        params.entities = entities

    @staticmethod
    def _audio_attr(doc):
        for attr in (getattr(doc, "attributes", None) or []):
            if attr.getClass().getSimpleName().startswith("TL_documentAttributeAudio"):
                return None if getattr(attr, "voice", False) else attr
        return None

    @staticmethod
    def _local_file(account, doc):
        from org.telegram.messenger import FileLoader
        loader = FileLoader.getInstance(account)
        for force in (False, True):
            try:
                path = loader.getPathToAttach(doc, force)
                if path is not None and path.exists() and path.length() > 0:
                    return path
            except Exception:
                pass
        return None

    def _nv_titles(self, account, params, resend):
        doc = getattr(params, "document", None)
        if doc is None or not self.get_setting("nv_clean_titles", True):
            return None
        attr = self._audio_attr(doc)
        if attr is None:
            return None
        words = [w.strip() for w in str(self.get_setting("nv_clean_words", "") or "").split(",") if w.strip()]
        title, performer = getattr(attr, "title", None), getattr(attr, "performer", None)
        new_title = clean_title(title, self.get_setting("nv_remove_feat", False), words) if title else title
        new_performer = clean_title(performer, False, words) if performer else performer
        if new_title == title and new_performer == performer:
            return None
        local = self._local_file(account, doc)
        if local is not None:
            self._nv_reupload(account, params, attr, new_title, new_performer, local)
            return HookStrategy.MODIFY
        if not resend and self.get_setting("nv_clean_download", True):
            self._nv_download_then_send(account, params)
            return HookStrategy.CANCEL
        return None

    def _nv_reupload(self, account, params, attr, title, performer, local):
        from org.telegram.messenger import FileLoader
        old = params.document
        doc = TLRPC.TL_document()
        doc.id = 0
        doc.access_hash = 0
        doc.dc_id = 0
        doc.date = old.date
        doc.mime_type = old.mime_type
        doc.size = old.size
        # Never mutate the cached original document: copy the audio attribute and the list.
        new_attr = TLRPC.TL_documentAttributeAudio()
        for field in ("flags", "voice", "duration", "title", "performer", "waveform"):
            try:
                setattr(new_attr, field, getattr(attr, field))
            except Exception:
                pass
        if title:
            new_attr.title = title
        if performer:
            new_attr.performer = performer
        # Flags follow the copied fields (legacy attribute classes may use other flag layouts).
        flags = int(getattr(new_attr, "flags", 0) or 0) & ~7
        if getattr(new_attr, "title", None):
            flags |= 1
        if getattr(new_attr, "performer", None):
            flags |= 2
        if getattr(new_attr, "waveform", None) is not None:
            flags |= 4
        new_attr.flags = flags
        attributes = ArrayList()
        replaced = False
        for item in (old.attributes or []):
            same = False
            if not replaced:
                try:
                    same = item is attr or bool(item.equals(attr))
                except Exception:
                    same = item is attr
            if same:
                replaced = True
                attributes.add(new_attr)
            else:
                attributes.add(item)
        if not replaced:
            attributes.add(new_attr)
        doc.attributes = attributes
        thumbs = ArrayList()
        loader = FileLoader.getInstance(account)
        for thumb in (old.thumbs or []):
            try:
                path = loader.getPathToAttach(thumb, True)
                if path is not None and path.exists():
                    thumbs.add(thumb)
            except Exception:
                pass
        doc.thumbs = thumbs
        params.document = doc
        params.path = local.getAbsolutePath()

    def _nv_download_then_send(self, account, params):
        from org.telegram.messenger import FileLoader, SendMessagesHelper
        doc = params.document
        try:
            FileLoader.getInstance(account).loadFile(doc, getattr(params, "parentObject", None) or "nvb",
                                                     FileLoader.PRIORITY_HIGH, 0)
        except Exception:
            pass
        toast_info("Скачиваю трек, чтобы почистить название…")
        params.params.put(NV_RESEND, "1")

        def _wait():
            for _ in range(120):
                if self._local_file(account, doc) is not None:
                    break
                time.sleep(0.5)
            run_on_ui_thread(lambda: SendMessagesHelper.getInstance(account).sendMessage(params))

        threading.Thread(target=_wait, daemon=True).start()








    def _dm_media_settings(self):
        kinds = {"photo"}
        for kind in ("video", "voice", "file"):
            if self.get_setting("dm_media_" + kind, False):
                kinds.add(kind)
        return (bool(self.get_setting("dm_media_private", True)), kinds,
                self._int_setting("dm_media_max_mb", 20, 1, 100) * 1024 * 1024)

    def _dm_media_enabled(self, reason):
        return (self._active and bool(self.get_setting("dm_enabled", True))
                and bool(self.get_setting("dm_media_rescue" if reason == "delete"
                                          else "dm_media_prefetch", reason == "delete")))

    def _dm_media_task(self, account, message):
        from org.telegram.messenger import AndroidUtilities, FileLoader, ImageLocation, MessageObject
        if message is None or bool(getattr(message, "out", False)) or getattr(message, "action", None) is not None:
            return None
        dialog_id = message_dialog_id(message)
        mid = int(getattr(message, "id", 0) or 0)
        if mid <= 0 or is_special_dialog(dialog_id):
            return None
        media = MessageObject.getMedia(message)
        # Secret/self-destruct/view-once media are deliberately not downloaded by this feature.
        if media is None or int(getattr(media, "ttl_seconds", 0) or 0) != 0 \
                or int(getattr(message, "ttl", 0) or 0) != 0:
            return None
        photo, doc = getattr(media, "photo", None), getattr(media, "document", None)
        if photo is not None and int(getattr(photo, "id", 0) or 0):
            try:
                side = int(AndroidUtilities.getPhotoSize(True))
            except Exception:
                side = int(AndroidUtilities.getPhotoSize())
            attach = FileLoader.getClosestPhotoSizeWithSize(photo.sizes, side, False, None, True)
            if attach is None or getattr(attach, "location", None) is None:
                return None
            size = int(getattr(attach, "size", 0) or 0)
            progressive = jlist(getattr(attach, "sizes", None))
            if progressive:
                size = max(size, max(int(v) for v in progressive))
            location = ImageLocation.getForPhoto(attach, photo)
            if location is None:
                return None
            kind = "photo"
        elif doc is not None and int(getattr(doc, "id", 0) or 0):
            # Optional files exclude stickers/emoji, which have separate loading lifecycles.
            if MessageObject.isAnyKindOfStickerOrEmoji(doc):
                return None
            attach, location, size = doc, None, int(getattr(doc, "size", 0) or 0)
            kind = ("voice" if MessageObject.isVoiceDocument(doc) else
                    "video" if MessageObject.isVideoDocument(doc) or MessageObject.isRoundVideoDocument(doc)
                    else "file")
        else:
            return None
        if size <= 0:
            return None
        filename = str(FileLoader.getAttachFileName(attach, "jpg" if kind == "photo" else None) or "")
        if not filename:
            return None
        return {"account": int(account), "dialog_id": dialog_id, "mid": mid, "message": message,
                "attach": attach, "location": location, "kind": kind, "size": size, "filename": filename}

    def _dm_media_allowed(self, task, reason):
        if not self._dm_media_enabled(reason):
            return False
        private, kinds, limit = self._dm_media_settings()
        account, did, mid = task["account"], task["dialog_id"], task["mid"]
        if self._dm_skip_dialog(account, did, self._dm_cfg()) or self._dm_is_pending(account, did, mid, time.time()):
            return False
        return dm_media_policy(task["kind"], task["size"], did, private, kinds, limit)

    def _dm_media_local(self, task):
        from org.telegram.messenger import FileLoader
        # Check both standard Telegram media directories and its cache.
        loader = FileLoader.getInstance(task["account"])
        for cache in (True, False):
            path = loader.getPathToAttach(task["attach"], cache)
            if path is not None and path.exists() and path.length() > 0:
                return True
        return False

    def _dm_media_receive(self, account, message):
        if not self._active:
            return
        def _run():
            try:
                if not self._active:
                    return
                task = self._dm_media_task(account, message)
                if task is None:
                    return
                key = (int(account), task["dialog_id"], task["mid"])
                self._dm_media_recent.pop(key, None)
                self._dm_media_recent[key] = (time.monotonic(), message)
                while len(self._dm_media_recent) > DM_MEDIA_RECENT:
                    self._dm_media_recent.pop(next(iter(self._dm_media_recent)))
                self._dm_media_enqueue(task, "receive")
            except Exception as exc:
                self._dm_media_error("receive", exc)
        ui(_run)

    def _dm_media_enqueue(self, task, reason):
        from org.telegram.messenger import FileLoader
        if not self._dm_media_allowed(task, reason) or self._dm_media_local(task):
            return
        key = (task["account"], task["filename"])
        if FileLoader.getInstance(task["account"]).isLoadingFile(task["filename"]):
            return  # Never cancel or duplicate a client-owned download.
        if self._dm_media_queue.submit(key, task, reason):
            self._dm_media_pump()

    def _dm_media_rescue(self, account, dialog_id, mids):
        wanted = set(int(m) for m in mids)
        def _run():
            if not self._dm_media_enabled("delete"):
                return
            try:
                now = time.monotonic()
                messages = {}
                for key, (stamp, message) in list(self._dm_media_recent.items()):
                    if now - stamp > DM_MEDIA_RECENT_TTL:
                        self._dm_media_recent.pop(key, None)
                    elif key[0] == account and key[1] == dialog_id and key[2] in wanted:
                        messages[key[2]] = message
                for obj in (self._loaded_messages(account, dialog_id) or []):
                    mid = int(obj.getId())
                    if mid in wanted:
                        messages[mid] = obj.messageOwner
                try:
                    cache = get_messages_controller(account).dialogMessagesByIds
                    for mid in wanted:
                        if mid not in messages:
                            obj = cache.get(mid)
                            if obj is not None and int(obj.getDialogId()) == dialog_id:
                                messages[mid] = obj.messageOwner
                except Exception as exc:
                    self._dm_media_error("rescue_cache", exc)
                for mid, message in messages.items():
                    if self._dm_store.has(account, dialog_id, mid):
                        task = self._dm_media_task(account, message)
                        if task is not None:
                            self._dm_media_enqueue(task, "delete")
            except Exception as exc:
                self._dm_media_error("rescue", exc)
        ui(_run)

    def _dm_media_pump(self):
        from org.telegram.messenger import FileLoader, MessageObject
        if not self._active:
            return
        # Release slots after real completion/failure. A stalled client-owned operation retains
        # its slot; do not start more downloads or cancel a potentially shared operation.
        for key, (task, reason) in list(self._dm_media_queue.running.items()):
            try:
                loader = FileLoader.getInstance(task["account"])
                if time.monotonic() - task.get("started", 0) > 5 and not loader.isLoadingFile(task["filename"]):
                    self._dm_media_queue.finish(key, self._dm_media_local(task))
            except Exception as exc:
                self._dm_media_error("poll", exc)
        while self._active:
            item = self._dm_media_queue.take()
            if item is None:
                break
            key, task, reason = item
            try:
                if not self._dm_media_allowed(task, reason):
                    self._dm_media_queue.finish(key, False)
                    continue
                if self._dm_media_local(task):
                    self._dm_media_queue.finish(key, True)
                    continue
                loader = FileLoader.getInstance(task["account"])
                if loader.isLoadingFile(task["filename"]):
                    self._dm_media_queue.finish(key, False)
                    continue
                task["started"] = time.monotonic()
                # Native parent supports file-reference renewal. cacheType=0 puts the file
                # where MessageObject/PhotoViewer/MediaController normally look for it.
                # Gallery behavior follows the client's existing save-to-gallery settings.
                parent = MessageObject(task["account"], task["message"], False, False)
                if task["kind"] == "photo":
                    loader.loadFile(task["location"], parent, "jpg", FileLoader.PRIORITY_NORMAL, 0)
                else:
                    loader.loadFile(task["attach"], parent, FileLoader.PRIORITY_NORMAL, 0)
            except Exception as exc:
                self._dm_media_queue.finish(key, False)
                self._dm_media_error("load", exc)
        if self._dm_media_queue.running and self._dm_media_timer is None:
            generation = self._dm_media_generation
            def _tick():
                def _run():
                    if self._active and generation == self._dm_media_generation:
                        self._dm_media_timer = None
                        self._dm_media_pump()
                ui(_run)
            self._dm_media_timer = _default_schedule(2, _tick)

    @staticmethod
    def _dm_spec_loader(name, types):
        if name == "loadFile" and types in (
                ["org.telegram.tgnet.TLRPC$Document", "java.lang.Object", "int", "int"],
                ["org.telegram.messenger.ImageLocation", "java.lang.Object", "java.lang.String", "int", "int"]):
            return "media_load"
        return None

    def _dm_media_load(self, param):
        # Observe user/client attempts too, so failure notices work after a plugin restart.
        # Never suppress the loader or claim that an absent message is certainly irrecoverable.
        if not self._active or not self.get_setting("dm_enabled", True):
            return
        try:
            parent = param.args[1]
            message = getattr(parent, "messageOwner", None)
            if message is None and isinstance(parent, TLRPC.Message):
                message = parent
            account = controller_account(param.thisObject)
            did, mid = message_dialog_id(message), int(getattr(message, "id", 0) or 0)
            if message is None or bool(getattr(message, "out", False)) or not self._dm_store.has(account, did, mid):
                return
            from org.telegram.messenger import FileLoader
            source = param.args[0]
            attach = (getattr(source, "document", None) or getattr(source, "photoSize", None)
                      or getattr(source, "location", None)) if len(param.args) == 5 else source
            ext = str(param.args[2]) if len(param.args) == 5 and param.args[2] is not None else None
            filename = str(FileLoader.getAttachFileName(attach, ext) or "")
            if filename:
                def _watch():
                    if not self._active:
                        return
                    self._dm_media_watched[(account, filename)] = (did, mid, time.monotonic())
                    while len(self._dm_media_watched) > DM_MEDIA_RECENT:
                        self._dm_media_watched.pop(next(iter(self._dm_media_watched)))
                ui(_watch)
        except Exception as exc:
            self._dm_media_error("watch", exc)

    def _dm_media_event(self, event, account, args):
        if not self._active or args is None or len(args) < 1:
            return
        key = (int(account), str(args[0]))
        success = int(event) == int(NotificationCenter.fileLoaded)
        item = self._dm_media_queue.finish(key, success)
        watched = self._dm_media_watched.pop(key, None)
        if success and item is not None:
            task = item[0]
            self._dm_refresh(task["account"], task["dialog_id"], [task["mid"]])
        cancelled = not success and len(args) > 1 and int(args[1]) == 1
        if not success and not cancelled and watched is not None and self.get_setting("dm_enabled", True):
            did, mid, stamp = watched
            # Cancellations are not proof of permanent loss, and background rescue stays quiet.
            background = item is not None
            if not background and time.monotonic() - stamp < 300 \
                    and self._dm_store.has(int(account), did, mid):
                fragment = get_last_fragment()
                if fragment is not None and str(fragment.getClass().getName()) == "org.telegram.ui.ChatActivity" \
                        and int(fragment.getCurrentAccount()) == int(account) and int(fragment.getDialogId()) == did:
                    now = time.monotonic()
                    if now - self._dm_media_notice_at > 5:
                        self._dm_media_notice_at = now
                        toast_info("Не удалось скачать удалённое медиа. Если файла нет в кэше, "
                                   "старая ссылка может быть недоступна. Включите сохранение медиа заранее.")
        self._dm_media_pump()

    def _dm_media_error(self, stage, exc):
        # No message text, IDs, usernames, file references, or paths in diagnostics.
        try:
            now = time.monotonic()
            if now - self._dm_media_error_at > 30:
                self._dm_media_error_at = now
                self.log("MultiTools media " + stage + ": " + type(exc).__name__)
        except Exception:
            pass

    def _dm_media_stop(self):
        self._dm_media_generation += 1
        timer, self._dm_media_timer = self._dm_media_timer, None
        if timer is not None:
            timer.cancel()
        self._dm_media_queue.clear()
        self._dm_media_recent.clear()
        self._dm_media_watched.clear()
        # Do not cancel FileLoader operations: the viewer may be sharing them.


    def _page_deleted(self):
        self._dm_trim_views()
        on = self.get_setting("dm_enabled", True)
        master = None
        if self._dm_custom_ok():
            try:
                from org.telegram.ui.Cells import TextCheckCell  # noqa: F401 (capability probe)
                master = self._dm_custom_row("master")
            except Exception:
                master = None
        expanded = bool(self.get_setting("dm_expanded", False)) if master is not None else True
        items = [Header(text="Основное")]
        if master is not None:
            items.append(master)
        else:
            items.append(Switch(key="dm_enabled", text="Сохранять удалённые", default=True,
                                subtext="Удалённые собеседником сообщения остаются в чате с меткой",
                                icon="msg_archive",
                                on_change=lambda v: self.set_setting("dm_enabled", bool(v), True)))
        if on:
            if expanded:
                items += [
                    Switch(key="dm_bots", text="В чатах с ботами", default=False,
                           subtext="Сохранять и то, что удаляют боты", icon="msg_bot"),
                    Switch(key="dm_notif", text="Оставлять уведомления", default=True,
                           subtext="Не убирать уведомление, если сообщение удалили", icon="msg_notifications"),
                    Switch(key="dm_selfdestruct", text="Не удалять исчезающие", default=False,
                           subtext="Сообщения с таймером самоудаления останутся", icon="msg_autodelete"),
                ]
            items += [
                Header(text="Медиа"),
                Switch(key="dm_media_prefetch", text="Сохранять медиа заранее", default=False,
                       subtext="Скачивать входящие медиа сразу. По умолчанию только фото", icon="msg_download"),
                Switch(key="dm_media_rescue", text="Пробовать скачать при удалении", default=True,
                       subtext="По старой ссылке; успех не гарантирован", icon="msg_retry"),
                Switch(key="dm_media_private", text="Только личные чаты", default=True, icon="msg_private"),
                Switch(key="dm_media_video", text="Видео и видеосообщения", default=False, icon="msg_video"),
                Switch(key="dm_media_voice", text="Голосовые", default=False, icon="msg_voice"),
                Switch(key="dm_media_file", text="Файлы и музыка", default=False, icon="msg_file"),
                Input(key="dm_media_max_mb", text="Максимальный размер, МБ", default="20",
                      icon="msg_download", on_change=self._number_check(1, 100, False)),
                Divider(text="Не более 200 МБ заявленного объёма за сеанс плагина, 3 загрузок одновременно. "
                             "Файлы хранятся как обычные медиа Telegram: очистка кэша удалит их. "
                             "Галерея — по настройкам клиента. "
                             "Исчезающие и секретные медиа пропускаются; загрузка работает, пока клиент активен."),
            ]
            items += [Divider(text="Сохраняются только удаления собеседника, "
                                   "свои удаления удаляются по-настоящему")] + self._dm_look_items()
        else:
            items.append(Divider(text="Удалённые собеседником сообщения остаются в чате с меткой"))
        items += [
            Header(text="Сохранённые"),
            self._dm_info_row("saved") or Text(text="Сохранено: %d" % self._dm_store.total(), icon="msg_info"),
            Text(text="Удалить сохранённые", icon="msg_clear", red=True, on_click=self._dm_on_clear),
            Divider(text="Сообщения исчезнут из чатов на этом устройстве"),
        ]
        return items

    def _dm_look_items(self):
        self._dm_cfg_cache = None
        self._dm_live = {}
        live = self._dm_custom_ok()

        def _pick(key):
            def _changed(value):
                self.set_setting(key, value, True)
                self._dm_cfg_cache = None
            return _changed

        style = self._dm_style()
        color = self._choice("dm_color", 0, tuple(range(len(DM_COLORS))))
        items = [Header(text="Вид")]
        preview_row = self._dm_custom_row("preview") if live else None
        if preview_row is not None:
            items.append(preview_row)
        items.append(Selector(key="dm_mark_style", text="Метка", default=0,
                              items=[("%s  %s" % (sym, name) if sym != DM_ICON else "%s (иконка)" % name) if sym else name
                                     for name, sym in DM_STYLES],
                              icon="msg_delete", on_change=_pick("dm_mark_style")))
        if style == DM_STYLE_CUSTOM:
            items.append(Input(key="dm_mark_text", text="Свой текст метки", default="удалено", icon="msg_text",
                               on_change=self._dm_mark_text_changed))
        palette = self._dm_custom_row("palette") if live else None
        if palette is not None:
            items.append(palette)
        if color == DM_COLOR_CUSTOM:
            items.append(Input(key="dm_color_hex", text="HEX цвет, например FF5555", default="FF5555",
                               icon="msg_palette", on_change=self._dm_hex_changed))
        slider = self._dm_custom_row(DM_ALPHA_KEY) if live else None
        if slider is not None:
            items.append(slider)
        if preview_row is None or palette is None or slider is None:
            items.append(Text(text="Обновите exteraGram",
                              subtext="Предпросмотр, цвет и прозрачность недоступны в этой версии",
                              icon="msg_info"))
        items.append(Divider(text="Метка тускнеет вместе с сообщением. "
                                  "Новый вид применится после повторного открытия чата"))
        return items

    def _dm_style(self):
        try:
            value = self.get_setting("dm_mark_style", None)
            if value is None:
                old = self.get_setting("dm_style", None)
                value = DM_STYLE_MIGRATE.get(int(old), 0) if old is not None else 0
                self.set_setting("dm_mark_style", value)
            value = int(value)
            return value if 0 <= value < len(DM_STYLES) else 0
        except Exception:
            return 0


    def _dm_alpha_pct(self):
        value = None
        try:
            value = self.get_setting(DM_ALPHA_KEY, None)
        except Exception:
            value = None
        if value is None:
            try:
                old = self.get_setting(DM_ALPHA_OLD_KEY, None)
                value = int(old) * 10 if old is not None else DM_ALPHA_DEFAULT
            except Exception:
                value = DM_ALPHA_DEFAULT
            value = max(0, min(DM_PCT_MAX, int(value)))
            try:
                self.set_setting(DM_ALPHA_KEY, value)
            except Exception:
                pass
            return value
        try:
            return max(0, min(DM_PCT_MAX, int(round(float(value)))))
        except Exception:
            return DM_ALPHA_DEFAULT

    def _dm_set_alpha(self, value):
        value = max(0, min(DM_PCT_MAX, int(value)))
        try:
            self.set_setting(DM_ALPHA_KEY, value)
        except Exception:
            pass
        self._dm_live.pop(DM_ALPHA_KEY, None)
        self._dm_cfg_cache = None

    def _dm_custom_ok(self):
        return Custom is not None and SimpleSettingFactory is not None

    def _dm_custom_row(self, kind):
        try:
            factory = self._dm_factories.get(kind)
            if factory is None:
                if kind == "preview":
                    factory = SimpleSettingFactory(self._dm_preview_create, self._dm_preview_bind,
                                                   is_clickable=False)
                elif kind == "master":
                    factory = SimpleSettingFactory(self._dm_master_create, self._dm_master_bind,
                                                   is_clickable=True, on_click=self._dm_master_click)
                elif kind == "palette":
                    factory = SimpleSettingFactory(self._dm_palette_create, self._dm_palette_bind,
                                                   is_clickable=False)
                else:
                    factory = SimpleSettingFactory(self._dm_slider_creator(kind), self._dm_slider_binder(kind),
                                                   is_clickable=False)
                self._dm_factories[kind] = factory
            return Custom(factory=factory.instance.java)
        except Exception:
            return None

    @staticmethod
    def _dm_theme(key_name, fallback):
        try:
            from org.telegram.ui.ActionBar import Theme
            return int(Theme.getColor(getattr(Theme, key_name)))
        except Exception:
            return signed_color(fallback)

    @staticmethod
    def _dm_dp(value):
        try:
            from org.telegram.messenger import AndroidUtilities
            return int(AndroidUtilities.dp(float(value)))
        except Exception:
            return int(value * 3)

    @staticmethod
    def _dm_full_width(view, height=-2):
        try:
            try:
                from androidx.recyclerview.widget import RecyclerView
                params = RecyclerView.LayoutParams(-1, int(height))
            except Exception:
                from android.view import ViewGroup
                params = ViewGroup.LayoutParams(-1, int(height))
            view.setLayoutParams(params)
        except Exception:
            pass
        return view

    def _dm_error_view(self, context):
        from android.widget import TextView
        view = TextView(context)
        view.setText("Не удалось отобразить")
        try:
            view.setTextSize(15.0)
            view.setTextColor(signed_color(0xFFFF4444))
            view.setPadding(self._dm_dp(21), self._dm_dp(12), self._dm_dp(21), self._dm_dp(12))
            self._dm_full_width(view)
        except Exception:
            pass
        return view

    def _dm_slider_creator(self, key):
        def _create(context, list_view, current_account, class_guid, resources_provider):
            try:
                from android.widget import LinearLayout, SeekBar, TextView
                from android.view import Gravity
                dp = self._dm_dp
                root = LinearLayout(context)
                root.setOrientation(LinearLayout.VERTICAL)
                root.setPadding(dp(21), dp(10), dp(21), dp(6))
                root.setBackgroundColor(self._dm_theme("key_windowBackgroundWhite", 0xFFFFFFFF))
                from android.widget import FrameLayout
                head = FrameLayout(context)
                title = TextView(context)
                title.setText(DM_ALPHA_LABEL)
                title.setTextSize(16.0)
                title.setTextColor(self._dm_theme("key_windowBackgroundWhiteBlackText", 0xFF000000))
                head.addView(title, FrameLayout.LayoutParams(-2, -2, int(Gravity.START | Gravity.CENTER_VERTICAL)))
                value = TextView(context)
                value.setTextSize(16.0)
                value.setTextColor(self._dm_theme("key_windowBackgroundWhiteValueText", 0xFF3A8CE6))
                head.addView(value, FrameLayout.LayoutParams(-2, -2, int(Gravity.END | Gravity.CENTER_VERTICAL)))
                root.addView(head, LinearLayout.LayoutParams(-1, -2))
                seek = SeekBar(context)
                seek.setMax(DM_PCT_MAX // DM_PCT_STEP)
                seek.setPadding(dp(4), dp(10), dp(4), dp(10))
                try:
                    from android.content.res import ColorStateList
                    accent = ColorStateList.valueOf(self._dm_theme("key_switchTrackChecked", 0xFF3A8CE6))
                    seek.setProgressTintList(accent)
                    seek.setThumbTintList(accent)
                    track = ColorStateList.valueOf(self._dm_theme("key_windowBackgroundWhiteGrayText", 0xFF8A8A8A))
                    seek.setProgressBackgroundTintList(track)
                except Exception:
                    pass
                listener = self._dm_seek_listener(key, value)
                if listener is not None:
                    self._dm_listeners.append(listener)
                    seek.setOnSeekBarChangeListener(listener)
                root.addView(seek, LinearLayout.LayoutParams(-1, -2))
                return self._dm_full_width(root)
            except Exception:
                return self._dm_error_view(context)
        return _create

    def _dm_slider_binder(self, key):
        def _bind(view, item, divider, adapter, list_view):
            try:
                pct = self._dm_alpha_pct()
                head = view.getChildAt(0)
                seek = view.getChildAt(1)
                if head is None or seek is None:
                    return
                head.getChildAt(1).setText("%d%%" % pct)
                seek.setProgress(0 if pct else 1)
                seek.setProgress(int(pct // DM_PCT_STEP))
            except Exception:
                pass
        return _bind

    def _dm_seek_listener(self, key, value_view):
        try:
            from java import dynamic_proxy
            from android.widget import SeekBar
        except Exception:
            return None
        plugin = self

        class _Listener(dynamic_proxy(SeekBar.OnSeekBarChangeListener)):
            def onProgressChanged(self, seek, progress, from_user):
                try:
                    pct = int(progress) * DM_PCT_STEP
                    value_view.setText("%d%%" % pct)
                    if from_user:
                        plugin._dm_live[key] = pct
                        plugin._dm_refresh_previews()
                except Exception:
                    pass

            def onStartTrackingTouch(self, seek):
                pass

            def onStopTrackingTouch(self, seek):
                try:
                    plugin._dm_set_alpha(int(seek.getProgress()) * DM_PCT_STEP)
                    plugin._dm_refresh_previews()
                except Exception:
                    pass

        return _Listener()


    def _dm_make_bubble(self, context, out):
        from android.widget import TextView
        from android.graphics.drawable import GradientDrawable
        dp = self._dm_dp
        bubble = TextView(context)
        bubble.setTextSize(15.0)
        bubble.setPadding(dp(11), dp(6), dp(11), dp(6))
        try:
            screen = int(context.getResources().getDisplayMetrics().widthPixels)
            bubble.setMaxWidth(max(dp(240), screen - dp(56)))
        except Exception:
            bubble.setMaxWidth(dp(330))
        shape = GradientDrawable()
        big, small = float(dp(16)), float(dp(5))
        radii = [big, big, big, big, small, small, big, big] if out else [big, big, big, big, big, big, small, small]
        try:
            from java import jarray, jfloat
            shape.setCornerRadii(jarray(jfloat)(radii))
        except Exception:
            shape.setCornerRadius(big)
        shape.setColor(self._dm_theme("key_chat_outBubble" if out else "key_chat_inBubble",
                                      0xFF2B5278 if out else 0xFF2A2A2E))
        bubble.setBackground(shape)
        return bubble

    def _dm_checks_span(self, color):
        try:
            from android.graphics import PorterDuff, PorterDuffColorFilter
            from android.graphics.drawable import LayerDrawable
            from android.text.style import ImageSpan
            from org.telegram.messenger import ApplicationLoader
            ctx = ApplicationLoader.applicationContext
            check_id = self._dm_res("msg_check_s")
            half_id = self._dm_res("msg_halfcheck")
            if not check_id or not half_id:
                return None
            check = ctx.getResources().getDrawable(check_id).mutate()
            half = ctx.getResources().getDrawable(half_id).mutate()
            shift = self._dm_dp(4)
            layer = LayerDrawable([check, half])
            layer.setLayerInset(0, 0, 0, shift, 0)
            layer.setLayerInset(1, shift, 0, 0, 0)
            layer.setColorFilter(PorterDuffColorFilter(color, PorterDuff.Mode.SRC_IN))
            w = int(check.getIntrinsicWidth()) + shift
            h = int(check.getIntrinsicHeight())
            layer.setBounds(0, 0, w, h)
            return ImageSpan(layer, ImageSpan.ALIGN_BASELINE)
        except Exception:
            return None

    def _dm_plain_text(self, text, time_text, out, checks=False):
        from android.text import SpannableStringBuilder
        from android.text.style import ForegroundColorSpan, RelativeSizeSpan
        text_color = self._dm_theme("key_chat_messageTextOut" if out else "key_chat_messageTextIn", 0xFFFFFFFF)
        time_color = self._dm_theme("key_chat_outTimeText" if out else "key_chat_inTimeText", 0xFF8A8A8A)
        out_text = SpannableStringBuilder(text)
        out_text.setSpan(ForegroundColorSpan(text_color), 0, len(text), 33)
        start = out_text.length()
        out_text.append("   " + time_text)
        out_text.setSpan(ForegroundColorSpan(time_color), start, out_text.length(), 33)
        out_text.setSpan(RelativeSizeSpan(0.85), start, out_text.length(), 33)
        if checks:
            span = self._dm_checks_span(time_color)
            if span is not None:
                pos = out_text.length()
                out_text.append(" \u2009")
                out_text.setSpan(span, pos + 1, pos + 2, 33)
        return out_text

    def _dm_bubble(self, context):
        from android.widget import FrameLayout, ImageView, LinearLayout
        from android.view import Gravity
        dp = self._dm_dp
        box = FrameLayout(context)
        wall = self._dm_wallpaper_drawable()
        if wall is not None:
            image = ImageView(context)
            image.setAdjustViewBounds(True)
            image.setMaxHeight(1)
            image.setMaxWidth(1)
            image.setScaleType(ImageView.ScaleType.CENTER_CROP)
            image.setImageDrawable(wall)
            box.addView(image, FrameLayout.LayoutParams(-1, -1))
        else:
            box.setBackgroundColor(self._dm_theme("key_windowBackgroundGray", 0xFFF0F0F0))
        column = LinearLayout(context)
        column.setOrientation(LinearLayout.VERTICAL)
        column.setPadding(dp(8), dp(8), dp(8), dp(8))

        def _add(bubble, out):
            lp = LinearLayout.LayoutParams(-2, -2)
            lp.gravity = int(Gravity.END if out else Gravity.START)
            lp.topMargin = dp(3)
            lp.bottomMargin = dp(3)
            column.addView(bubble, lp)

        first = self._dm_make_bubble(context, False)
        first.setText(self._dm_plain_text("Привет, как дела?", "12:30", False))
        _add(first, False)
        mine = self._dm_make_bubble(context, True)
        mine.setText(self._dm_plain_text("Норм, а у тебя?", "12:31", True, checks=True))
        _add(mine, True)
        deleted = self._dm_make_bubble(context, False)
        _add(deleted, False)
        box.addView(column, FrameLayout.LayoutParams(-1, -2))
        return box, deleted

    def _dm_wallpaper_drawable(self):
        try:
            from org.telegram.ui.ActionBar import Theme
            wall = None
            for getter in ("getCachedWallpaperNonBlocking", "getCachedWallpaper"):
                try:
                    wall = getattr(Theme, getter)()
                except Exception:
                    wall = None
                if wall is not None:
                    break
            if wall is None:
                return None
            state = wall.getConstantState()
            return state.newDrawable().mutate() if state is not None else wall
        except Exception:
            return None


    def _dm_preview_create(self, context, list_view, current_account, class_guid, resources_provider):
        try:
            box, bubble = self._dm_bubble(context)
            self._dm_preview_views.append(bubble)
            self._dm_trim_views()
            return self._dm_full_width(box)
        except Exception:
            return self._dm_error_view(context)

    def _dm_preview_bind(self, view, item, divider, adapter, list_view):
        try:
            for bubble in list(self._dm_preview_views):
                self._dm_fill_preview(bubble)
        except Exception:
            pass

    def _dm_fill_preview(self, view):
        cfg = self._dm_live_cfg()
        msg_alpha = float(cfg["alpha"])
        text_color = self._dm_theme("key_chat_messageTextIn", 0xFFFFFFFF)
        time_color = self._dm_theme("key_chat_inTimeText", 0xFF8A8A8A)
        view.setText(self._dm_preview_text(cfg, text_color, time_color, 15))
        view.setAlpha(msg_alpha)

    def _dm_refresh_previews(self):
        def _run():
            for view in list(self._dm_preview_views):
                try:
                    self._dm_fill_preview(view)
                except Exception:
                    pass
        ui(_run)

    def _dm_live_cfg(self):
        cfg = dict(self._dm_cfg())
        live = self._dm_live.get(DM_ALPHA_KEY)
        if live is not None:
            cfg["alpha_pct"] = live
        cfg["alpha"] = 1.0 - cfg["alpha_pct"] / 100.0
        return cfg


    def _dm_native_fill(self, cell):
        on = bool(self.get_setting("dm_enabled", True))
        expanded = bool(self.get_setting("dm_expanded", False))
        text, value = "Сохранять удалённые", "Остаются в чате с меткой"
        res = self._dm_res("msg_archive")
        how = self._dm_master_native.get("how")
        tries = (
            ("reflect", lambda: self._dm_reflect_icon_check(cell, text, value, res, on)),
            ("value5", lambda: cell.setTextAndValueAndCheck(text, value, on, False, False)),
        )
        for name, call in tries:
            if how is not None and name != how:
                continue
            try:
                call()
                if how is None:
                    self._dm_master_native["how"] = name
                break
            except Exception:
                continue
        try:
            cell.setChecked(on)
        except Exception:
            pass
        box = self._dm_master_native.get("arrow")
        if box is not None:
            box.setVisibility(0 if on else 4)
            arrow = box.getChildAt(1)
            arrow.setRotation(180.0 if expanded else 0.0)

    def _dm_master_click(self, plugin, item, view):
        self._dm_master_toggle("list")

    def _dm_master_toggle(self, source):
        try:
            now = time.time()
            if now - getattr(self, "_dm_last_expand", 0.0) < 0.4:
                return
            if now - getattr(self, "_dm_last_toggle", 0.0) < 0.4:
                return
            self._dm_last_toggle = now
            value = not bool(self.get_setting("dm_enabled", True))
            self._dm_cfg_cache = None
            for row in list(getattr(self, "_dm_master_rows", []) or []):
                try:
                    row.setChecked(value)
                except Exception:
                    pass
            self.set_setting("dm_enabled", value, True)
        except Exception:
            pass

    def _dm_reflect_icon_check(self, cell, text, value, res, on):
        from java import jarray
        from java.lang import Boolean, Integer, Object, String
        if not res:
            raise ValueError("no icon")
        methods = [m for m in cell.getClass().getMethods() if "Icon" in str(m.getName())
                   and "Check" in str(m.getName()) and str(m.getName()).startswith("setText")]
        methods.sort(key=lambda m: 0 if "Value" in str(m.getName()) else 1)
        for method in methods:
            types = [str(t.getName()) for t in method.getParameterTypes()]
            args, texts, ints, bools = [], [text, value], 0, 0
            ok = True
            for t in types:
                if t in ("java.lang.String", "java.lang.CharSequence"):
                    args.append(String(texts.pop(0)) if texts else None)
                elif t == "int":
                    args.append(Integer.valueOf(int(res) if ints == 0 else 0))
                    ints += 1
                elif t == "boolean":
                    args.append(Boolean.valueOf(bool(on) if bools == 0 else False))
                    bools += 1
                else:
                    ok = False
                    break
            if not ok or ints == 0:
                continue
            method.invoke(cell, jarray(Object)(args))
            return
        raise ValueError("no suitable method")

    def _dm_master_create(self, context, list_view, current_account, class_guid, resources_provider):
        try:
            from org.telegram.ui.Cells import TextCheckCell
            from java import dynamic_proxy
            from android.view import Gravity, View
            from android.widget import FrameLayout, ImageView, LinearLayout, TextView
            from android.graphics import PorterDuff, PorterDuffColorFilter
            dp = self._dm_dp
            plugin = self
            cell = TextCheckCell(context)
            cell.setBackgroundColor(self._dm_theme("key_windowBackgroundWhite", 0xFFFFFFFF))
            gray = self._dm_theme("key_windowBackgroundWhiteBlueText4",
                                  self._dm_theme("key_switchTrackChecked", 0xFF3A8CE6))
            box = LinearLayout(context)
            box.setOrientation(LinearLayout.HORIZONTAL)
            box.setGravity(int(Gravity.CENTER_VERTICAL))
            box.setPadding(dp(10), dp(10), dp(12), dp(10))
            count = TextView(context)
            count.setText("3")
            count.setTextSize(16.0)
            try:
                from android.graphics import Typeface
                count.setTypeface(Typeface.DEFAULT_BOLD)
            except Exception:
                pass
            count.setTextColor(gray)
            box.addView(count, LinearLayout.LayoutParams(-2, -2))
            arrow = ImageView(context)
            res = self._dm_res("arrow_more") or self._dm_res("msg_expand")
            if res:
                arrow.setImageResource(res)
            arrow.setColorFilter(PorterDuffColorFilter(gray, PorterDuff.Mode.SRC_IN))
            lp = LinearLayout.LayoutParams(dp(22), dp(22))
            lp.leftMargin = dp(3)
            box.addView(arrow, lp)
            line = View(context)
            line.setBackgroundColor(self._dm_theme("key_windowBackgroundWhiteGrayText", 0xFF8A8A8A))
            lp = LinearLayout.LayoutParams(max(1, dp(1)), dp(26))
            lp.leftMargin = dp(12)
            box.addView(line, lp)
            lp = FrameLayout.LayoutParams(-2, -2, int(Gravity.END | Gravity.CENTER_VERTICAL))
            lp.rightMargin = dp(66)
            cell.addView(box, lp)

            class _Toggle(dynamic_proxy(View.OnClickListener)):
                def onClick(self, view):
                    plugin._dm_master_toggle("cell")

            class _Expand(dynamic_proxy(View.OnClickListener)):
                def onClick(self, view):
                    try:
                        plugin._dm_last_expand = time.time()
                        value = not bool(plugin.get_setting("dm_expanded", False))
                        try:
                            arrow.animate().rotation(180.0 if value else 0.0).setDuration(150).start()
                        except Exception:
                            pass
                        plugin.set_setting("dm_expanded", value, True)
                    except Exception:
                        pass

            toggle, expand = _Toggle(), _Expand()
            self._dm_listeners += [toggle, expand]
            cell.setOnClickListener(toggle)
            box.setOnClickListener(expand)
            self._dm_master_native = {"row": cell, "arrow": box, "how": self._dm_master_native.get("how")}
            self._dm_master_rows = [cell]
            self._dm_native_fill(cell)
            return self._dm_full_width(cell)
        except Exception:
            self._dm_master_native = {}
            return self._dm_error_view(context)

    def _dm_master_bind(self, view, item, divider, adapter, list_view):
        try:
            for row in list(getattr(self, "_dm_master_rows", []) or []):
                self._dm_native_fill(row)
        except Exception:
            pass


    def _dm_circle_color(self, index):
        if index == 0:
            return self._dm_theme("key_chat_inTimeText", 0xFF8A8A8A)
        if index == DM_COLOR_CUSTOM:
            raw = str(self.get_setting("dm_color_hex", "FF5555") or "").strip()
            match = _HEX_RE.match(raw)
            return signed_color(0xFF000000 | int(match.group(1) if match else "FF5555", 16))
        return signed_color(DM_COLORS[index][1])

    def _dm_paint_circles(self, strip):
        from android.graphics.drawable import GradientDrawable
        dp = self._dm_dp
        current = self._choice("dm_color", 0, tuple(range(len(DM_COLORS))))
        ring = self._dm_theme("key_windowBackgroundWhiteBlackText", 0xFF000000)
        accent = self._dm_theme("key_switchTrackChecked", 0xFF3A8CE6)
        for index in range(strip.getChildCount()):
            circle = strip.getChildAt(index)
            color = self._dm_circle_color(index)
            shape = GradientDrawable()
            shape.setShape(GradientDrawable.OVAL)
            shape.setColor(color)
            if index == current:
                shape.setStroke(dp(3), accent if (int(color) & 0xFFFFFF) == 0xFFFFFF else ring)
            else:
                shape.setStroke(max(1, dp(1)), self._dm_theme("key_divider", 0xFF3A3A3E))
            circle.setBackground(shape)
            light = (((int(color) >> 16) & 0xFF) * 3 + ((int(color) >> 8) & 0xFF) * 6 + (int(color) & 0xFF)) > 1500
            circle.setTextColor(signed_color(0xFF000000 if light else 0xFFFFFFFF))
            if index == 0:
                circle.setText("A")
            elif index == DM_COLOR_CUSTOM:
                circle.setText("#")
            else:
                circle.setText("\u2713" if index == current else "")

    def _dm_palette_click(self, index):
        def _run():
            try:
                old = self._choice("dm_color", 0, tuple(range(len(DM_COLORS))))
                if index == old and index != DM_COLOR_CUSTOM:
                    return
                need_reload = (index == DM_COLOR_CUSTOM) != (old == DM_COLOR_CUSTOM)
                self.set_setting("dm_color", index, need_reload)
                self._dm_cfg_cache = None
                for strip in list(self._dm_palette_views):
                    try:
                        self._dm_paint_circles(strip)
                    except Exception:
                        pass
                self._dm_refresh_previews()
            except Exception:
                pass
        ui(_run)

    def _dm_palette_create(self, context, list_view, current_account, class_guid, resources_provider):
        try:
            from java import dynamic_proxy
            from android.view import Gravity, View
            from android.widget import HorizontalScrollView, LinearLayout, TextView
            dp = self._dm_dp
            root = LinearLayout(context)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(0, dp(10), 0, dp(8))
            root.setBackgroundColor(self._dm_theme("key_windowBackgroundWhite", 0xFFFFFFFF))
            title = TextView(context)
            title.setText("Цвет метки")
            title.setTextSize(16.0)
            title.setTextColor(self._dm_theme("key_windowBackgroundWhiteBlackText", 0xFF000000))
            title.setPadding(dp(21), 0, dp(21), dp(8))
            root.addView(title, LinearLayout.LayoutParams(-1, -2))
            scroll = HorizontalScrollView(context)
            scroll.setHorizontalScrollBarEnabled(False)
            strip = LinearLayout(context)
            strip.setOrientation(LinearLayout.HORIZONTAL)
            strip.setPadding(dp(15), dp(2), dp(15), dp(2))
            plugin = self

            class _Click(dynamic_proxy(View.OnClickListener)):
                def __init__(self, index):
                    super().__init__()
                    self.index = index

                def onClick(self, view):
                    plugin._dm_palette_click(self.index)

            for index in range(len(DM_COLORS)):
                circle = TextView(context)
                circle.setGravity(Gravity.CENTER)
                circle.setTextSize(15.0)
                circle.setContentDescription(DM_COLORS[index][0])
                listener = _Click(index)
                self._dm_listeners.append(listener)
                circle.setOnClickListener(listener)
                lp = LinearLayout.LayoutParams(dp(38), dp(38))
                lp.leftMargin = dp(6)
                lp.rightMargin = dp(6)
                strip.addView(circle, lp)
            scroll.addView(strip)
            root.addView(scroll, LinearLayout.LayoutParams(-1, -2))
            self._dm_palette_views.append(strip)
            self._dm_trim_views()
            self._dm_paint_circles(strip)
            return self._dm_full_width(root)
        except Exception:
            return self._dm_error_view(context)

    def _dm_palette_bind(self, view, item, divider, adapter, list_view):
        try:
            strip = view.getChildAt(1).getChildAt(0)
            if not any(v == strip for v in self._dm_palette_views):
                self._dm_palette_views.append(strip)
                self._dm_trim_views()
            self._dm_paint_circles(strip)
        except Exception:
            pass


    def _dm_info_values(self, kind):
        return "Сохранено", str(self._dm_store.total())

    def _dm_info_row(self, kind):
        if not self._dm_custom_ok():
            return None
        try:
            factory = self._dm_factories.get("info_" + kind)
            if factory is None:
                factory = SimpleSettingFactory(self._dm_info_creator(kind), self._dm_info_binder(kind),
                                               is_clickable=False)
                self._dm_factories["info_" + kind] = factory
            return Custom(factory=factory.instance.java)
        except Exception:
            return None

    @staticmethod
    def _dm_res(name):
        try:
            from org.telegram.messenger import ApplicationLoader
            ctx = ApplicationLoader.applicationContext
            return int(ctx.getResources().getIdentifier(name, "drawable", ctx.getPackageName()))
        except Exception:
            return 0

    def _dm_trim_views(self, keep=4):
        self._dm_preview_views = self._dm_preview_views[-keep:]
        self._dm_palette_views = self._dm_palette_views[-keep:]
        self._dm_info_views = {k: v[-keep:] for k, v in self._dm_info_views.items()}
        self._dm_listeners = self._dm_listeners[-200:]

    def _dm_info_fill(self, kind, root):
        title, value = self._dm_info_values(kind)
        if not self._dm_info_set(root, title, value):
            for own in self._dm_info_views.get(kind, []):
                self._dm_info_set(own, title, value)

    @staticmethod
    def _dm_info_set(root, title, value):
        try:
            if str(root.getClass().getSimpleName()) == "TextSettingsCell":
                root.setTextAndValue(title, value, False)
                return True
        except Exception:
            pass
        try:
            head = root.getChildAt(0)
            head.getChildAt(0).setText(title)
            head.getChildAt(1).setText(value)
            return True
        except Exception:
            return False

    def _dm_info_creator(self, kind):
        def _create(context, list_view, current_account, class_guid, resources_provider):
            root = None
            try:
                from org.telegram.ui.Cells import TextSettingsCell
                root = TextSettingsCell(context)
                root.setBackgroundColor(self._dm_theme("key_windowBackgroundWhite", 0xFFFFFFFF))
                title, value = self._dm_info_values(kind)
                root.setTextAndValue(title, value, False)
            except Exception:
                root = None
            if root is not None:
                try:
                    self._dm_info_views.setdefault(kind, []).append(root)
                    self._dm_trim_views()
                    self._dm_info_tick(root, kind)
                except Exception:
                    pass
                return self._dm_full_width(root)
            try:
                from android.widget import FrameLayout, LinearLayout, TextView
                from android.view import Gravity
                dp = self._dm_dp
                root = LinearLayout(context)
                root.setOrientation(LinearLayout.VERTICAL)
                root.setPadding(dp(21), dp(15), dp(21), dp(15))
                root.setBackgroundColor(self._dm_theme("key_windowBackgroundWhite", 0xFFFFFFFF))
                head = FrameLayout(context)
                title = TextView(context)
                title.setTextSize(16.0)
                title.setTextColor(self._dm_theme("key_windowBackgroundWhiteBlackText", 0xFF000000))
                head.addView(title, FrameLayout.LayoutParams(-2, -2, int(Gravity.START | Gravity.CENTER_VERTICAL)))
                value = TextView(context)
                value.setTextSize(16.0)
                value.setTextColor(self._dm_theme("key_windowBackgroundWhiteValueText", 0xFF3A8CE6))
                head.addView(value, FrameLayout.LayoutParams(-2, -2, int(Gravity.END | Gravity.CENTER_VERTICAL)))
                root.addView(head, LinearLayout.LayoutParams(-1, -2))
                self._dm_info_views.setdefault(kind, []).append(root)
                self._dm_trim_views()
                self._dm_info_fill(kind, root)
                try:
                    self._dm_info_tick(root, kind)
                except Exception:
                    pass
                return self._dm_full_width(root)
            except Exception:
                return self._dm_error_view(context)
        return _create

    def _dm_info_binder(self, kind):
        def _bind(view, item, divider, adapter, list_view):
            try:
                self._dm_info_fill(kind, view)
            except Exception:
                pass
        return _bind

    def _dm_info_tick(self, cell, kind):
        try:
            from java import dynamic_proxy
            from java.lang import Runnable
            from android.view import View
        except Exception:
            return
        plugin = self
        state = {"on": False}

        class _Tick(dynamic_proxy(Runnable)):
            def run(self):
                state["on"] = False
                try:
                    if not plugin._active or not cell.isAttachedToWindow():
                        return
                    plugin._dm_info_fill(kind, cell)
                    state["on"] = True
                    cell.postDelayed(self, 1000)
                except Exception:
                    pass

        tick = _Tick()

        class _Attach(dynamic_proxy(View.OnAttachStateChangeListener)):
            def onViewAttachedToWindow(self, view):
                try:
                    if plugin._active and not state["on"]:
                        state["on"] = True
                        cell.postDelayed(tick, 1000)
                except Exception:
                    pass

            def onViewDetachedFromWindow(self, view):
                try:
                    cell.removeCallbacks(tick)
                except Exception:
                    pass
                state["on"] = False

        attach = _Attach()
        cell.addOnAttachStateChangeListener(attach)
        self._dm_listeners += [tick, attach]
        self._dm_ticks = [t for t in self._dm_ticks if t[0] in self._dm_info_cells()][-12:] + [(cell, tick)]
        state["on"] = True
        cell.postDelayed(tick, 1000)

    def _dm_info_cells(self):
        return [c for cells in self._dm_info_views.values() for c in cells]

    def _dm_refresh_info(self):
        def _run():
            for kind, cells in list(self._dm_info_views.items()):
                for cell in list(cells):
                    try:
                        self._dm_info_fill(kind, cell)
                    except Exception:
                        pass
        ui(_run)

    def _dm_mark_text_changed(self, _value):
        self._dm_cfg_cache = None
        self._dm_refresh_previews()

    def _dm_hex_changed(self, value):
        self._dm_cfg_cache = None
        if not _HEX_RE.match(str(value or "").strip()):
            toast_err("Нужен HEX из 6 символов, например FF5555")
        else:
            self._dm_refresh_previews()

            def _repaint():
                for strip in list(self._dm_palette_views):
                    try:
                        self._dm_paint_circles(strip)
                    except Exception:
                        pass
            ui(_repaint)

    def _dm_mark_span(self, base_color, size_dp, cfg=None):
        if cfg is None:
            cfg = self._dm_cfg()
        mark = cfg["mark"]
        if not mark:
            return None
        from android.text import SpannableStringBuilder
        from android.text.style import ForegroundColorSpan
        color = cfg["color"] if cfg["color"] else base_color
        builder = SpannableStringBuilder(mark + " ")
        if mark == DM_ICON:
            span = self._dm_icon_span(size_dp)
            if span is None:
                builder = SpannableStringBuilder("\u2715 ")
            else:
                if color is not None:
                    try:
                        span.setOverrideColor(with_alpha(color, ((int(color) >> 24) & 0xFF) / 255.0 or 1.0))
                    except Exception:
                        pass
                builder.setSpan(span, 0, 1, 33)
                return builder
        if cfg["color"]:
            src_alpha = ((int(color) >> 24) & 0xFF) / 255.0 or 1.0
            builder.setSpan(ForegroundColorSpan(with_alpha(color, src_alpha)), 0, builder.length() - 1, 33)
        return builder

    def _dm_icon_span(self, size_dp):
        try:
            from org.telegram.ui.Components import ColoredImageSpan
            from org.telegram.messenger import AndroidUtilities, ApplicationLoader
            res_id = 0
            try:
                from org.telegram.messenger import R
                res_id = int(R.drawable.msg_delete)
            except Exception:
                ctx = ApplicationLoader.applicationContext
                res_id = int(ctx.getResources().getIdentifier("msg_delete", "drawable", ctx.getPackageName()))
            if not res_id:
                return None
            span = ColoredImageSpan(res_id)
            try:
                span.setSize(int(AndroidUtilities.dp(size_dp)))
            except Exception:
                pass
            return span
        except Exception:
            return None

    def _dm_preview_text(self, cfg, text_color, time_color, size_dp, line="Это сообщение было удалено"):
        from android.text import SpannableStringBuilder
        from android.text.style import ForegroundColorSpan, RelativeSizeSpan
        out = SpannableStringBuilder()
        out.append(line)
        out.setSpan(ForegroundColorSpan(with_alpha(text_color, 1.0)), 0, len(line), 33)
        out.append("\u00A0\u00A0\u00A0")
        start = out.length()
        mark = self._dm_mark_span(time_color, max(11, size_dp - 2), cfg=cfg)
        if mark is not None:
            out.append(mark)
            last = out.length() - 1
            if last >= start and str(out.charAt(last)) == " ":
                out.replace(last, last + 1, "\u00A0")
        time_start = out.length()
        out.append("12:32")
        out.setSpan(ForegroundColorSpan(with_alpha(time_color, 1.0)), time_start, out.length(), 33)
        out.setSpan(RelativeSizeSpan(0.85), start, out.length(), 33)
        if mark is not None and not cfg["color"] and time_start - start > 1:
            out.setSpan(ForegroundColorSpan(time_color), start, time_start - 1, 33)
        return out

    def _dm_cfg(self):
        now = time.time()
        cfg = self._dm_cfg_cache
        if cfg is not None and now - cfg["ts"] < DM_CFG_TTL:
            return cfg
        try:
            style = self._dm_style()
            mark = DM_STYLES[style][1]
            if mark is None:
                mark = str(self.get_setting("dm_mark_text", "удалено") or "").strip()[:20]
            color_index = self._choice("dm_color", 0, tuple(range(len(DM_COLORS))))
            hex_raw = str(self.get_setting("dm_color_hex", "FF5555") or "").strip()
            match = _HEX_RE.match(hex_raw)
            hex_value = match.group(1).upper() if match else "FF5555"
            if color_index == DM_COLOR_CUSTOM:
                color = signed_color(0xFF000000 | int(hex_value, 16))
            else:
                color = signed_color(DM_COLORS[color_index][1]) if DM_COLORS[color_index][1] else 0
            alpha_pct = self._dm_alpha_pct()
            cfg = {
                "ts": now,
                "enabled": bool(self.get_setting("dm_enabled", True)) and self._active,
                "bots": bool(self.get_setting("dm_bots", False)),
                "notif": bool(self.get_setting("dm_notif", True)),
                "selfdestruct": bool(self.get_setting("dm_selfdestruct", False)),
                "mark": mark,
                "color": color,
                "color_index": color_index,
                "hex": hex_value,
                "alpha_pct": alpha_pct,
                "alpha": 1.0 - alpha_pct / 100.0,
            }
        except Exception:
            cfg = {"ts": now, "enabled": False, "bots": False, "notif": False, "selfdestruct": False,
                   "mark": "", "color": 0, "color_index": 0, "hex": "FF5555", "alpha_pct": 0,
                   "alpha": 1.0}
        self._dm_cfg_cache = cfg
        return cfg

    def _dm_install(self):
        specs = (
            ("org.telegram.messenger.FileLoader", self._dm_spec_loader),
            ("org.telegram.messenger.MessagesStorage", self._dm_spec_storage),
            ("org.telegram.messenger.MessagesController", self._dm_spec_controller),
            ("org.telegram.ui.ChatActivity", self._dm_spec_chat),
            ("org.telegram.messenger.NotificationsController", self._dm_spec_notif),
            ("org.telegram.ui.Cells.ChatMessageCell", self._dm_spec_cell),
            ("org.telegram.ui.recyclerview.ChatListItemAnimator", self._dm_spec_anim),
            ("androidx.recyclerview.widget.ChatListItemAnimator", self._dm_spec_anim),
        )
        installed = []
        for class_name, spec in specs:
            self._dm_hook_class(class_name, spec, installed)

    def _dm_hook_class(self, class_name, spec, installed):
        clazz = java_class(class_name)
        if clazz is None:
            return
        try:
            methods = list(clazz.getDeclaredMethods())
        except Exception:
            return
        for method in methods:
            try:
                name = str(method.getName())
                types = [str(t.getName()) for t in method.getParameterTypes()]
                kind = spec(name, types)
                if not kind:
                    continue
                returns_value = str(method.getReturnType().getName()) != "void"
                self.hook_method(method, make_hook(self, kind, returns_value))
                installed.append(kind)
            except Exception:
                pass

    @staticmethod
    def _dm_spec_storage(name, types):
        if name in ("markMessagesAsDeleted", "markMessagesAsDeletedInternal") and len(types) >= 3:
            if types[0] == "long" and types[1] == "java.util.ArrayList":
                return "mark_list"
            if types[0] == "long" and types[1] == "int":
                return "mark_range"
        if name in ("updateDialogsWithDeletedMessages", "updateDialogsWithDeletedMessagesInternal"):
            if len(types) >= 3 and types[0] == "long" and types[1] == "long" and types[2] == "java.util.ArrayList":
                return "update"
        return None

    @staticmethod
    def _dm_spec_controller(name, types):
        if name == "deleteMessages" and len(types) >= 7 and types[0] == "java.util.ArrayList" and types[3] == "long":
            return "delete"
        if name == "deleteMessagesRange":
            return "range_flag"
        if name == "deleteDialog" and types and types[0] == "long":
            return "delete_dialog"
        if name == "checkDeletingTask" and types == ["boolean"]:
            return "selfdestruct"
        return None

    @staticmethod
    def _dm_spec_chat(name, types):
        if name == "processDeletedMessages" and len(types) >= 2 and types[0] in (
                "java.util.ArrayList", "java.util.List", "java.util.Collection"):
            return "process"
        return None

    @staticmethod
    def _dm_spec_notif(name, types):
        if name == "removeDeletedMessagesFromNotifications" and len(types) == 2 and types[1] == "boolean":
            return "notif"
        if name == "processNewMessages" and len(types) >= 1 and types[0] == "java.util.ArrayList":
            return "mute_notif"
        return None

    @staticmethod
    def _dm_spec_anim(name, types):
        # Telegram's chat animator resets cell alpha to 1 when animations end
        # (restoreTransitionParams, add/change listeners). Both methods run once per animation,
        # not per frame, so re-applying the dimming there is cheap.
        if name == "onAllAnimationsDone" and not types:
            return "anim_done"
        if name == "restoreTransitionParams" and types == ["android.view.View"]:
            return "anim_restore"
        return None

    @staticmethod
    def _dm_spec_cell(name, types):
        if name in ("setMessageObject", "setMessageContent") and len(types) >= 4                 and types[0] == "org.telegram.messenger.MessageObject":
            return "cell_content" if name == "setMessageContent" else "cell_bind"
        if name == "onAttachedToWindow" and not types:
            return "cell_attach"
        if name == "measureTime" and types == ["org.telegram.messenger.MessageObject"]:
            return "measure"
        return None


    def _dm_before(self, kind, param, returns_value):
        if kind == "media_load":
            self._dm_media_load(param)
            return
        if kind in MUTE_FILTER_ARG:
            self._mute_filter(kind, param, returns_value)
            return
        if kind in DM_UI_KINDS:
            return
        if kind == "range_flag":
            _dm_tls.range = getattr(_dm_tls, "range", 0) + 1
            return
        if kind == "delete":
            self._dm_on_own_delete(param)
            return
        if kind == "delete_dialog":
            self._dm_on_delete_dialog(param)
            return
        cfg = self._dm_cfg()
        if not cfg["enabled"]:
            return
        if kind == "selfdestruct":
            if cfg["selfdestruct"]:
                param.setResult(False if returns_value else None)
            return
        if kind == "notif":
            if cfg["notif"] and not bool(num(param.args[1])):
                param.setResult(None)
            return
        if range_active():
            return
        if kind == "mark_list":
            self._dm_mark_list(param, cfg, returns_value)
        elif kind == "mark_range":
            self._dm_mark_range(param, cfg, returns_value)
        elif kind == "update":
            self._dm_update_dialogs(param, cfg, returns_value)
        elif kind == "process":
            self._dm_process(param, cfg)

    def _dm_after(self, kind, param):
        if kind == "range_flag":
            _dm_tls.range = max(0, getattr(_dm_tls, "range", 0) - 1)
        elif kind in ("cell_bind", "cell_content", "cell_attach"):
            self._dm_cell_bind(param)
        elif kind == "measure":
            self._dm_measure(param)
        elif kind == "anim_restore":
            if self._dm_dimmed:
                self._dm_reapply(param.args[0])
        elif kind == "anim_done":
            if self._dm_dimmed:
                self._dm_reapply_visible()


    def _dm_prune_pending(self, now):
        if len(self._dm_pend) > 2000:
            for key in [k for k, v in self._dm_pend.items() if now - v[1] > DM_PENDING_TTL]:
                self._dm_pend.pop(key, None)
        if len(self._dm_clear) > 100:
            for key in [k for k, v in self._dm_clear.items() if now - v[0] > DM_PENDING_TTL]:
                self._dm_clear.pop(key, None)

    def _dm_on_own_delete(self, param):
        account = controller_account(param.thisObject)
        dialog_id = int(num(param.args[3]))
        mids = [m for m in ids_of(param.args[0]) if m > 0]
        if not mids:
            return
        now = time.time()
        self._dm_prune_pending(now)
        for mid in mids:
            self._dm_pend[(account, mid)] = (dialog_id, now)
        self._dm_store.remove(account, dialog_id, mids)

    def _dm_on_delete_dialog(self, param):
        account = controller_account(param.thisObject)
        dialog_id = int(num(param.args[0]))
        if not dialog_id:
            return
        now = time.time()
        self._dm_prune_pending(now)
        if self._dm_is_migration(account, dialog_id, now):
            return
        key = (account, dialog_id)
        bounds = []
        try:
            if len(param.args) >= 7:
                bounds.append(int(num(param.args[3])))
        except Exception:
            pass
        try:
            dialog = get_messages_controller(account).dialogs_dict.get(jlong(dialog_id))
            if dialog is not None:
                bounds.append(int(dialog.top_message))
        except Exception:
            pass
        prev = self._dm_clear.get(key)
        if prev is not None and now - prev[0] < DM_PENDING_TTL and prev[1]:
            bounds.append(prev[1])
        max_mid = max([b for b in bounds if b > 0] or [0]) or None
        self._dm_clear[key] = (now, max_mid)
        with self._dm_store._lock:
            bucket = self._dm_store._data.get(account, {}).get(dialog_id)
            mids = list(bucket) if bucket else []
        if mids:
            self._dm_store.remove(account, dialog_id, mids)

    def _dm_is_migration(self, account, dialog_id, now):
        if dialog_id >= 0:
            return False
        try:
            stamp = self._dm_migr.get((account, dialog_id))
            if stamp is not None and now - stamp < DM_PENDING_TTL:
                return True
            chat = self._get_chat(account, -dialog_id)
            migrated = getattr(chat, "migrated_to", None) if chat is not None else None
            channel_id = int(num(getattr(migrated, "channel_id", 0))) if migrated is not None else 0
            if channel_id:
                self._dm_migr[(account, -channel_id)] = now
                return True
        except Exception:
            pass
        return False

    def _dm_clear_active(self, account, dialog_id, mid, now):
        stamp = self._dm_clear.get((account, dialog_id))
        if stamp is None or now - stamp[0] >= DM_PENDING_TTL:
            return False
        return stamp[1] is None or mid <= stamp[1]

    def _dm_is_pending(self, account, dialog_id, mid, now):
        entry = self._dm_pend.get((account, mid))
        if entry is not None and now - entry[1] < DM_PENDING_TTL:
            if dialog_id == 0 or entry[0] == dialog_id or entry[0] == 0:
                return True
        return self._dm_clear_active(account, dialog_id, mid, now)

    def _dm_split(self, account, dialog_id, mids):
        keep, save = [], []
        now = time.time()
        for mid in mids:
            if mid <= 0 or self._dm_is_pending(account, dialog_id, mid, now):
                keep.append(mid)
            else:
                save.append(mid)
        return keep, save

    def _dm_skip_dialog(self, account, dialog_id, cfg):
        if dialog_id == 0:
            return False
        if dialog_id > 0 and (dialog_id & 0x4000000000000000) != 0:
            return True
        if dialog_id > 0 and not cfg["bots"]:
            user = self._get_user(account, dialog_id)
            if user is not None and bool(getattr(user, "bot", False)):
                return True
        return False


    @staticmethod
    def _dm_query(storage, sql):
        rows = []
        db = storage.getDatabase()
        if db is None:
            return rows
        try:
            cursor = db.queryFinalized(sql)
        except TypeError:
            from java import jarray
            from java.lang import Object
            cursor = db.queryFinalized(sql, jarray(Object)([]))
        try:
            while cursor.next():
                rows.append((int(cursor.longValue(0)), int(cursor.intValue(1))))
        finally:
            try:
                cursor.dispose()
            except Exception:
                pass
        return rows

    def _dm_resolve(self, account, storage, mids):
        groups = {}
        left = set(mids)
        try:
            sql = ("SELECT uid, mid FROM messages_v2 WHERE mid IN (%s) AND is_channel = 0"
                   % ",".join(str(int(m)) for m in mids))
            rows = self._dm_query(storage, sql)
            for uid, mid in rows:
                if mid in left and uid != 0:
                    groups.setdefault(uid, []).append(mid)
                    left.discard(mid)
        except Exception:
            pass
        if left:
            try:
                cache = get_messages_controller(account).dialogMessagesByIds
                for mid in list(left):
                    obj = cache.get(int(mid))
                    if obj is not None:
                        uid = int(obj.getDialogId())
                        if uid:
                            groups.setdefault(uid, []).append(mid)
                            left.discard(mid)
            except Exception:
                pass
        if left:
            try:
                fragment = get_last_fragment()
                if fragment is not None and str(fragment.getClass().getName()) == "org.telegram.ui.ChatActivity" \
                        and int(fragment.getCurrentAccount()) == int(account):
                    did = int(fragment.getDialogId())
                    for obj in jlist(fragment.messages):
                        mid = int(obj.getId())
                        if mid in left:
                            groups.setdefault(did, []).append(mid)
                            left.discard(mid)
            except Exception:
                pass
        if left:
            groups[0] = sorted(left)
        return groups

    def _dm_own_mids(self, storage, dialog_id, mids):
        mids = [int(m) for m in mids if int(m) > 0]
        if not mids:
            return set()
        where = ("uid = %d" % int(dialog_id)) if dialog_id else "is_channel = 0"
        sql = ("SELECT mid, out FROM messages_v2 WHERE %s AND out = 1 AND mid IN (%s)"
               % (where, ",".join(str(m) for m in mids)))
        try:
            return set(int(r[0]) for r in self._dm_query(storage, sql))
        except Exception:
            return set()

    def _dm_purge_own(self):
        if self.get_setting("dm_purged_own_v2", False):
            return
        entries = self._dm_store.snapshot()
        if not entries:
            self._dm_store.flush_now()
            self.set_setting("dm_purged_own_v2", True)
            return
        from java import dynamic_proxy
        from java.lang import Runnable
        from org.telegram.messenger import MessagesStorage
        plugin = self
        by_account = {}
        for account, dialog_id, mids in entries:
            by_account.setdefault(int(account), []).append((int(dialog_id), list(mids)))

        class _Purge(dynamic_proxy(Runnable)):
            def __init__(self, account, items):
                super().__init__()
                self.account = account
                self.items = items

            def run(self):
                removed = 0
                try:
                    storage = MessagesStorage.getInstance(self.account)
                    for dialog_id, mids in self.items:
                        for start in range(0, len(mids), 500):
                            part = mids[start:start + 500]
                            own = plugin._dm_own_mids(storage, dialog_id, part)
                            if own:
                                plugin._dm_store.remove(self.account, dialog_id, sorted(own))
                                removed += len(own)
                    plugin._dm_store.flush_now()
                    plugin.set_setting("dm_purged_own_v2", True)
                except Exception:
                    pass

        for account, items in by_account.items():
            task = _Purge(account, items)
            self._dm_listeners.append(task)
            MessagesStorage.getInstance(account).getStorageQueue().postRunnable(task)

    def _dm_intercept(self, account, storage, dialog_id, mids, cfg):
        key = (int(account), int(dialog_id), tuple(sorted(int(m) for m in mids)))
        now = time.time()
        with self._lock:
            hit = self._dm_dedup.get(key)
            if hit is not None and now - hit[0] < DM_DEDUP_TTL:
                hit = (list(hit[1]), hit[2])
            else:
                hit = None
        if hit is not None:
            return hit
        keep, saved = self._dm_intercept_now(account, storage, dialog_id, mids, cfg)
        with self._lock:
            if len(self._dm_dedup) > 200:
                self._dm_dedup = {k: v for k, v in self._dm_dedup.items() if now - v[0] < DM_DEDUP_TTL}
            self._dm_dedup[key] = (now, list(keep), saved)
        return keep, saved

    def _dm_intercept_now(self, account, storage, dialog_id, mids, cfg):
        keep, save = self._dm_split(account, dialog_id, mids)
        if save:
            own = self._dm_own_mids(storage, dialog_id, save)
            if own:
                self._dm_mark_own(account, dialog_id, own)
                keep += [m for m in save if m in own]
                save = [m for m in save if m not in own]
        if not save:
            return keep, False
        if dialog_id != 0:
            if self._dm_skip_dialog(account, dialog_id, cfg):
                return mids, False
            groups = {dialog_id: save}
        else:
            groups = self._dm_resolve(account, storage, save)
            keep += groups.pop(0, [])
        saved = False
        for did, part in groups.items():
            if self._dm_skip_dialog(account, did, cfg):
                keep += part
                continue
            own = self._dm_save(account, did, part)
            keep += own
            if len(own) < len(part):
                saved = True
        return keep, saved

    def _dm_obj_mine(self, obj):
        try:
            return bool(obj.isOut())
        except Exception:
            return False

    def _dm_mark_own(self, account, dialog_id, mids):
        now = time.time()
        for mid in mids:
            self._dm_pend[(account, int(mid))] = (int(dialog_id), now)

    def _dm_filter_own(self, account, dialog_id, mids):
        own, rest = [], []
        cache = None
        try:
            cache = get_messages_controller(account).dialogMessagesByIds
        except Exception:
            cache = None
        now = time.time()
        for mid in mids:
            if self._dm_is_pending(account, dialog_id, mid, now):
                own.append(mid)
                continue
            obj = None
            try:
                obj = cache.get(int(mid)) if cache is not None else None
                if obj is not None and int(obj.getDialogId()) != int(dialog_id):
                    obj = None
            except Exception:
                obj = None
            (own if obj is not None and self._dm_obj_mine(obj) else rest).append(mid)
        return own, rest

    def _dm_save(self, account, dialog_id, mids):
        own, mids = self._dm_filter_own(account, dialog_id, list(mids))
        if own:
            self._dm_mark_own(account, dialog_id, own)
        if not mids:
            return own

        try:
            added = self._dm_store.add(account, dialog_id, mids)

        except Exception as exc:

            self._dm_store_notice(exc)
            # Keep only previously committed markers; pass uncommitted IDs to native deletion.
            return own + [m for m in mids if not self._dm_store.has(account, dialog_id, m)]
        if added:
            self._dm_media_rescue(int(account), int(dialog_id), added)
            self._dm_refresh(account, dialog_id, added)
        return own

    def _dm_store_notice(self, exc):
        try:
            now = time.monotonic()
            with self._lock:
                if now - self._dm_store_notice_at < 30:
                    return
                self._dm_store_notice_at = now
            self.log("MultiTools deleted-marker write: " + type(exc).__name__)
        except Exception:
            pass
        if isinstance(exc, OverflowError):
            toast_err("Достигнут лимит меток удаления в чате. Новое сообщение не сохранено. "
                      "Удалите сохранённые через настройки плагина, если они больше не нужны.")
        else:
            toast_err("Не удалось записать метку удаления. Сообщение не сохранено: "
                      "проверьте свободное место и доступ к хранилищу.")

    def _dm_mark_list(self, param, cfg, returns_value):
        mids = ids_of(param.args[1])
        if not mids:
            return
        account = controller_account(param.thisObject)
        dialog_id = int(num(param.args[0]))
        keep, saved = self._dm_intercept(account, param.thisObject, dialog_id, mids, cfg)
        if not saved:
            return
        param.args[1] = int_list(keep)
        if not keep:
            param.setResult(ArrayList() if returns_value else None)

    def _dm_mark_range(self, param, cfg, returns_value):
        account = controller_account(param.thisObject)
        raw = int(num(param.args[0]))
        # Native MessagesStorage uses uid = -channelId; a negative raw value is a private dialog.
        dialog_id = -raw
        max_mid = int(num(param.args[1]))
        if not raw or max_mid <= 0:
            return
        now = time.time()
        if self._dm_clear_active(account, dialog_id, max_mid, now):
            return
        try:
            rows = self._dm_query(param.thisObject,
                                  "SELECT mid, 0 FROM messages_v2 WHERE uid = %d AND mid <= %d AND out = 0 "
                                  "ORDER BY mid DESC LIMIT %d"
                                  % (dialog_id, max_mid, DM_RANGE_LIMIT))
        except Exception:
            return
        mids = [int(r[0]) for r in rows if r[0] > 0]
        if not mids:

            return  # No identified incoming rows: never retain a range without committed markers.
        if any(self._dm_is_pending(account, dialog_id, m, now) for m in mids):
            return
        if mids:
            passthrough = self._dm_save(account, dialog_id, mids)
            if passthrough:
                return  # Persistence failure / own deletion: do not suppress the native range delete.
        param.setResult(ArrayList() if returns_value else None)

    def _dm_update_dialogs(self, param, cfg, returns_value):
        mids = ids_of(param.args[2])
        if not mids:
            return
        account = controller_account(param.thisObject)
        uid = int(num(param.args[0]))
        channel_id = int(num(param.args[1]))
        dialog_id = -channel_id if channel_id else uid
        keep, saved = self._dm_intercept(account, param.thisObject, dialog_id, mids, cfg)
        if not saved:
            return
        param.args[2] = int_list(keep)
        if not keep and not returns_value:
            param.setResult(None)

    def _dm_process(self, param, cfg):
        chat = param.thisObject
        try:
            if int(chat.getChatMode()) == 1:
                return
        except Exception:
            pass
        account = int(chat.getCurrentAccount())
        dialog_id = int(chat.getDialogId())
        channel_id = int(num(param.args[1])) if len(param.args) > 1 else 0
        if channel_id and -channel_id != dialog_id:
            return
        if not channel_id and dialog_id < 0 and self._is_channel(account, dialog_id):
            return
        if self._dm_skip_dialog(account, dialog_id, cfg):
            return
        keep, save = self._dm_split(account, dialog_id, ids_of(param.args[0]))
        if save:
            try:
                wanted = set(save)
                objs = [o for o in jlist(chat.messages) if int(o.getId()) in wanted]
                own = set(int(o.getId()) for o in objs if self._dm_obj_mine(o))
                if own:
                    self._dm_mark_own(account, dialog_id, own)
                    keep += [m for m in save if m in own]
                    save = [m for m in save if m not in own]
            except Exception:
                pass
        if not save:
            return
        keep += self._dm_save(account, dialog_id, save)
        param.args[0] = int_list(keep)


    def _dm_obj_deleted(self, account, obj):
        if obj is None:
            return False
        if bool(getattr(obj, "deleted", False)):
            return True
        return self._dm_store.has(account, int(obj.getDialogId()), int(obj.getId()))

    def _dm_cell_deleted(self, cell, obj):
        if obj is None:
            return False
        account = int(obj.currentAccount)
        if not self._dm_store.any_for(account) and not bool(getattr(obj, "deleted", False)):
            return False
        try:
            group = cell.getCurrentMessagesGroup()
            messages = group.messages if group is not None else None
            if messages is not None and messages.size() > 0:
                for item in jlist(messages):
                    if not self._dm_obj_deleted(account, item):
                        return False
                return True
        except Exception:
            pass
        return self._dm_obj_deleted(account, obj)

    def _dm_cell_bind(self, param):
        cell = param.thisObject
        # setMessageObject can defer the binding until attach/unfreeze. Never apply the
        # requested object's state to a different currently bound cell.
        obj = cell.getMessageObject()
        if not self._dm_dimmed and (obj is None or (not bool(getattr(obj, "deleted", False))
                                                     and not self._dm_store.any_for(int(obj.currentAccount)))):
            return
        cfg = self._dm_cfg()
        key = ident(cell)
        dim = (cfg["enabled"] and cfg["alpha"] < 1.0 and obj is not None
               and not bool(getattr(obj, "deletedByThanos", False)) and self._dm_cell_deleted(cell, obj))
        if dim:

            if key not in self._dm_dimmed and len(self._dm_dimmed) > 600:
                for old in list(self._dm_dimmed)[:300]:
                    self._dm_dimmed.pop(old, None)
            target = float(cfg["alpha"])
            self._dm_dimmed[key] = target
            if abs(float(cell.getAlpha()) - target) >= 0.01:
                cell.setAlpha(target)
        elif self._dm_dimmed.pop(key, None) is not None:
            cell.setAlpha(1.0)

    def _dm_reapply(self, view):
        target = self._dm_dimmed.get(ident(view))
        if target is None or not self._dm_cfg()["enabled"]:
            return
        if abs(float(view.getAlpha()) - target) >= 0.01:
            view.setAlpha(target)

    def _dm_reapply_visible(self):
        fragment = get_last_fragment()
        if fragment is None or str(fragment.getClass().getName()) != "org.telegram.ui.ChatActivity":
            return
        list_view = fragment.getChatListView()
        if list_view is None:
            return
        for i in range(int(list_view.getChildCount())):
            self._dm_reapply(list_view.getChildAt(i))


    def _dm_measure(self, param):
        cfg = self._dm_cfg()
        mark = cfg["mark"]
        if not cfg["enabled"] or not mark:
            return
        cell = param.thisObject
        obj = param.args[0]
        if obj is None or not self._dm_cell_deleted(cell, obj):
            return

        cls = "org.telegram.ui.Cells.ChatMessageCell"
        field = java_field(cls, "currentTimeString")
        if field is None:

            return
        current = field.get(cell)
        if current is None:

            return
        text = current if isinstance(current, str) else str(current.toString())
        if text.startswith(mark + " ") or text.startswith("\u2715 ") and mark == DM_ICON:
            return
        from android.text import SpannableStringBuilder
        from org.telegram.ui.ActionBar import Theme
        import math
        paint = Theme.chat_timePaint
        prefix = self._dm_mark_span(None, 13)
        if prefix is None:
            return
        try:
            builder = current if isinstance(current, SpannableStringBuilder) else SpannableStringBuilder(current)
            builder.insert(0, prefix)
            field.set(cell, builder)
        except Exception:
            field.set(cell, str(prefix.toString()) + text)

        width = 0
        try:
            from android.text.style import ReplacementSpan
            spans = prefix.getSpans(0, 1, ReplacementSpan)
            if spans is not None and len(spans) > 0:
                width = int(spans[0].getSize(paint, prefix, 0, 1, None)) + \
                    int(math.ceil(float(paint.measureText(" "))))
        except Exception:
            width = 0
        if width <= 0:
            width = int(math.ceil(float(paint.measureText(str(prefix.toString())))))
        for name in ("timeTextWidth", "timeWidth"):
            fld = java_field(cls, name)
            if fld is not None:
                fld.setInt(cell, int(fld.getInt(cell)) + width)

    def _dm_refresh(self, account, dialog_id, mids):
        wanted = set(int(m) for m in mids)

        def _run():
            try:
                from org.telegram.ui.Cells import ChatMessageCell
                fragment = get_last_fragment()
                if fragment is None or str(fragment.getClass().getName()) != "org.telegram.ui.ChatActivity":
                    return
                if int(fragment.getCurrentAccount()) != account or int(fragment.getDialogId()) != dialog_id:
                    return
                list_view = fragment.getChatListView()
                if list_view is None:
                    return
                adapter = list_view.getAdapter()
                for i in range(int(list_view.getChildCount())):
                    view = list_view.getChildAt(i)
                    if not isinstance(view, ChatMessageCell):
                        continue
                    obj = view.getMessageObject()
                    if obj is None or int(obj.getId()) not in wanted:
                        continue
                    try:
                        view.forceResetMessageObject()
                    except Exception:
                        pass
                    pos = int(list_view.getChildAdapterPosition(view))
                    if adapter is not None and pos >= 0:
                        adapter.notifyItemChanged(pos)
                    view.requestLayout()
                    view.invalidate()
            except Exception:
                pass
        ui(_run)


    def _dm_on_clear(self, _view=None):
        total = self._dm_store.total()
        if not total:
            toast_info("Сохранённых нет")
            return
        self._confirm("Удалить сохранённые?",
                      "%d %s исчезнут из чатов на этом устройстве." % (total, plural_ru(total)),
                      "Удалить", self._dm_clear_now)

    def _dm_clear_now(self):
        entries = self._dm_store.snapshot()

        def _run():
            failed = 0
            for account, dialog_id, mids in entries:
                try:
                    controller = get_messages_controller(int(account))
                    for start in range(0, len(mids), HARD_LIMIT):
                        controller.deleteMessages(int_list(mids[start:start + HARD_LIMIT]), None, None,
                                                  int(dialog_id), 0, False, 0, True)
                except Exception:
                    failed += 1
            self._dm_store.clear()
            self._dm_store.flush_now()
            self._dm_refresh_info()
            if failed:
                toast_err("Часть сообщений не удалось убрать")
            else:
                toast_ok("Сохранённые удалены")
            self._reload_settings()
        ui(_run)


