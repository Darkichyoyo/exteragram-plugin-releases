# Generated by tools/build_diagnostics.py; edit canonical diagnostics sources.

# --- core.py ---
"""Bounded structured diagnostics journal. No Android, networking, settings or private data access."""
from collections import deque
from dataclasses import dataclass
from datetime import datetime, timezone
import os
from pathlib import Path
import re
import threading
import uuid


def utc_time():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def physical_lines(text):
    """LF-normalized text: a terminating LF is not an extra empty line."""
    return 0 if not text else text.count("\n") + (not text.endswith("\n"))


def redact(text):
    """Best-effort guard, NOT a privacy guarantee. Producers must log safe events."""
    text = re.sub(r"(?i)\b(token|password|secret|authorization|api[_-]?key)\s*[:=]\s*[^\s]+",
                  r"\1=[redacted]", text)
    text = re.sub(r"(?i)\bBearer\s+[^\s]+", "Bearer [redacted]", text)
    text = re.sub(r"(?:github_pat_|gh[pousr]_)[A-Za-z0-9_]+", "[redacted]", text)
    text = re.sub(r"\b\d{8,}:[A-Za-z0-9_-]{20,}\b", "[redacted]", text)
    text = re.sub(r"[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}", "[email]", text)
    text = re.sub(r"https?://[^\s]+", "[url]", text)
    return text


@dataclass(frozen=True)
class ReportSnapshot:
    revision: int
    text: str

    @property
    def lines(self):
        return physical_lines(self.text)

    @property
    def utf8(self):
        return self.text.encode("utf-8")


# Severity order for filters. "LOG" entries from the SDK logger map onto these levels.
LEVELS = ("DEBUG", "INFO", "WARN", "ERROR")
# Built-in categories; components may add new ones (any short UPPER_CASE word, see PROJECT.md).
CATEGORIES = ("PLUGIN", "HOOK", "EVENT", "NETWORK", "UPDATE", "UI", "ERROR", "LOG")
_CATEGORY = re.compile(r"[A-Z][A-Z0-9_]{1,15}")
_LEVEL_ALIASES = {"WARNING": "WARN", "VERBOSE": "DEBUG", "FATAL": "ERROR", "CRITICAL": "ERROR"}


def normalize_level(level):
    text = str(level or "INFO").upper()
    text = _LEVEL_ALIASES.get(text, text)
    return text if text in LEVELS else "INFO"


def level_rank(level):
    return LEVELS.index(normalize_level(level))


def _clean(value, limit):
    text = value if isinstance(value, str) else repr(value) if isinstance(value, (bool, int, float)) \
        else type(value).__name__
    text = redact(text.replace("\r\n", "\n").replace("\r", "\n")[:limit])
    return text.encode("utf-8", errors="replace").decode("utf-8")


@dataclass(frozen=True)
class LogEntry:
    """One structured journal record. All text fields are already redacted and bounded."""
    seq: int
    time: str
    level: str
    category: str
    component: str
    event: str
    result: str = ""
    details: tuple = ()
    trace: tuple = ()
    raw: str = ""  # verbatim (bounded) text for free-form records such as SDK logger lines

    def render(self):
        if self.raw:
            return self.raw
        head = f"{self.time} {self.level} {self.category}/{self.component} {self.event}"
        if self.result:
            head += " -> " + self.result
        if self.details:
            head += " | " + " ".join(f"{k}={v}" for k, v in self.details)
        return head + "\n" + "".join("  " + line + "\n" for line in self.trace)

    def matches(self, min_level=None, category=None, component=None, text=None):
        if min_level and level_rank(self.level) < level_rank(min_level):
            return False
        if category and self.category != category:
            return False
        if component and self.component != component:
            return False
        if text and text.casefold() not in self.render().casefold():
            return False
        return True


class DiagnosticStore:
    """Bounded, thread-safe journal. Old entries are evicted first (FIFO) by bytes/lines/count."""
    MARKER = "[older entries removed]\n"
    ENTRY_MARKER = "[entry truncated]\n"

    def __init__(self, max_bytes=256 * 1024, max_lines=2000, max_entries=1500, clock=utc_time):
        if max_bytes < 128 or max_lines < 4 or max_entries < 1:
            raise ValueError("Budget requires at least 128 bytes, 4 lines and 1 entry")
        self.max_bytes, self.max_lines, self.max_entries = max_bytes, max_lines, max_entries
        self._clock = clock
        self._entries = deque()  # (LogEntry, rendered text, bytes, lines)
        self._bytes = self._lines = 0
        self._trimmed = False
        self.evicted = 0
        self._seq = 0
        self._lock = threading.RLock()
        self._revision = 0
        self._current = ReportSnapshot(0, "")
        self._observers = {}
        self._next_observer = 0
        self.observer_failures = 0

    def _entry(self, text):
        if not isinstance(text, str):
            raise TypeError("Log text must be a string, not a dumped object")
        budget = min(16 * 1024, self.max_bytes - len(self.MARKER.encode()))
        line_budget = min(256, self.max_lines - 1)
        # Slice before normalization/encoding/redaction to bound our allocations.
        clipped = len(text) > budget
        text = redact(text[:budget].replace("\r\n", "\n").replace("\r", "\n"))
        text = text.encode("utf-8", errors="replace").decode("utf-8")
        if not text.endswith("\n"):
            text += "\n"
        if clipped or len(text.encode()) > budget or physical_lines(text) > line_budget:
            available = budget - len(self.ENTRY_MARKER.encode())
            text = text.encode()[:available].decode("utf-8", errors="ignore")
            text = "\n".join(text.split("\n")[:line_budget - 1]).rstrip("\n")
            # Reserve LF in addition to the marker (multi-byte safe).
            text = text.encode()[:max(0, available - 1)].decode("utf-8", errors="ignore")
            text = text.rstrip("\n") + "\n" + self.ENTRY_MARKER
        return text

    def _commit(self):
        # Lazy: the full text is rebuilt only when someone reads a snapshot (hot paths stay O(1)).
        self._revision += 1
        return self._revision, tuple(self._observers.values())

    def _notify(self, revision, observers):
        for observer in observers:
            try:
                observer(revision)  # outside data lock; callbacks may arrive out of order
            except Exception:
                with self._lock:
                    self.observer_failures += 1

    def _store(self, build):
        with self._lock:
            self._seq += 1
            entry = build(self._seq)
            text = self._entry(entry.render())
            size, lines = len(text.encode()), physical_lines(text)
            self._entries.append((entry, text, size, lines))
            self._bytes += size
            self._lines += lines
            # Rendered marker participates in BOTH limits.
            while (self._bytes + (len(self.MARKER.encode()) if self._trimmed else 0) > self.max_bytes
                   or self._lines + int(self._trimmed) > self.max_lines
                   or len(self._entries) > self.max_entries):
                _, _, nbytes, nlines = self._entries.popleft()
                self._bytes -= nbytes
                self._lines -= nlines
                self._trimmed = True
                self.evicted += 1
            rev, observers = self._commit()
        self._notify(rev, observers)
        return entry

    def append(self, text, level="INFO", category="LOG", component="sdk-logger"):
        """Free-form line (kept verbatim after redaction/bounds), e.g. an SDK logger record."""
        if not isinstance(text, str):
            raise TypeError("Log text must be a string, not a dumped object")
        level, category = normalize_level(level), self._category(category)
        component = _clean(component, 40) or "unknown"
        raw = self._entry(text)
        first = raw.split("\n", 1)[0][:200]
        return self._store(lambda seq: LogEntry(seq, self._clock(), level, category, component,
                                                first, raw=raw))

    @staticmethod
    def _category(category):
        text = str(category or "PLUGIN").upper()
        return text if _CATEGORY.fullmatch(text) else "PLUGIN"

    def record(self, level, category, component, event, result="", details=None, trace=()):
        """Structured entry: time, level, category, component, event name, result, k=v details."""
        level, category = normalize_level(level), self._category(category)
        items = list(details.items()) if isinstance(details, dict) else list(details or ())
        clean_details = tuple((_clean(k, 32).replace(" ", "_"), _clean(v, 200).replace("\n", " "))
                              for k, v in items[:16])
        clean_trace = tuple(_clean(line, 300).replace("\n", " ") for line in list(trace)[:40])
        return self._store(lambda seq: LogEntry(
            seq, self._clock(), level, category, _clean(component, 40) or "unknown",
            _clean(event, 200).replace("\n", " "), _clean(result, 300).replace("\n", " "),
            clean_details, clean_trace))

    def event(self, level, event, category="PLUGIN", component="core"):
        """Legacy one-line API, kept for host plugins that already call it."""
        lines = str(event)[:16384].split("\n")
        return self.record(level, category, component, lines[0], trace=lines[1:])

    def exception(self, exc, event="operation failed", category="ERROR", component="core",
                  include_message=False, details=None):
        """Type + bounded frames. Message only on explicit opt-in (it may contain private data)."""
        return self.record("ERROR", category, component, event,
                           result=type(exc).__name__, details=details, trace=exception_frames(exc, include_message))

    def clear(self, confirmed=False):
        if not confirmed:
            return False
        with self._lock:
            self._entries.clear()
            self._bytes = self._lines = 0
            self._trimmed = False
            rev, observers = self._commit()
        self._notify(rev, observers)
        return True

    def snapshot(self):
        with self._lock:
            if self._current.revision != self._revision:
                prefix = self.MARKER if self._trimmed else ""
                self._current = ReportSnapshot(self._revision, prefix + "".join(item[1] for item in self._entries))
            return self._current

    def entries(self):
        with self._lock:
            return tuple(item[0] for item in self._entries)

    def query(self, min_level=None, category=None, component=None, text=None, limit=None):
        """Chronological (oldest first) entries matching ALL given filters; limit keeps the newest."""
        found = [e for e in self.entries() if e.matches(min_level, category, component, text)]
        return found[-limit:] if limit else found

    @staticmethod
    def render(entries):
        return "".join(entry.render() for entry in entries)

    def stats(self):
        levels, categories, components = {}, {}, {}
        for entry in self.entries():
            levels[entry.level] = levels.get(entry.level, 0) + 1
            categories[entry.category] = categories.get(entry.category, 0) + 1
            components[entry.component] = components.get(entry.component, 0) + 1
        return {"levels": levels, "categories": categories, "components": components,
                "evicted": self.evicted, "entries": sum(levels.values())}

    def subscribe(self, observer):
        with self._lock:
            if len(self._observers) >= 8:
                raise RuntimeError("Too many diagnostics observers")
            key = self._next_observer
            self._next_observer += 1
            self._observers[key] = observer
        def unsubscribe():
            with self._lock:
                self._observers.pop(key, None)
        return unsubscribe


def exception_frames(exc, include_message=False, limit=24):
    """Exception type, optional redacted message and file:line frames. Never locals or source lines."""
    frames = []
    tb = getattr(exc, "__traceback__", None)
    while tb is not None and len(frames) < limit:
        frames.append(f"{Path(tb.tb_frame.f_code.co_filename).name}:{tb.tb_lineno} "
                      f"in {tb.tb_frame.f_code.co_name}")
        tb = tb.tb_next
    head = type(exc).__name__
    if include_message:
        message = str(exc).strip().split("\n")[0][:300]
        if message:
            head += ": " + message
    return [head] + frames


class RateLimiter:
    """Per-key budget per window so hot paths cannot flood the journal; counts what was dropped."""
    def __init__(self, per_window=30, window=60.0, clock=None):
        import time
        self.per_window, self.window = per_window, window
        self._clock = clock or time.monotonic
        self._lock = threading.Lock()
        self._state = {}

    def allow(self, key):
        """Returns (allowed, dropped_since_last_allowed)."""
        with self._lock:
            now = self._clock()
            start, used, dropped = self._state.get(key, (now, 0, 0))
            if now - start >= self.window:
                start, used = now, 0
            if used < self.per_window:
                self._state[key] = (start, used + 1, 0)
                return True, dropped
            self._state[key] = (start, used, dropped + 1)
            return False, dropped + 1


class LiveUpdates:
    """At most one pending UI job. Read CURRENT snapshot, not notification payload."""
    def __init__(self, store, schedule, display):
        self.store, self.schedule, self.display = store, schedule, display
        self._lock = threading.RLock()
        self._pending = False
        self._closed = False
        self.last_error = None
        self._unsubscribe = store.subscribe(self.changed)

    def changed(self, _revision=0):
        with self._lock:
            if self._pending or self._closed:
                return
            self._pending = True
        try:
            self.schedule(self._flush)
        except Exception as exc:
            with self._lock:
                self._pending = False
                self.last_error = type(exc).__name__

    def _flush(self):
        with self._lock:
            self._pending = False
            if self._closed:
                return
        try:
            self.display(self.store.snapshot())
        except Exception as exc:
            self.last_error = type(exc).__name__

    def close(self):
        with self._lock:
            self._closed = True
        self._unsubscribe()


class ExportError(RuntimeError):
    pass


def publish_report(snapshot, backend):
    """Create/write/publish a NEW destination; roll back only that destination."""
    handle = backend.create("diagnostic-" + uuid.uuid4().hex + ".txt")
    if handle is None:
        raise ExportError("Cannot create destination")
    try:
        backend.write(handle, snapshot.text)
        backend.publish(handle)
    except Exception as exc:
        try:
            backend.delete(handle)
        except Exception as cleanup:
            raise ExportError("Export failed; cleanup failed: " + type(cleanup).__name__) from exc
        raise ExportError("Export failed: " + type(exc).__name__) from exc
    return handle


def export_utf8(snapshot, directory):
    """Desktop/test export. Never overwrite existing files or touch settings."""
    target = Path(directory) / ("diagnostic-" + uuid.uuid4().hex + ".txt")
    created = False
    try:
        with target.open("xb") as output:
            created = True
            output.write(snapshot.utf8)
            output.flush()
            os.fsync(output.fileno())
    except Exception:
        if created:
            target.unlink(missing_ok=True)
        raise
    return target

# --- hooks.py ---
"""Hook registry: lookup -> install/registration -> real invocation, tracked as SEPARATE states.

Pure Python. Reflection and the SDK hook calls are injected, so this module is reusable by any host
plugin and testable without Android. A found method is not an installed hook; an installed hook is
not a confirmed call. Zero calls is reported as "not confirmed", never as a failure or a success.
"""
import threading
import time


# Lookup (where is the target?)
PENDING, FOUND = "PENDING", "FOUND"
CLASS_NOT_FOUND, METHOD_NOT_FOUND = "CLASS_NOT_FOUND", "METHOD_NOT_FOUND"
NO_MATCHING_OVERLOAD, LOOKUP_ERROR, NOT_APPLICABLE = "NO_MATCHING_OVERLOAD", "LOOKUP_ERROR", "NOT_APPLICABLE"
# Installation (did the SDK accept it?)
NOT_ATTEMPTED, INSTALLED, PARTIAL = "NOT_ATTEMPTED", "INSTALLED", "PARTIAL"
REGISTERED, INSTALL_FAILED, DISABLED, REMOVED = "REGISTERED", "INSTALL_FAILED", "DISABLED", "REMOVED"

LOOKUP_PROBLEMS = (CLASS_NOT_FOUND, METHOD_NOT_FOUND, NO_MATCHING_OVERLOAD, LOOKUP_ERROR)
INSTALL_PROBLEMS = (INSTALL_FAILED, PARTIAL)
KINDS = ("xposed", "request", "update", "send_message", "handler")

VERDICTS = {
    CLASS_NOT_FOUND: "Класс не найден (переименован/удалён в этой версии клиента?)",
    METHOD_NOT_FOUND: "Класс найден, метода с таким именем нет",
    NO_MATCHING_OVERLOAD: "Метод есть, но нет перегрузки с нужной сигнатурой (сигнатура изменилась?)",
    LOOKUP_ERROR: "Ошибка при поиске цели",
    INSTALL_FAILED: "Цель найдена, но установка хука не удалась",
    PARTIAL: "Установлена только часть перегрузок",
    "HANDLER_ERRORS": "Хук вызывается, но обработчик завершался исключением",
    "ACTIVE": "Работает: реальные вызовы подтверждены",
    "WAITING_INSTALLED": "Установлен; вызов пока не наблюдался (это не ошибка: событие могло ещё не произойти)",
    "WAITING_REGISTERED": "Зарегистрирован в SDK; вызов пока не наблюдался (это не ошибка)",
    "FOUND_NOT_INSTALLED": "Цель найдена, установка не выполнялась",
    "PENDING": "Поиск цели не выполнялся",
    DISABLED: "Не регистрировался: выключено настройкой",
    "REMOVED_CALLED": "Снят; до снятия вызовы подтверждены",
    "REMOVED_SILENT": "Снят; вызовов не было",
}


class HookState:
    """Mutable record guarded by the registry lock. Read through HookRegistry.snapshot()."""
    def __init__(self, hook_id, purpose, kind, target, method, params):
        self.id, self.purpose, self.kind = hook_id, purpose, kind
        self.target, self.method, self.params = target, method, params
        self.lookup, self.lookup_detail = (PENDING if kind == "xposed" else NOT_APPLICABLE), ""
        self.signatures, self.matched = (), 0
        self.install, self.install_detail = NOT_ATTEMPTED, ""
        self.installed_at, self.handles = None, []
        self.calls, self.errors = 0, 0
        self.first_call = self.last_call = None
        self.last_error = None  # dict(stage, frames, context)
        self.lookup_failed_at = None  # "find_class" | "methods" when lookup raised

    def copy(self):
        clone = HookState.__new__(HookState)
        clone.__dict__.update(self.__dict__)
        clone.handles = list(self.handles)
        clone.last_error = dict(self.last_error) if self.last_error else None
        return clone


def verdict_code(state):
    if state.lookup in LOOKUP_PROBLEMS:
        return state.lookup
    if state.install == DISABLED:
        return DISABLED
    if state.install in INSTALL_PROBLEMS:
        return state.install
    if state.errors:
        return "HANDLER_ERRORS"
    if state.install == REMOVED:
        return "REMOVED_CALLED" if state.calls else "REMOVED_SILENT"
    if state.calls:
        return "ACTIVE"
    if state.install == INSTALLED:
        return "WAITING_INSTALLED"
    if state.install == REGISTERED:
        return "WAITING_REGISTERED"
    if state.lookup == FOUND:
        return "FOUND_NOT_INSTALLED"
    return "PENDING"


def stages(state):
    """The six facts kept SEPARATE (never merged into one SUCCESS):
    class -> method -> signature -> install -> call observed -> handler result."""
    unknown = "—"
    cls = method = signature = unknown
    if state.kind == "xposed":
        lookup = state.lookup
        if lookup == CLASS_NOT_FOUND:
            cls = "НЕ_НАЙДЕН"
        elif lookup == LOOKUP_ERROR and state.lookup_failed_at == "find_class":
            cls = "ОШИБКА_ПОИСКА"
        elif lookup in (FOUND, METHOD_NOT_FOUND, NO_MATCHING_OVERLOAD) or \
                (lookup == LOOKUP_ERROR and state.lookup_failed_at == "methods"):
            cls = "НАЙДЕН"
        if cls == "НАЙДЕН":
            if lookup == METHOD_NOT_FOUND:
                method = "НЕ_НАЙДЕН"
            elif lookup == LOOKUP_ERROR:
                method = "ОШИБКА_ПОИСКА"
            else:
                method = "НАЙДЕН"
        if method == "НАЙДЕН":
            signature = "ПОДХОДИТ" if lookup == FOUND else "НЕ_ПОДХОДИТ"
    install = {INSTALLED: "ПОДТВЕРЖДЕНА", REGISTERED: "ПРИНЯТА_SDK", PARTIAL: "ЧАСТИЧНО",
               INSTALL_FAILED: "ОШИБКА", DISABLED: "ВЫКЛЮЧЕНА", REMOVED: "СНЯТ",
               NOT_ATTEMPTED: "НЕ_ВЫПОЛНЯЛАСЬ"}.get(state.install, state.install)
    called = f"НАБЛЮДАЛСЯ({state.calls})" if state.calls else "ЕЩЁ_НЕ_НАБЛЮДАЛСЯ"
    if not state.calls and not state.errors:
        handler = unknown
    elif state.errors:
        handler = f"ОШИБКИ({state.errors})"
    else:
        handler = "УСПЕШНО"
    return (("класс", cls), ("метод", method), ("сигнатура", signature), ("установка", install),
            ("вызов", called), ("обработчик", handler))


def is_problem(state):
    return verdict_code(state) in LOOKUP_PROBLEMS + INSTALL_PROBLEMS + ("HANDLER_ERRORS",)


def describe(state, now=None):
    """Multi-line, copyable, privacy-safe report for one hook."""
    code = verdict_code(state)
    now = time.time() if now is None else now
    target = state.target + ("." + state.method if state.method else "")
    lines = [f"Хук: {state.id} ({state.kind})", f"Назначение: {state.purpose}", f"Цель: {target}"]
    if state.params is not None:
        lines.append("Ожидаемая сигнатура: (" + ", ".join(state.params) + ")")
    if state.kind == "xposed":
        lines.append(f"Поиск: {state.lookup}" + (f" — {state.lookup_detail}" if state.lookup_detail else ""))
        lines.append(f"Найдено перегрузок с этим именем: {len(state.signatures)}; подходящих: {state.matched}")
        lines += ["  " + sig for sig in state.signatures[:12]]
    lines.append(f"Установка: {state.install}" + (f" — {state.install_detail}" if state.install_detail else ""))
    if state.installed_at:
        lines.append(f"Установлен {int(now - state.installed_at)} с назад")
    lines.append("Этапы: " + " ".join(f"{k}={v}" for k, v in stages(state)))
    lines.append(f"Вызовов: {state.calls}; без ошибок: {max(0, state.calls - state.errors)}; "
                 f"ошибок обработчика: {state.errors}")
    if state.calls:
        lines.append(f"Последний вызов {int(now - state.last_call)} с назад")
    if state.last_error:
        lines.append(f"Последняя ошибка ({state.last_error['stage']}): {state.last_error['context']}")
        lines += ["  " + f for f in state.last_error["frames"]]
    lines.append("Вывод: " + VERDICTS.get(code, code))
    return "\n".join(lines) + "\n"


class HookRegistry:
    """Records every stage into the journal (category HOOK). Thread-safe; handlers must stay cheap."""
    MAX_HOOKS = 64

    def __init__(self, store, clock=time.time):
        self.store, self._clock = store, clock
        self._lock = threading.RLock()
        self._hooks = {}

    def _log(self, level, state, event, result="", **details):
        self.store.record(level, "HOOK", state.id, event, result, details)

    def declare(self, hook_id, purpose, kind, target, method=None, params=None):
        if kind not in KINDS:
            raise ValueError("Unknown hook kind: " + str(kind))
        with self._lock:
            if hook_id in self._hooks:
                return self._hooks[hook_id]
            if len(self._hooks) >= self.MAX_HOOKS:
                raise RuntimeError("Too many tracked hooks")
            state = HookState(hook_id, purpose, kind, target, method,
                              tuple(params) if params is not None else None)
            self._hooks[hook_id] = state
        self._log("DEBUG", state, "declared", "", kind=kind, target=target, method=method or "-")
        return state

    def get(self, hook_id):
        with self._lock:
            return self._hooks[hook_id]

    def snapshot(self):
        with self._lock:
            return [state.copy() for state in self._hooks.values()]

    def problems(self):
        return [state for state in self.snapshot() if is_problem(state)]

    # --- lookup -------------------------------------------------------------------------------
    def lookup(self, hook_id, reflection):
        """reflection.find_class(name) -> class|None; reflection.methods(cls, name) ->
        [(java_method, "name(type, ...)", ("type", ...)), ...]. Returns matching Java methods."""
        state = self.get(hook_id)
        try:
            cls = reflection.find_class(state.target)
        except Exception as exc:
            return self._lookup_failed(state, LOOKUP_ERROR, "find_class", exc)
        if cls is None:
            with self._lock:
                state.lookup, state.lookup_detail = CLASS_NOT_FOUND, "find_class вернул None"
            self._log("ERROR", state, "lookup", CLASS_NOT_FOUND, target=state.target)
            return []
        try:
            candidates = list(reflection.methods(cls, state.method))
        except Exception as exc:
            return self._lookup_failed(state, LOOKUP_ERROR, "methods", exc)
        signatures = tuple(sig for _, sig, _ in candidates)
        matched = [m for m, _, types in candidates if state.params is None or tuple(types) == state.params]
        with self._lock:
            state.signatures, state.matched = signatures, len(matched)
            if not candidates:
                state.lookup, state.lookup_detail = METHOD_NOT_FOUND, "в классе нет метода " + str(state.method)
            elif not matched:
                state.lookup = NO_MATCHING_OVERLOAD
                state.lookup_detail = "нужна (" + ", ".join(state.params or ()) + ")"
            else:
                state.lookup, state.lookup_detail = FOUND, ""
        level = "INFO" if matched else "ERROR"
        self._log(level, state, "lookup", state.lookup, overloads=len(candidates), matched=len(matched),
                  signatures="; ".join(signatures[:6]) or "-")
        return matched

    def _lookup_failed(self, state, code, stage, exc):
        frames = exception_frames(exc, include_message=True)  # reflection errors are technical
        with self._lock:
            state.lookup, state.lookup_detail = code, f"{stage}: {frames[0]}"
            state.lookup_failed_at = stage
            state.last_error = {"stage": "lookup", "context": stage, "frames": frames}
        self.store.record("ERROR", "HOOK", state.id, "lookup", code, {"stage": stage}, frames)
        return []

    # --- installation -------------------------------------------------------------------------
    def install(self, hook_id, methods, installer):
        """installer(java_method) -> unhook handle (falsy = rejected). Each overload is separate."""
        state = self.get(hook_id)
        ok = failed = 0
        for method in methods:
            try:
                handle = installer(method)
            except Exception as exc:
                failed += 1
                self._error(state, "install", "installer raised", exc, include_message=True)
                continue
            if not handle:
                failed += 1
                self._log("ERROR", state, "install", "REJECTED", reason="SDK returned no unhook handle")
                continue
            ok += 1
            with self._lock:
                state.handles.append(handle)
        with self._lock:
            if ok and not failed:
                state.install, state.install_detail = INSTALLED, f"{ok} перегрузк(и)"
            elif ok:
                state.install, state.install_detail = PARTIAL, f"успешно {ok}, ошибок {failed}"
            elif failed:
                state.install, state.install_detail = INSTALL_FAILED, f"ошибок {failed}"
            else:
                state.install_detail = "нет найденных целей — установка не выполнялась"
            if ok:
                state.installed_at = self._clock()
        level = "INFO" if ok and not failed else "ERROR" if failed else "WARN"
        self._log(level, state, "install", state.install, installed=ok, failed=failed,
                  note="call not yet confirmed" if ok else "-")
        return ok

    def register(self, hook_id, register, enabled=True):
        """SDK name-based hooks (add_hook/add_on_send_message_hook). Acceptance != invocation."""
        state = self.get(hook_id)
        if not enabled:
            with self._lock:
                state.install, state.install_detail = DISABLED, "выключено настройкой"
            self._log("INFO", state, "register", DISABLED)
            return False
        with self._lock:
            if state.install == REGISTERED:
                return True
        try:
            returned = register()
        except Exception as exc:
            with self._lock:
                state.install, state.install_detail = INSTALL_FAILED, "регистрация вызвала исключение"
            self._error(state, "register", "SDK registration raised", exc, include_message=True)
            return False
        with self._lock:
            state.install = REGISTERED
            state.install_detail = "SDK принял регистрацию"
            state.installed_at = self._clock()
        self._log("INFO", state, "register", REGISTERED, returned=type(returned).__name__,
                  note="invocation not yet confirmed")
        return True

    def uninstall(self, hook_id, unhook):
        state = self.get(hook_id)
        with self._lock:
            handles, state.handles = list(state.handles), []
        failed = 0
        for handle in handles:
            try:
                unhook(handle)
            except Exception as exc:
                failed += 1
                self._error(state, "uninstall", "unhook raised", exc, include_message=True)
        with self._lock:
            if handles:
                state.install = REMOVED
        self._log("INFO" if not failed else "ERROR", state, "uninstall", REMOVED if handles else "NOTHING",
                  removed=len(handles) - failed, failed=failed, calls_before_removal=state.calls)
        return not failed

    # --- invocation ---------------------------------------------------------------------------
    def called(self, hook_id):
        with self._lock:
            state = self._hooks.get(hook_id)
            if state is None:
                return 0
            state.calls += 1
            now = self._clock()
            state.last_call = now
            first = state.first_call is None
            if first:
                state.first_call = now
            calls = state.calls
        if first:
            self._log("INFO", state, "invocation", "FIRST_CALL_CONFIRMED")
        elif calls in (10, 100, 1000, 10000, 100000):
            self._log("DEBUG", state, "invocation", "MILESTONE", calls=calls)
        return calls

    def failed(self, hook_id, stage, exc, context="", include_message=False):
        self._error(self.get(hook_id), stage, context, exc, include_message)

    def _error(self, state, stage, context, exc, include_message=False):
        frames = exception_frames(exc, include_message)
        with self._lock:
            if stage == "handler":
                state.errors += 1
            state.last_error = {"stage": stage, "context": context or stage, "frames": frames}
            errors = state.errors
        if stage != "handler" or errors <= 20 or errors in (100, 1000, 10000):
            self.store.record("ERROR", "HOOK", state.id, stage, type(exc).__name__,
                              {"context": context or stage, "handler_errors": errors}, frames)

    def guard(self, hook_id, fn, default=None, context="handler", count=True):
        """Wrap a hook/handler: counts the REAL call and never lets an exception escape to Java/SDK."""
        def wrapper(*args, **kwargs):
            if count:
                try:
                    self.called(hook_id)
                except Exception:
                    pass
            try:
                return fn(*args, **kwargs)
            except Exception as exc:
                try:
                    self.failed(hook_id, "handler", exc, context)
                except Exception:
                    pass
                return default
        return wrapper

    def report(self, now=None):
        states = self.snapshot()
        problems = [s for s in states if is_problem(s)]
        head = f"Хуков отслеживается: {len(states)}; проблем: {len(problems)}\n"
        return head + "\n".join(describe(s, now) for s in states)

# --- events.py ---
"""Client event observation through DOCUMENTED SDK hooks only (add_hook / add_on_send_message_hook).

Privacy by default: no message text, captions, reaction emoji, usernames or peer/message IDs.
Only request/update names, account index, peer TYPE, counts, flags, timing and TL error code/text.
Observation starts automatically at plugin load; there is no switch and no "detailed IDs" mode.

Stages (they are different facts and are logged separately):
  LOCAL     on_send_message_hook: the client prepared an outgoing message (before network);
  ATTEMPT   pre_request_hook: the request is leaving towards the server;
  CONFIRMED post_request_hook without error: the server answered successfully;
  FAILED    post_request_hook with TL error;
  SERVER    on_update_hook: a server update (edit/delete/reaction/id assignment) arrived;
  CALLED    Xposed after-hook on a CLIENT_POINTS method: the client method actually ran (args unread).
"""
import threading
import time


# request name -> (action, purpose). Names are TLRPC class names as used by the SDK docs.
REQUESTS = {
    "TL_messages_sendMessage": ("send", "отправка текстового сообщения"),
    "TL_messages_sendMedia": ("send", "отправка медиа"),
    "TL_messages_sendMultiMedia": ("send", "отправка альбома"),
    "TL_messages_editMessage": ("edit", "редактирование сообщения"),
    "TL_messages_deleteMessages": ("delete", "удаление сообщений (личные чаты/группы)"),
    "TL_channels_deleteMessages": ("delete", "удаление сообщений в канале/супергруппе"),
    "TL_messages_sendReaction": ("reaction", "установка/снятие реакции"),
    "TL_messages_forwardMessages": ("forward", "пересылка сообщений"),
    "TL_messages_updatePinnedMessage": ("pin", "закрепление/открепление сообщения"),
}
# Incoming-message updates are deliberately NOT observed (volume + privacy).
UPDATES = {
    "TL_updateMessageID": ("send", "сервер присвоил ID отправленному сообщению"),
    "TL_updateEditMessage": ("edit", "сообщение изменено"),
    "TL_updateEditChannelMessage": ("edit", "сообщение в канале изменено"),
    "TL_updateDeleteMessages": ("delete", "сообщения удалены"),
    "TL_updateDeleteChannelMessages": ("delete", "сообщения в канале удалены"),
    "TL_updateMessageReactions": ("reaction", "реакции сообщения изменились"),
    "TL_updatePinnedMessages": ("pin", "закреплённые сообщения изменились"),
    "TL_updatePinnedChannelMessages": ("pin", "закреплённые сообщения канала изменились"),
}
SEND_HOOK = "event.send_message_hook"
# Low-frequency, user-action client methods (Telegram-Android open source names; HYPOTHESIS for the
# installed client until the journal shows lookup FOUND + FIRST_CALL_CONFIRMED). Observation-only
# after-hooks on all overloads: arguments are never read, so no message content can leak.
# (hook_id, action, purpose, class, method)
CLIENT_POINTS = (
    ("client.MessagesController.deleteMessages", "delete", "удаление сообщений в клиенте",
     "org.telegram.messenger.MessagesController", "deleteMessages"),
    ("client.SendMessagesHelper.editMessage", "edit", "редактирование сообщения в клиенте",
     "org.telegram.messenger.SendMessagesHelper", "editMessage"),
    ("client.SendMessagesHelper.sendReaction", "reaction", "отправка реакции в клиенте",
     "org.telegram.messenger.SendMessagesHelper", "sendReaction"),
)


def hook_id(kind, name):
    return f"{kind}.{name}"


def simple_name(obj):
    if obj is None:
        return "None"
    try:
        return str(obj.getClass().getSimpleName())
    except Exception:
        return type(obj).__name__


def _field(obj, name):
    try:
        return getattr(obj, name)
    except Exception:
        return None


def _count(value):
    if value is None:
        return 0
    try:
        return int(value.size())
    except Exception:
        try:
            return len(value)
        except Exception:
            return -1


class EventObserver:
    """Turns SDK hook callbacks into journal entries. Callbacks must be fast and must not raise."""
    PENDING_LIMIT = 256

    def __init__(self, store, registry, clock=time.monotonic, limiter=None):
        self.store, self.registry = store, registry
        self._clock = clock
        self._limiter = limiter or RateLimiter(per_window=40, window=60.0, clock=clock)
        self._lock = threading.Lock()
        self._pending = {}  # request name -> [start times] (FIFO pairing; approximate by design)
        self.counters = {}

    # --- declaration / registration ---
    def declare(self, registry=None):
        registry = registry or self.registry
        registry.declare(SEND_HOOK, "локальная обработка исходящего сообщения клиентом",
                         "send_message", "BasePlugin.on_send_message_hook")
        for name, (_, purpose) in REQUESTS.items():
            registry.declare(hook_id("request", name), purpose + " (запрос и ответ сервера)",
                             "request", name)
        for name, (_, purpose) in UPDATES.items():
            registry.declare(hook_id("update", name), purpose + " (серверное обновление)", "update", name)

    def register(self, add_hook, add_send_hook):
        """add_hook(name) and add_send_hook() are the SDK BasePlugin methods. Always on."""
        ok = int(self.registry.register(SEND_HOOK, add_send_hook))
        for name in REQUESTS:
            ok += int(self.registry.register(hook_id("request", name), lambda n=name: add_hook(n)))
        for name in UPDATES:
            ok += int(self.registry.register(hook_id("update", name), lambda n=name: add_hook(n)))
        total = 1 + len(REQUESTS) + len(UPDATES)
        self.store.record("INFO" if ok == total else "ERROR", "EVENT", "observer", "observation",
                          "STARTED" if ok else "FAILED",
                          {"registered": ok, "of": total, "note": "calls not yet observed"})
        return ok

    # --- helpers ---
    def _emit(self, level, component, event, result, details):
        key = component + ":" + event
        allowed, dropped = self._limiter.allow(key)
        with self._lock:
            self.counters[key] = self.counters.get(key, 0) + 1
        if not allowed:
            return
        if dropped:
            details["suppressed_before"] = dropped
        self.store.record(level, "EVENT", component, event, result, details)

    def _peer_details(self, details, peer):
        details["peer_type"] = simple_name(peer)

    def _request_details(self, name, request):
        details = {}
        if request is None:
            return details
        self._peer_details(details, _field(request, "peer"))
        if name in ("TL_messages_deleteMessages", "TL_channels_deleteMessages"):
            details["ids"] = _count(_field(request, "id"))
            if name == "TL_messages_deleteMessages":
                details["revoke"] = bool(_field(request, "revoke"))
        if name == "TL_messages_sendReaction":
            details["reactions"] = _count(_field(request, "reaction"))  # count only, never the emoji
            details["big"] = bool(_field(request, "big"))
        if name == "TL_messages_sendMultiMedia":
            details["items"] = _count(_field(request, "multi_media"))
        if name in ("TL_messages_sendMessage", "TL_messages_sendMedia"):
            details["silent"] = bool(_field(request, "silent"))
            details["scheduled"] = bool(_field(request, "schedule_date"))
        if name == "TL_messages_forwardMessages":
            details["ids"] = _count(_field(request, "id"))
            details["drop_author"] = bool(_field(request, "drop_author"))
        if name == "TL_messages_updatePinnedMessage":
            details["unpin"] = bool(_field(request, "unpin"))
        return details

    # --- SDK callbacks (wired from the plugin class) ---
    def on_send_message(self, account, params):
        self.registry.called(SEND_HOOK)
        details = {"account": account,
                   "has_text": isinstance(_field(params, "message"), str) and bool(_field(params, "message")),
                   "reply": _field(params, "replyToMsg") is not None,
                   "media": any(_field(params, f) is not None for f in ("photo", "document", "location"))}
        self._emit("INFO", "send", "send_message", "LOCAL", details)

    def on_pre_request(self, name, account, request):
        if name not in REQUESTS:
            return
        self.registry.called(hook_id("request", name))
        with self._lock:
            queue = self._pending.setdefault(name, [])
            if len(queue) < self.PENDING_LIMIT:
                queue.append(self._clock())
        details = self._request_details(name, request)
        details["account"] = account
        self._emit("INFO", REQUESTS[name][0], name, "ATTEMPT", details)

    def on_post_request(self, name, account, response, error):
        if name not in REQUESTS:
            return
        self.registry.called(hook_id("request", name))
        with self._lock:
            queue = self._pending.get(name) or []
            started = queue.pop(0) if queue else None
            waiting = len(queue)
        details = {"account": account, "pending": waiting}
        if started is not None:
            details["ms"] = int((self._clock() - started) * 1000)
        if error is not None:
            details["code"] = _field(error, "code")
            text = _field(error, "text")
            details["error"] = str(text)[:80] if text is not None else simple_name(error)
            self._emit("WARN", REQUESTS[name][0], name, "FAILED", details)
        else:
            details["response"] = simple_name(response)
            self._emit("INFO", REQUESTS[name][0], name, "CONFIRMED", details)

    def on_update(self, name, account, update):
        if name not in UPDATES:
            return
        self.registry.called(hook_id("update", name))
        details = {"account": account}
        messages = _field(update, "messages")
        if messages is not None:
            details["ids"] = _count(messages)
        self._emit("INFO", UPDATES[name][0], name, "SERVER", details)

    def on_client_call(self, point_id, action):
        """Called from a guarded Xposed after-hook (the registry already counted the call)."""
        self._emit("INFO", action, point_id, "CALLED", {})

    def summary(self):
        with self._lock:
            items = sorted(self.counters.items())
        if not items:
            return "Событий пока не наблюдалось\n"
        return "".join(f"{key}: {count}\n" for key, count in items)

# --- updater.py ---
"""Manual, user-confirmed plugin updater. Pure logic + thin Android/SDK bindings.

Trust model: HTTPS + fixed repository prefix + SHA-256 from the manifest. This detects corruption and
wrong files; it does NOT defend against a compromised release repository (no signature).
"""
import ast
import hashlib
import json
import os
import re
import shutil
import tempfile
import threading
import time

RELEASES_BASE = "https://raw.githubusercontent.com/Darkichyoyo/exteragram-plugin-releases/main/"
MANIFEST_URL = RELEASES_BASE + "releases.json"
# Primary transport since 0.5.2: GitHub Contents API (raw media type). raw.githubusercontent.com is a
# Fastly CDN with max-age=300 that IGNORES query strings (x-cache: HIT for a fresh ?nocache=..., checked
# 2026-10-10), so a just-published manifest could stay invisible for up to 5 minutes. The API answers
# from the repository; unauthenticated limit is 60 requests/hour per IP, so raw stays as the fallback.
API_CONTENTS_BASE = "https://api.github.com/repos/Darkichyoyo/exteragram-plugin-releases/contents/"
API_REF = "main"
MAX_MANIFEST_BYTES = 64 * 1024
MAX_PLUGIN_BYTES = 2 * 1024 * 1024
BUSY_TIMEOUT_SECONDS = 180
_VERSION = re.compile(r"[0-9]{1,6}(\.[0-9]{1,6}){0,3}")
_SHA = re.compile(r"[0-9a-f]{64}")


class UpdateError(Exception):
    """Message is safe to show to the user (no URLs, paths or tracebacks)."""


def parse_version(text):
    if not isinstance(text, str) or not _VERSION.fullmatch(text):
        raise UpdateError("Некорректный формат версии")
    parts = tuple(int(p) for p in text.split("."))
    return parts + (0,) * (4 - len(parts))


class ReleaseInfo:
    def __init__(self, plugin_id, version, url, sha256, size):
        self.plugin_id, self.version, self.url, self.sha256, self.size = plugin_id, version, url, sha256, size


def parse_manifest(raw, plugin_id):
    """Returns ReleaseInfo for plugin_id, or None when the manifest has no entry for it."""
    try:
        data = json.loads(raw.decode("utf-8") if isinstance(raw, (bytes, bytearray)) else raw)
    except (ValueError, UnicodeDecodeError):
        raise UpdateError("Манифест обновлений повреждён")
    if not isinstance(data, dict) or data.get("schema") != 1 or not isinstance(data.get("plugins"), dict):
        raise UpdateError("Неподдерживаемый формат манифеста")
    entry = data["plugins"].get(plugin_id)
    if entry is None:
        return None
    if not isinstance(entry, dict):
        raise UpdateError("Некорректная запись манифеста")
    version, url, digest, size = (entry.get(k) for k in ("version", "url", "sha256", "size"))
    parse_version(version)
    if not (isinstance(url, str) and url.startswith(RELEASES_BASE) and url.endswith(".plugin")
            and ".." not in url and len(url) < 300):
        raise UpdateError("Адрес файла обновления не из доверенного репозитория")
    if not (isinstance(digest, str) and _SHA.fullmatch(digest)):
        raise UpdateError("Некорректная контрольная сумма в манифесте")
    if not (isinstance(size, int) and not isinstance(size, bool) and 0 < size <= MAX_PLUGIN_BYTES):
        raise UpdateError("Некорректный размер файла в манифесте")
    return ReleaseInfo(plugin_id, version, url, digest, size)


def read_plugin_metadata(source):
    """Static AST read of top-level __id__/__version__; the downloaded code is never executed."""
    try:
        tree = ast.parse(source)
    except (SyntaxError, ValueError):
        raise UpdateError("Файл обновления не является корректным Python")
    found = {}
    for node in tree.body:
        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
            name = node.targets[0].id
            if name in ("__id__", "__version__") and isinstance(node.value, ast.Constant) \
                    and isinstance(node.value.value, str):
                found[name] = node.value.value
    return found.get("__id__"), found.get("__version__")


def verify_payload(payload, info, current_id, current_version, stage=None):
    stage = stage or (lambda *_args, **_kwargs: None)
    if len(payload) != info.size:
        raise UpdateError("Размер файла не совпал с манифестом")
    stage("verify.size", "OK", bytes=len(payload))
    digest = hashlib.sha256(payload).hexdigest()
    if digest != info.sha256:
        raise UpdateError("Контрольная сумма SHA-256 не совпала")
    stage("verify.sha256", "OK", sha256=digest[:12])
    try:
        source = payload.decode("utf-8")
    except UnicodeDecodeError:
        raise UpdateError("Файл обновления не в UTF-8")
    file_id, file_version = read_plugin_metadata(source)
    if file_id != current_id or info.plugin_id != current_id:
        raise UpdateError("Идентификатор плагина в файле не совпал")
    if file_version != info.version:
        raise UpdateError("Версия в файле не совпала с манифестом")
    stage("verify.metadata", "OK", id=file_id, version=file_version)
    return source


class UpdateController:
    """All platform access is injected: http_get(url, max_bytes), install(path, callback), ui(fn).

    log(stage, result, level="INFO", details=None) receives one structured record per stage:
    check -> manifest.fetch -> manifest.parse -> version.compare -> confirm -> download ->
    verify.size / verify.sha256 / verify.metadata -> install.handoff -> install.result.
    """

    def __init__(self, plugin_id, version, http_get, install, notify, confirm, background, log=None,
                 clock=time.monotonic, tmp_root=None, source=None):
        parse_version(version)
        self.plugin_id, self.version = plugin_id, version
        self._http_get, self._install, self._notify = http_get, install, notify
        self._confirm, self._background = confirm, background
        self._log = log or (lambda *_args, **_kwargs: None)
        self._clock, self._tmp_root = clock, tmp_root
        self._lock = threading.Lock()
        self._busy_since = None
        self._source = source  # optional () -> str: which transport answered the last request

    def _enter(self):
        with self._lock:
            now = self._clock()
            if self._busy_since is not None and now - self._busy_since < BUSY_TIMEOUT_SECONDS:
                return False
            self._busy_since = now
            return True

    def _leave(self):
        with self._lock:
            self._busy_since = None

    def _stage(self, stage, result, level="INFO", **details):
        try:
            self._log(stage, result, level, details)
        except Exception:
            pass  # diagnostics must never break the update flow

    def _fetch(self, stage, url, max_bytes):
        started = self._clock()
        try:
            raw = self._http_get(url, max_bytes)
        except Exception as exc:
            reason = str(exc) if isinstance(exc, UpdateError) else type(exc).__name__
            self._stage(stage, "FAILED", "ERROR", reason=reason, ms=int((self._clock() - started) * 1000))
            raise
        try:
            host = str(self._source()) if self._source is not None else "injected"
        except Exception:
            host = "unknown"
        self._stage(stage, "OK", bytes=len(raw), limit=max_bytes, ms=int((self._clock() - started) * 1000),
                    host=host)
        return raw

    def check(self, *_args):
        """Button handler: ignores repeated presses while an operation is in flight."""
        if not self._enter():
            self._stage("check", "IGNORED_BUSY", "WARN")
            self._notify("Проверка или установка уже выполняется")
            return
        self._stage("check", "STARTED", installed=self.version)
        try:
            self._background(self._check_work)
        except Exception as exc:
            self._leave()
            self._stage("check", "NOT_STARTED", "ERROR", reason=type(exc).__name__)
            self._notify("Проверка не запущена: " + type(exc).__name__, True)

    def find_update(self):
        try:
            raw = self._fetch("manifest.fetch", MANIFEST_URL, MAX_MANIFEST_BYTES)
        except UpdateError:
            raise
        except Exception as exc:
            raise UpdateError("Не удалось получить манифест: " + type(exc).__name__)
        if len(raw) > MAX_MANIFEST_BYTES:
            self._stage("manifest.parse", "FAILED", "ERROR", reason="too large", bytes=len(raw))
            raise UpdateError("Манифест слишком большой")
        try:
            info = parse_manifest(raw, self.plugin_id)
        except UpdateError as exc:
            self._stage("manifest.parse", "FAILED", "ERROR", reason=str(exc))
            raise
        if info is None:
            self._stage("manifest.parse", "NO_ENTRY", "WARN", plugin=self.plugin_id)
            return None
        self._stage("manifest.parse", "OK", remote=info.version, size=info.size, sha256=info.sha256[:12])
        newer = parse_version(info.version) > parse_version(self.version)
        self._stage("version.compare", "NEWER" if newer else "NOT_NEWER", installed=self.version,
                    remote=info.version)
        return info if newer else None

    def _check_work(self):
        try:
            info = self.find_update()
        except UpdateError as exc:
            self._leave()
            self._notify(str(exc), True)
            return
        except Exception as exc:  # defensive: never leave the button locked
            self._leave()
            self._stage("check", "CRASHED", "ERROR", reason=type(exc).__name__)
            self._notify("Проверка не выполнена: " + type(exc).__name__, True)
            return
        if info is None:
            self._leave()
            self._stage("check", "UP_TO_DATE", installed=self.version)
            self._notify(f"Установлена последняя версия ({self.version})")
            return
        self._stage("confirm", "SHOWN", remote=info.version)

        def declined():
            self._stage("confirm", "DECLINED")
            self._leave()
        try:
            self._confirm(info, lambda: self.start_install(info), declined)
        except Exception as exc:
            self._leave()
            self._stage("confirm", "FAILED", "ERROR", reason=type(exc).__name__)
            self._notify("Диалог обновления не открыт: " + type(exc).__name__, True)

    def start_install(self, info):
        """Called only after explicit user confirmation. The busy flag is still held."""
        self._stage("confirm", "ACCEPTED", remote=info.version)
        try:
            self._background(lambda: self._install_work(info))
        except Exception as exc:
            self._leave()
            self._notify("Установка не запущена: " + type(exc).__name__, True)

    def _install_work(self, info):
        directory = None
        try:
            payload = self._fetch("download", info.url, min(info.size, MAX_PLUGIN_BYTES))
            try:
                verify_payload(payload, info, self.plugin_id, self.version, self._stage)
            except UpdateError as exc:
                self._stage("verify", "FAILED", "ERROR", reason=str(exc))
                raise
            if parse_version(info.version) <= parse_version(self.version):
                raise UpdateError("Версия не новее установленной")
            directory = tempfile.mkdtemp(prefix="eg_update_", dir=self._tmp_root)
            path = os.path.join(directory, self.plugin_id + ".plugin")
            with open(path, "xb") as output:
                output.write(payload)
            self._stage("install.handoff", "STARTED", note="file verified; passing to plugin engine")
        except UpdateError as exc:
            self._finish(directory, False, str(exc))
            return
        except Exception as exc:
            self._finish(directory, False, "Скачивание не выполнено: " + type(exc).__name__)
            return
        done = []
        def callback(result):
            if done:
                return
            done.append(1)
            if result is None:
                self._finish(directory, True, f"Движок подтвердил установку версии {info.version}")
            else:
                first = str(result).strip().splitlines()[0][:120] if str(result).strip() else "без описания"
                self._finish(directory, False, "Установка не выполнена движком: " + first)
        try:
            route = self._install(path, callback)
            self._stage("install.handoff", "RETURNED", route=str(route), callback_received=bool(done))
        except Exception as exc:
            if not done:
                done.append(1)
                self._finish(directory, False, "Установщик недоступен: " + type(exc).__name__)

    def _finish(self, directory, ok, message):
        if directory:
            shutil.rmtree(directory, ignore_errors=True)
        self._leave()
        self._stage("install.result", "OK" if ok else "FAILED", "INFO" if ok else "ERROR", message=message[:160])
        self._notify(message, not ok)


def no_cache_url(url, now=None):
    """The manifest is mutable and raw.githubusercontent.com caches it (max-age=300): add a unique query
    so a check never sees a stale version. Versioned .plugin URLs are immutable and stay untouched."""
    if url != MANIFEST_URL:
        return url
    stamp = int((time.time() if now is None else now) * 1000)
    return f"{url}?nocache={stamp}"


def api_url(url):
    """Same file through the GitHub Contents API, or None for URLs outside the releases repository."""
    if not url.startswith(RELEASES_BASE):
        return None
    path = url[len(RELEASES_BASE):]
    if not path or ".." in path or "?" in path or "#" in path:
        return None
    return API_CONTENTS_BASE + path + "?ref=" + API_REF


class UpdaterBindings:
    """Android/SDK glue. Signatures come from third-party sources; NOT verified on ExteraGram 12.9.0."""

    def __init__(self):
        self.last_source = "none"

    def http_get(self, url, max_bytes):
        """Releases-repo files: GitHub API first (no CDN delay), raw.githubusercontent.com as fallback
        (API rate limit, outage). Size limits, HTTPS and SHA-256 checks are identical for both."""
        if not url.startswith("https://"):
            raise UpdateError("Допускается только HTTPS")
        primary = api_url(url)
        if primary is not None:
            try:
                data = self._get(primary, max_bytes, api=True)
                self.last_source = "api.github.com"
                return data
            except Exception as exc:
                reason = str(exc) if isinstance(exc, UpdateError) else type(exc).__name__
                data = self._get(url, max_bytes)
                self.last_source = "raw.githubusercontent.com (api: " + reason[:60] + ")"
                return data
        data = self._get(url, max_bytes)
        self.last_source = "raw.githubusercontent.com"
        return data

    def _get(self, url, max_bytes, api=False):
        from java.net import URL
        conn = URL(url if api else no_cache_url(url)).openConnection()
        if api:
            conn.setRequestProperty("Accept", "application/vnd.github.raw")
            conn.setRequestProperty("X-GitHub-Api-Version", "2022-11-28")
        conn.setUseCaches(False)
        conn.setRequestProperty("Cache-Control", "no-cache")
        conn.setRequestProperty("Pragma", "no-cache")
        conn.setInstanceFollowRedirects(False)
        conn.setConnectTimeout(10000)
        conn.setReadTimeout(20000)
        conn.setRequestProperty("User-Agent", "exteragram-plugin-updater/1")
        code = conn.getResponseCode()
        if code != 200:
            raise UpdateError(f"Сервер ответил HTTP {code}")
        stream = conn.getInputStream()
        chunks, total = [], 0
        try:
            from java import jarray, jbyte
            buffer = jarray(jbyte)(8192)
            while True:
                count = stream.read(buffer)
                if count < 0:
                    break
                total += count
                if total > max_bytes:
                    raise UpdateError("Ответ сервера больше допустимого размера")
                chunks.append(bytes(bytearray(b & 0xFF for b in buffer[:count])))
        finally:
            stream.close()
            conn.disconnect()
        return b"".join(chunks)

    def install(self, path, callback):
        """Engine route first (12.x community usage), then legacy controller route.
        Only a TypeError raised BEFORE the call (wrong overload) falls through to the legacy route."""
        from java import dynamic_proxy, jclass
        Utilities = jclass("org.telegram.messenger.Utilities")
        PluginsController = jclass("com.exteragram.messenger.plugins.PluginsController")

        class Result(dynamic_proxy(Utilities.Callback)):
            def run(self, arg):
                callback(None if arg is None else str(arg))

        proxy = Result()
        controller = PluginsController.getInstance()
        engine = None
        try:
            engine = controller.engines.get("python")
        except Exception:
            engine = None
        if engine is not None:
            try:
                engine.loadPluginFromFile(path, None, proxy)
                return "engine"
            except TypeError:
                pass
        controller.loadPluginFromFile(path, proxy)
        return "controller"

# --- adapter.py ---
"""ExteraGram SDK/Android adapter. Platform imports are lazy; see PROJECT.md."""
import sys
import threading
import time

COPY_LIMIT = 200000  # characters; Android clipboard goes through Binder. The shared file is never trimmed.


class SDKBindings:
    def __init__(self):
        from android_utils import run_on_ui_thread
        from client_utils import run_on_queue, get_last_fragment
        from ui.settings import Divider, Header, Text
        from ui.alert import AlertDialogBuilder
        from ui.bulletin import BulletinHelper
        self.ui, self.background = run_on_ui_thread, run_on_queue
        self.fragment = get_last_fragment
        self.Divider, self.Header, self.Text = Divider, Header, Text
        self.Alert = AlertDialogBuilder
        self.bulletins = BulletinHelper

    def environment(self):
        """Technical environment for the report. Each source is optional and guarded separately.
        android.os.Build is the public Android API; BuildVars is Telegram-Android source (used in the
        SDK hooking docs) and its fields are best-effort, so "unknown" is reported instead of guessing."""
        env = {}
        try:
            from android.os import Build
            env["android"] = f"{Build.VERSION.RELEASE} (API {Build.VERSION.SDK_INT})"
        except Exception as exc:
            env["android"] = "unknown: " + type(exc).__name__
        try:
            from org.telegram.messenger import BuildVars
            name = getattr(BuildVars, "BUILD_VERSION_STRING", None)
            code = getattr(BuildVars, "BUILD_VERSION", None)
            env["app"] = (str(name) if name is not None else "unknown") + \
                (f" (build {code})" if code is not None else "")
        except Exception as exc:
            env["app"] = "unknown: " + type(exc).__name__
        return env

    def toast(self, message, error=False):
        if error:
            self.bulletins.show_error(message)
        else:
            self.bulletins.show_info(message)

    def activity(self):
        fragment = self.fragment()
        activity = fragment.getParentActivity() if fragment is not None else None
        if activity is None:
            raise RuntimeError("No current activity")
        return activity

    def show_update_sheet(self, title, versions, note, button, decision):
        """Telegram's BottomSheet with a custom view (signatures: BottomSheet(Context, boolean),
        setCustomView(View), show(), dismiss(), setOnDismissListener(OnDismissListener) from the open-source
        client). It is NOT part of the documented plugin SDK, so any failure BEFORE show() raises and the
        caller falls back to AlertDialog. Must run on the UI thread."""
        from java import dynamic_proxy
        from android.content import DialogInterface
        from android.graphics.drawable import GradientDrawable
        from android.view import Gravity, View
        from android.widget import LinearLayout, TextView
        from org.telegram.ui.ActionBar import BottomSheet, Theme
        context = self.activity()
        density = context.getResources().getDisplayMetrics().density
        dp = lambda v: int(density * v + 0.5)

        def color(name, default):
            try:
                return Theme.getColor(getattr(Theme, name))
            except Exception:
                return default

        def signed(argb):
            argb &= 0xFFFFFFFF
            return argb - (1 << 32) if argb >= (1 << 31) else argb

        def with_alpha(value, alpha):
            return signed((alpha << 24) | (value & 0xFFFFFF))

        def readable_on(value):
            red, green, blue = (value >> 16) & 255, (value >> 8) & 255, value & 255
            return signed(0xFF1B1B1B) if (0.299 * red + 0.587 * green + 0.114 * blue) > 150 else -1

        def rounded(fill, radius):
            shape = GradientDrawable()
            shape.setColor(fill)
            shape.setCornerRadius(float(dp(radius)))
            return shape

        sheet = BottomSheet(context, False)

        class Click(dynamic_proxy(View.OnClickListener)):
            def __init__(self, action):
                super().__init__()
                self.action = action

            def onClick(self, view):
                self.action(view)

        class Dismissed(dynamic_proxy(DialogInterface.OnDismissListener)):
            def onDismiss(self, dialog):
                decision.close()

        def text_view(text, size, text_color):
            view = TextView(context)
            view.setText(text)
            view.setTextSize(size)
            view.setTextColor(text_color)
            return view

        main_color = color("key_windowBackgroundWhiteBlackText", -1)
        gray_color = color("key_windowBackgroundWhiteGrayText2", -5592406)
        accent = color("key_featuredStickers_addButton", -14443544)

        root = LinearLayout(context)
        root.setOrientation(LinearLayout.VERTICAL)
        root.setPadding(dp(20), dp(10), dp(20), dp(20))
        # Info area (handle + texts): the only "close" target; it does not overlap the button.
        info = LinearLayout(context)
        info.setOrientation(LinearLayout.VERTICAL)
        info.setClickable(True)
        handle = View(context)
        handle.setBackground(rounded(with_alpha(gray_color, 0x80), 2))
        handle_params = LinearLayout.LayoutParams(dp(36), dp(4))
        handle_params.gravity = Gravity.CENTER_HORIZONTAL
        info.addView(handle, handle_params)

        heading = text_view(title, 22, main_color)
        try:  # optional styling only; the sheet works without it
            from org.telegram.messenger import AndroidUtilities
            heading.setTypeface(AndroidUtilities.bold())
        except Exception:
            pass
        heading_params = LinearLayout.LayoutParams(-2, -2)
        heading_params.topMargin = dp(18)
        info.addView(heading, heading_params)

        chip = text_view(versions, 14, accent)
        chip.setPadding(dp(10), dp(4), dp(10), dp(4))
        chip.setBackground(rounded(with_alpha(accent, 0x2E), 10))
        chip_params = LinearLayout.LayoutParams(-2, -2)
        chip_params.topMargin = dp(10)
        info.addView(chip, chip_params)

        note_view = text_view(note, 14, gray_color)
        note_params = LinearLayout.LayoutParams(-1, -2)
        note_params.topMargin = dp(10)
        note_params.bottomMargin = dp(18)
        info.addView(note_view, note_params)
        root.addView(info, LinearLayout.LayoutParams(-1, -2))

        action = text_view(button, 16, readable_on(accent))
        action.setGravity(Gravity.CENTER)
        action.setBackground(rounded(accent, 14))
        action.setClickable(True)
        try:
            from org.telegram.messenger import AndroidUtilities
            action.setTypeface(AndroidUtilities.bold())
        except Exception:
            pass
        root.addView(action, LinearLayout.LayoutParams(-1, dp(52)))

        def on_download(view):
            if decision.download():
                view.setEnabled(False)
                sheet.dismiss()

        def on_info(view):
            decision.close()
            sheet.dismiss()

        action.setOnClickListener(Click(on_download))
        info.setOnClickListener(Click(on_info))
        sheet.setCustomView(root)
        sheet.setOnDismissListener(Dismissed())
        sheet.show()

    def copy(self, text):
        # ClipboardManager has an observable error path; SDK helper returns no status.
        from android.content import ClipData, Context
        clipboard = self.activity().getSystemService(Context.CLIPBOARD_SERVICE)
        if clipboard is None:
            raise RuntimeError("Clipboard unavailable")
        clipboard.setPrimaryClip(ClipData.newPlainText("diagnostic report", text))
        current = clipboard.getPrimaryClip()
        if (current is None or current.getItemCount() < 1
                or str(current.getItemAt(0).getText()) != text):
            raise RuntimeError("Clipboard readback did not match")

    def export_backend(self):
        return MediaStoreExport(self.activity().getApplicationContext())

    def share(self, uri):
        from android.content import Intent, ClipData
        from android.os import Parcelable
        from java import cast
        activity = self.activity()
        intent = Intent(Intent.ACTION_SEND)
        intent.setType("text/plain")
        intent.putExtra(Intent.EXTRA_STREAM, cast(Parcelable, uri))
        intent.setClipData(ClipData.newUri(activity.getContentResolver(), "diagnostic report", uri))
        intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
        activity.startActivity(Intent.createChooser(intent, "Выберите приложение, затем чат"))
        # Does not imply a destination was chosen or upload/delivery succeeded.


class JavaReflection:
    """hook_utils.find_class + java.lang.reflect. Parameter names come from Class.getName()."""
    def find_class(self, name):
        from hook_utils import find_class
        return find_class(name)

    def methods(self, cls, name):
        members = cls.getDeclaredConstructors() if name == "<init>" else cls.getDeclaredMethods()
        found = []
        for member in members:
            if name != "<init>" and str(member.getName()) != name:
                continue
            types = tuple(str(t.getName()) for t in member.getParameterTypes())
            found.append((member, name + "(" + ", ".join(types) + ")", types))
        return found


class XposedHooks:
    """Reusable tracked Xposed hooking for host plugins (SDK: hook_method/unhook_method).

    hook() records lookup, install and every real call separately in the registry/journal."""
    def __init__(self, plugin, registry, reflection=None):
        self.plugin, self.registry = plugin, registry
        self.reflection = reflection or JavaReflection()

    def hook(self, hook_id, purpose, class_name, method, params=None, before=None, after=None,
             all_overloads=False):
        self.registry.declare(hook_id, purpose, "xposed", class_name, method, params)
        methods = self.registry.lookup(hook_id, self.reflection)
        if not all_overloads:
            methods = methods[:1]
        guarded = {}
        if before is not None:
            guarded["before"] = self.registry.guard(hook_id, before, context="before_hooked_method")
        if after is not None:
            guarded["after"] = self.registry.guard(hook_id, after, context="after_hooked_method",
                                                   count=before is None)

        def install(java_method):
            java_method.setAccessible(True)
            return self.plugin.hook_method(java_method, **guarded)
        return self.registry.install(hook_id, methods, install)

    def unhook(self, hook_id):
        return self.registry.uninstall(hook_id, self.plugin.unhook_method)


class MediaStoreExport:
    """Downloads/ExteraGramDiagnostics, Android API 29+, no manifest changes."""
    def __init__(self, context, types=None):
        if types is None:
            from android.os import Build
            if Build.VERSION.SDK_INT < 29:
                raise RuntimeError("Export requires Android 10 (API 29) or newer")
            from android.content import ContentValues
            from android.provider import MediaStore
            from java.lang import Integer
            from java.io import OutputStreamWriter
            types = (ContentValues, MediaStore, Integer, OutputStreamWriter)
        self.Values, self.Media, self.Int, self.Writer = types
        self.resolver = context.getContentResolver()

    def create(self, filename):
        values = self.Values()
        values.put(self.Media.MediaColumns.DISPLAY_NAME, filename)
        values.put(self.Media.MediaColumns.MIME_TYPE, "text/plain")
        values.put(self.Media.MediaColumns.RELATIVE_PATH, "Download/ExteraGramDiagnostics/")
        values.put(self.Media.MediaColumns.IS_PENDING, self.Int(1))
        return self.resolver.insert(
            self.Media.Downloads.getContentUri(self.Media.VOLUME_EXTERNAL_PRIMARY), values)

    def write(self, uri, text):
        stream = self.resolver.openOutputStream(uri, "w")
        if stream is None:
            raise RuntimeError("Destination stream unavailable")
        writer = None
        try:
            writer = self.Writer(stream, "UTF-8")
            writer.write(text)
        finally:
            if writer is not None:
                writer.close()  # includes flushing; errors trigger rollback
            else:
                stream.close()

    def publish(self, uri):
        values = self.Values()
        values.put(self.Media.MediaColumns.IS_PENDING, self.Int(0))
        if self.resolver.update(uri, values, None, None) != 1:
            raise RuntimeError("Cannot publish exported report")

    def delete(self, uri):
        if self.resolver.delete(uri, None, None) != 1:
            raise RuntimeError("Cannot remove failed export")


class DiagnosticsController:
    """Automatic, per-plugin diagnostics: one journal, no manual tests, no extra screens.

    Observes only this plugin, documented SDK hook points and a few justified client methods
    (events.CLIENT_POINTS). Never hooks other plugins, RPC payloads or global logcat."""
    def __init__(self, plugin, bindings=None, meta=None):
        self.plugin = plugin
        self.sdk = bindings if bindings is not None else SDKBindings()
        self.meta = dict(meta or {})
        self.store = DiagnosticStore()
        self._logger = None
        self._record_handler = self._on_record
        self._closed = False
        self._busy = False
        self._operation_lock = threading.Lock()
        self.notice_error = None
        self.journal_failures = 0  # the journal itself failed to record something
        self.last_journal_failure = None
        self.registry = HookRegistry(self.store)
        self.events = EventObserver(self.store, self.registry)
        self._xposed_ids = []
        self._hooks_api = None
        self._app_limiter = RateLimiter(per_window=20, window=60.0)
        self.init_steps = []  # [(step, result)] in order; shown in the report and the status
        self.store.record("INFO", "PLUGIN", "diagnostics", "controller", "INITIALIZED",
                          {"format": "v2", "mode": "automatic"})
        self.environment = self._collect_environment()

    def _collect_environment(self):
        env = {"python": sys.version.split()[0]}
        try:
            collect = getattr(self.sdk, "environment", None)
            if collect is not None:
                env.update(collect())
        except Exception as exc:
            env["environment_error"] = type(exc).__name__
        self.safe_record("INFO", "PLUGIN", "diagnostics", "environment", "COLLECTED", env)
        return env

    def init_step(self, step, result, level=None, **details):
        """One initialization stage (journal + report section). Never raises."""
        try:
            self.init_steps.append((str(step)[:40], str(result)[:40]))
            del self.init_steps[:-32]
        except Exception:
            pass
        bad = result not in ("OK", "READY", "REGISTERED", "STARTED", "SCHEDULED", "COMPLETED")
        self.safe_record(level or ("ERROR" if bad else "INFO"), "PLUGIN", "init", step, result, details)

    def init_problems(self):
        return [(s, r) for s, r in self.init_steps
                if r not in ("OK", "READY", "REGISTERED", "STARTED", "SCHEDULED", "COMPLETED")]

    def app_event(self, name):
        """AppEvent START/STOP/PAUSE/RESUME. Rate-limited: background/foreground can be frequent."""
        allowed, dropped = self._app_limiter.allow("app_event")
        if allowed:
            details = {"suppressed_before": dropped} if dropped else None
            self.safe_record("DEBUG", "PLUGIN", "lifecycle", "app_event", str(name)[:24], details)

    # --- journal safety ---------------------------------------------------------------------------
    def safe_record(self, *args, **kwargs):
        """Record without ever raising into the caller; failures of the journal are counted."""
        try:
            return self.store.record(*args, **kwargs)
        except Exception as exc:
            self.journal_failures += 1
            self.last_journal_failure = type(exc).__name__
            return None

    def _safe_exception(self, exc, event, **kwargs):
        try:
            return self.store.exception(exc, event, **kwargs)
        except Exception as inner:
            self.journal_failures += 1
            self.last_journal_failure = type(inner).__name__
            return None

    def ui_event(self, event, result="OK", level="INFO", **details):
        self.safe_record(level, "UI", "settings", event, result, details)

    # --- reusable tracking API for this plugin and host plugins ---
    def track_handler(self, hook_id, purpose, fn, default=None):
        """Declare a plain handler (menu click, callback, ...) and return a guarded wrapper."""
        self.registry.declare(hook_id, purpose, "handler", getattr(fn, "__qualname__", "handler"))
        self.registry.register(hook_id, lambda: True)
        return self.registry.guard(hook_id, fn, default)

    def xposed(self):
        return XposedHooks(self.plugin, self.registry)

    # --- automatic observation ----------------------------------------------------------------
    def attach_events(self, add_hook, add_send_hook):
        """Declare and register every documented SDK observation point. Always on, no settings."""
        self.events.declare()
        return self.events.register(add_hook, add_send_hook)

    def observe_client(self, hooks=None, points=None):
        """Install observation-only after-hooks on CLIENT_POINTS. Lookup, every overload, install and
        each real call are separate journal facts. Runs in the background; never raises."""
        hooks = hooks or self.xposed()
        self._hooks_api = hooks
        for point in (points if points is not None else CLIENT_POINTS):
            if self._closed:
                return
            hook_id, action, purpose, class_name, method = point
            try:
                def after(_param, _id=hook_id, _action=action):
                    self.events.on_client_call(_id, _action)
                installed = hooks.hook(hook_id, purpose, class_name, method, after=after, all_overloads=True)
                if installed:
                    self._xposed_ids.append(hook_id)
            except Exception as exc:
                self._safe_exception(exc, "client observation point failed", category="HOOK",
                                     component=hook_id, include_message=True)
        self.safe_record("INFO", "HOOK", "client-points", "observe", "DONE",
                         {"points": len(points if points is not None else CLIENT_POINTS),
                          "installed": len(self._xposed_ids)})

    def start_client_observation(self):
        try:
            self.sdk.background(self.observe_client)
            self.safe_record("INFO", "HOOK", "client-points", "observe", "SCHEDULED")
            return True
        except Exception as exc:
            self._safe_exception(exc, "client observation not scheduled", category="HOOK",
                                 component="client-points")
            return False

    def on_sdk_event(self, kind, *args):
        """Entry point for BasePlugin hook methods. Never raises into the SDK."""
        try:
            if kind == "send":
                self.events.on_send_message(*args)
            elif kind == "pre":
                self.events.on_pre_request(*args)
            elif kind == "post":
                self.events.on_post_request(*args)
            elif kind == "update":
                self.events.on_update(*args)
        except Exception as exc:
            self._safe_exception(exc, "event observer failed", category="EVENT", component=kind)
            # Attribute the failure to the concrete hook so its verdict shows HANDLER_ERRORS.
            try:
                name = args[0] if args and isinstance(args[0], str) else None
                target = (SEND_HOOK if kind == "send"
                          else event_hook_id("request", name) if kind in ("pre", "post") and name in REQUESTS
                          else event_hook_id("update", name) if kind == "update" and name in UPDATES
                          else None)
                if target is not None:
                    self.registry.failed(target, "handler", exc, context=kind + "_callback")
            except Exception:
                self.journal_failures += 1

    # --- SDK logger ---------------------------------------------------------------------------
    def bind_logger(self, logger):
        if self._logger is not None or logger is None:
            if logger is None:
                self.safe_record("WARN", "PLUGIN", "sdk-logger", "add_handler", "NO_LOGGER")
            return False
        try:
            logger.add_handler(self._record_handler)
            self._logger = logger
        except Exception as exc:
            self._safe_exception(exc, "SDK logger handler registration failed", category="PLUGIN",
                                 component="sdk-logger")
            return False
        self.safe_record("INFO", "PLUGIN", "sdk-logger", "add_handler", "REGISTERED",
                         {"note": "invocation not yet observed"})
        return True

    @staticmethod
    def _record_level(record):
        level = getattr(record, "level", None)
        name = getattr(level, "name", None)
        if isinstance(name, str):
            return name
        try:
            return {2: "DEBUG", 3: "DEBUG", 4: "INFO", 5: "WARN", 6: "ERROR", 7: "ERROR"}.get(int(level), "INFO")
        except Exception:
            return "INFO"

    def _on_record(self, record):
        if self._closed:
            return
        try:
            text = getattr(record, "text", None)
            if not isinstance(text, str):
                text = getattr(record, "message", "[record without text]")
            if not isinstance(text, str):
                text = "[non-text record omitted]"
            trace = getattr(record, "traceback", None)
            text = text[:16384]
            if isinstance(trace, str) and trace[:16384] not in text:
                text += "\n" + trace[:16384]
            tag = getattr(record, "tag", None)
            self.store.append(text, level=self._record_level(record), category="LOG",
                              component=tag if isinstance(tag, str) and tag else "sdk-logger")
        except Exception as exc:
            self._safe_exception(exc, "SDK logger record capture failed", category="PLUGIN",
                                 component="sdk-logger")

    # --- status and report --------------------------------------------------------------------
    def status(self):
        """(title, subtitle, is_problem) for the compact settings screen."""
        try:
            stats = self.store.stats()
        except Exception as exc:
            return ("❌ Журнал недоступен", "Ошибка журнала: " + type(exc).__name__, True)
        levels = stats["levels"]
        errors, warnings = levels.get("ERROR", 0), levels.get("WARN", 0)
        states = self.registry.snapshot()
        problems = [s for s in states if is_problem(s)]
        called = sum(1 for s in states if s.calls)
        init_bad = self.init_problems()
        if self.journal_failures:
            title, bad = f"⚠ Логирование работает со сбоями ({self.journal_failures})", True
        elif init_bad:
            title, bad = f"⚠ Инициализация с ошибками ({len(init_bad)}) · журнал работает", True
        elif errors or problems:
            title, bad = f"⚠ Логирование работает · ошибок: {errors}", True
        else:
            title, bad = "✅ Логирование работает · ошибок нет", False
        subtitle = (f"Записей: {stats['entries']} · ошибок: {errors} · предупреждений: {warnings} · "
                    f"точек наблюдения: {len(states)} (вызывались: {called}, проблем: {len(problems)})")
        return title, subtitle, bad

    def build_report(self):
        """One copyable/shareable report. Privacy: no message text, peer/message IDs or secrets."""
        stats = self.store.stats()
        title, subtitle, _bad = self.status()
        meta = self.meta
        errors = self.store.query(min_level="ERROR")[-30:]
        updates = [e for e in self.store.entries() if e.category in ("UPDATE", "NETWORK")][-30:]
        env = ", ".join(f"{k}={v}" for k, v in self.environment.items()) or "нет данных"
        init = "\n".join(f"{step}: {result}" for step, result in self.init_steps) or "Этапы не записаны"
        hooks_problems = self.registry.problems()
        head = [
            "=== ExteraGram Diagnostics: отчёт ===",
            f"Плагин: {meta.get('id', '?')} {meta.get('version', '?')} (автор {meta.get('author', '?')})",
            f"Сформирован (UTC): {utc_time()}",
            "Статус: " + title,
            subtitle,
            f"Вытеснено старых записей: {stats['evicted']}; сбоев записи журнала: {self.journal_failures}"
            + (f" (последний: {self.last_journal_failure})" if self.last_journal_failure else ""),
            "Приватность: без текста сообщений, ID чатов/сообщений, токенов и паролей.",
            "Нулевое число вызовов означает «вызов пока не наблюдался», а не поломку.",
            "Окружение: " + env,
            "",
            "=== Инициализация диагностики ===",
            init,
            "",
            f"=== Проблемные хуки: {len(hooks_problems)} ===",
            ("\n".join(f"{s.id}: {s.lookup}/{s.install}, ошибок обработчика {s.errors}"
                       for s in hooks_problems) if hooks_problems else "Нет"),
            "",
            "=== Хуки и точки наблюдения ===",
            self.registry.report().rstrip("\n"),
            "",
            "=== События клиента (счётчики с запуска плагина) ===",
            self.events.summary().rstrip("\n"),
            "",
            f"=== Ошибки (последние {len(errors)}, с трассировками) ===",
            (self.store.render(errors).rstrip("\n") if errors else "Ошибок нет"),
            "",
            f"=== Обновление плагина (последние {len(updates)} записей UPDATE/NETWORK) ===",
            (self.store.render(updates).rstrip("\n") if updates else "Проверка обновлений не запускалась"),
            "",
            "=== Журнал (по времени, UTC) ===",
            "",
        ]
        return "\n".join(head), self.store.snapshot()

    def report_text(self, limit=None):
        head, snapshot = self.build_report()
        body = snapshot.text
        if limit is not None and len(head) + len(body) > limit:
            keep = max(0, limit - len(head) - 80)
            cut = body[len(body) - keep:]
            cut = cut[cut.find("\n") + 1:] if "\n" in cut else cut
            body = "[… старые записи не поместились в буфер обмена; полный отчёт — «Отправить логи» …]\n" + cut
        return head + body, snapshot.revision

    # --- UI -----------------------------------------------------------------------------------
    def _notice(self, text, error=False):
        if self._closed:
            return
        try:
            self.sdk.toast(text, error)
        except Exception as exc:
            self.notice_error = type(exc).__name__  # inspectable; do not recurse into logging

    def _post(self, callback):
        try:
            self.sdk.ui(callback)
        except Exception as exc:
            self.notice_error = type(exc).__name__

    def settings(self):
        if self._closed:
            return []
        title, subtitle, bad = self.status()
        return [
            self.sdk.Header(text="Диагностика"),
            self.sdk.Text(text=title, subtext=subtitle, red=bad, icon="msg_info"),
            self.sdk.Text(text="Скопировать логи", on_click=self.copy, icon="msg_copy"),
            self.sdk.Text(text="Отправить логи", on_click=self.share, icon="msg_send"),
            self.sdk.Text(text="Очистить логи", on_click=self.confirm_clear, red=True, icon="msg_clear"),
        ]

    def copy(self, *_args):
        if self._closed:
            return
        self.ui_event("copy", "REQUESTED")
        try:
            text, revision = self.report_text(COPY_LIMIT)
        except Exception as exc:
            self._safe_exception(exc, "report build failed", category="UI", component="settings")
            self._notice("Отчёт не сформирован: " + type(exc).__name__, True)
            return
        try:
            self.sdk.copy(text)
        except Exception as exc:
            self.ui_event("copy", "FAILED", "ERROR", reason=type(exc).__name__)
            self._notice("Копирование не выполнено: " + type(exc).__name__, True)
            return
        self.ui_event("copy", "OK", chars=len(text), revision=revision)
        self._notice(f"Отчёт скопирован: {len(text)} символов")

    def confirm_clear(self, *_args):
        if self._closed:
            return
        try:
            builder = self.sdk.Alert(self.sdk.activity())
            builder.set_title("Очистить логи?")
            builder.set_message("Будут удалены все текущие записи журнала. Статусы хуков, "
                                "счётчики событий и ранее отправленные файлы останутся.")
            def confirmed(bld, _which):
                if not self._closed:
                    removed = self.store.stats()["entries"]
                    self.store.clear(confirmed=True)
                    self.ui_event("clear", "OK", removed_entries=removed)
                    self._notice("Логи очищены")
                bld.dismiss()
            builder.set_positive_button("Очистить", confirmed)
            builder.set_negative_button("Отмена", lambda bld, _which: bld.dismiss())
            builder.create()
            builder.set_cancelable(True)
            builder.show()
        except Exception as exc:
            self._notice("Логи не очищены: " + type(exc).__name__, True)

    def share(self, *_args):
        """Same report as a .txt in Downloads/ExteraGramDiagnostics + Android share sheet (user picks
        the app and chat). Nothing is uploaded automatically."""
        with self._operation_lock:
            if self._closed or self._busy:
                return
            self._busy = True  # bounded: one in-flight export per controller
        self.ui_event("share", "REQUESTED")
        try:
            text, revision = self.report_text()
            report = ReportSnapshot(revision, text)
            backend = self.sdk.export_backend()  # activity access on UI, resolver work in background
        except Exception as exc:
            with self._operation_lock:
                self._busy = False
            self.ui_event("share", "FAILED", "ERROR", stage="prepare", reason=type(exc).__name__)
            self._notice("Отправка не выполнена: " + type(exc).__name__, True)
            return

        def work():
            try:
                if self._closed:
                    return
                uri = publish_report(report, backend)
                self.ui_event("share", "FILE_SAVED", lines=report.lines)

                def completed():
                    if self._closed:
                        return
                    try:
                        self.sdk.share(uri)
                        self.ui_event("share", "CHOOSER_OPENED", note="delivery not confirmed")
                    except Exception as exc:
                        self.ui_event("share", "FAILED", "ERROR", stage="chooser", reason=type(exc).__name__)
                        self._notice("Файл сохранён в Загрузки/ExteraGramDiagnostics, но выбор приложения "
                                     "не открыт: " + type(exc).__name__, True)
                self._post(completed)
            except Exception as exc:
                detail = str(exc) if isinstance(exc, ExportError) else type(exc).__name__
                self.ui_event("share", "FAILED", "ERROR", stage="file", reason=detail)
                self._post(lambda: self._notice("Ошибка отправки: " + detail, True))
            finally:
                with self._operation_lock:
                    self._busy = False
        try:
            self.sdk.background(work)
        except Exception as exc:
            with self._operation_lock:
                self._busy = False
            self._notice("Задача отправки не запущена: " + type(exc).__name__, True)

    def close(self):
        self.safe_record("INFO", "PLUGIN", "diagnostics", "controller", "CLOSING",
                         {"client_hooks": len(self._xposed_ids)})
        self._closed = True
        hooks = getattr(self, "_hooks_api", None)
        for hook_id in list(self._xposed_ids):
            try:
                hooks.unhook(hook_id)
            except Exception as exc:
                self._safe_exception(exc, "client hook removal failed", category="HOOK", component=hook_id)
        self._xposed_ids = []
        if self._logger is not None:
            try:
                self._logger.remove_handler(self._record_handler)
            except Exception as exc:
                self._safe_exception(exc, "SDK logger handler removal failed", category="PLUGIN",
                                     component="sdk-logger")
            self._logger = None
        self.safe_record("INFO", "PLUGIN", "lifecycle", "unload", "COMPLETED",
                         {"entries": len(self.store.entries()), "journal_failures": self.journal_failures})


class UpdateSheetDecision:
    """First outcome wins: 'Скачать' -> accepted(); close/info tap/swipe/outside tap/dismiss -> declined()."""
    def __init__(self, accepted, declined):
        self._accepted, self._declined = accepted, declined
        self._lock, self._decided = threading.Lock(), False

    def _take(self):
        with self._lock:
            if self._decided:
                return False
            self._decided = True
            return True

    def download(self):
        if not self._take():
            return False
        self._accepted()
        return True

    def close(self):
        if not self._take():
            return False
        self._declined()
        return True


def present_update_sheet(sdk, current, new, decision):
    """Builds the update bottom sheet for the real update flow."""
    sdk.show_update_sheet("Доступно обновление", f"{current} → {new}",
                          "Перед установкой файл будет проверен.", "Скачать", decision)


def build_updater(diagnostics, plugin_id, version, http_get=None, install=None):
    """Wire the manual updater to a DiagnosticsController's SDK bindings (None http/install = Android)."""
    sdk = diagnostics.sdk
    android = None
    if http_get is None or install is None:
        android = UpdaterBindings()
        http_get, install = http_get or android.http_get, install or android.install

    def notify(text, error=False):
        # Deliberately NOT gated by controller._closed: a self-update unloads this plugin first.
        try:
            sdk.ui(lambda: sdk.toast(text, error))
        except Exception:
            pass

    def confirm_dialog(info, accepted, declined):
        """Fallback used only when the bottom sheet cannot be built (old dialog, unchanged behaviour)."""
        try:
            builder = sdk.Alert(sdk.activity())
            builder.set_title("Доступно обновление")
            builder.set_message(f"Версия {version} → {info.version}. Файл будет скачан, проверен "
                                f"(SHA-256, ID, версия) и передан движку плагинов для установки.")
            def yes(bld, _which):
                bld.dismiss()
                accepted()
            def no(bld, _which):
                bld.dismiss()
                declined()
            builder.set_positive_button("Установить", yes)
            builder.set_negative_button("Отмена", no)
            builder.create()
            builder.set_cancelable(True)
            builder.show()
        except Exception as exc:
            declined()
            notify("Диалог обновления не открыт: " + type(exc).__name__, True)

    def confirm(info, accepted, declined):
        def show():
            decision = UpdateSheetDecision(accepted, declined)
            try:
                present_update_sheet(sdk, version, info.version, decision)
            except Exception as exc:
                diagnostics.store.record("WARN", "UPDATE", "updater", "confirm", "SHEET_UNAVAILABLE",
                                         {"reason": type(exc).__name__, "fallback": "AlertDialog"})
                confirm_dialog(info, accepted, declined)
        sdk.ui(show)

    def log(stage, result, level="INFO", details=None):
        category = "NETWORK" if stage in ("manifest.fetch", "download") else "UPDATE"
        diagnostics.store.record(level, category, "updater", stage, result, details or {})

    source = (lambda: android.last_source) if android is not None and http_get == android.http_get else None
    return UpdateController(plugin_id, version, http_get, install, notify, confirm, sdk.background, log=log,
                            source=source)


def updater_rows(sdk, updater):
    return [sdk.Divider(),
            sdk.Header(text="Обновления"),
            sdk.Text(text="Проверить обновления", on_click=updater.check, icon="msg_download",
                     subtext=f"Установлена версия {updater.version}")]

# --- entry.py ---
"""Standalone automatic diagnostics plugin. It observes itself, documented SDK hook points and a few
justified client methods (events.CLIENT_POINTS); other plugins are never read, modified or required."""
import time
from base_plugin import BasePlugin, HookResult

__id__ = "exteragram_diagnostics"
__name__ = "ExteraGram Diagnostics"
__description__ = ("Автоматический технический журнал: запуск плагина, хуки (поиск, установка, реальные "
                   "вызовы, ошибки), события клиента без текста сообщений и этапы обновления. "
                   "Скопировать или отправить отчёт — одной кнопкой.")
__author__ = "@darkaxq"
__version__ = "0.5.2"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"


class ExteraGramDiagnosticsPlugin(BasePlugin):
    def on_plugin_load(self):
        started = time.monotonic()
        try:
            self.diagnostics = DiagnosticsController(
                self, meta={"id": __id__, "version": __version__, "author": __author__})
        except Exception:
            # Without the journal the SDK logger (logcat tag plugin.<id>) is the only channel left.
            getattr(self, "logger", None) and self.logger.exception("diagnostics controller failed to start")
            raise
        d = self.diagnostics
        d.safe_record("INFO", "PLUGIN", "lifecycle", "load", "STARTED", {"id": __id__, "version": __version__})
        d.init_step("journal", "OK")
        bound = d.bind_logger(getattr(self, "logger", None))
        d.init_step("sdk_logger", "REGISTERED" if bound else "NOT_BOUND", level=None if bound else "WARN")
        try:
            self.updater = build_updater(d, __id__, __version__)
            d.safe_record("INFO", "UPDATE", "updater", "init", "READY", {"installed": __version__})
            d.init_step("updater", "READY")
        except Exception as exc:
            self.updater = None
            d._safe_exception(exc, "updater initialization failed", category="UPDATE", component="updater")
            d.init_step("updater", "FAILED", reason=type(exc).__name__)
        try:
            registered = d.attach_events(self.add_hook, self.add_on_send_message_hook)
            total = 1 + len(REQUESTS) + len(UPDATES)
            d.init_step("sdk_event_hooks", "REGISTERED" if registered == total else
                        "PARTIAL" if registered else "FAILED", registered=registered, of=total)
        except Exception as exc:
            d._safe_exception(exc, "event hook registration failed", category="HOOK", component="events",
                              include_message=True)
            d.init_step("sdk_event_hooks", "FAILED", reason=type(exc).__name__)
        d.init_step("client_points", "SCHEDULED" if d.start_client_observation() else "FAILED",
                    note="results: HOOK/client.* lookup/install")
        d.init_step("load", "COMPLETED", ms=int((time.monotonic() - started) * 1000))
        d.safe_record("INFO", "PLUGIN", "lifecycle", "load", "COMPLETED",
                      {"ms": int((time.monotonic() - started) * 1000)})

    def on_plugin_unload(self):
        if hasattr(self, "diagnostics"):
            self.diagnostics.safe_record("INFO", "PLUGIN", "lifecycle", "unload", "STARTED")
            self.diagnostics.close()

    def on_app_event(self, event_type):
        if hasattr(self, "diagnostics"):
            name = getattr(event_type, "name", None) or str(event_type)
            self.diagnostics.app_event(name)

    # Documented SDK hook methods. Observation only: always return a default HookResult.
    def on_send_message_hook(self, account, params):
        if hasattr(self, "diagnostics"):
            self.diagnostics.on_sdk_event("send", account, params)
        return HookResult()

    def pre_request_hook(self, request_name, account, request):
        if hasattr(self, "diagnostics"):
            self.diagnostics.on_sdk_event("pre", request_name, account, request)
        return HookResult()

    def post_request_hook(self, request_name, account, response, error):
        if hasattr(self, "diagnostics"):
            self.diagnostics.on_sdk_event("post", request_name, account, response, error)
        return HookResult()

    def on_update_hook(self, update_name, account, update):
        if hasattr(self, "diagnostics"):
            self.diagnostics.on_sdk_event("update", update_name, account, update)
        return HookResult()

    def create_settings(self):
        from ui.settings import Text
        if not hasattr(self, "diagnostics"):
            return [Text(text="Отладка не загружена")]
        rows = self.diagnostics.settings()
        if getattr(self, "updater", None) is not None:
            rows += updater_rows(self.diagnostics.sdk, self.updater)
        return rows
